{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.local/008-egypt-tax-accounting/wht-certificate.schema.json",
  "title": "Egyptian WHT Certificate (شهادة خصم)",
  "description": "Structured representation of a withholding-tax certificate. Used both for outbound certificates the system issues to suppliers and inbound certificates the system records from customers. The PDF rendering is generated by QuestPDF from this same payload.",
  "type": "object",
  "required": [
    "certificateNumber",
    "direction",
    "issuedAt",
    "issuerCompanyTin",
    "issuerCompanyName",
    "counterpartyTin",
    "counterpartyName",
    "sourceInvoiceNumber",
    "sourceInvoiceDate",
    "sourceVoucherNumber",
    "sourceVoucherDate",
    "whtCategoryCode",
    "rateAppliedPercent",
    "amountWithheld",
    "currency",
    "language"
  ],
  "properties": {
    "certificateNumber": { "type": "string", "minLength": 1 },
    "direction": { "type": "string", "enum": ["OutboundToSupplier", "InboundFromCustomer"] },
    "issuedAt": { "type": "string", "format": "date-time" },
    "issuerCompanyTin": { "type": "string", "pattern": "^[0-9]{9}$" },
    "issuerCompanyName": {
      "type": "object",
      "required": ["ar", "en"],
      "properties": {
        "ar": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "counterpartyTin": { "type": "string", "pattern": "^[0-9]{9}$" },
    "counterpartyName": {
      "type": "object",
      "required": ["ar", "en"],
      "properties": {
        "ar": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "sourceInvoiceNumber": { "type": "string", "minLength": 1 },
    "sourceInvoiceDate": { "type": "string", "format": "date" },
    "sourceVoucherNumber": { "type": "string", "minLength": 1 },
    "sourceVoucherDate": { "type": "string", "format": "date" },
    "whtCategoryCode": { "type": "string", "minLength": 1 },
    "whtCategoryName": {
      "type": "object",
      "required": ["ar", "en"],
      "properties": {
        "ar": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "rateAppliedPercent": { "type": "number", "minimum": 0, "maximum": 100 },
    "amountWithheld": { "type": "number", "minimum": 0 },
    "grossPayment": { "type": "number", "minimum": 0 },
    "netPayment": { "type": "number", "minimum": 0 },
    "currency": { "type": "string", "const": "EGP" },
    "language": { "type": "string", "enum": ["ar+en"] },
    "auditChainHash": { "type": "string", "pattern": "^[a-f0-9]{64}$", "description": "SHA-256 of the audit-log entry that records the certificate creation" }
  }
}
