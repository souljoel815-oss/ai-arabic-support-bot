# =============================================================================
# AI Customer Support Agent — deployment environment
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# `.env` is gitignored; never commit it.
# =============================================================================

# --- Required -----------------------------------------------------------------

# Google Gemini API key from AI Studio / Google Cloud.
GEMINI_API_KEY=

# Default Gemini variant. Per research.md R1, Flash is the default; switch to
# `gemini-1.5-pro` if SC-002 (Egyptian-dialect ≥ 85%) fails on Flash.
GEMINI_MODEL=gemini-1.5-flash

# Public hostname Caddy will TLS-terminate on. DNS A record must point here.
N8N_HOST=support-demo.example.com

# Public webhook base URL (must match N8N_HOST and be HTTPS).
WEBHOOK_URL=https://support-demo.example.com/

# Random 32-byte hex string used by n8n to encrypt stored credentials.
# Generate with:  openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# --- Recommended --------------------------------------------------------------

# Timezone used for n8n's cron evaluations and for log timestamps.
GENERIC_TIMEZONE=Africa/Cairo

# n8n log level: error | warn | info | verbose | debug
N8N_LOG_LEVEL=info
