# =========================================================================
# DaftarX Portal — environment configuration template
# =========================================================================
# Copy to `.env` and fill in production secrets before deploying. The real
# `.env` is gitignored; only this template lives in the repo. Hostinger
# Shared Hosting reads `.env` from the project root via Laravel's
# DotenvLoader, so the file must sit alongside `artisan` on the server.
# =========================================================================

# --- App ----------------------------------------------------------------
APP_NAME="DaftarX"
APP_ENV=production
APP_KEY=                       # `php artisan key:generate` after first deploy
APP_DEBUG=false                # NEVER true in production
APP_TIMEZONE=Africa/Cairo
APP_URL=https://daftarx.app

APP_LOCALE=ar-EG
APP_FALLBACK_LOCALE=en-US
APP_FAKER_LOCALE=ar_EG

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# --- Logging ------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info                 # `debug` in staging, `info` in production

# --- Database -----------------------------------------------------------
# Hostinger Shared Hosting provides MySQL (no Postgres). SQLite works for
# local dev but cannot be used in production due to file-locking limits.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u123456789_daftarx
DB_USERNAME=u123456789_daftarx
DB_PASSWORD=

# --- Sessions / queues / cache ------------------------------------------
# All routed through the database since Hostinger Shared Hosting has no
# Redis. Sessions are encrypted because they hold CSRF tokens for paid
# actions (subscription start, refund, licence transfer).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true     # HTTPS-only cookies in production

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=daftarx

# --- Mail (Resend SMTP) -------------------------------------------------
# Resend's transactional-email SMTP submission server. The username is
# the literal string "resend"; password is the API key from the Resend
# dashboard (rotate quarterly per security policy).
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@daftarx.app"
MAIL_FROM_NAME="${APP_NAME}"

# --- Paymob (Egypt PSP) -------------------------------------------------
# Card + Fawry + Vodafone Cash + InstaPay routing per FR-015. Credentials
# come from the Paymob merchant dashboard (separate sandbox + production
# IDs). The HMAC secret signs webhook payloads — Paymob rotates this on
# request; never expose it in any client-side context.
PAYMOB_API_BASE=https://accept.paymob.com/api
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_FAWRY=
PAYMOB_INTEGRATION_ID_VODAFONE_CASH=
PAYMOB_INTEGRATION_ID_INSTAPAY=

# --- Licence signing ----------------------------------------------------
# Path to the JSON file holding the Ed25519 keypair used to sign portal-
# issued paid licences. Mounted READ-ONLY on the server outside the web
# root (e.g. /home/u123456789/private/vendor-keys.json — chmod 400).
# The matching public key is embedded in the on-prem desktop binary so
# the desktop verifies portal-signed licences offline.
LICENCE_SIGNING_KEYS_PATH=/home/u123456789/private/vendor-keys.json

# --- Cloudflare cache purge (CI/CD) -------------------------------------
# Used by the deploy pipeline to invalidate marketing-route cache after
# every release. Scoped API token (Zone:Cache Purge); rotate annually.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# --- UptimeRobot / status page (optional) -------------------------------
UPTIMEROBOT_API_KEY=

# --- Vite ---------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
