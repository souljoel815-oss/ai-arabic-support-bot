@inherits LayoutComponentBase
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<div class="flex min-h-screen bg-[color:var(--daftarx-cream)] text-[color:var(--daftarx-ink)]">

    @* T034 — Mission Control sidebar (locked layout per memory:
       feedback_appshell_sidebar_locked.md — 2-tier ModuleSidebar +
       SubNavPanel pattern from the on-prem product). The portal sidebar
       is a slimmer single-tier variant since the portal's surface area
       is small (~12 screens) vs the on-prem product's ~55. *@
    <aside class="w-56 bg-white border-e shrink-0">
        <div class="px-4 py-4 border-b">
            <a href="/portal" class="block text-lg font-bold text-[color:var(--daftarx-charcoal)]">DaftarX</a>
            <span class="text-xs text-gray-500">Customer portal</span>
        </div>
        <nav class="flex flex-col p-2 text-sm">
            <a href="/portal" class="rounded px-3 py-2 hover:bg-gray-100">Dashboard</a>
            <a href="/portal/licences" class="rounded px-3 py-2 hover:bg-gray-100">Licences</a>
            <a href="/portal/subscription" class="rounded px-3 py-2 hover:bg-gray-100">Subscription</a>
            <a href="/portal/billing" class="rounded px-3 py-2 hover:bg-gray-100">Billing</a>
            <a href="/portal/downloads" class="rounded px-3 py-2 hover:bg-gray-100">Downloads</a>
            <a href="/portal/support" class="rounded px-3 py-2 hover:bg-gray-100">Support</a>
            <a href="/portal/organisation" class="rounded px-3 py-2 hover:bg-gray-100">Organisation</a>
            <a href="/portal/account/security" class="rounded px-3 py-2 hover:bg-gray-100">Account &amp; security</a>
        </nav>
    </aside>

    <main class="flex-1 px-8 py-8">
        @Body
    </main>

</div>
