@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Loc
@{
    var culture = System.Threading.Thread.CurrentThread.CurrentUICulture;
    var isArabic = culture.TwoLetterISOLanguageName == "ar";
    var dir = isArabic ? "rtl" : "ltr";
    var langTag = culture.Name;
}
<!DOCTYPE html>
<html lang="@langTag" dir="@dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — DaftarX</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="alternate" hreflang="ar-EG" href="/ar@(Context.Request.Path.Value?.Substring(Math.Min(3, Context.Request.Path.Value.Length)))" />
    <link rel="alternate" hreflang="en-US" href="/en@(Context.Request.Path.Value?.Substring(Math.Min(3, Context.Request.Path.Value.Length)))" />
</head>
<body class="min-h-screen bg-[color:var(--daftarx-cream)] text-[color:var(--daftarx-ink)]">

    @* T033 — Mission Control marketing header. Sidebar layout is a portal
       concern (T034 _PortalLayout.razor); the public marketing surface gets
       a simple top nav so prospects can scan the site in one screen. *@
    <header class="border-b bg-white">
        <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
            <a href="/" class="text-xl font-bold text-[color:var(--daftarx-charcoal)]">DaftarX</a>
            <div class="flex items-center gap-6 text-sm">
                <a href="/features" class="hover:text-[color:var(--daftarx-gold)]">@Loc["nav.features"]</a>
                <a href="/pricing" class="hover:text-[color:var(--daftarx-gold)]">@Loc["nav.pricing"]</a>
                <a href="/downloads" class="hover:text-[color:var(--daftarx-gold)]">@Loc["nav.downloads"]</a>
                <a href="/about" class="hover:text-[color:var(--daftarx-gold)]">@Loc["nav.about"]</a>
                <a href="/contact" class="hover:text-[color:var(--daftarx-gold)]">@Loc["nav.contact"]</a>
                <a href="/portal" class="btn-primary">@Loc["nav.signin"]</a>
                <partial name="_LanguageSwitcher" />
            </div>
        </nav>
    </header>

    <main class="mx-auto max-w-6xl px-4 py-12">
        @RenderBody()
    </main>

    @* T051 — footer with legal links rendered everywhere per FR-007. *@
    <footer class="mt-16 border-t bg-white">
        <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-6 text-xs text-gray-500">
            <span>© @DateTime.UtcNow.Year DaftarX. @Loc["footer.tagline"]</span>
            <div class="flex gap-4">
                <a href="/terms" class="hover:text-[color:var(--daftarx-gold)]">@Loc["footer.terms"]</a>
                <a href="/refund" class="hover:text-[color:var(--daftarx-gold)]">@Loc["footer.refund"]</a>
                <a href="/privacy" class="hover:text-[color:var(--daftarx-gold)]">@Loc["footer.privacy"]</a>
                <a href="/privacy/android" class="hover:text-[color:var(--daftarx-gold)]">@Loc["footer.privacy_android"]</a>
            </div>
        </div>
    </footer>

</body>
</html>
