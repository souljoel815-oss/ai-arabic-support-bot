<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>EgyptTax.Infrastructure</RootNamespace>
    <AssemblyName>EgyptTax.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EgyptTax.Application\EgyptTax.Application.csproj" />
  </ItemGroup>

  <!--
    T102 — Cairo + Amiri TTFs from src/EgyptTax.Web/wwwroot/fonts/ are
    embedded into the Infrastructure assembly so QuestPdfInvoiceRenderer
    can register them at static-construction time without a disk-path
    dependency. This keeps the renderer self-contained for contract
    tests (which never go through Web's hosting pipeline) and removes
    the "stripped CI image has no Arabic glyphs" failure mode flagged
    in the T102 closeout note. Single source on disk; logical Link
    flattens the namespace to EgyptTax.Infrastructure.Pdf.Fonts.{name}.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\EgyptTax.Web\wwwroot\fonts\Cairo-Regular.ttf"
                      Link="Pdf\Fonts\Cairo-Regular.ttf" />
    <EmbeddedResource Include="..\EgyptTax.Web\wwwroot\fonts\Amiri-Regular.ttf"
                      Link="Pdf\Fonts\Amiri-Regular.ttf" />
    <EmbeddedResource Include="..\EgyptTax.Web\wwwroot\fonts\Amiri-Bold.ttf"
                      Link="Pdf\Fonts\Amiri-Bold.ttf" />
  </ItemGroup>

  <!--
    T232 — verify-bundle.ps1 ships embedded so InspectionBundleBuilder
    can write it into every produced bundle. Pure PowerShell + .NET-
    built-in cmdlets so it runs on a clean Windows VM with no module
    installs and no internet access.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Inspection\verify-bundle.ps1"
                      Link="Inspection\verify-bundle.ps1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Dapper" />
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="Otp.NET" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
    <PackageReference Include="System.Formats.Cbor" />
    <PackageReference Include="Hangfire.Core" />
    <PackageReference Include="Hangfire.SqlServer" />
    <PackageReference Include="Polly" />
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" />
    <PackageReference Include="Tesseract" />
  </ItemGroup>

</Project>
