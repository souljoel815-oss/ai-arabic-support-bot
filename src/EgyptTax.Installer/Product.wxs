<?xml version="1.0" encoding="UTF-8"?>
<!--
  T247 + T247-followup / R-24 / SC-001 — EgyptTax MSI installer source.

  Build via the wixproj sibling — see README.md for the canonical
  invocation. TL;DR: `dotnet publish` the EgyptTax.Web project to
  ./publish/, then `dotnet build EgyptTax.Installer.wixproj
  -p:PublishDir=path-to-publish`. Output lands at
  bin/Release/EgyptTax.Installer.msi.

  The MSI installs the EgyptTax Web service into Program Files,
  registers it as an auto-start Windows service, opens HTTPS port
  443 in the firewall, runs the seeder to apply EF migrations + create
  the first Administrator account, and gates the "install complete"
  screen on the readiness probe (T257).

  WiX 5 <Files> element auto-harvests the `publish/` output at
  build time — there's no separate `wix harvest` step. The Files
  element generates one Component per file with a stable
  Guid-from-path so upgrade scenarios work without manual
  ComponentGuid bookkeeping.

  Operator-prompted properties (set via msiexec command-line):
    SQL_CONNECTION       — connection string to the SQL Server
                           database; default uses Trusted_Connection
                           against local default instance.
    AUDIT_CHECKPOINT_MODE — "Sql" or "FileSystem" (FR-028 install-time
                           choice); default "Sql".
    ATTACHMENTS_ROOT     — directory for receipt uploads (FR-019);
                           default %ProgramData%\EgyptTax\attachments.
    NTP_SERVER           — clock-drift defense (FR-042); default
                           time.windows.com.

  Out of scope for the MVP installer (deferred — see README.md):
    * Custom UI dialog pages for the 4 properties above. Properties
      are MSI-public + can be set via msiexec command-line:
      `msiexec /i EgyptTax-Setup.msi SQL_CONNECTION="..." ...`
      The full WixUI_Mondo dialog set + a custom property page is
      Near-term.
    * WixUtil's XmlConfig support to write the operator-supplied
      properties into the published appsettings.json at install time.
      Today: operator hand-edits per docs/operator-runbook.md §1.2.

  See docs/operator-runbook.md §1 for the install + bootstrap flow.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="EgyptTax"
           Manufacturer="EgyptTax"
           Version="1.0.0.0"
           UpgradeCode="C8E3D7B6-1F5A-4B2C-9D8E-7F4A6E1B3C2D"
           Compressed="yes"
           InstallerVersion="500"
           Scope="perMachine">

    <SummaryInformation Description="EgyptTax — Egyptian SME accounting + tax compliance"
                        Manufacturer="EgyptTax" />

    <MediaTemplate EmbedCab="yes" />

    <!-- Operator-prompted properties (see comment above for current
         msiexec-command-line bootstrap path). -->
    <Property Id="SQL_CONNECTION"
              Value="Server=.\SQLEXPRESS;Database=EgyptTax;Trusted_Connection=True;TrustServerCertificate=True"
              Secure="yes" />
    <Property Id="AUDIT_CHECKPOINT_MODE" Value="Sql" Secure="yes" />
    <Property Id="ATTACHMENTS_ROOT"
              Value="C:\ProgramData\EgyptTax\attachments"
              Secure="yes" />
    <Property Id="NTP_SERVER" Value="time.windows.com" Secure="yes" />

    <!-- Initial admin credentials. Bundle wires these from the
         setup-wizard PowerShell GUI; if invoked directly with msiexec,
         the bundle's defaults remain the safe fallbacks below.
         The seed CLI applies them on first install only — re-running
         the MSI does not overwrite an existing admin's email/password. -->
    <Property Id="ADMIN_EMAIL" Value="admin@daftarx.local" Secure="yes" />
    <Property Id="ADMIN_PASSWORD" Value="TempP@ssw0rd!2026" Secure="yes" />

    <!-- Optional internal-network domain so workstations can reach the
         server at https://<INTERNAL_DOMAIN>/ instead of an IP. The
         setup-https.ps1 CA bakes it into the cert SAN list. Default
         to a sensible placeholder; the bundle overrides via MsiProperty
         (or empty string passed when the operator skipped the field). -->
    <Property Id="INTERNAL_DOMAIN" Value="daftarx.local" Secure="yes" />

    <!-- Kestrel bind URL — what the EgyptTax Windows service listens
         on. Default matches the firewall rule below (HTTP on 8088).
         Operators who want HTTPS instead can pass BIND_URL=https://+:443
         on the msiexec command line + run setup-https.ps1 separately
         to provision the cert. -->
    <Property Id="BIND_URL" Value="http://+:8088" Secure="yes" />

    <!-- Reject downgrade installs; require uninstall first. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of EgyptTax is already installed." />

    <!-- The single feature that ships everything. Future near-term
         batches can split out a "Hangfire dashboard" or "Live ETA
         client" feature for selective install. -->
    <Feature Id="ProductFeature"
             Title="EgyptTax"
             Description="EgyptTax accounting + tax compliance service"
             Level="1"
             AllowAbsent="no">
      <ComponentGroupRef Id="EgyptTaxFiles" />
      <ComponentGroupRef Id="EgyptTaxScripts" />
      <ComponentGroupRef Id="EgyptTaxWorkstationTools" />
      <ComponentRef Id="FirewallComponent" />
    </Feature>

    <!-- WiX 5 <Files> harvest — single recursive glob covers the
         entire publish output, including EgyptTax.Web.exe. The
         harvester auto-generates one Component per file with a
         stable Guid-from-path so MajorUpgrade scenarios work
         without manual ComponentGuid bookkeeping.

         Note: WiX 5's <Files> element doesn't respect file-extension
         restrictions in the include glob (each pattern walks the
         full tree); a single catch-all pattern is the only stable
         shape. The .exe is harvested here AND the Windows service
         is registered via sc.exe in custom actions below — no
         ServiceInstall element used (which would have required the
         .exe in a dedicated component, conflicting with the
         catch-all harvest). -->
    <ComponentGroup Id="EgyptTaxFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>

    <!-- The verifier script ships with the installer source rather
         than the published web app (it's an install-time tool, not
         a runtime artifact). -->
    <ComponentGroup Id="EgyptTaxScripts" Directory="INSTALLFOLDER">
      <Component Id="VerifyHealthScriptComponent"
                 Guid="A2B3C4D5-E6F7-8901-2345-67890ABCDEF1">
        <File Id="VerifyHealthScript"
              Source="$(var.ProjectDir)verify-health.ps1"
              KeyPath="yes" />
      </Component>
      <Component Id="ApplyConfigScriptComponent"
                 Guid="C3D4E5F6-A7B8-9012-3456-7890ABCDEF12">
        <File Id="ApplyConfigScript"
              Source="$(var.ProjectDir)apply-config.ps1"
              KeyPath="yes" />
      </Component>
      <Component Id="RegisterServiceScriptComponent"
                 Guid="D4E5F6A7-B8C9-0123-4567-890ABCDEF123">
        <File Id="RegisterServiceScript"
              Source="$(var.ProjectDir)register-service.ps1"
              KeyPath="yes" />
      </Component>
      <Component Id="SetupHttpsScriptComponent"
                 Guid="E5F6A7B8-C9D0-1234-5678-90ABCDEF1234">
        <File Id="SetupHttpsScript"
              Source="$(var.ProjectDir)setup-https.ps1"
              KeyPath="yes" />
      </Component>
      <Component Id="GrantSqlPermissionsScriptComponent"
                 Guid="B7C8D9E0-F1A2-3456-7890-1234567890AB">
        <File Id="GrantSqlPermissionsScript"
              Source="$(var.ProjectDir)grant-sql-permissions.ps1"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Workstation-tools subfolder. Copied to:
         C:\Program Files\EgyptTax\workstation-tools\
         IT staff grab these files from the server and run them on
         each workstation to trust the SSL cert + add the hosts entry.
         Distinct ComponentGroup so the Files element scopes
         correctly into the WorkstationToolsFolder Directory. -->
    <ComponentGroup Id="EgyptTaxWorkstationTools" Directory="WORKSTATIONTOOLSFOLDER">
      <Component Id="WorkstationTrustCmd"
                 Guid="F6A7B8C9-D0E1-2345-6789-0ABCDEF12345">
        <File Id="WorkstationTrustCmdFile"
              Source="$(var.ProjectDir)workstation-tools\Trust-DaftarX-Cert.cmd"
              KeyPath="yes" />
      </Component>
      <Component Id="WorkstationTrustPs1"
                 Guid="A7B8C9D0-E1F2-3456-7890-ABCDEF123456">
        <File Id="WorkstationTrustPs1File"
              Source="$(var.ProjectDir)workstation-tools\trust-cert.ps1"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Windows service registration via PowerShell wrapper
         (register-service.ps1) instead of separate sc.exe-create
         + sc.exe-start CAs. The wrapper handles the three
         pre-existing-service states the simple sc.exe form trips on:
           1. Service exists + running          → stop + reconfigure
           2. Service exists + marked-for-delete → wait up to 30s
                                                    for kernel cleanup
           3. Service doesn't exist             → straight create
         Without the wrapper, error 1072
         "ERROR_SERVICE_MARKED_FOR_DELETE" fires when the operator
         re-runs the MSI after a previous failed install (the
         marked-for-delete state can persist for minutes if any
         process holds an open handle).

         Operators using SQL Windows-auth against a remote DB should
         re-issue the service registration with a dedicated domain
         account post-install via:
           sc.exe config EgyptTax obj= "DOMAIN\acct" password= "..." -->
    <CustomAction Id="RegisterService"
                  Directory="INSTALLFOLDER"
                  ExeCommand='powershell.exe -NoProfile -ExecutionPolicy Bypass -File "[INSTALLFOLDER]register-service.ps1"'
                  Execute="deferred"
                  Impersonate="yes"
                  Return="check" />
    <CustomAction Id="StopService"
                  Directory="INSTALLFOLDER"
                  ExeCommand='sc.exe stop EgyptTax'
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />
    <CustomAction Id="DeleteService"
                  Directory="INSTALLFOLDER"
                  ExeCommand='sc.exe delete EgyptTax'
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- HTTP port 8088 inbound rule so accountants on the LAN can
         reach the web app at http://<server>:8088/. Matches the
         BIND_URL default above. Operators who switch to HTTPS via
         setup-https.ps1 should add a 443 rule manually OR re-run
         the MSI with BIND_URL=https://+:443 (which re-binds and
         the cert flow handles 443 itself).

         Uses a registry value as keypath so the firewall rule can
         live independently of any installed file (the firewall
         rule is install-state, not file-content). -->
    <Component Id="FirewallComponent"
               Directory="INSTALLFOLDER"
               Guid="B2C3D4E5-F6A7-8901-BCDE-234567890ABC">
      <RegistryValue Root="HKLM"
                     Key="Software\EgyptTax\Install"
                     Name="FirewallConfigured"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
      <fw:FirewallException Id="EgyptTaxHttp8088"
                            Name="EgyptTax HTTP (8088)"
                            Description="Inbound HTTP for the EgyptTax web service on port 8088"
                            Port="8088"
                            Protocol="tcp"
                            Scope="any"
                            Profile="all"
                            IgnoreFailure="yes" />
      <!-- v5 — port 50063 is the fixed bind for the DaftarX desktop
           shell (src/EgyptTax.Desktop). When the operator runs
           DaftarX.exe on the same machine the MSI was installed on,
           workstations on the LAN need this hole to reach the
           Photino-wrapped Kestrel instance bound to 0.0.0.0:50063.
           Override on the launcher side via --port <n> or
           DAFTARX_PORT=<n>; if the operator picks a different port
           they own the firewall rule for it. -->
      <fw:FirewallException Id="DaftarXDesktop50063"
                            Name="DaftarX desktop (50063)"
                            Description="Inbound HTTP for the DaftarX desktop shell on port 50063"
                            Port="50063"
                            Protocol="tcp"
                            Scope="any"
                            Profile="all"
                            IgnoreFailure="yes" />
    </Component>

    <!-- T247-fix-A: write appsettings.Production.json from the
         operator-supplied MSI properties BEFORE the seed CLI fires.
         Without this, the seed CLI's chained config has no
         connection string + exits with code 4 "No connection
         string found" + the MSI rolls back. The runtime web
         service ALSO consumes this file, so the same config bridge
         covers both the install-time seed AND post-install
         service operation.

         Uses WixToolset.Util.wixext's WixQuietExec helper: the
         SetProperty resolves [SQL_CONNECTION] etc. at "execute"
         sequence time (when public props are available) + writes
         the resolved command line into the WixQuietExecCmdLine
         property. The util:WixQuietExec CA reads that property +
         executes the command as a deferred LocalSystem-context
         process — sidesteps the deferred-CA can't-read-public-
         props limitation. -->
    <!-- Trimmed param list to fit MSI's CustomAction.Target 255-char
         column (ICE03). Only the connection string is essential —
         the other properties (audit-checkpoint mode, attachments
         root, NTP server) all have sensible defaults in the
         apply-config.ps1 script + can be reconfigured post-install
         by hand-editing appsettings.Production.json.

         IMPORTANT: SetProperty.Id MUST match the deferred CA's Id
         (not "WixQuietExecCmdLine" or any other name) — that's how
         MSI auto-routes the value as the CA's CustomActionData,
         which is where util:WixQuietExec reads its command line
         from. Mismatching IDs gives WixQuietExec error 0x80070057
         "Failed to get command line data". -->
    <SetProperty Id="ApplyConfig"
                 Value='"powershell.exe" -ExecutionPolicy Bypass -File "[INSTALLFOLDER]apply-config.ps1" -SqlConnection "[SQL_CONNECTION]" -BindUrl "[BIND_URL]"'
                 Sequence="execute"
                 Before="ApplyConfig" />
    <CustomAction Id="ApplyConfig"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!-- Custom action: invoke the EgyptTax.Web seed CLI after
         install to apply EF migrations + create the first
         Administrator. The action's exit code is checked; non-zero
         rolls back the install.

         Impersonate="yes": run as the installing user (already
         elevated via UAC), NOT LocalSystem. Reason: most SQL
         Server installs grant the interactive admin user a
         sysadmin login, but NT AUTHORITY\SYSTEM may not have one
         (especially on Express installs configured for
         Windows-auth-with-specific-users). Running under the
         installing user's context lets Trusted_Connection
         authenticate against SQL the same way the operator's
         own sqlcmd / SSMS sessions do. -->
    <!-- Same SetProperty/util:WixQuietExec pattern as ApplyConfig:
         resolves [ADMIN_EMAIL] + [ADMIN_PASSWORD] at execute-sequence
         time (when public props are visible) and routes them as the
         deferred CA's CustomActionData. The seed CLI uses
         the admin-email + bootstrap-password flags it already supports. -->
    <SetProperty Id="ApplyMigrationsAndSeed"
                 Value='"[INSTALLFOLDER]EgyptTax.Web.exe" seed --apply-migrations --admin-email "[ADMIN_EMAIL]" --bootstrap-password "[ADMIN_PASSWORD]"'
                 Sequence="execute"
                 Before="ApplyMigrationsAndSeed" />
    <CustomAction Id="ApplyMigrationsAndSeed"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="check" />

    <!-- Grant the EgyptTax Windows service account (NetworkService)
         a SQL login + db_owner on the EgyptTax database. Without
         this, the service starts but every DB query throws "Login
         failed for user NT AUTHORITY\NETWORK SERVICE" (the SQL
         Express install only adds BUILTIN\Administrators as
         sysadmin by default, and our service runs under a different
         account).

         Runs as the installing user (impersonate=yes) so the script
         inherits the SQL Express sysadmin grant for
         BUILTIN\Administrators. Sequenced AFTER the schema is
         created (ApplyMigrationsAndSeed) and BEFORE the service is
         registered (RegisterService) so the first time the service
         calls DB it already has access. -->
    <CustomAction Id="GrantSqlPermissions"
                  Directory="INSTALLFOLDER"
                  ExeCommand='powershell.exe -NoProfile -ExecutionPolicy Bypass -File "[INSTALLFOLDER]grant-sql-permissions.ps1"'
                  Execute="deferred"
                  Impersonate="yes"
                  Return="check" />

    <!-- T257 — health-readiness probe. Informational, NOT install-
         blocking: probes /api/v1/health/ready up to 10 times with
         a 1s gap. Real-world install testing showed the probe is
         too aggressive — many envs need Kestrel TLS cert
         configured AFTER first install (operator-supplied cert),
         so the probe times out even though the service is
         healthy. Return="ignore" lets the install complete; the
         operator verifies health post-install via Get-Service
         EgyptTax + a browser check.
         Impersonate="yes" so the script runs in the operator's
         elevated context (TLS callback registration etc.). -->
    <CustomAction Id="VerifyHealthReady"
                  Directory="INSTALLFOLDER"
                  ExeCommand='powershell.exe -NoProfile -ExecutionPolicy Bypass -File "[INSTALLFOLDER]verify-health.ps1"'
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />

    <!-- Generate self-signed HTTPS cert + bind Kestrel to 443.
         SetProperty resolves [INTERNAL_DOMAIN] at execute-sequence
         time so the deferred CA receives the operator-supplied domain
         (or empty string) as CustomActionData via util:WixQuietExec. -->
    <SetProperty Id="SetupHttps"
                 Value='"powershell.exe" -NoProfile -ExecutionPolicy Bypass -File "[INSTALLFOLDER]setup-https.ps1" -InstallFolder "[INSTALLFOLDER]" -InternalDomain "[INTERNAL_DOMAIN]"'
                 Sequence="execute"
                 Before="SetupHttps" />
    <CustomAction Id="SetupHttps"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- Sequence the custom actions:
         Install path (NOT REMOVE):
           1. InstallFiles writes everything to disk.
           2. ApplyMigrationsAndSeed creates the EgyptTax schema +
              first Administrator (we need the schema in place
              before the service can connect cleanly).
           3. CreateService registers the Windows service with
              sc.exe, pointing at [INSTALLFOLDER]EgyptTax.Web.exe.
           4. StartService launches it.
           5. VerifyHealthReady polls /api/v1/health/ready until
              the service reports Healthy (T257) — non-Healthy
              fails the install + rollback.
         Uninstall path (REMOVE="ALL"):
           1. StopService halts the running instance.
           2. DeleteService removes the registration from SCM.
           3. Standard RemoveFiles tears down the disk install. -->
    <InstallExecuteSequence>
      <Custom Action="ApplyConfig"
              After="InstallFiles"
              Condition="NOT REMOVE" />
      <Custom Action="ApplyMigrationsAndSeed"
              After="ApplyConfig"
              Condition="NOT REMOVE" />
      <Custom Action="GrantSqlPermissions"
              After="ApplyMigrationsAndSeed"
              Condition="NOT REMOVE" />
      <Custom Action="RegisterService"
              After="GrantSqlPermissions"
              Condition="NOT REMOVE" />
      <Custom Action="SetupHttps"
              After="RegisterService"
              Condition="NOT REMOVE" />
      <Custom Action="VerifyHealthReady"
              After="SetupHttps"
              Condition="NOT REMOVE" />

      <Custom Action="StopService"
              Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="DeleteService"
              After="StopService"
              Condition="REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>

    <!-- Standard install directory layout. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="EgyptTax">
        <Directory Id="WORKSTATIONTOOLSFOLDER" Name="workstation-tools" />
      </Directory>
    </StandardDirectory>

  </Package>
</Wix>
