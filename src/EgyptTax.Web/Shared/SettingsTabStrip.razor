@inject NavigationManager Nav

@*
    Gux.3 — gives a related cluster of Settings pages a shared tab
    strip so operators perceive them as one area. Pages keep their
    URLs (no breakage for bookmarks); the strip renders tabs and
    highlights whichever one matches the current path.

    Two clusters today:
      Group="tax-setup"  → Tax periods + VAT categories
      Group="money"      → Payment methods + Cash accounts + Opening balances
*@

@code {
    [Parameter] public string Group { get; set; } = "";

    private record Tab(string Path, string Ar, string En);

    private static readonly Tab[] TaxSetupTabs =
    {
        new("/settings/tax-periods",     "الفترات الضريبية", "Tax periods"),
        new("/settings/fiscal-year",     "السنة المالية",   "Fiscal year"),
        new("/settings/vat-categories",  "فئات الضريبة",     "VAT categories"),
        new("/settings/wht-categories",  "فئات الخصم",      "WHT categories"),
        new("/settings/payment-terms",   "شروط الدفع",      "Payment terms"),
        new("/settings/fiscal-positions","المواقف الضريبية", "Fiscal positions"),
    };

    private static readonly Tab[] MoneyTabs =
    {
        new("/settings/payment-methods",  "طرق الدفع",         "Payment methods"),
        new("/settings/cash-accounts",    "الخزائن والبنوك",    "Cashboxes & banks"),
        new("/currencies",                "العملات",          "Currencies"),
        new("/settings/opening-balances", "الأرصدة الافتتاحية", "Opening balances"),
    };

    private static readonly Tab[] PricingTabs =
    {
        new("/settings/quotation-templates", "قوالب عروض الأسعار", "Quotation templates"),
        new("/settings/pricelists",          "قوائم الأسعار",      "Pricelists"),
        new("/settings/sales-teams",         "فرق المبيعات",        "Sales teams"),
    };

    private static readonly Tab[] EtaTabs =
    {
        new("/eta-dashboard",       "لوحة ETA",         "ETA dashboard"),
        new("/eta-inbox",           "الصندوق الوارد",   "Inbox"),
        new("/eta-export",          "تصدير",           "Export"),
        new("/eta-wizard",          "معالج الإعداد",    "Setup wizard"),
        new("/inspection-bundle",   "حزمة فحص ضريبي",  "Inspection bundle"),
    };

    // v5 sidebar consolidation — new clusters used by the rolled-out
    // SubNavPanel entries.
    private static readonly Tab[] AccrualsTabs =
    {
        new("/prepaid-expenses",   "المصروفات المدفوعة مقدماً", "Prepaid expenses"),
        new("/deferred-revenue",   "الإيرادات المؤجلة",         "Deferred revenue"),
    };

    private static readonly Tab[] TaxesTabs =
    {
        new("/tax/vat-return",         "إقرار VAT",          "VAT return"),
        new("/wht",                    "خصم من المنبع",       "WHT"),
        new("/wht/inbound",            "استيراد WHT الوارد",  "Inbound WHT"),
        new("/tax/income-tax-return",  "ضريبة الدخل",        "Income tax"),
        new("/compliance/calendar",    "تقويم الالتزامات",    "Compliance calendar"),
        new("/compliance/health",      "صحة الالتزام",        "Compliance health"),
    };

    private static readonly Tab[] ClosingTabs =
    {
        new("/journals",         "قيود التسوية",        "Adjusting entries"),
        new("/cockpit",          "كشكول الإقفال",       "Closing cockpit"),
        new("/year-end-close",   "إقفال السنة المالية", "Year-end close"),
        new("/approvals",        "قفل الفترة",          "Period lock"),
    };

    private static readonly Tab[] SalesReportsTabs =
    {
        new("/dashboards/sales",        "لوحة المبيعات",   "Sales dashboard"),
        new("/reports/sales-pipeline",  "قمع المبيعات",   "Sales pipeline"),
        new("/reports/sales-by-rep",    "مبيعات المناديب", "Sales by rep"),
        new("/reports/commissions",     "عمولات المناديب", "Commissions"),
    };

    private static readonly Tab[] InventoryReorderingTabs =
    {
        new("/reorder-rules",        "قواعد إعادة الطلب",  "Reorder rules"),
        new("/reorder-suggestions",  "اقتراحات إعادة الطلب","Reorder suggestions"),
    };

    private static readonly Tab[] InventoryReportsTabs =
    {
        new("/reports/stock-valuation", "تقييم المخزون",   "Stock valuation"),
        new("/reports/pos-sessions",    "جلسات الكاشير",   "POS sessions"),
    };

    private static readonly Tab[] CrmTabs =
    {
        new("/leads",            "الفرص",          "Leads"),
        new("/projects",         "المشاريع",        "Projects"),
        new("/routes",           "جولات المناديب", "Routes"),
        new("/dashboards/me",    "لوحتي الشخصية",  "My dashboard"),
    };

    private static readonly Tab[] TimesheetsTabs =
    {
        new("/timesheets/me",    "جدولي الزمني",  "My timesheet"),
        new("/timesheets/team",  "جداول الفريق",  "Team timesheets"),
    };

    private static readonly Tab[] WhtTabs =
    {
        new("/wht",                 "الخصم من المنبع",      "WHT overview"),
        new("/wht/form41",          "نموذج 41",           "Form 41"),
        new("/wht/inbound",         "استيراد WHT الوارد", "Inbound import"),
        new("/certificates",        "الشهادات",            "Certificates"),
    };

    private static readonly Tab[] AccountingReportsTabs =
    {
        new("/reports/trial-balance",  "ميزان المراجعة",   "Trial balance"),
        new("/reports/general-ledger", "دفتر الأستاذ",     "General ledger"),
        new("/reports/profit-loss",    "قائمة الدخل",      "P&L"),
        new("/reports/balance-sheet",  "الميزانية",        "Balance sheet"),
        new("/reports/cash-flow",      "التدفقات النقدية", "Cash flow"),
        new("/reports/cost-centers",   "مراكز التكلفة",    "Cost centers"),
    };

    private static readonly Tab[] TaxReportsTabs =
    {
        new("/reports/vat-monthly",     "VAT الشهري",          "Monthly VAT"),
        new("/reports/turnover-tax",    "ضريبة رقم الأعمال",   "Turnover tax"),
        new("/reports/taxable-income",  "الدخل الخاضع",        "Taxable income"),
        new("/penalty-shield",          "درع الغرامات",         "Penalty shield"),
    };

    private Tab[] Tabs => Group switch
    {
        "tax-setup"           => TaxSetupTabs,
        "money"               => MoneyTabs,
        "pricing"             => PricingTabs,
        "eta"                 => EtaTabs,
        "wht"                 => WhtTabs,
        "accounting-reports"  => AccountingReportsTabs,
        "tax-reports"         => TaxReportsTabs,
        "accruals"            => AccrualsTabs,
        "taxes"               => TaxesTabs,
        "closing"             => ClosingTabs,
        "sales-reports"       => SalesReportsTabs,
        "inventory-reordering"=> InventoryReorderingTabs,
        "inventory-reports"   => InventoryReportsTabs,
        "crm"                 => CrmTabs,
        "timesheets"          => TimesheetsTabs,
        _                     => Array.Empty<Tab>(),
    };

    private string GroupTitle => Group switch
    {
        "tax-setup"           => IsArabic ? "إعداد الضرائب"          : "Tax setup",
        "money"               => IsArabic ? "نقدية وبنوك"            : "Money & banks",
        "pricing"             => IsArabic ? "التسعير والمبيعات"      : "Pricing & sales",
        "eta"                 => IsArabic ? "الفاتورة الإلكترونية"   : "E-invoicing",
        "wht"                 => IsArabic ? "الخصم من المنبع"        : "Withholding tax",
        "accounting-reports"  => IsArabic ? "التقارير المحاسبية"    : "Accounting reports",
        "tax-reports"         => IsArabic ? "التقارير الضريبية"     : "Tax reports",
        "accruals"            => IsArabic ? "التراكم والاعتراف"      : "Accruals & recognition",
        "taxes"               => IsArabic ? "الضرائب"                : "Taxes",
        "closing"             => IsArabic ? "الإقفال"                : "Closing",
        "sales-reports"       => IsArabic ? "تقارير المبيعات"        : "Sales reports",
        "inventory-reordering"=> IsArabic ? "إعادة الطلب"            : "Reordering",
        "inventory-reports"   => IsArabic ? "تقارير المخزون"         : "Inventory reports",
        "crm"                 => IsArabic ? "إدارة العلاقات (CRM)"   : "CRM",
        "timesheets"          => IsArabic ? "الجداول الزمنية"        : "Timesheets",
        _                     => "",
    };

    private bool IsActive(string path)
    {
        var current = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
        return current.Equals(path.TrimEnd('/'), StringComparison.OrdinalIgnoreCase);
    }
}

@if (Tabs.Length > 0)
{
    <div class="settings-tabstrip">
        <div class="settings-tabstrip-label">@GroupTitle</div>
        <nav class="settings-tabstrip-tabs">
            @foreach (var tab in Tabs)
            {
                <a href="@tab.Path" class="settings-tab @(IsActive(tab.Path) ? "is-active" : "")">
                    @(IsArabic ? tab.Ar : tab.En)
                </a>
            }
        </nav>
    </div>
}
