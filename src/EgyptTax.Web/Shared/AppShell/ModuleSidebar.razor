@using System.Globalization
@using EgyptTax.Web.Shared.AppShell
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime Js

@*
    v5 UI Rebuild — Sprint 1 (updated 2026-05-15).
    200px-wide module sidebar (RTL: fixed right edge) with icons +
    Arabic labels ALWAYS visible (no hover-to-expand). Gold "DX"
    shield logo at top, then 6 main modules (dashboard through
    contacts), then a bottom section with search trigger (Ctrl+K),
    settings link, and logout button.
*@

<aside class="appshell-modules" aria-label="@(_isArabic ? "الوحدات" : "Modules")">
    @* Logo block *@
    <a class="appshell-modules-logo" href="/" title="DaftarX" aria-label="DaftarX">
        <span class="appshell-logo-d">D</span>
        <span class="appshell-logo-text">DaftarX</span>
    </a>

    @* Main module buttons (all except settings) *@
    <nav class="appshell-modules-nav">
        @foreach (var m in AppShellModuleRegistry.All.Where(x => x.Id != AppShellModuleRegistry.SettingsId))
        {
            var isActive = m.Id == ActiveModuleId;
            <a class="appshell-module-btn @(isActive ? "is-active" : "")"
               href="@m.DefaultRoute"
               aria-current="@(isActive ? "page" : null)"
               aria-label="@(_isArabic ? m.LabelAr : m.LabelEn)">
                <Icon Name="@m.IconName" Class="appshell-module-icon" />
                <span class="appshell-module-label">@(_isArabic ? m.LabelAr : m.LabelEn)</span>
            </a>
        }
    </nav>

    @* Bottom section: search, theme, settings, logout *@
    <div class="appshell-modules-footer">
        @* Search / Command Palette trigger *@
        <button type="button" class="appshell-module-btn appshell-module-btn--footer"
                title="@(_isArabic ? "بحث (Ctrl+K)" : "Search (Ctrl+K)")"
                aria-label="@(_isArabic ? "افتح البحث الشامل" : "Open universal search")"
                @onclick="OpenCommandPaletteAsync">
            <Icon Name="search" Class="appshell-module-icon" />
            <span class="appshell-module-label">@(_isArabic ? "بحث" : "Search")</span>
            <kbd class="appshell-kbd">⌘K</kbd>
        </button>

        @* Theme toggle (nahar/leil) *@
        <button type="button" class="appshell-module-btn appshell-module-btn--footer"
                title="@(_isArabic ? "تبديل المظهر" : "Toggle theme")"
                aria-label="@(_isArabic ? "تبديل بين الفاتح والداكن" : "Toggle light/dark theme")"
                @onclick="ToggleThemeAsync">
            <Icon Name="@(_currentTheme == "leil" ? "sun" : "moon")" Class="appshell-module-icon" />
            <span class="appshell-module-label">@(_isArabic
                ? (_currentTheme == "leil" ? "فاتح" : "داكن")
                : (_currentTheme == "leil" ? "Light" : "Dark"))</span>
        </button>

        @* Settings module link *@
        @{
            var settingsModule = AppShellModuleRegistry.Get(AppShellModuleRegistry.SettingsId);
            var settingsActive = ActiveModuleId == AppShellModuleRegistry.SettingsId;
        }
        @if (settingsModule is not null)
        {
            <a class="appshell-module-btn appshell-module-btn--footer @(settingsActive ? "is-active" : "")"
               href="@settingsModule.DefaultRoute"
               aria-current="@(settingsActive ? "page" : null)">
                <Icon Name="settings" Class="appshell-module-icon" />
                <span class="appshell-module-label">@(_isArabic ? settingsModule.LabelAr : settingsModule.LabelEn)</span>
            </a>
        }

        @* Logout *@
        <button type="button" class="appshell-module-btn appshell-module-btn--footer appshell-module-btn--danger"
                title="@(_isArabic ? "تسجيل الخروج" : "Log out")"
                @onclick="LogoutAsync">
            <Icon Name="log-out" Class="appshell-module-icon" />
            <span class="appshell-module-label">@(_isArabic ? "تسجيل الخروج" : "Log out")</span>
        </button>
    </div>
</aside>

@code {
    [Parameter, EditorRequired] public string ActiveModuleId { get; set; } = "dashboard";

    private bool _isArabic =>
        CultureInfo.CurrentCulture.Name.StartsWith("ar", StringComparison.OrdinalIgnoreCase);

    private string _currentTheme = "leil";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _currentTheme = await Js.InvokeAsync<string>("daftarxGetTheme") ?? "leil";
                StateHasChanged();
            }
            catch { /* JS not loaded yet — keep default */ }
        }
    }

    private async Task OpenCommandPaletteAsync()
    {
        try { await Js.InvokeVoidAsync("daftarxOpenCmdPalette"); }
        catch { /* JS not loaded yet — first paint, ignore */ }
    }

    private async Task ToggleThemeAsync()
    {
        _currentTheme = _currentTheme == "leil" ? "nahar" : "leil";
        try { await Js.InvokeVoidAsync("daftarxSetTheme", _currentTheme); }
        catch { /* JS not loaded yet — next click will work */ }
    }

    private async Task LogoutAsync()
    {
        try { await Js.InvokeVoidAsync("daftarxLogout"); }
        catch { Nav.NavigateTo("/logout", forceLoad: true); }
    }
}
