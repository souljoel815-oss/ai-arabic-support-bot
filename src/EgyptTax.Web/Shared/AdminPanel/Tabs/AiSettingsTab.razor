@using EgyptTax.Domain.Settings
@using EgyptTax.Infrastructure.Ai
@using EgyptTax.Infrastructure.Persistence
@using EgyptTax.Infrastructure.Settings
@using Microsoft.EntityFrameworkCore
@inject SettingsRepository Settings
@inject AnthropicApiKeyProtector Protector
@inject AppDbContext Db

@*
    M-phase (v3 roadmap) — AI Settings tab. Operator pastes their
    Anthropic API key + picks a model. Key is DataProtector-encrypted
    at rest; plaintext only in memory during the form save and during
    the actual Claude HTTP call.

    Disabled by default — flipping the master switch on without a
    key short-circuits in OcrReceiptHandler with a clear "configure
    the key first" error.
*@

@if (_loading)
{
    <p>@(IsArabic ? "جارٍ التحميل…" : "Loading…")</p>
    return;
}

<section class="ai-settings-tab">
    <h2>@(IsArabic ? "الذكاء الاصطناعي (Groq)" : "AI (Groq)")</h2>
    <p class="page-subtitle">
        @(IsArabic
            ? "بيستخدم Groq + Llama 4 Scout (multimodal) لاستخراج بيانات الإيصالات تلقائياً (M.1) والإجابة على أسئلتك المحاسبية بالعربي (M.2). محتاج مفتاح API من console.groq.com."
            : "Uses Groq + Llama 4 Scout (multimodal) for receipt OCR (M.1) and Arabic NL accounting queries (M.2). Needs an API key from console.groq.com.")
    </p>

    @if (_flash is not null)
    {
        <div class="@_flashClass" style="margin:8px 0;">@_flash</div>
    }

    <div class="form-grid">
        <label style="grid-column:span 2;">
            <span>@(IsArabic ? "تفعيل الذكاء الاصطناعي" : "Enable AI features")</span>
            <input type="checkbox" @bind="_enabled" />
        </label>

        <label style="grid-column:span 2;">
            <span>@(IsArabic ? "مفتاح Groq API" : "Groq API key")</span>
            <input type="password" @bind="_groqApiKey" placeholder="@_groqApiKeyHint" autocomplete="off" />
            <em style="font-size:12px;color:var(--muted);">
                @(IsArabic
                    ? "احصل عليه من console.groq.com → API Keys. مشفّر عند الحفظ ومش هيتعرض تاني."
                    : "Get one from console.groq.com → API Keys. Encrypted at rest; never displayed again.")
            </em>
        </label>

        <label>
            <span>@(IsArabic ? "نموذج Groq" : "Groq model")</span>
            <select @bind="_groqModelName">
                <option value="meta-llama/llama-4-scout-17b-16e-instruct">Llama 4 Scout 17B (multimodal — recommended)</option>
                <option value="meta-llama/llama-4-maverick-17b-128e-instruct">Llama 4 Maverick 17B (multimodal, larger context)</option>
                <option value="llama-3.3-70b-versatile">Llama 3.3 70B Versatile (text-only — OCR will fail)</option>
            </select>
        </label>

    </div>
    <p class="page-subtitle" style="font-size:12px;margin-top:6px;">
        ✨ @(IsArabic
            ? "Groq API مجاني للاستخدام الشخصي (rate-limited). مفيش حد ميزانية."
            : "Groq's API is free for personal use (rate-limited). No budget cap needed.")
    </p>

    @* Anthropic fields are intentionally hidden — operator picked Groq.
       Domain still has the columns so a power user can flip via SQL,
       but the UI is single-provider clean. _chatProvider is locked to
       Groq below so the save flow takes the Groq branch. *@
    @{ _chatProvider = AiChatProvider.Groq; }

    <div class="invoice-actions" style="margin-top:16px;">
        <button type="button" class="btn-primary" disabled="@_saving" @onclick="OnSaveAsync">
            @(_saving ? Tr("جارٍ الحفظ…", "Saving…") : Tr("حفظ", "Save"))
        </button>
    </div>

    @* v5 — usage meter (no cost since Groq is free). Just call count
       + token totals for visibility into volume / rate-limit safety. *@
    <h3 style="margin-top:24px;">
        @(IsArabic ? "استخدام هذا الشهر" : "This month's usage")
    </h3>
    <div class="kpi-grid kpi-grid-3" style="margin-bottom:8px;">
        <div class="kpi-card kpi-info">
            <div class="kpi-label">@(IsArabic ? "العمليات" : "Calls")</div>
            <div class="kpi-value">@_monthCallCount</div>
        </div>
        <div class="kpi-card kpi-info">
            <div class="kpi-label">@(IsArabic ? "Tokens (in/out)" : "Tokens (in/out)")</div>
            <div class="kpi-value" style="font-size:14px;">
                @_monthInputTokens / @_monthOutputTokens
            </div>
        </div>
    </div>
    <p class="page-subtitle" style="font-size:12px;margin-top:0;">
        <a href="/scan-history">@(IsArabic ? "افتح السجل الكامل ←" : "Open full activity log →")</a>
    </p>

    @if (_recentScans.Count > 0)
    {
        <h3 style="margin-top:24px;">@(IsArabic ? "آخر العمليات" : "Recent scans")</h3>
        <table class="data-table">
            <thead>
                <tr>
                    <th>@(IsArabic ? "التاريخ" : "When")</th>
                    <th>@(IsArabic ? "الملف" : "File")</th>
                    <th>@(IsArabic ? "البائع" : "Vendor")</th>
                    <th>@(IsArabic ? "الإجمالي" : "Total")</th>
                    <th>@(IsArabic ? "Tokens" : "Tokens (in/out)")</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var scan in _recentScans)
                {
                    <tr>
                        <td>@scan.ScannedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@scan.FileName</td>
                        <td>@(scan.ExtractedVendor ?? "—")</td>
                        <td>@(scan.ExtractedTotalEgp?.ToString("N2") ?? "—")</td>
                        <td>@scan.InputTokens / @scan.OutputTokens</td>
                        <td>
                            @if (!string.IsNullOrEmpty(scan.ErrorMessage))
                            {
                                <span style="color:var(--danger);">⚠ @scan.ErrorMessage</span>
                            }
                            else
                            {
                                <span style="color:var(--success);">✓</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    private bool _loading = true;
    private bool _saving;
    private string? _flash;
    private string _flashClass = "kpi-card kpi-info";

    private bool _enabled;
    private string _apiKey = "";
    private string _apiKeyHint = "";
    private string _modelName = "claude-haiku-4-5-20251001";
    private int _monthlyBudget = 500;

    // v5 — Groq chat provider state.
    private AiChatProvider _chatProvider = AiChatProvider.Anthropic;
    private string _groqApiKey = "";
    private string _groqApiKeyHint = "";
    private string _groqModelName = "meta-llama/llama-4-scout-17b-16e-instruct";

    private List<ReceiptScan> _recentScans = new();
    private int _monthCallCount;
    private int _monthInputTokens;
    private int _monthOutputTokens;
    private decimal _monthEgp;

    protected override async Task OnInitializedAsync()
    {
        var s = await Settings.GetAiSettingsAsync();
        _enabled = s.Enabled;
        _modelName = s.ModelName;
        _monthlyBudget = s.MonthlyBudgetEgp;
        _apiKey = "";
        _apiKeyHint = string.IsNullOrEmpty(s.EncryptedApiKey)
            ? Tr("sk-ant-api03-…", "sk-ant-api03-…")
            : Tr("(محفوظ — اتركه فارغاً للإبقاء عليه)", "(stored — leave blank to keep)");

        // v5 — Groq side
        _chatProvider = s.ChatProvider;
        _groqModelName = s.GroqModelName;
        _groqApiKey = "";
        _groqApiKeyHint = string.IsNullOrEmpty(s.EncryptedGroqApiKey)
            ? Tr("gsk_…", "gsk_…")
            : Tr("(محفوظ — اتركه فارغاً للإبقاء عليه)", "(stored — leave blank to keep)");

        _recentScans = await Db.Set<ReceiptScan>()
            .AsNoTracking()
            .OrderByDescending(r => r.ScannedAtUtc)
            .Take(10)
            .ToListAsync();

        // Monthly aggregate across receipt scans + chat logs.
        var now = DateTime.UtcNow;
        var monthStart = new DateTime(now.Year, now.Month, 1, 0, 0, 0, DateTimeKind.Utc);
        var scanTotals = await Db.Set<ReceiptScan>().AsNoTracking()
            .Where(r => r.ScannedAtUtc >= monthStart)
            .Select(r => new { r.InputTokens, r.OutputTokens })
            .ToListAsync();
        var chatTotals = await Db.Set<AiChatLog>().AsNoTracking()
            .Where(c => c.AskedAtUtc >= monthStart)
            .Select(c => new { c.InputTokens, c.OutputTokens })
            .ToListAsync();
        _monthCallCount = scanTotals.Count + chatTotals.Count;
        _monthInputTokens = scanTotals.Sum(x => x.InputTokens) + chatTotals.Sum(x => x.InputTokens);
        _monthOutputTokens = scanTotals.Sum(x => x.OutputTokens) + chatTotals.Sum(x => x.OutputTokens);
        // Haiku 4.5 published rates × 50 EGP/USD. Display-only.
        _monthEgp = Math.Round(
            ((decimal)_monthInputTokens / 1_000_000m * 0.25m
             + (decimal)_monthOutputTokens / 1_000_000m * 1.25m) * 50m, 2);

        _loading = false;
    }

    private async Task OnSaveAsync()
    {
        _saving = true;
        _flash = null;
        try
        {
            if (_monthlyBudget is < 50 or > 100000)
            {
                _flash = Tr("الميزانية لازم تكون بين 50 و 100,000 ج.م.", "Budget must be 50-100,000 EGP.");
                _flashClass = "kpi-card kpi-error";
                return;
            }

            var s = await Settings.GetAiSettingsAsync();

            var encryptedKey = string.IsNullOrWhiteSpace(_apiKey)
                ? (s.EncryptedApiKey ?? "")
                : Protector.Encrypt(_apiKey);

            if (_enabled && string.IsNullOrEmpty(encryptedKey))
            {
                _flash = Tr("أدخل مفتاح API قبل التفعيل.", "Enter an API key before enabling.");
                _flashClass = "kpi-card kpi-error";
                return;
            }

            if (_enabled)
            {
                s.Configure(encryptedKey, _modelName, _monthlyBudget);
            }
            else
            {
                // Allow model-only updates while disabled.
                s.UpdateModelOnly(_modelName);
                s.Disable();
            }

            // v5 — Groq side: when the operator switches chat provider
            // to Groq we encrypt the typed key (or keep the stored one
            // if the field is blank) and persist the chosen model.
            if (_chatProvider == AiChatProvider.Groq)
            {
                var encryptedGroqKey = string.IsNullOrWhiteSpace(_groqApiKey)
                    ? (s.EncryptedGroqApiKey ?? "")
                    : Protector.Encrypt(_groqApiKey);
                if (string.IsNullOrEmpty(encryptedGroqKey))
                {
                    _flash = Tr("أدخل مفتاح Groq API قبل اختيار Groq كمزوّد.",
                               "Enter a Groq API key before picking Groq as the chat provider.");
                    _flashClass = "kpi-card kpi-error";
                    return;
                }
                s.ConfigureGroq(
                    encryptedKey: string.IsNullOrWhiteSpace(_groqApiKey) ? null : encryptedGroqKey,
                    modelName: _groqModelName);
            }
            else
            {
                s.SwitchChatProvider(AiChatProvider.Anthropic);
            }

            await Db.SaveChangesAsync();

            _apiKey = "";
            _apiKeyHint = Tr("(محفوظ — اتركه فارغاً للإبقاء عليه)", "(stored — leave blank to keep)");
            _groqApiKey = "";
            _groqApiKeyHint = Tr("(محفوظ — اتركه فارغاً للإبقاء عليه)", "(stored — leave blank to keep)");
            _flash = Tr("✓ تم الحفظ.", "✓ Saved.");
            _flashClass = "kpi-card kpi-info";
        }
        catch (Exception ex)
        {
            _flash = ex.Message;
            _flashClass = "kpi-card kpi-error";
        }
        finally { _saving = false; }
    }
}
