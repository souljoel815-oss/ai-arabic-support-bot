@*
    DaftarX — Modern SaaS layout (navy palette, SVG icons).
    Sidebar: grouped nav with active-state accent bar + section headers.
    Topbar: company name + current period (with lock state) + language switcher + user menu.
*@
@inherits LayoutComponentBase
@using System.Globalization
@using EgyptTax.Domain.MasterData
@using EgyptTax.Domain.Periods
@using EgyptTax.Domain.Workflow
@using EgyptTax.Infrastructure.Persistence
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject NavigationManager Nav
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthState

@code {
    private bool IsArabic => CultureInfo.CurrentCulture.Name.StartsWith("ar", StringComparison.OrdinalIgnoreCase);
    private string Tr(string ar, string en) => IsArabic ? ar : en;
    private string CurrentReturnUrl => new Uri(Nav.Uri).PathAndQuery;

    private string? _companyName;
    private string _periodLabel = "";
    private bool _periodLocked;
    private string? _userInitial;
    private string? _userDisplayName;

    /// <summary>Sales-rep mode — true when the signed-in user has the
    /// SALES_REP role and NOT the ADMIN role. The nav uses this to
    /// hide groups and items reps shouldn't see (Reports, Compliance,
    /// Settings, Firm portal, Purchase/Expense quick actions, etc.).
    /// Defaults to false so a slow auth lookup doesn't briefly hide
    /// admin's nav while loading.</summary>
    private bool _isRepOnly;

    /// <summary>Mobile-only sidebar drawer state. Toggled by the
    /// hamburger button in the topbar (CSS-hidden on desktop) and
    /// by the backdrop click. Closes automatically when the user
    /// taps any nav link (via the @onclick on app-nav anchors).</summary>
    private bool _sidebarOpen;
    private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;
    private void CloseSidebar() => _sidebarOpen = false;

    /// <summary>Gux.1 — auto-expand the sidebar group containing the
    /// current page. Each group below calls <see cref="GroupOpen"/>
    /// with a prefix list; if any prefix matches the current URL
    /// path, the &lt;details&gt; element gets the open attribute.</summary>
    private string CurrentPath
    {
        get
        {
            var uri = new Uri(Nav.Uri);
            return uri.AbsolutePath.TrimStart('/');
        }
    }

    private string GroupOpen(params string[] prefixes)
    {
        var path = CurrentPath;
        return prefixes.Any(p =>
            string.Equals(path, p, StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith(p + "/", StringComparison.OrdinalIgnoreCase))
            ? "open" : "";
    }

    private string ActiveLink(string path) =>
        string.Equals(CurrentPath, path, StringComparison.OrdinalIgnoreCase) ? "active" : "";

    /// <summary>Gux.3 — variant for sidebar entries that point at a
    /// page which shares a tab strip with siblings. Stays active for
    /// any path in the group so the operator's place in the strip
    /// matches the sidebar's highlight.</summary>
    private string ActiveLink(params string[] paths) =>
        paths.Any(p => string.Equals(CurrentPath, p, StringComparison.OrdinalIgnoreCase)) ? "active" : "";

    /// <summary>Splat helper for &lt;details&gt; elements — returns
    /// the boolean <c>open</c> HTML attribute when the current page
    /// matches one of the prefixes; an empty dictionary otherwise.
    /// Blazor's @attributes directive omits null/missing entries
    /// so the closed state simply renders <c>&lt;details&gt;</c>.</summary>
    private Dictionary<string, object> OpenAttr(params string[] prefixes) =>
        GroupOpen(prefixes) == "open"
            ? new Dictionary<string, object> { ["open"] = "open" }
            : new Dictionary<string, object>();

    /// <summary>Gux.10 — pending-approvals count for the topbar
    /// notification badge. Populated alongside the other layout
    /// state in <see cref="OnInitializedAsync"/>.</summary>
    private int _pendingApprovalCount;
    private bool _quickActionsOpen;
    private void ToggleQuickActions() => _quickActionsOpen = !_quickActionsOpen;

    // Once-per-process flag for the lazy default-data seed (VAT
    // categories etc.). Done in MainLayout because it's the first DB
    // hit on every authenticated request, and the request context has
    // SqlClient fully warmed (unlike background startup tasks).
    private static int _defaultsSeeded;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var Db = await DbFactory.CreateDbContextAsync();

            if (System.Threading.Interlocked.CompareExchange(ref _defaultsSeeded, 1, 0) == 0)
            {
                try
                {
                    await EgyptTax.Web.Tools.StartupSeed.EnsureDefaultsAsync(Db);
                }
                catch
                {
                    // Reset so a future request can retry.
                    System.Threading.Interlocked.Exchange(ref _defaultsSeeded, 0);
                }
            }

            var company = await Db.Set<Company>().AsNoTracking().FirstOrDefaultAsync();
            _companyName = company is null
                ? Tr("لم تُكوَّن بعد", "Not configured")
                : (IsArabic ? company.LegalName.Arabic : company.LegalName.English);

            var now = DateTime.UtcNow;
            var period = await Db.Set<TaxPeriod>().AsNoTracking()
                .FirstOrDefaultAsync(p => p.PeriodKind == TaxPeriodKind.VatMonth
                    && p.Year == now.Year && p.MonthOrQuarter == now.Month);
            _periodLocked = period?.Status == TaxPeriodStatus.Locked;
            _periodLabel = $"{MonthName(now.Month)} {now.Year}";

            var auth = await AuthState.GetAuthenticationStateAsync();
            var name = auth.User.Identity?.Name;
            if (!string.IsNullOrWhiteSpace(name))
            {
                _userDisplayName = name;
                _userInitial = name.Trim()[..1].ToUpperInvariant();
            }
            _isRepOnly = auth.User.IsInRole("SALES_REP") && !auth.User.IsInRole("ADMIN");

            // Gux.10 — pending approvals → topbar bell badge.
            _pendingApprovalCount = await Db.Set<ApprovalRequest>()
                .AsNoTracking()
                .CountAsync(a => a.ApprovedByUserId == null && a.RejectedByUserId == null);
        }
        catch
        {
            // Topbar context is decorative — never block layout if a query fails.
        }
    }

    private string MonthName(int m) => IsArabic
        ? m switch
        {
            1 => "يناير", 2 => "فبراير", 3 => "مارس", 4 => "أبريل",
            5 => "مايو", 6 => "يونيو", 7 => "يوليو", 8 => "أغسطس",
            9 => "سبتمبر", 10 => "أكتوبر", 11 => "نوفمبر", 12 => "ديسمبر",
            _ => $"الشهر {m}",
        }
        : CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(m);
}

<div class="app-shell @(_sidebarOpen ? "sidebar-open" : "")">

    <div class="sidebar-backdrop" @onclick="CloseSidebar"></div>

    <aside class="app-sidebar">
        <a href="/" class="sidebar-brand" style="text-decoration:none;">
            <div class="sidebar-brand-mark">DX</div>
            <div class="sidebar-brand-name">Daftar<span class="brand-x">X</span></div>
        </a>

        @* Gux.1 — quick-action launcher pinned at top, always visible *@
        <div class="sidebar-quick-actions @(_quickActionsOpen ? "is-open" : "")">
            <button type="button" class="quick-action-btn" @onclick="ToggleQuickActions">
                <Icon Name="plus" Class="ic" />
                <span>@Tr("إنشاء جديد", "Create new")</span>
            </button>
            @if (_quickActionsOpen)
            {
                <div class="quick-action-menu">
                    <a href="sales-orders/new" @onclick="CloseSidebar"><Icon Name="clipboard" Class="ic" />@Tr("أمر بيع", "Sales order")</a>
                    <a href="invoices/new" @onclick="CloseSidebar"><Icon Name="file-text" Class="ic" />@Tr("فاتورة مبيعات", "Sales invoice")</a>
                    @if (!_isRepOnly)
                    {
                        <a href="purchase-invoices/new" @onclick="CloseSidebar"><Icon Name="package" Class="ic" />@Tr("فاتورة مشتريات", "Purchase invoice")</a>
                        <a href="expenses/new" @onclick="CloseSidebar"><Icon Name="credit-card" Class="ic" />@Tr("مصروف", "Expense")</a>
                        <a href="invoices/bulk" @onclick="CloseSidebar"><Icon Name="archive" Class="ic" />@Tr("رفع جماعي", "Bulk upload")</a>
                    }
                </div>
            }
        </div>

        @* Gux.1 — Home (no sub-items, just a link). Explicit "/" so
           the link works from any nested route; an empty href reloads
           the current URL on some browsers + dev hosts (BUG-D-002). *@
        <nav class="app-nav app-nav-toplevel">
            <a href="/" class="@ActiveLink("")" @onclick="CloseSidebar">
                <Icon Name="home" Class="nav-icon" />@Tr("الرئيسية", "Home")
            </a>
            <a href="dashboards/me" class="@ActiveLink("dashboards/me")" @onclick="CloseSidebar">
                <Icon Name="user" Class="nav-icon" />@Tr("لوحتي", "My dashboard")
            </a>
            @if (!_isRepOnly)
            {
                <a href="pos" class="@ActiveLink("pos")" @onclick="CloseSidebar">
                    <Icon Name="shopping-cart" Class="nav-icon" />@Tr("نقطة البيع", "POS")
                </a>
            }
        </nav>

        @* Gux.1 — Invoices & Operations *@
        <details class="sidebar-group" @attributes="@OpenAttr("invoices", "purchase-invoices", "expenses", "payments")">
            <summary>
                <Icon Name="file-text" Class="nav-icon" />
                <span>@Tr("الفواتير والعمليات", "Invoices & operations")</span>
            </summary>
            <nav class="app-nav">
                <a href="routes" class="@ActiveLink("routes")" @onclick="CloseSidebar">@Tr("خط السير", "Route plan")</a>
                <a href="sales-orders" class="@ActiveLink("sales-orders")" @onclick="CloseSidebar">@Tr("أوامر البيع", "Sales orders")</a>
                <a href="invoices" class="@ActiveLink("invoices")" @onclick="CloseSidebar">@Tr("فواتير المبيعات", "Sales invoices")</a>
                <a href="payments/customer-receipts/new" class="@ActiveLink("payments/customer-receipts/new")" @onclick="CloseSidebar">@Tr("إيصال قبض", "Receive payment")</a>
                @if (!_isRepOnly)
                {
                    <a href="recurring-invoices" class="@ActiveLink("recurring-invoices")" @onclick="CloseSidebar">@Tr("فواتير متكررة", "Recurring invoices")</a>
                    <a href="invoices/bulk" class="@ActiveLink("invoices/bulk")" @onclick="CloseSidebar">@Tr("رفع جماعي", "Bulk upload")</a>
                    <a href="purchase-invoices" class="@ActiveLink("purchase-invoices")" @onclick="CloseSidebar">@Tr("فواتير المشتريات", "Purchases")</a>
                    <a href="expenses" class="@ActiveLink("expenses")" @onclick="CloseSidebar">@Tr("المصروفات", "Expenses")</a>
                    <a href="payments/bank-statements" class="@ActiveLink("payments/bank-statements")" @onclick="CloseSidebar">@Tr("كشوف البنك", "Bank statements")</a>
                    <a href="payments/unmatched" class="@ActiveLink("payments/unmatched")" @onclick="CloseSidebar">@Tr("بنود غير مطابقة", "Unmatched lines")</a>
                }
            </nav>
        </details>

        @* Gux.1 — Customers & Suppliers (was "Master data") *@
        <details class="sidebar-group" @attributes="@OpenAttr("customers", "suppliers", "items", "data-import", "quotations", "leads", "stock-locations", "stock-transfer", "cost-centers", "expiring-lots", "reorder-rules", "reorder-suggestions", "scan-receipt", "scan-history")">
            <summary>
                <Icon Name="users" Class="nav-icon" />
                <span>@Tr("العملاء والموردون", "Customers & suppliers")</span>
            </summary>
            <nav class="app-nav">
                <a href="customers" class="@ActiveLink("customers")" @onclick="CloseSidebar">@Tr("العملاء", "Customers")</a>
                @if (!_isRepOnly)
                {
                    <a href="suppliers" class="@ActiveLink("suppliers")" @onclick="CloseSidebar">@Tr("الموردون", "Suppliers")</a>
                }
                <a href="items" class="@ActiveLink("items")" @onclick="CloseSidebar">@Tr("الأصناف", "Items")</a>
                @if (!_isRepOnly)
                {
                    <a href="stock-locations" class="@ActiveLink("stock-locations")" @onclick="CloseSidebar">@Tr("🏬 المخازن والفروع", "🏬 Stock locations")</a>
                    <a href="stock-transfer" class="@ActiveLink("stock-transfer")" @onclick="CloseSidebar">@Tr("🔄 نقل مخزون", "🔄 Stock transfer")</a>
                    <a href="cost-centers" class="@ActiveLink("cost-centers")" @onclick="CloseSidebar">@Tr("🏷️ مراكز التكلفة", "🏷️ Cost centers")</a>
                    <a href="expiring-lots" class="@ActiveLink("expiring-lots")" @onclick="CloseSidebar">@Tr("🧪 دفعات قاربت تنتهي", "🧪 Expiring lots")</a>
                    <a href="reorder-rules" class="@ActiveLink("reorder-rules")" @onclick="CloseSidebar">@Tr("🔁 قواعد إعادة الطلب", "🔁 Reorder rules")</a>
                    <a href="reorder-suggestions" class="@ActiveLink("reorder-suggestions")" @onclick="CloseSidebar">@Tr("📋 اقتراحات الطلب", "📋 Reorder suggestions")</a>
                }
                @if (!_isRepOnly)
                {
                    <a href="data-import" class="@ActiveLink("data-import")" @onclick="CloseSidebar">@Tr("📥 استيراد بيانات", "📥 Import data")</a>
                <a href="leads" class="@ActiveLink("leads")" @onclick="CloseSidebar">@Tr("🎯 الفرص البيعية", "🎯 Sales pipeline")</a>
                <a href="quotations" class="@ActiveLink("quotations")" @onclick="CloseSidebar">@Tr("📝 عروض الأسعار", "📝 Quotations")</a>
                @if (!_isRepOnly)
                {
                    <a href="scan-receipt" class="@ActiveLink("scan-receipt")" @onclick="CloseSidebar">@Tr("🤖 مسح إيصال (AI)", "🤖 Scan receipt (AI)")</a>
                    <a href="scan-history" class="@ActiveLink("scan-history")" @onclick="CloseSidebar">@Tr("📜 سجل عمليات الـ AI", "📜 AI activity log")</a>
                }
                }
            </nav>
        </details>

        @* Gux.1 — Reports (admin/accountant only — reps don't see this) *@
        @if (!_isRepOnly)
        {
        <details class="sidebar-group" @attributes="@OpenAttr("reports", "wht", "projects")">
            <summary>
                <Icon Name="bar-chart" Class="nav-icon" />
                <span>@Tr("التقارير", "Reports")</span>
            </summary>
            <nav class="app-nav">
                <a href="reports/vat-monthly" class="@ActiveLink("reports/vat-monthly")" @onclick="CloseSidebar">@Tr("الضريبة الشهرية", "Monthly VAT")</a>
                <a href="reports/taxable-income" class="@ActiveLink("reports/taxable-income")" @onclick="CloseSidebar">@Tr("الدخل الخاضع للضريبة", "Taxable income")</a>
                <a href="reports/trial-balance" class="@ActiveLink("reports/trial-balance")" @onclick="CloseSidebar">@Tr("ميزان المراجعة", "Trial balance")</a>
                <a href="reports/general-ledger" class="@ActiveLink("reports/general-ledger")" @onclick="CloseSidebar">@Tr("📚 دفتر الأستاذ", "📚 General Ledger")</a>
                <a href="reports/turnover-tax" class="@ActiveLink("reports/turnover-tax")" @onclick="CloseSidebar">@Tr("ضريبة معدل الدوران", "Turnover tax")</a>
                <a href="reports/cost-centers" class="@ActiveLink("reports/cost-centers")" @onclick="CloseSidebar">@Tr("📊 مراكز التكلفة", "📊 Cost centers")</a>
                <a href="projects" class="@ActiveLink("projects")" @onclick="CloseSidebar">@Tr("📁 المشروعات", "📁 Projects")</a>
                <a href="reports/sales-by-rep" class="@ActiveLink("reports/sales-by-rep")" @onclick="CloseSidebar">@Tr("مبيعات المناديب", "Sales by rep")</a>
                <a href="reports/commissions" class="@ActiveLink("reports/commissions")" @onclick="CloseSidebar">@Tr("عمولات المناديب", "Commissions")</a>
                <a href="dashboards/sales" class="@ActiveLink("dashboards/sales")" @onclick="CloseSidebar">@Tr("📊 لوحة المبيعات", "📊 Sales dashboard")</a>
                <a href="wht" class="@ActiveLink("wht")" @onclick="CloseSidebar">@Tr("دورة الخصم", "WHT lifecycle")</a>
                <a href="wht/inbound" class="@ActiveLink("wht/inbound")" @onclick="CloseSidebar">@Tr("شهادات خصم واردة", "Inbound WHT")</a>
                <a href="tax/vat-return" class="@ActiveLink("tax/vat-return")" @onclick="CloseSidebar">@Tr("إقرارات الضريبة", "VAT returns")</a>
                <a href="tax/income-tax-return" class="@ActiveLink("tax/income-tax-return")" @onclick="CloseSidebar">@Tr("إقرارات ضريبة الدخل", "Income-tax returns")</a>
            </nav>
        </details>
        }

        @* Gux.1 + Gux.2 — Compliance (setup-only items moved to Settings) *@
        @if (!_isRepOnly)
        {
        <details class="sidebar-group" @attributes="@OpenAttr("penalty-shield", "compliance", "eta-dashboard", "eta-inbox", "eta-export")">
            <summary>
                <Icon Name="shield" Class="nav-icon" />
                <span>@Tr("الامتثال", "Compliance")</span>
            </summary>
            <nav class="app-nav">
                <a href="compliance/health" class="@ActiveLink("compliance/health")" @onclick="CloseSidebar">@Tr("🩺 صحة الامتثال", "🩺 Compliance health")</a>
                <a href="penalty-shield" class="@ActiveLink("penalty-shield")" @onclick="CloseSidebar">@Tr("درع الغرامات", "Penalty Shield")</a>
                <a href="compliance/calendar" class="@ActiveLink("compliance/calendar")" @onclick="CloseSidebar">@Tr("تقويم الالتزامات", "Compliance calendar")</a>
                <a href="eta-dashboard" class="@ActiveLink("eta-dashboard")" @onclick="CloseSidebar">@Tr("لوحة ETA", "ETA dashboard")</a>
                <a href="eta-inbox" class="@ActiveLink("eta-inbox")" @onclick="CloseSidebar">@Tr("صندوق ETA الوارد", "ETA inbox")</a>
                <a href="eta-export" class="@ActiveLink("eta-export")" @onclick="CloseSidebar">@Tr("تصدير ETA", "ETA export")</a>
            </nav>
        </details>
        }

        @* Gux.1 + Gux.2 — Settings (absorbs setup-only items from Compliance + Master Data) *@
        @if (!_isRepOnly)
        {
        <details class="sidebar-group" @attributes="@OpenAttr("settings", "eta-wizard", "certificates", "expense-categories", "audit-log", "inspection-bundle", "cockpit", "currencies")">
            <summary>
                <Icon Name="building" Class="nav-icon" />
                <span>@Tr("الإعدادات", "Settings")</span>
            </summary>
            <nav class="app-nav">
                @* Gux.13 — single admin panel hosting all settings tabs. Old links below stay for now. *@
                <a href="settings" class="@ActiveLink("settings")" @onclick="CloseSidebar"><strong>@Tr("⚙️ لوحة الإعدادات", "⚙️ Admin panel")</strong></a>
                <a href="settings/company" class="@ActiveLink("settings/company")" @onclick="CloseSidebar">@Tr("بيانات الشركة", "Company profile")</a>
                @* Gux.3 — Tax periods + VAT categories share a tab strip on the page itself, so one sidebar entry is enough. *@
                <a href="settings/tax-periods" class="@(ActiveLink("settings/tax-periods", "settings/vat-categories"))" @onclick="CloseSidebar">@Tr("إعداد الضرائب", "Tax setup")</a>
                <a href="settings/fiscal-year" class="@ActiveLink("settings/fiscal-year")" @onclick="CloseSidebar">@Tr("السنة المالية", "Fiscal year")</a>
                @* Gux.3 — Payment methods + Cash accounts + Opening balances share a tab strip. *@
                <a href="settings/cash-accounts" class="@(ActiveLink("settings/cash-accounts", "settings/payment-methods", "settings/opening-balances"))" @onclick="CloseSidebar">@Tr("نقدية وبنوك", "Money & banks")</a>
                <a href="expense-categories" class="@ActiveLink("expense-categories")" @onclick="CloseSidebar">@Tr("فئات المصروفات", "Expense categories")</a>
                <a href="currencies" class="@ActiveLink("currencies")" @onclick="CloseSidebar">@Tr("💱 العملات", "💱 Currencies")</a>
                <a href="settings/referrals" class="@ActiveLink("settings/referrals")" @onclick="CloseSidebar">@Tr("ادعُ صديق", "Refer a friend")</a>
                @* Setup-only ETA items moved here per Gux.2 *@
                <a href="eta-wizard" class="@ActiveLink("eta-wizard")" @onclick="CloseSidebar">@Tr("معالج إعداد ETA", "ETA setup wizard")</a>
                <a href="certificates" class="@ActiveLink("certificates")" @onclick="CloseSidebar">@Tr("الشهادات الرقمية", "Digital certificates")</a>
                @* Advanced — accountant / auditor tools (rarely-used mid-month) *@
                <a href="cockpit" class="@ActiveLink("cockpit")" @onclick="CloseSidebar">@Tr("قمرة الإقفال", "Closing cockpit")</a>
                <a href="settings/chart-of-accounts" class="@ActiveLink("settings/chart-of-accounts")" @onclick="CloseSidebar">@Tr("دليل الحسابات", "Chart of accounts")</a>
                <a href="audit-log" class="@ActiveLink("audit-log")" @onclick="CloseSidebar">@Tr("سجل التدقيق", "Audit log")</a>
                <a href="inspection-bundle" class="@ActiveLink("inspection-bundle")" @onclick="CloseSidebar">@Tr("حزمة الفحص الضريبي", "Inspection bundle")</a>
            </nav>
        </details>
        }

        @* Gux.1 — Firm Portal (only relevant for accounting firms; no role-gating yet, ships visible) *@
        @if (!_isRepOnly)
        {
        <details class="sidebar-group" @attributes="@OpenAttr("firm-portal")">
            <summary>
                <Icon Name="landmark" Class="nav-icon" />
                <span>@Tr("بوابة المكتب", "Firm portal")</span>
            </summary>
            <nav class="app-nav">
                <a href="firm-portal" class="@ActiveLink("firm-portal")" @onclick="CloseSidebar">@Tr("لوحة مراجعة المكتب", "Accountant review")</a>
                <a href="firm-portal/switch" class="@ActiveLink("firm-portal/switch")" @onclick="CloseSidebar">@Tr("تبديل الشركة", "Switch company")</a>
                <a href="firm-portal/commissions" class="@ActiveLink("firm-portal/commissions")" @onclick="CloseSidebar">@Tr("عمولات المحاسبين", "Commissions")</a>
            </nav>
        </details>
        }
    </aside>

    <header class="app-header">
        <button type="button" class="sidebar-toggle-btn" @onclick="ToggleSidebar"
                aria-label="@Tr("القائمة", "Menu")">
            <span></span><span></span><span></span>
        </button>
        <div class="topbar-context">
            <div class="topbar-company">@(_companyName ?? Tr("جارٍ التحميل…", "Loading…"))</div>
            <div class="topbar-period @(_periodLocked ? "is-locked" : "")">
                <span class="period-dot"></span>
                @Tr("الفترة الحالية:", "Current period:") @_periodLabel
                @if (_periodLocked)
                {
                    <span>· @Tr("مقفولة", "Locked")</span>
                }
            </div>
        </div>

        <div class="topbar-actions">
            <span class="lang-toggle">
                @if (IsArabic)
                {
                    <a href="set-culture?culture=en-US&returnUrl=@(Uri.EscapeDataString(CurrentReturnUrl))" class="topbar-btn">
                        <Icon Name="globe" Class="ic" />English
                    </a>
                }
                else
                {
                    <a href="set-culture?culture=ar-EG&returnUrl=@(Uri.EscapeDataString(CurrentReturnUrl))" class="topbar-btn">
                        <Icon Name="globe" Class="ic" />العربية
                    </a>
                }
            </span>

            @* Gux.10 — approvals as a notification bell, not a sidebar destination *@
            <a href="approvals" class="topbar-bell @(_pendingApprovalCount > 0 ? "has-unread" : "")"
               title="@Tr($"{_pendingApprovalCount} اعتماد بانتظارك", $"{_pendingApprovalCount} approvals waiting")">
                <Icon Name="check-square" Class="ic" />
                @if (_pendingApprovalCount > 0)
                {
                    <span class="topbar-bell-badge">@_pendingApprovalCount</span>
                }
            </a>

            <AuthorizeView>
                <Authorized>
                    <a href="logout" class="topbar-user" title="@_userDisplayName">
                        <span>@(_userDisplayName ?? Tr("المستخدم", "User"))</span>
                        <span class="topbar-avatar">@(_userInitial ?? "U")</span>
                    </a>
                </Authorized>
            </AuthorizeView>
        </div>
    </header>

    <main class="app-main">
        <UpdateAvailableBanner />
        <TrialCountdownBanner />
        <LicenseExpiryBanner />
        <TaxDeadlineBanner />
        <BackupReminderBanner />
        @Body
    </main>

    @* M.2 (v3 roadmap) — Arabic NL chat sidebar. Rendered once at
       the layout level so the FAB + drawer are available from every
       authenticated page. The component itself short-circuits with
       a friendly message when AiSettings is disabled. *@
    <AuthorizeView>
        <Authorized>
            <AiChatSidebar />
        </Authorized>
    </AuthorizeView>

    @* Gux.12 — Mobile bottom-nav bar. Hidden on >768px via CSS.
       Four most-common destinations one tap away (vs. two taps
       through the hamburger drawer). *@
    <nav class="mobile-bottom-nav">
        <a href="/" class="@ActiveLink("")">
            <Icon Name="home" Class="ic" />
            <span>@Tr("الرئيسية", "Home")</span>
        </a>
        <a href="invoices/new">
            <Icon Name="plus" Class="ic" />
            <span>@Tr("فاتورة", "Invoice")</span>
        </a>
        <a href="reports/vat-monthly" class="@ActiveLink("reports/vat-monthly")">
            <Icon Name="bar-chart" Class="ic" />
            <span>@Tr("تقارير", "Reports")</span>
        </a>
        <a href="settings/company" class="@ActiveLink("settings/company")">
            <Icon Name="building" Class="ic" />
            <span>@Tr("الإعدادات", "Settings")</span>
        </a>
    </nav>

</div>
