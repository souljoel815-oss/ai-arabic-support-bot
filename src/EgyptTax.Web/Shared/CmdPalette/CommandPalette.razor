@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime Js
@inject NavigationManager Nav

@*
    v5 DP.3 — global Cmd+K / Ctrl+K command palette. Operator
    presses ⌘K from any page; modal opens centered with a search
    input + filtered list of every page route + common quick-create
    actions in both languages. Type to filter (simple
    case-insensitive contains; no fuzzy lib). Up/Down navigates
    the list, Enter follows, Esc closes.
*@

<div class="cmd-palette-modal @(_open ? "is-open" : "")" @onclick="OnBackdropClick">
    @if (_open)
    {
        <div class="cmd-palette-card" @onclick:stopPropagation>
            <div class="cmd-palette-search">
                <span class="cmd-palette-icon">⌘K</span>
                <input @ref="_inputRef"
                       type="search"
                       placeholder="@Tr("ابحث عن صفحة أو إجراء…", "Search pages or actions…")"
                       value="@_query"
                       @oninput="OnQueryChanged"
                       @onkeydown="OnKeyDown" />
                <button type="button" class="cmd-palette-dismiss"
                        @onclick="Close" aria-label="Close">×</button>
            </div>

            <div class="cmd-palette-results">
                @if (Filtered.Count == 0)
                {
                    <div class="cmd-palette-empty">
                        @Tr("ما فيش نتائج للبحث ده.", "Nothing matches that search.")
                    </div>
                }
                else
                {
                    @for (var i = 0; i < Filtered.Count; i++)
                    {
                        var idx = i;
                        var cmd = Filtered[idx];
                        <button type="button"
                                class="cmd-palette-item @(idx == _selectedIndex ? "is-active" : "")"
                                @onmouseenter="() => _selectedIndex = idx"
                                @onclick="() => Run(cmd)">
                            <span class="cmd-palette-item-icon">@cmd.Icon</span>
                            <span class="cmd-palette-item-label">
                                <span>@(IsArabic ? cmd.LabelAr : cmd.LabelEn)</span>
                                <small>@cmd.Hint</small>
                            </span>
                            <span class="cmd-palette-item-section">@cmd.Section</span>
                        </button>
                    }
                }
            </div>

            <div class="cmd-palette-foot">
                <span><kbd>↑</kbd><kbd>↓</kbd> @Tr("للتنقل", "navigate")</span>
                <span><kbd>↵</kbd> @Tr("افتح", "open")</span>
                <span><kbd>Esc</kbd> @Tr("إغلاق", "close")</span>
            </div>
        </div>
    }
</div>

@code {
    private bool _open;
    private string _query = "";
    private int _selectedIndex;
    private ElementReference _inputRef;
    private DotNetObjectReference<CommandPalette>? _selfRef;
    private bool _jsRegistered;

    private bool IsArabic =>
        System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith(
            "ar", StringComparison.OrdinalIgnoreCase);
    private string Tr(string ar, string en) => IsArabic ? ar : en;

