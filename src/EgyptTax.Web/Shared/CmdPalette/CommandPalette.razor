    private List<PaletteCommand> Filtered
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_query))
            {
                // No query → show top 20 (Quick + first sections).
                return AllCommands.Take(20).ToList();
            }
            var q = _query.Trim();
            return AllCommands
                .Where(c => c.LabelAr.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || c.LabelEn.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || (c.Section?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (c.Url?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false))
                .Take(40)
                .ToList();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            await Js.InvokeVoidAsync("daftarxRegisterCmdPalette", _selfRef);
            _jsRegistered = true;
        }

        if (_open && _inputRef.Context is not null)
        {
            try { await _inputRef.FocusAsync(); } catch { /* element may not be in DOM yet */ }
        }
    }

    [JSInvokable]
    public Task Toggle()
    {
        _open = !_open;
        if (_open)
        {
            _query = "";
            _selectedIndex = 0;
        }
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task Close()
    {
        _open = false;
        return InvokeAsync(StateHasChanged);
    }

    private void OnQueryChanged(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? "";
        _selectedIndex = 0;
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        var max = Filtered.Count;
        if (max == 0) return;
        switch (e.Key)
        {
            case "ArrowDown":
                _selectedIndex = (_selectedIndex + 1) % max;
                break;
            case "ArrowUp":
                _selectedIndex = (_selectedIndex - 1 + max) % max;
                break;
            case "Enter":
                Run(Filtered[_selectedIndex]);
                break;
        }
    }

    private void Run(PaletteCommand cmd)
    {
        _open = false;
        if (cmd.Url is { } url)
        {
            Nav.NavigateTo(url);
        }
        cmd.Action?.Invoke();
    }

    private void OnBackdropClick() => Close();

    public async ValueTask DisposeAsync()
    {
        if (_jsRegistered)
        {
            // Listener stays bound for the page lifetime; Blazor
            // server-side circuits aren't long-lived enough to
            // benefit from removeEventListener bookkeeping.
        }
        _selfRef?.Dispose();
        await Task.CompletedTask;
    }
}
