@using System.Globalization
@using EgyptTax.Web.Shared.AppShell
@inject NavigationManager Nav
@inject IJSRuntime Js
@implements IAsyncDisposable

@*
    v5 UI Rebuild — Sprint 1 (new 2026-05-15).
    Command Palette overlay triggered by Ctrl+K.
    Two sections:
      1. "إجراءات سريعة" — 5 quick actions (new invoice, quotation, etc.)
      2. "الشاشات" — all searchable screens across all modules
    Supports real-time filtering, keyboard navigation, and
    closes on Escape or backdrop click.
*@

@if (_isOpen)
{
    <div class="dx-cmd-backdrop" @onclick="Close" @onclick:stopPropagation="true"></div>
    <div class="dx-cmd-palette" role="dialog" aria-modal="true" aria-label="@(_isArabic ? "البحث الشامل" : "Universal search")">
        <div class="dx-cmd-input-wrap">
            <Icon Name="search" Class="dx-cmd-input-icon" />
            <input type="text"
                   class="dx-cmd-input"
                   placeholder="@(_isArabic ? "ابحث عن أي شيء..." : "Search anything...")"
                   @bind="_searchText"
                   @bind:event="oninput"
                   @ref="_inputRef"
                   @onkeydown="HandleKeyDown"
                   dir="rtl" />
            <kbd class="dx-cmd-esc">Esc</kbd>
        </div>

        <div class="dx-cmd-results" dir="rtl">
            @if (FilteredQuickActions.Any())
            {
                <div class="dx-cmd-group-header">@(_isArabic ? "إجراءات سريعة" : "Quick actions")</div>
                @foreach (var action in FilteredQuickActions)
                {
                    var idx = _flatItems.IndexOf(("action", action.Url));
                    <button type="button"
                            class="dx-cmd-item @(idx == _selectedIndex ? "is-selected" : "")"
                            @onclick="() => Navigate(action.Url)">
                        <span class="dx-cmd-item-icon dx-cmd-item-icon--gold">
                            <Icon Name="plus" Class="dx-cmd-ic" />
                        </span>
                        <span class="dx-cmd-item-label">@(_isArabic ? action.LabelAr : action.LabelEn)</span>
                    </button>
                }
            }

            @if (FilteredScreens.Any())
            {
                <hr class="dx-cmd-sep" />
                <div class="dx-cmd-group-header">@(_isArabic ? "الشاشات" : "Screens")</div>
                @foreach (var screen in FilteredScreens)
                {
                    var idx = _flatItems.IndexOf(("screen", screen.Url));
                    <button type="button"
                            class="dx-cmd-item @(idx == _selectedIndex ? "is-selected" : "")"
                            @onclick="() => Navigate(screen.Url)">
                        <span class="dx-cmd-item-icon">
                            <Icon Name="@screen.IconName" Class="dx-cmd-ic" />
                        </span>
                        <span class="dx-cmd-item-label">@screen.Label</span>
                        <span class="dx-cmd-item-module">@screen.ModuleLabel</span>
                    </button>
                }
            }

            @if (!FilteredQuickActions.Any() && !FilteredScreens.Any())
            {
                <p class="dx-cmd-empty">@(_isArabic ? "لا توجد نتائج" : "No results")</p>
            }
        </div>
    </div>
}

@code {
    private bool _isOpen;
    private string _searchText = "";
    private int _selectedIndex;
    private ElementReference _inputRef;
    private DotNetObjectReference<CommandPalette>? _objRef;

    private bool _isArabic =>
        CultureInfo.CurrentCulture.Name.StartsWith("ar", StringComparison.OrdinalIgnoreCase);

    // Flat list for keyboard navigation
    private List<(string type, string url)> _flatItems = new();

    private IEnumerable<QuickAction> FilteredQuickActions =>
        AppShellModuleRegistry.QuickActions.Where(a =>
            string.IsNullOrEmpty(_searchText) ||
            a.LabelAr.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
            a.LabelEn.Contains(_searchText, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<(string Label, string Url, string ModuleLabel, string IconName)> FilteredScreens =>
        AppShellModuleRegistry.GetAllSearchableItems(_isArabic).Where(s =>
            string.IsNullOrEmpty(_searchText) ||
            s.Label.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
            s.ModuleLabel.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
            s.Url.Contains(_searchText, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _objRef = DotNetObjectReference.Create(this);
            await Js.InvokeVoidAsync("daftarxCmdPaletteInit", _objRef);
        }

        if (_isOpen)
        {
            try { await _inputRef.FocusAsync(); }
            catch { /* element not yet in DOM */ }
        }
    }

    [JSInvokable]
    public void Open()
    {
        _isOpen = true;
        _searchText = "";
        _selectedIndex = 0;
        RebuildFlatItems();
        StateHasChanged();
    }

    private void Close()
    {
        _isOpen = false;
        _searchText = "";
        StateHasChanged();
    }

    private void Navigate(string url)
    {
        Close();
        Nav.NavigateTo(url);
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        RebuildFlatItems();

        switch (e.Key)
        {
            case "Escape":
                Close();
                break;
            case "ArrowDown":
                _selectedIndex = Math.Min(_selectedIndex + 1, _flatItems.Count - 1);
                break;
            case "ArrowUp":
                _selectedIndex = Math.Max(_selectedIndex - 1, 0);
                break;
            case "Enter":
                if (_flatItems.Count > 0 && _selectedIndex < _flatItems.Count)
                    Navigate(_flatItems[_selectedIndex].url);
                break;
        }
    }

    private void RebuildFlatItems()
    {
        _flatItems.Clear();
        foreach (var a in FilteredQuickActions)
            _flatItems.Add(("action", a.Url));
        foreach (var s in FilteredScreens)
            _flatItems.Add(("screen", s.Url));

        if (_selectedIndex >= _flatItems.Count)
            _selectedIndex = Math.Max(0, _flatItems.Count - 1);
    }

    public async ValueTask DisposeAsync()
    {
        try { await Js.InvokeVoidAsync("daftarxCmdPaletteDestroy"); }
        catch { /* circuit may already be gone */ }
        _objRef?.Dispose();
    }
}
