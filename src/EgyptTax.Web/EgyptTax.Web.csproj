<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>EgyptTax.Web</RootNamespace>
    <AssemblyName>EgyptTax.Web</AssemblyName>
    <UserSecretsId>egypttax-web-dev-local</UserSecretsId>
    <!-- Single-file portable mode: bundle wwwroot into the assembly
         so the static-files middleware can serve them via
         ManifestEmbeddedFileProvider when the EXE is run from a
         folder that doesn't have wwwroot beside it. -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EgyptTax.Infrastructure\EgyptTax.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\specs\008-egypt-tax-accounting\contracts\api\openapi.yaml"
             Link="contracts\openapi.yaml"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Hangfire.MemoryStorage" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" />
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="System.Management" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.MSSqlServer" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Cookies" />
    <!-- T247-fix: lifecycle integration with Windows SCM so the
         exe reports Started/Stopped to the Service Control Manager
         when launched as a Windows Service. Without this, sc.exe
         start times out with error 1053 because ASP.NET Core
         doesn't talk to SCM by default. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
