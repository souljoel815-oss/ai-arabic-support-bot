@page "/reports/cost-centers"
@using EgyptTax.Domain.Expenses
@using EgyptTax.Domain.Invoices
@using EgyptTax.Domain.MasterData
@using EgyptTax.Domain.Purchases
@using EgyptTax.Domain.Workflow
@using EgyptTax.Infrastructure.Persistence
@using EgyptTax.SharedKernel
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@attribute [Authorize(Policy = "FullyAuthenticated")]

@*
    v3 §11 #3 + v4 C.2 — analytical report. Per cost center:
    revenue (sales-invoice lines tagged with this center) +
    purchase cost (purchase-invoice lines tagged) + expenses
    (Expense.CostCenterId, document-level tagging, pre-existing).
    Net margin = revenue − (purchase cost + expense). Untagged
    bucket surfaces the data-quality gap.
*@

<PageTitle>@Tr("تقرير مراكز التكلفة | DaftarX", "Cost Centers Report | DaftarX")</PageTitle>

<h1>@Tr("تقرير مراكز التكلفة", "Cost Centers Report")</h1>
<p class="page-subtitle">
    @Tr(
        "إجمالي المصروفات المرحّلة لكل مركز تكلفة في الفترة المحددة. لما الإيرادات تربط بمراكز التكلفة هتشوف هامش الربح كمان.",
        "Total posted expenses per cost center in the chosen period. When revenue tagging lands, you'll see net margin too.")
</p>

<div class="invoice-toolbar" style="gap:12px;flex-wrap:wrap;">
    <label>
        @Tr("من", "From") <input type="date" @bind="_from" @bind:after="ReloadAsync" />
    </label>
    <label>
        @Tr("إلى", "To") <input type="date" @bind="_to" @bind:after="ReloadAsync" />
    </label>
</div>

@if (_loading)
{
    <p>@Tr("جارٍ التحميل…", "Loading…")</p>
}
else if (_rows.Count == 0 && _untaggedRevenue == 0m && _untaggedCost == 0m && _untaggedExpense == 0m)
{
    <div class="kpi-card kpi-info" style="padding:14px;">
        @Tr("مفيش حركة في الفترة دي.", "No posted activity in this range.")
    </div>
}
else
{
    <div class="kpi-grid kpi-grid-3" style="margin-bottom:16px;">
        <div class="kpi-card kpi-info">
            <div class="kpi-label">@Tr("إجمالي الإيرادات (Revenue)", "Total revenue")</div>
            <div class="kpi-value">@_totalRevenue.ToString("N2") @Tr("ج.م", "EGP")</div>
        </div>
        <div class="kpi-card kpi-info">
            <div class="kpi-label">@Tr("إجمالي المشتريات + المصاريف", "Total cost (purchases + expenses)")</div>
            <div class="kpi-value">@((_totalCost + _totalExpense).ToString("N2")) @Tr("ج.م", "EGP")</div>
        </div>
        <div class="kpi-card @(_totalRevenue - _totalCost - _totalExpense >= 0 ? "kpi-info" : "kpi-warn")">
            <div class="kpi-label">@Tr("صافي الهامش", "Net margin")</div>
            <div class="kpi-value">@((_totalRevenue - _totalCost - _totalExpense).ToString("N2")) @Tr("ج.م", "EGP")</div>
        </div>
    </div>

    <table class="data-table">
        <thead>
            <tr>
                <th>@Tr("الكود", "Code")</th>
                <th>@Tr("الاسم", "Name")</th>
                <th class="num">@Tr("الإيرادات", "Revenue")</th>
                <th class="num">@Tr("المشتريات", "Purchases")</th>
                <th class="num">@Tr("المصاريف", "Expenses")</th>
                <th class="num">@Tr("الهامش", "Margin")</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in _rows)
            {
                var margin = r.Revenue - r.Cost - r.Expense;
                <tr>
                    <td><code>@r.Code</code></td>
                    <td>@r.Name.Display(IsArabic ? Language.Ar : Language.En)</td>
                    <td class="num">@r.Revenue.ToString("N2")</td>
                    <td class="num">@r.Cost.ToString("N2")</td>
                    <td class="num">@r.Expense.ToString("N2")</td>
                    <td class="num"><strong>@margin.ToString("N2")</strong></td>
                </tr>
            }
            @if (_untaggedRevenue > 0 || _untaggedCost > 0 || _untaggedExpense > 0)
            {
                <tr style="background:var(--bg);">
                    <td><em>—</em></td>
                    <td><em>@Tr("(غير مصنّفة)", "(untagged)")</em></td>
                    <td class="num">@_untaggedRevenue.ToString("N2")</td>
                    <td class="num">@_untaggedCost.ToString("N2")</td>
                    <td class="num">@_untaggedExpense.ToString("N2")</td>
                    <td class="num">@((_untaggedRevenue - _untaggedCost - _untaggedExpense).ToString("N2"))</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private bool _loading = true;
    private DateTime _from = new DateTime(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1, 0, 0, 0, DateTimeKind.Utc);
    private DateTime _to = DateTime.UtcNow.Date;

    private List<Row> _rows = new();
    private decimal _totalRevenue;
    private decimal _totalCost;
    private decimal _totalExpense;
    private decimal _untaggedRevenue;
    private decimal _untaggedCost;
    private decimal _untaggedExpense;

    private sealed record Row(string Code, ArabicEnglishText Name, decimal Revenue, decimal Cost, decimal Expense);

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        var fromDate = DateOnly.FromDateTime(_from);
        var toDate = DateOnly.FromDateTime(_to);

        // Materialise then aggregate in C# — SQLite can't sum
        // decimal columns server-side. v4 C.2 expands the report
        // from "expenses only" to three streams: revenue (sales
        // invoice lines), purchase cost (purchase invoice lines),
        // and expenses (document-level Expense.CostCenterId, the
        // only one that pre-dates v4).

        // Revenue per cost-center from sales invoice lines.
        var revenueRows = await (
            from i in Db.Set<SalesInvoice>().AsNoTracking()
            from l in i.Lines
            where i.State == DocumentState.Posted
                && i.DocumentDate >= fromDate && i.DocumentDate <= toDate
            select new { l.CostCenterId, Amount = l.LineSubtotal.Amount }
        ).ToListAsync();

        // Purchase cost per cost-center from purchase invoice lines.
        // PurchaseInvoice uses DateReceived (no DocumentDate field).
        var purchaseRows = await (
            from p in Db.Set<PurchaseInvoice>().AsNoTracking()
            from l in p.Lines
            where p.State == DocumentState.Posted
                && p.DateReceived >= fromDate && p.DateReceived <= toDate
            select new { l.CostCenterId, Amount = l.LineSubtotal.Amount }
        ).ToListAsync();

        var expenses = await Db.Set<Expense>().AsNoTracking()
            .Where(e => e.State == DocumentState.Posted
                && e.DocumentDate >= fromDate && e.DocumentDate <= toDate)
            .Select(e => new { e.CostCenterId, Amount = e.Amount.Amount })
            .ToListAsync();

        var ccLookup = await Db.Set<CostCenter>().AsNoTracking()
            .ToDictionaryAsync(c => c.Id);

        var revenueByCc = revenueRows
            .Where(r => r.CostCenterId.HasValue)
            .GroupBy(r => r.CostCenterId!.Value)
            .ToDictionary(g => g.Key, g => g.Sum(x => x.Amount));
        var purchaseByCc = purchaseRows
            .Where(r => r.CostCenterId.HasValue)
            .GroupBy(r => r.CostCenterId!.Value)
            .ToDictionary(g => g.Key, g => g.Sum(x => x.Amount));
        var expenseByCc = expenses
            .Where(r => r.CostCenterId.HasValue)
            .GroupBy(r => r.CostCenterId!.Value)
            .ToDictionary(g => g.Key, g => g.Sum(x => x.Amount));

        var allCcIds = revenueByCc.Keys
            .Union(purchaseByCc.Keys)
            .Union(expenseByCc.Keys)
            .Distinct()
            .ToList();

        _rows = allCcIds
            .Select(id =>
            {
                ccLookup.TryGetValue(id, out var cc);
                var rev = revenueByCc.TryGetValue(id, out var r) ? r : 0m;
                var cost = purchaseByCc.TryGetValue(id, out var c) ? c : 0m;
                var exp = expenseByCc.TryGetValue(id, out var e) ? e : 0m;
                return new Row(
                    Code: cc?.Code ?? "?",
                    Name: cc?.Name ?? new ArabicEnglishText("(?)", "(?)"),
                    Revenue: rev,
                    Cost: cost,
                    Expense: exp);
            })
            .OrderByDescending(r => r.Revenue - r.Cost - r.Expense)
            .ToList();

        _totalRevenue = revenueRows.Sum(r => r.Amount);
        _totalCost = purchaseRows.Sum(r => r.Amount);
        _totalExpense = expenses.Sum(e => e.Amount);

        _untaggedRevenue = revenueRows.Where(r => !r.CostCenterId.HasValue).Sum(r => r.Amount);
        _untaggedCost = purchaseRows.Where(r => !r.CostCenterId.HasValue).Sum(r => r.Amount);
        _untaggedExpense = expenses.Where(e => !e.CostCenterId.HasValue).Sum(e => e.Amount);

        _loading = false;
    }
}
