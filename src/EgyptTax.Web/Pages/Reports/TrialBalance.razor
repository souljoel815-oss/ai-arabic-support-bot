@page "/reports/trial-balance"
@using EgyptTax.Application.Reports
@using Microsoft.AspNetCore.Authorization
@inject ITrialBalanceReportQuery ReportQuery
@attribute [Authorize(Policy = "FullyAuthenticated")]

<h1>Trial balance (FR-024) / ميزان المراجعة</h1>

<form class="invoice-toolbar" @onsubmit="OnRefresh" @onsubmit:preventDefault>
    <label>
        <span>Period start</span>
        <input type="date" @bind="_periodStart" />
    </label>
    <label>
        <span>Period end</span>
        <input type="date" @bind="_periodEnd" />
    </label>
    <button type="submit" class="btn-primary" disabled="@_loading">
        @(_loading ? "Computing…" : "Run report")
    </button>
</form>

@if (_report is null)
{
    @if (_loading)
    {
        <p>Loading…</p>
    }
    else
    {
        <p><em>Pick a period above and click "Run report".</em></p>
    }
    return;
}

<section class="invoice-totals">
    <div><strong>Period:</strong> @_report.PeriodStart.ToString("yyyy-MM-dd") to @_report.PeriodEnd.ToString("yyyy-MM-dd")</div>
    <div><strong>Total debits:</strong> <span class="num">@_report.TotalDebits.Amount.ToString("F2") EGP</span></div>
    <div><strong>Total credits:</strong> <span class="num">@_report.TotalCredits.Amount.ToString("F2") EGP</span></div>
    @if (_report.IsBalanced)
    {
        <div class="grand"><strong>Balanced ✓</strong> debits == credits</div>
    }
    else
    {
        <div class="flash-error">
            <strong>NOT BALANCED ✗</strong> — difference @((_report.TotalDebits.Amount - _report.TotalCredits.Amount).ToString("F2")) EGP.
            The journal-entry factory enforces the invariant at write time, so a non-balanced
            trial balance indicates out-of-band tampering with the accounting tables.
        </div>
    }
</section>

<section>
    <h2>Account activity (@_report.Rows.Count accounts)</h2>
    @if (_report.Rows.Count == 0)
    {
        <p><em>No journal-entry activity in this period.</em></p>
    }
    else
    {
        <table class="data-grid">
            <thead>
                <tr>
                    <th>Account code</th>
                    <th class="num">Debit</th>
                    <th class="num">Credit</th>
                    <th class="num">Net (debit − credit)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _report.Rows)
                {
                    <tr>
                        <td><code>@row.AccountCode</code></td>
                        <td class="num">@row.TotalDebit.Amount.ToString("F2")</td>
                        <td class="num">@row.TotalCredit.Amount.ToString("F2")</td>
                        <td class="num">@row.NetBalance.Amount.ToString("F2")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    private DateTime _periodStart = new(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1);
    private DateTime _periodEnd = new(DateTime.UtcNow.Year, DateTime.UtcNow.Month,
        DateTime.DaysInMonth(DateTime.UtcNow.Year, DateTime.UtcNow.Month));
    private bool _loading;
    private TrialBalanceReport? _report;

    private async Task OnRefresh()
    {
        _loading = true;
        try
        {
            _report = await ReportQuery.RunAsync(
                DateOnly.FromDateTime(_periodStart),
                DateOnly.FromDateTime(_periodEnd));
        }
        finally
        {
            _loading = false;
        }
    }
}
