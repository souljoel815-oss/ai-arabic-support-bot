@page "/reports/sales-by-rep"
@using EgyptTax.Domain.Identity
@using EgyptTax.Domain.Invoices
@using EgyptTax.Domain.Workflow
@using EgyptTax.Infrastructure.Persistence
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@attribute [Authorize(Policy = "NotSalesRepOnly")]

@*
    Phase C.3 — Sales by Rep. Admin/manager-facing report grouped by
    SalesInvoice.CreatedByUserId. Each rep gets one row per period
    (defaults to current month) with invoice count, total revenue,
    total VAT, and total grand. Restricted to NotSalesRepOnly so reps
    don't see each others' numbers.

    The report only counts POSTED invoices; drafts and submitted-for-
    approval rows are excluded so the totals represent real revenue.
    Credit notes (negative grand totals) are netted in by SumAsync's
    natural arithmetic.
*@

<h1>@(IsArabic ? "تقرير مبيعات المناديب" : "Sales by Representative")</h1>

<div class="form-grid" style="max-width:560px; margin-bottom:16px;">
    <label>
        <span>@(IsArabic ? "من تاريخ" : "From")</span>
        <input type="date" @bind="_from" @bind:after="ReloadAsync" />
    </label>
    <label>
        <span>@(IsArabic ? "إلى تاريخ" : "To")</span>
        <input type="date" @bind="_to" @bind:after="ReloadAsync" />
    </label>
</div>

@if (_loading)
{
    <p>@(IsArabic ? "جارٍ التحميل…" : "Loading…")</p>
    return;
}

@if (_rows.Count == 0)
{
    <p><em>@(IsArabic ? "لا توجد فواتير مرحَّلة في هذه الفترة." : "No posted invoices in this period.")</em></p>
    return;
}

<table class="data-grid">
    <thead>
        <tr>
            <th>@(IsArabic ? "المندوب" : "Rep")</th>
            <th>@(IsArabic ? "البريد" : "Email")</th>
            <th class="num">@(IsArabic ? "عدد الفواتير" : "Invoices")</th>
            <th class="num">@(IsArabic ? "صافي المبيعات" : "Net sales")</th>
            <th class="num">@(IsArabic ? "الضريبة" : "VAT")</th>
            <th class="num">@(IsArabic ? "الإجمالي الكلي" : "Grand total")</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in _rows)
        {
            <tr>
                <td>@(IsArabic ? r.NameAr : r.NameEn)</td>
                <td><code>@r.Email</code></td>
                <td class="num">@r.InvoiceCount</td>
                <td class="num">@r.NetSales.ToString("F2")</td>
                <td class="num">@r.VatTotal.ToString("F2")</td>
                <td class="num"><strong>@r.GrandTotal.ToString("F2")</strong></td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="2"><strong>@(IsArabic ? "الإجمالي" : "Total")</strong></td>
            <td class="num"><strong>@_rows.Sum(r => r.InvoiceCount)</strong></td>
            <td class="num"><strong>@_rows.Sum(r => r.NetSales).ToString("F2")</strong></td>
            <td class="num"><strong>@_rows.Sum(r => r.VatTotal).ToString("F2")</strong></td>
            <td class="num"><strong>@_rows.Sum(r => r.GrandTotal).ToString("F2")</strong></td>
        </tr>
    </tfoot>
</table>

@code {
    private bool _loading = true;
    private DateTime _from = new DateTime(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1);
    private DateTime _to = DateTime.UtcNow.Date;
    private List<RepRow> _rows = new();

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        var fromDate = DateOnly.FromDateTime(_from);
        var toDate = DateOnly.FromDateTime(_to);

        // Project the per-invoice rows we need then group + sum in
        // memory. EF's SQLite provider can't translate Sum() on
        // decimal columns, so we deliberately materialise first.
        // Volumes per period are small (a few hundred invoices at
        // most for an SMB); the round-trip stays cheap.
        var raw = await Db.Set<SalesInvoice>().AsNoTracking()
            .Where(i => i.State == DocumentState.Posted
                && i.CreatedByUserId != null
                && i.DocumentDate >= fromDate
                && i.DocumentDate <= toDate)
            .Select(i => new
            {
                UserId = i.CreatedByUserId!.Value,
                Net = i.NetBeforeVat.Amount,
                Vat = i.VatTotal.Amount,
                Grand = i.GrandTotal.Amount,
            })
            .ToListAsync();
        var grouped = raw
            .GroupBy(r => r.UserId)
            .Select(g => new
            {
                UserId = g.Key,
                Count = g.Count(),
                NetSales = g.Sum(x => x.Net),
                VatTotal = g.Sum(x => x.Vat),
                GrandTotal = g.Sum(x => x.Grand),
            })
            .ToList();

        // Bulk-load user display names so the table shows "Mahmoud" not a GUID.
        var userIds = grouped.Select(r => r.UserId).ToArray();
        var users = await Db.Set<User>().AsNoTracking()
            .Where(u => userIds.Contains(u.Id))
            .ToDictionaryAsync(u => u.Id);

        _rows = grouped
            .Select(r =>
            {
                var u = users.GetValueOrDefault(r.UserId);
                return new RepRow(
                    UserId: r.UserId,
                    NameAr: u?.DisplayName.Arabic ?? r.UserId.ToString("D"),
                    NameEn: u?.DisplayName.English ?? r.UserId.ToString("D"),
                    Email: u?.Email ?? "—",
                    InvoiceCount: r.Count,
                    NetSales: r.NetSales,
                    VatTotal: r.VatTotal,
                    GrandTotal: r.GrandTotal);
            })
            .OrderByDescending(r => r.GrandTotal)
            .ToList();

        _loading = false;
    }

    private sealed record RepRow(
        Guid UserId,
        string NameAr,
        string NameEn,
        string Email,
        int InvoiceCount,
        decimal NetSales,
        decimal VatTotal,
        decimal GrandTotal);
}
