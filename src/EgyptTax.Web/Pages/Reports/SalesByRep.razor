@page "/reports/sales-by-rep"
@using EgyptTax.Domain.Identity
@using EgyptTax.Domain.Invoices
@using EgyptTax.Domain.Workflow
@using EgyptTax.Infrastructure.Persistence
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@attribute [Authorize(Policy = "NotSalesRepOnly")]

@*
    Phase C.3 — Sales by Rep. Admin/manager-facing report grouped by
    SalesInvoice.CreatedByUserId. Each rep gets one row per period
    (defaults to current month) with invoice count, total revenue,
    total VAT, and total grand. Restricted to NotSalesRepOnly so reps
    don't see each others' numbers.

    The report only counts POSTED invoices; drafts and submitted-for-
    approval rows are excluded so the totals represent real revenue.
    Credit notes (negative grand totals) are netted in by SumAsync's
    natural arithmetic.
*@

<SettingsTabStrip Group="sales-reports" />

<h1>@(IsArabic ? "تقرير مبيعات المناديب" : "Sales by Representative")</h1>

<div class="form-grid" style="max-width:680px; margin-bottom:16px;">
    <label>
        <span>@(IsArabic ? "من تاريخ" : "From")</span>
        <input type="date" @bind="_from" @bind:after="ReloadAsync" />
    </label>
    <label>
        <span>@(IsArabic ? "إلى تاريخ" : "To")</span>
        <input type="date" @bind="_to" @bind:after="ReloadAsync" />
    </label>
    <label style="grid-column:1 / -1;display:flex;align-items:center;gap:8px;">
        <input type="checkbox" @bind="_byTeam" @bind:after="ReloadAsync" />
        <span>@(IsArabic ? "تجميع حسب الفريق (مع نسبة تحقيق الهدف)" : "Group by team (with target attainment %)")</span>
    </label>
</div>

@if (_loading)
{
    <p>@(IsArabic ? "جارٍ التحميل…" : "Loading…")</p>
    return;
}

@if (_rows.Count == 0)
{
    <p><em>@(IsArabic ? "لا توجد فواتير مرحَّلة في هذه الفترة." : "No posted invoices in this period.")</em></p>
    return;
}

@if (!_byTeam)
{
    @* Per-rep view (original) *@
    <table class="data-grid">
        <thead>
            <tr>
                <th>@(IsArabic ? "المندوب" : "Rep")</th>
                <th>@(IsArabic ? "البريد" : "Email")</th>
                <th>@(IsArabic ? "الفريق" : "Team")</th>
                <th class="num">@(IsArabic ? "عدد الفواتير" : "Invoices")</th>
                <th class="num">@(IsArabic ? "صافي المبيعات" : "Net sales")</th>
                <th class="num">@(IsArabic ? "الضريبة" : "VAT")</th>
                <th class="num">@(IsArabic ? "الإجمالي الكلي" : "Grand total")</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in _rows)
            {
                <tr>
                    <td>@(IsArabic ? r.NameAr : r.NameEn)</td>
                    <td><code>@r.Email</code></td>
                    <td>@(r.TeamNameAr is null ? "—" : (IsArabic ? r.TeamNameAr : r.TeamNameEn))</td>
                    <td class="num">@r.InvoiceCount</td>
                    <td class="num">@r.NetSales.ToString("F2")</td>
                    <td class="num">@r.VatTotal.ToString("F2")</td>
                    <td class="num"><strong>@r.GrandTotal.ToString("F2")</strong></td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3"><strong>@(IsArabic ? "الإجمالي" : "Total")</strong></td>
                <td class="num"><strong>@_rows.Sum(r => r.InvoiceCount)</strong></td>
                <td class="num"><strong>@_rows.Sum(r => r.NetSales).ToString("F2")</strong></td>
                <td class="num"><strong>@_rows.Sum(r => r.VatTotal).ToString("F2")</strong></td>
                <td class="num"><strong>@_rows.Sum(r => r.GrandTotal).ToString("F2")</strong></td>
            </tr>
        </tfoot>
    </table>
}
else
{
    @* By-team view: group rep rows by SalesTeamId *@
    var teamGroups = _rows
        .GroupBy(r => r.TeamId)
        .Select(g => new
        {
            TeamId = g.Key,
            TeamNameAr = g.First().TeamNameAr ?? (IsArabic ? "غير معيّن" : "Unassigned"),
            TeamNameEn = g.First().TeamNameEn ?? "Unassigned",
            MonthlyTarget = g.First().TeamMonthlyTarget,
            Reps = g.OrderByDescending(r => r.GrandTotal).ToList(),
            NetSales = g.Sum(r => r.NetSales),
            VatTotal = g.Sum(r => r.VatTotal),
            GrandTotal = g.Sum(r => r.GrandTotal),
            InvoiceCount = g.Sum(r => r.InvoiceCount),
        })
        .OrderByDescending(t => t.GrandTotal)
        .ToList();

    // Attainment % is grand_total / (target * months_in_range).
    var months = Math.Max(1, ((_to.Year - _from.Year) * 12 + _to.Month - _from.Month) + 1);

    @foreach (var team in teamGroups)
    {
        var teamTarget = team.MonthlyTarget * months;
        var attainmentPct = teamTarget is decimal t && t > 0
            ? (int)Math.Round(team.GrandTotal / t * 100m)
            : (int?)null;
        <h2 style="margin-top:20px;">
            @(IsArabic ? team.TeamNameAr : team.TeamNameEn)
            @if (attainmentPct is not null)
            {
                <span style="font-size:14px;font-weight:500;color:@(attainmentPct >= 100 ? "var(--success-text)" : attainmentPct >= 75 ? "var(--warning-text)" : "var(--danger-text)");margin-inline-start:12px;">
                    @attainmentPct% @(IsArabic ? "من الهدف" : "of target")
                    @if (teamTarget is decimal t2)
                    {
                        <text> (@team.GrandTotal.ToString("N0") / @t2.ToString("N0"))</text>
                    }
                </span>
            }
        </h2>
        <table class="data-grid">
            <thead>
                <tr>
                    <th>@(IsArabic ? "المندوب" : "Rep")</th>
                    <th>@(IsArabic ? "البريد" : "Email")</th>
                    <th class="num">@(IsArabic ? "عدد الفواتير" : "Invoices")</th>
                    <th class="num">@(IsArabic ? "صافي المبيعات" : "Net sales")</th>
                    <th class="num">@(IsArabic ? "الضريبة" : "VAT")</th>
                    <th class="num">@(IsArabic ? "الإجمالي الكلي" : "Grand total")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in team.Reps)
                {
                    <tr>
                        <td>@(IsArabic ? r.NameAr : r.NameEn)</td>
                        <td><code>@r.Email</code></td>
                        <td class="num">@r.InvoiceCount</td>
                        <td class="num">@r.NetSales.ToString("F2")</td>
                        <td class="num">@r.VatTotal.ToString("F2")</td>
                        <td class="num">@r.GrandTotal.ToString("F2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="2"><strong>@(IsArabic ? "إجمالي الفريق" : "Team total")</strong></td>
                    <td class="num"><strong>@team.InvoiceCount</strong></td>
                    <td class="num"><strong>@team.NetSales.ToString("F2")</strong></td>
                    <td class="num"><strong>@team.VatTotal.ToString("F2")</strong></td>
                    <td class="num"><strong>@team.GrandTotal.ToString("F2")</strong></td>
                </tr>
            </tfoot>
        </table>
    }
}

@code {
    private bool _loading = true;
    private DateTime _from = new DateTime(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1);
    private DateTime _to = DateTime.UtcNow.Date;
    private bool _byTeam;     // v5 B.1 — toggles per-team grouping
    private List<RepRow> _rows = new();

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        var fromDate = DateOnly.FromDateTime(_from);
        var toDate = DateOnly.FromDateTime(_to);

        // Project the per-invoice rows we need then group + sum in
        // memory. EF's SQLite provider can't translate Sum() on
        // decimal columns, so we deliberately materialise first.
        var raw = await Db.Set<SalesInvoice>().AsNoTracking()
            .Where(i => i.State == DocumentState.Posted
                && i.CreatedByUserId != null
                && i.DocumentDate >= fromDate
                && i.DocumentDate <= toDate)
            .Select(i => new
            {
                UserId = i.CreatedByUserId!.Value,
                Net = i.NetBeforeVat.Amount,
                Vat = i.VatTotal.Amount,
                Grand = i.GrandTotal.Amount,
            })
            .ToListAsync();
        var grouped = raw
            .GroupBy(r => r.UserId)
            .Select(g => new
            {
                UserId = g.Key,
                Count = g.Count(),
                NetSales = g.Sum(x => x.Net),
                VatTotal = g.Sum(x => x.Vat),
                GrandTotal = g.Sum(x => x.Grand),
            })
            .ToList();

        // Bulk-load user display names + team membership so we can
        // show team names + roll up per-team totals.
        var userIds = grouped.Select(r => r.UserId).ToArray();
        var users = await Db.Set<User>().AsNoTracking()
            .Where(u => userIds.Contains(u.Id))
            .ToDictionaryAsync(u => u.Id);

        var teamIds = users.Values
            .Where(u => u.SalesTeamId is not null)
            .Select(u => u.SalesTeamId!.Value)
            .Distinct()
            .ToArray();
        var teams = await Db.Set<SalesTeam>().AsNoTracking()
            .Where(t => teamIds.Contains(t.Id))
            .ToDictionaryAsync(t => t.Id);

        _rows = grouped
            .Select(r =>
            {
                var u = users.GetValueOrDefault(r.UserId);
                var team = u?.SalesTeamId is { } tid ? teams.GetValueOrDefault(tid) : null;
                return new RepRow(
                    UserId: r.UserId,
                    NameAr: u?.DisplayName.Arabic ?? r.UserId.ToString("D"),
                    NameEn: u?.DisplayName.English ?? r.UserId.ToString("D"),
                    Email: u?.Email ?? "—",
                    InvoiceCount: r.Count,
                    NetSales: r.NetSales,
                    VatTotal: r.VatTotal,
                    GrandTotal: r.GrandTotal,
                    TeamId: u?.SalesTeamId,
                    TeamNameAr: team?.Name.Arabic,
                    TeamNameEn: team?.Name.English,
                    TeamMonthlyTarget: team?.MonthlyTargetEgp);
            })
            .OrderByDescending(r => r.GrandTotal)
            .ToList();

        _loading = false;
    }

    private sealed record RepRow(
        Guid UserId,
        string NameAr,
        string NameEn,
        string Email,
        int InvoiceCount,
        decimal NetSales,
        decimal VatTotal,
        decimal GrandTotal,
        Guid? TeamId,
        string? TeamNameAr,
        string? TeamNameEn,
        decimal? TeamMonthlyTarget);
}
