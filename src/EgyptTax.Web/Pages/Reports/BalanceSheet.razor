@page "/reports/balance-sheet"
@using EgyptTax.Application.Reports
@using Microsoft.AspNetCore.Authorization
@inject IBalanceSheetReportQuery ReportQuery
@attribute [Authorize(Policy = "NotSalesRepOnly")]

<RequireFeature Feature="@Feature.TrialBalance" />

<SettingsTabStrip Group="accounting-reports" />

<h1>@(IsArabic ? "الميزانية" : "Balance Sheet")</h1>

<form class="invoice-toolbar" @onsubmit="OnRefresh" @onsubmit:preventDefault>
    <label>
        <span>@(IsArabic ? "اللقطة كما في" : "Snapshot as of")</span>
        <input type="date" @bind="_asOfDate" />
    </label>
    <button type="submit" class="btn-primary" disabled="@_loading">
        @(_loading ? (IsArabic ? "جارٍ الحساب…" : "Computing…") : (IsArabic ? "تشغيل التقرير" : "Run report"))
    </button>
</form>

@if (_report is null)
{
    @if (_loading)
    {
        <p>@(IsArabic ? "جارٍ التحميل…" : "Loading…")</p>
    }
    else
    {
        <p><em>@(IsArabic ? "اختر التاريخ بالأعلى ثم اضغط «تشغيل التقرير»." : "Pick a date above and click \"Run report\".")</em></p>
    }
    return;
}

<section class="invoice-totals">
    <div><strong>@(IsArabic ? "كما في:" : "As of:")</strong> @_report.AsOfDate.ToString("yyyy-MM-dd")</div>
    <div><strong>@(IsArabic ? "إجمالي الأصول:" : "Total assets:")</strong> <span class="num">@_report.TotalAssets.Amount.ToString("F2") @(IsArabic ? "ج.م." : "EGP")</span></div>
    <div><strong>@(IsArabic ? "إجمالي الالتزامات:" : "Total liabilities:")</strong> <span class="num">@_report.TotalLiabilities.Amount.ToString("F2") @(IsArabic ? "ج.م." : "EGP")</span></div>
    <div><strong>@(IsArabic ? "إجمالي حقوق الملكية:" : "Total equity:")</strong> <span class="num">@_report.TotalEquity.Amount.ToString("F2") @(IsArabic ? "ج.م." : "EGP")</span></div>
    <div><strong>@(IsArabic ? "الأرباح المحتجزة:" : "Retained earnings:")</strong> <span class="num">@_report.RetainedEarnings.Amount.ToString("F2") @(IsArabic ? "ج.م." : "EGP")</span></div>
    @if (_report.IsBalanced)
    {
        <div class="grand">
            <strong>@(IsArabic ? "متوازن ✓" : "Balanced ✓")</strong>
            @(IsArabic ? "الأصول = الالتزامات + حقوق الملكية + الأرباح المحتجزة" : "assets == liabilities + equity + retained earnings")
        </div>
    }
    else
    {
        <div class="flash-error">
            <strong>@(IsArabic ? "غير متوازن ✗" : "NOT BALANCED ✗")</strong>
            @(IsArabic
                ? "— خلل في معادلة المحاسبة. ابحث فوراً عن تلاعب خارجي بجداول قيود اليومية."
                : "— accounting equation violated. Investigate immediately for out-of-band tampering with the journal-entry tables.")
        </div>
    }
</section>

<section>
    <h2>@(IsArabic ? $"الأصول ({_report.AssetRows.Count})" : $"Assets ({_report.AssetRows.Count})")</h2>
    @if (_report.AssetRows.Count == 0)
    {
        <p><em>@(IsArabic ? "لا توجد أصول مسجلة." : "No assets recorded.")</em></p>
    }
    else
    {
        <table class="data-grid">
            <thead>
                <tr>
                    <th>@(IsArabic ? "كود الحساب" : "Account code")</th>
                    <th class="num">@(IsArabic ? "الرصيد" : "Balance")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _report.AssetRows)
                {
                    <tr>
                        <td><code>@row.AccountCode</code></td>
                        <td class="num">@row.Balance.Amount.ToString("F2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th>@(IsArabic ? "الإجمالي" : "Total")</th>
                    <th class="num">@_report.TotalAssets.Amount.ToString("F2")</th>
                </tr>
            </tfoot>
        </table>
    }
</section>

<section>
    <h2>@(IsArabic ? $"الالتزامات ({_report.LiabilityRows.Count})" : $"Liabilities ({_report.LiabilityRows.Count})")</h2>
    @if (_report.LiabilityRows.Count == 0)
    {
        <p><em>@(IsArabic ? "لا توجد التزامات مسجلة." : "No liabilities recorded.")</em></p>
    }
    else
    {
        <table class="data-grid">
            <thead>
                <tr>
                    <th>@(IsArabic ? "كود الحساب" : "Account code")</th>
                    <th class="num">@(IsArabic ? "الرصيد" : "Balance")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _report.LiabilityRows)
                {
                    <tr>
                        <td><code>@row.AccountCode</code></td>
                        <td class="num">@row.Balance.Amount.ToString("F2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th>@(IsArabic ? "الإجمالي" : "Total")</th>
                    <th class="num">@_report.TotalLiabilities.Amount.ToString("F2")</th>
                </tr>
            </tfoot>
        </table>
    }
</section>

<section>
    <h2>@(IsArabic ? $"حقوق الملكية ({_report.EquityRows.Count} + الأرباح المحتجزة)" : $"Equity ({_report.EquityRows.Count} + retained earnings)")</h2>
    <table class="data-grid">
        <thead>
            <tr>
                <th>@(IsArabic ? "كود الحساب" : "Account code")</th>
                <th class="num">@(IsArabic ? "الرصيد" : "Balance")</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in _report.EquityRows)
            {
                <tr>
                    <td><code>@row.AccountCode</code></td>
                    <td class="num">@row.Balance.Amount.ToString("F2")</td>
                </tr>
            }
            <tr>
                <td><em>@(IsArabic ? "الأرباح المحتجزة (محسوبة)" : "Retained earnings (computed)")</em></td>
                <td class="num">@_report.RetainedEarnings.Amount.ToString("F2")</td>
            </tr>
        </tbody>
        <tfoot>
            <tr>
                <th>@(IsArabic ? "الإجمالي" : "Total")</th>
                <th class="num">@((_report.TotalEquity.Amount + _report.RetainedEarnings.Amount).ToString("F2"))</th>
            </tr>
        </tfoot>
    </table>
</section>

@code {
    private DateTime _asOfDate = DateTime.UtcNow.Date;
    private bool _loading;
    private BalanceSheetReport? _report;

    private async Task OnRefresh()
    {
        _loading = true;
        try
        {
            _report = await ReportQuery.RunAsync(DateOnly.FromDateTime(_asOfDate));
        }
        finally
        {
            _loading = false;
        }
    }
}
