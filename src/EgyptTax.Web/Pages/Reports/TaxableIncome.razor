@page "/reports/taxable-income"
@using EgyptTax.Application.Reports
@using EgyptTax.Domain.Workflow
@using Microsoft.AspNetCore.Authorization
@inject ITaxableIncomeReportQuery ReportQuery
@attribute [Authorize(Policy = "FullyAuthenticated")]

<h1>@(IsArabic ? "تقرير الدخل الخاضع للضريبة" : "Taxable income report (FR-023)")</h1>

<form class="invoice-toolbar" @onsubmit="OnRefresh" @onsubmit:preventDefault>
    <label>
        <span>@(IsArabic ? "بداية الفترة" : "Period start")</span>
        <input type="date" @bind="_periodStart" />
    </label>
    <label>
        <span>@(IsArabic ? "نهاية الفترة" : "Period end")</span>
        <input type="date" @bind="_periodEnd" />
    </label>
    <button type="submit" class="btn-primary" disabled="@_loading">
        @(_loading ? (IsArabic ? "جارٍ الحساب…" : "Computing…") : (IsArabic ? "تشغيل التقرير" : "Run report"))
    </button>
</form>

@if (_report is null)
{
    @if (_loading)
    {
        <p>@(IsArabic ? "جارٍ التحميل…" : "Loading…")</p>
    }
    else
    {
        <p><em>@(IsArabic ? "اختر الفترة بالأعلى ثم اضغط «تشغيل التقرير»." : "Pick a period above and click \"Run report\".")</em></p>
    }
    return;
}

<section class="invoice-totals">
    <div><strong>@(IsArabic ? "الفترة:" : "Period:")</strong> @_report.PeriodStart.ToString("yyyy-MM-dd") @(IsArabic ? "إلى" : "to") @_report.PeriodEnd.ToString("yyyy-MM-dd")</div>
    <div><strong>@(IsArabic ? "الإيرادات:" : "Revenue:")</strong> <span class="num">@_report.Revenue.Amount.ToString("F2") @(IsArabic ? "ج.م." : "EGP")</span></div>
    <div><strong>@(IsArabic ? "المصروفات القابلة للخصم:" : "Deductible expenses:")</strong> <span class="num">(@_report.DeductibleExpenses.Amount.ToString("F2")) @(IsArabic ? "ج.م." : "EGP")</span></div>
    <div><strong>@(IsArabic ? "التسويات غير القابلة للخصم (تُضاف):" : "Non-deductible adjustments (added back):")</strong> <span class="num">+@_report.NonDeductibleAdjustments.Amount.ToString("F2") @(IsArabic ? "ج.م." : "EGP")</span></div>
    <div><strong>@(IsArabic ? "الربح/الخسارة الإدارية:" : "Management P&L:")</strong> <span class="num">@_report.ManagementProfitLoss.Amount.ToString("F2") @(IsArabic ? "ج.م." : "EGP")</span></div>
    <div class="grand">
        <strong>@(IsArabic ? "الدخل الخاضع للضريبة:" : "Taxable income:")</strong>
        <span class="num">@_report.TaxableIncome.Amount.ToString("F2") @(IsArabic ? "ج.م." : "EGP")</span>
    </div>
    <p><em>@(IsArabic ? "الهوية الحسابية: الدخل الخاضع للضريبة = الربح الإداري + التسويات غير القابلة للخصم. البنود غير القابلة للخصم تظهر في قائمة الدخل لكن تُضاف مرة أخرى عند حساب الربح الخاضع للضريبة (سيناريو القبول 2 من US2)." : "Identity: TaxableIncome = ManagementP&L + NonDeductibleAdjustments. Non-deductible items appear in P&L but are added back when computing taxable profit (US2 acceptance scenario 2).")</em></p>
</section>

<section>
    <h2>@(IsArabic ? $"المستندات المساهمة ({_report.Rows.Count})" : $"Contributing documents ({_report.Rows.Count})")</h2>
    @if (_report.Rows.Count == 0)
    {
        <p><em>@(IsArabic ? "لا توجد مستندات مرحّلة في هذه الفترة." : "No posted documents in this period.")</em></p>
    }
    else
    {
        <table class="data-grid">
            <thead>
                <tr>
                    <th>@(IsArabic ? "التاريخ" : "Date")</th>
                    <th>@(IsArabic ? "الفئة" : "Bucket")</th>
                    <th>@(IsArabic ? "النوع" : "Type")</th>
                    <th>@(IsArabic ? "رقم المستند" : "Document #")</th>
                    <th>@(IsArabic ? "الوصف" : "Description")</th>
                    <th class="num">@(IsArabic ? "المبلغ" : "Amount")</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _report.Rows)
                {
                    <tr>
                        <td>@row.DocumentDate.ToString("yyyy-MM-dd")</td>
                        <td>@row.Bucket</td>
                        <td>@row.DocumentType</td>
                        <td>@(row.DocumentNumber ?? (IsArabic ? "(مسودة)" : "(draft)"))</td>
                        <td>@row.Description</td>
                        <td class="num">@row.Amount.Amount.ToString("F2")</td>
                        <td><a href="@DrillDownUrl(row)">@(IsArabic ? "فتح" : "Open")</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    private DateTime _periodStart = new(DateTime.UtcNow.Year, 1, 1);
    private DateTime _periodEnd = new(DateTime.UtcNow.Year, 12, 31);
    private bool _loading;
    private TaxableIncomeReport? _report;

    private async Task OnRefresh()
    {
        _loading = true;
        try
        {
            _report = await ReportQuery.RunAsync(
                DateOnly.FromDateTime(_periodStart),
                DateOnly.FromDateTime(_periodEnd));
        }
        finally
        {
            _loading = false;
        }
    }

    private static string DrillDownUrl(TaxableIncomeRow row) => row.DocumentType switch
    {
        DocumentType.SalesInvoice => $"/invoices/{row.DocumentId}",
        DocumentType.CreditNote => $"/invoices/{row.DocumentId}",
        DocumentType.PurchaseInvoice => $"/purchase-invoices/{row.DocumentId}",
        DocumentType.Expense => $"/expenses/{row.DocumentId}",
        _ => $"/document360/{row.DocumentType.ToString().ToLowerInvariant()}/{row.DocumentId}",
    };
}
