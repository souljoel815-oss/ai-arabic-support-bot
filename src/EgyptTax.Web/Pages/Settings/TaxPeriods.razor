@page "/settings/tax-periods"
@using System.ComponentModel.DataAnnotations
@using EgyptTax.Application.Periods
@using EgyptTax.Domain.Periods
@using EgyptTax.Infrastructure.Periods
@using EgyptTax.Infrastructure.Persistence
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject LockTaxPeriodHandler PeriodHandler
@inject AuthenticationStateProvider AuthState
@attribute [Authorize(Policy = "FullyAuthenticated")]

<h1>@(IsArabic ? "الفترات الضريبية (FR-037)" : "Tax periods (FR-037)")</h1>

<p>
    @(IsArabic
        ? "اقفل شهر الضريبة بعد تقديم الإقرار عشان الترحيلات بأثر رجعي ترفض أوتوماتيك. أعد الفتح فقط لو فاتورة مورد متأخرة أو تصحيح محتاج يدخل. الإجراءين مسجلين في سجل التدقيق."
        : "Lock a VAT month after filing the return so backdated posts into that period are rejected automatically. Reopen only when a late supplier invoice or correction needs to land. Both actions are recorded in the audit log.")
</p>

@if (_flash is not null)
{
    <div class="@_flashClass" role="status">@_flash</div>
}

@if (_blockedDecision is not null)
{
    <div class="kpi-card kpi-error" style="margin-top:12px;">
        <strong>@(IsArabic ? "القفل مرفوض — افتح قمرة الإقفال (`/cockpit`) لمعالجة:" : "Lock refused — open the cockpit (/cockpit) to resolve:")</strong>
        <ul>
            @foreach (var b in _blockedDecision.HardBlockers)
            {
                <li>@(IsArabic ? b.DescriptionAr : b.DescriptionEn)</li>
            }
            @foreach (var b in _blockedDecision.SoftBlockers)
            {
                <li>@(IsArabic ? b.DescriptionAr : b.DescriptionEn) — @(IsArabic ? "قابل للتجاوز من الكوكبيت بسبب موثَّق" : "force-lockable from the cockpit with a written reason")</li>
            }
        </ul>
    </div>
}

<section class="master-data-list">
    <h2>@(IsArabic ? "الفترات المقفولة + المتأخرة" : "Locked + recently-touched periods")</h2>
    @if (_periods is null)
    {
        <p>@(IsArabic ? "جارٍ التحميل…" : "Loading…")</p>
    }
    else if (_periods.Count == 0)
    {
        <p><em>@(IsArabic ? "لا توجد فترات مسجلة. اقفل واحدة بالأسفل." : "No periods on record. Lock one below.")</em></p>
    }
    else
    {
        <table class="data-grid">
            <thead>
                <tr>
                    <th>@(IsArabic ? "النوع" : "Kind")</th>
                    <th>@(IsArabic ? "السنة" : "Year")</th>
                    <th>@(IsArabic ? "الشهر / الربع" : "Month / Quarter")</th>
                    <th>@(IsArabic ? "الحالة" : "Status")</th>
                    <th>@(IsArabic ? "وقت القفل (UTC)" : "Locked at (UTC)")</th>
                    <th>@(IsArabic ? "السبب" : "Reason")</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in _periods)
                {
                    <tr>
                        <td>@p.PeriodKind</td>
                        <td>@p.Year</td>
                        <td>@(p.PeriodKind == TaxPeriodKind.IncomeFiscalYear ? "—" : p.MonthOrQuarter.ToString("D2"))</td>
                        <td><strong>@p.Status</strong></td>
                        <td>@(p.LockedAtUtc?.ToString("yyyy-MM-dd HH:mm:ss") ?? "—")</td>
                        <td>@(p.LockedReason ?? "—")</td>
                        <td>
                            @if (p.Status == TaxPeriodStatus.Locked)
                            {
                                <button type="button" @onclick="() => OnReopenAsync(p)">@(IsArabic ? "إعادة فتح" : "Reopen")</button>
                            }
                            else
                            {
                                <em>@(IsArabic ? "مفتوحة" : "Open")</em>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="master-data-create">
    <h2>@(IsArabic ? "قفل شهر ضريبي" : "Lock a VAT month")</h2>
    <EditForm Model="_form" OnValidSubmit="OnLockAsync" FormName="tax-period-lock" class="form-grid">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <label>
            <span>@(IsArabic ? "السنة" : "Year")</span>
            <InputNumber @bind-Value="_form.Year" min="2000" max="9999" />
        </label>
        <label>
            <span>@(IsArabic ? "الشهر" : "Month")</span>
            <InputSelect @bind-Value="_form.Month">
                @for (var m = 1; m <= 12; m++)
                {
                    <option value="@m">@System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(m) (@m.ToString("D2"))</option>
                }
            </InputSelect>
        </label>
        <label>
            <span>@(IsArabic ? "السبب (اختياري لكن مستحسن)" : "Reason (optional but recommended)")</span>
            <InputText @bind-Value="_form.Reason" placeholder="@(IsArabic ? "مثال: الإقرار قُدِّم لمايو 2026" : "e.g. VAT return filed for May 2026")" />
        </label>

        <button type="submit">@(IsArabic ? "قفل الفترة" : "Lock period")</button>
    </EditForm>
</section>

@code {
    private List<TaxPeriod>? _periods;
    private FormModel _form = new();
    private string? _flash;
    private string _flashClass = "flash-success";
    private PeriodLockReadinessDecision? _blockedDecision;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _periods = await Db.Set<TaxPeriod>()
            .AsNoTracking()
            .OrderByDescending(p => p.Year)
            .ThenByDescending(p => p.MonthOrQuarter)
            .Take(100)
            .ToListAsync();
    }

    private async Task OnLockAsync()
    {
        _blockedDecision = null;
        try
        {
            var operatorUserId = await ResolveOperatorIdAsync();
            await PeriodHandler.HandleAsync(new LockTaxPeriodCommand(
                TaxPeriodKind.VatMonth, _form.Year, _form.Month,
                operatorUserId, string.IsNullOrWhiteSpace(_form.Reason) ? null : _form.Reason),
                CancellationToken.None);

            _flash = IsArabic
                ? $"تم قفل فترة الضريبة {_form.Year}-{_form.Month:D2}."
                : $"Locked VAT period {_form.Year}-{_form.Month:D2}.";
            _flashClass = "flash-success";
            _form = new FormModel();
            await ReloadAsync();
        }
        catch (PeriodLockBlockedException ex)
        {
            _blockedDecision = ex.Decision;
            _flash = IsArabic
                ? "القفل مرفوض من قمرة الإقفال — افتح /cockpit لمعالجة المشاكل."
                : "Lock refused by the closing-cockpit gate — open /cockpit to resolve.";
            _flashClass = "flash-error";
        }
        catch (Exception ex)
        {
            _flash = ex.Message;
            _flashClass = "flash-error";
        }
    }

    private async Task OnReopenAsync(TaxPeriod period)
    {
        try
        {
            var operatorUserId = await ResolveOperatorIdAsync();
            await PeriodHandler.ReopenAsync(new ReopenTaxPeriodCommand(
                period.PeriodKind, period.Year, period.MonthOrQuarter,
                operatorUserId, "Reopened from settings UI"),
                CancellationToken.None);

            _flash = IsArabic
                ? $"تم إعادة فتح {period.PeriodKind} {period.Year}-{period.MonthOrQuarter:D2}."
                : $"Reopened {period.PeriodKind} {period.Year}-{period.MonthOrQuarter:D2}.";
            _flashClass = "flash-success";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _flash = ex.Message;
            _flashClass = "flash-error";
        }
    }

    private async Task<Guid> ResolveOperatorIdAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var claim = auth.User.FindFirst("sub")?.Value
            ?? auth.User.FindFirst("userId")?.Value;
        return Guid.TryParse(claim, out var u) ? u : Guid.Empty;
    }

    private sealed class FormModel
    {
        [Range(2000, 9999)] public int Year { get; set; } = DateTime.UtcNow.Year;
        [Range(1, 12)] public int Month { get; set; } = DateTime.UtcNow.Month;
        [StringLength(500)] public string Reason { get; set; } = "";
    }
}
