@page "/settings/payment-terms"
@using System.Globalization
@using EgyptTax.Domain.MasterData
@using EgyptTax.Infrastructure.Persistence
@using EgyptTax.SharedKernel
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@attribute [Authorize(Policy = "NotSalesRepOnly")]

<PageTitle>@Tr("شروط الدفع | DaftarX", "Payment Terms | DaftarX")</PageTitle>

<SettingsTabStrip Group="tax-setup" />

<h1>@Tr("شروط الدفع وخصم السداد المبكر", "Payment terms & early-settlement discounts")</h1>
<p class="page-subtitle">
    @Tr(
        "v5 E.8 — عرّف الشروط مرة (مثلاً «صافي 30» أو «2/10 صافي 30») وخليها متاحة للاختيار على كل فاتورة. لما عميل يدفع داخل نافذة الخصم، السند بيخصم النسبة لحساب «خصومات مكتسبة».",
        "v5 E.8 — define each term once (e.g. Net 30 or 2/10 Net 30) and pick from the dropdown on each invoice. If a customer pays inside the discount window, the receipt voucher routes the percentage to a Discount Given account.")
</p>

@if (_flash is not null)
{
    <div class="@_flashClass">@_flash</div>
}

@if (_loading)
{
    <p>@Tr("جارٍ التحميل…", "Loading…")</p>
    return;
}

@if (_terms.Count > 0)
{
    <div class="list-stats">
        <div class="list-stat">
            <span class="list-stat-label">@Tr("إجمالي الشروط", "Total terms")</span>
            <span class="list-stat-value">@_terms.Count</span>
        </div>
        <div class="list-stat">
            <span class="list-stat-label">@Tr("نشطة", "Active")</span>
            <span class="list-stat-value is-success">@_terms.Count(t => t.IsActive)</span>
        </div>
        <div class="list-stat">
            <span class="list-stat-label">@Tr("بها خصم", "With discount")</span>
            <span class="list-stat-value is-gold">@_terms.Count(t => t.DiscountPercent > 0m)</span>
        </div>
    </div>
}

<section class="invoice-toolbar">
    <button type="button" class="btn-primary" @onclick="StartCreate" disabled="@_editing">
        + @Tr("شرط جديد", "New term")
    </button>
</section>

@if (_editing)
{
    <section class="form-grid" style="margin-top:16px;max-width:720px;">
        <h2 style="margin:0 0 12px;">@(_editingId is null
            ? Tr("شرط جديد", "New term")
            : Tr("تعديل الشرط", "Edit term"))</h2>

        <label>
            <span>@Tr("الاسم (عربي)", "Name (Arabic)")</span>
            <input type="text" @bind="_form.NameAr" placeholder="@Tr("مثال: صافي 30", "e.g. صافي 30")" />
        </label>
        <label>
            <span>@Tr("الاسم (إنجليزي)", "Name (English)")</span>
            <input type="text" @bind="_form.NameEn" placeholder="@Tr("مثال: Net 30", "e.g. Net 30")" />
        </label>
        <label>
            <span>@Tr("صافي خلال (يوم)", "Net (days)")</span>
            <input type="number" min="0" max="365" @bind="_form.NetDays" />
        </label>
        <label>
            <span>@Tr("نسبة الخصم %", "Discount %")</span>
            <input type="number" step="0.01" min="0" max="100" @bind="_form.DiscountPercent" />
        </label>
        <label>
            <span>@Tr("نافذة الخصم (يوم)", "Discount window (days)")</span>
            <input type="number" min="0" max="365" @bind="_form.DiscountWindowDays" />
        </label>
        <label style="display:flex;align-items:center;gap:8px;">
            <input type="checkbox" @bind="_form.IsDefault" style="width:auto;" />
            <span>@Tr("الشرط الافتراضي (واحد فقط)", "Default term (only one can be default)")</span>
        </label>

        <p style="font-size:13px;color:var(--text-muted);">
            @if (_form.DiscountPercent > 0m && _form.DiscountWindowDays > 0)
            {
                <text>@Tr(
                    $"الترجمة: لو العميل دفع خلال {_form.DiscountWindowDays} يوم، يحصل خصم {_form.DiscountPercent:0.##}%. الموعد النهائي للسداد بدون خصم هو {_form.NetDays} يوم من تاريخ الفاتورة.",
                    $"Reads as: if paid within {_form.DiscountWindowDays}d, customer earns a {_form.DiscountPercent:0.##}% discount. Full payment due in {_form.NetDays}d.")</text>
            }
            else
            {
                <text>@Tr(
                    $"الترجمة: السداد مستحق خلال {_form.NetDays} يوم — لا يوجد خصم سداد مبكر.",
                    $"Reads as: payment due in {_form.NetDays}d, no early-pay discount.")</text>
            }
        </p>

        <div class="invoice-actions" style="margin-top:16px;">
            <button type="button" class="btn-primary" @onclick="SaveAsync" disabled="@_saving">
                @(_saving ? Tr("جارٍ الحفظ…", "Saving…") : Tr("حفظ", "Save"))
            </button>
            <button type="button" class="btn-secondary" @onclick="CancelEdit">
                @Tr("إلغاء", "Cancel")
            </button>
        </div>
    </section>
}

@if (!_editing && _terms.Count > 0)
{
    <table class="data-grid" style="margin-top:16px;">
        <thead>
            <tr>
                <th>@Tr("الاسم", "Name")</th>
                <th class="num">@Tr("صافي", "Net (d)")</th>
                <th class="num">@Tr("الخصم %", "Discount %")</th>
                <th class="num">@Tr("نافذة الخصم", "Window (d)")</th>
                <th>@Tr("الترجمة", "Reads as")</th>
                <th>@Tr("الحالة", "Status")</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in _terms)
            {
                <tr class="@(t.IsActive ? "" : "row-muted")">
                    <td>
                        <strong>@(IsArabic ? t.Name.Arabic : t.Name.English)</strong>
                        @if (t.IsDefault)
                        {
                            <span class="state-badge state-approved" style="margin-inline-start:8px;">@Tr("افتراضي", "Default")</span>
                        }
                    </td>
                    <td class="num">@t.NetDays</td>
                    <td class="num">@(t.DiscountPercent > 0 ? t.DiscountPercent.ToString("0.##") + "%" : "—")</td>
                    <td class="num">@(t.DiscountWindowDays > 0 ? t.DiscountWindowDays.ToString() : "—")</td>
                    <td style="font-size:12.5px;color:var(--text-muted);">
                        @if (t.DiscountPercent > 0)
                        {
                            <text>@(IsArabic
                                ? $"{t.DiscountPercent:0.##}/{t.DiscountWindowDays} صافي {t.NetDays}"
                                : $"{t.DiscountPercent:0.##}/{t.DiscountWindowDays} Net {t.NetDays}")</text>
                        }
                        else
                        {
                            <text>@(IsArabic ? $"صافي {t.NetDays}" : $"Net {t.NetDays}")</text>
                        }
                    </td>
                    <td>
                        @if (t.IsActive)
                        {
                            <span class="state-badge state-approved">@Tr("نشط", "Active")</span>
                        }
                        else
                        {
                            <span class="state-badge state-voided">@Tr("موقوف", "Inactive")</span>
                        }
                    </td>
                    <td>
                        <button type="button" @onclick="@(() => StartEdit(t))">@Tr("تعديل", "Edit")</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else if (!_editing)
{
    <p style="padding:32px 0;text-align:center;color:var(--text-muted);">
        <em>@Tr("لا توجد شروط دفع بعد. ابدأ بإنشاء «صافي 30» كقالب افتراضي.",
            "No payment terms yet. Start by creating \"Net 30\" as the default.")</em>
    </p>
}

@code {
    private bool IsArabic =>
        CultureInfo.CurrentCulture.Name.StartsWith("ar", StringComparison.OrdinalIgnoreCase);
    private string Tr(string ar, string en) => IsArabic ? ar : en;

    private bool _loading = true;
    private bool _editing;
    private bool _saving;
    private Guid? _editingId;
    private FormModel _form = new();
    private List<PaymentTerm> _terms = new();
    private string? _flash;
    private string _flashClass = "flash-success";

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _terms = await db.Set<PaymentTerm>().AsNoTracking()
            .OrderByDescending(t => t.IsDefault)
            .ThenByDescending(t => t.IsActive)
            .ThenBy(t => t.NetDays)
            .ToListAsync();
        _loading = false;
    }

    private void StartCreate()
    {
        _editingId = null;
        _form = new FormModel { NetDays = 30 };
        _editing = true;
        _flash = null;
    }

    private void StartEdit(PaymentTerm t)
    {
        _editingId = t.Id;
        _form = new FormModel
        {
            NameAr = t.Name.Arabic,
            NameEn = t.Name.English,
            NetDays = t.NetDays,
            DiscountPercent = t.DiscountPercent,
            DiscountWindowDays = t.DiscountWindowDays,
            IsDefault = t.IsDefault,
        };
        _editing = true;
        _flash = null;
    }

    private void CancelEdit()
    {
        _editing = false;
        _editingId = null;
    }

    private async Task SaveAsync()
    {
        _flash = null;
        if (string.IsNullOrWhiteSpace(_form.NameAr) || string.IsNullOrWhiteSpace(_form.NameEn))
        {
            _flash = Tr("الاسم بالعربي والإنجليزي مطلوب.", "Both Arabic and English names required.");
            _flashClass = "flash-error";
            return;
        }

        _saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            PaymentTerm term;
            if (_editingId is { } id)
            {
                term = await db.Set<PaymentTerm>().FirstAsync(t => t.Id == id);
                term.Update(
                    new ArabicEnglishText(_form.NameAr, _form.NameEn),
                    _form.NetDays,
                    _form.DiscountPercent,
                    _form.DiscountWindowDays,
                    _form.IsDefault);
            }
            else
            {
                term = new PaymentTerm(
                    new ArabicEnglishText(_form.NameAr, _form.NameEn),
                    _form.NetDays,
                    _form.DiscountPercent,
                    _form.DiscountWindowDays,
                    _form.IsDefault,
                    DateTime.UtcNow);
                db.Add(term);
            }

            // Enforce single-default rule: if this term is the new default,
            // unmark every other term.
            if (_form.IsDefault)
            {
                var others = await db.Set<PaymentTerm>()
                    .Where(t => t.IsDefault && t.Id != term.Id)
                    .ToListAsync();
                foreach (var o in others) o.UnmarkDefault();
            }

            await db.SaveChangesAsync();
            _flash = Tr("تم الحفظ.", "Saved.");
            _flashClass = "flash-success";
            _editing = false;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _flash = ex.Message;
            _flashClass = "flash-error";
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed class FormModel
    {
        public string NameAr { get; set; } = "";
        public string NameEn { get; set; } = "";
        public int NetDays { get; set; } = 30;
        public decimal DiscountPercent { get; set; }
        public int DiscountWindowDays { get; set; }
        public bool IsDefault { get; set; }
    }
}
