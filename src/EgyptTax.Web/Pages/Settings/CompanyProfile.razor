@page "/settings/company"
@using System.ComponentModel.DataAnnotations
@using EgyptTax.Domain.MasterData
@using EgyptTax.Infrastructure.Persistence
@using EgyptTax.SharedKernel
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@attribute [Authorize(Policy = "FullyAuthenticated")]

<h1>@(IsArabic ? "بيانات الشركة" : "Company profile")</h1>
<p>@(IsArabic ? "وفقاً لـ FR-005، صف الشركة الوحيد يتحكم في بلوك المُصدر على كل فاتورة قانونية وكل إرسال للفاتورة الإلكترونية." : "Per FR-005, the single-tenant Company row drives the issuer block on every legal invoice and ETA submission.")</p>

@if (_savedFlash)
{
    <div class="flash-success" role="status">@(IsArabic ? "تم الحفظ." : "Saved.")</div>
}

<EditForm Model="_form" OnValidSubmit="OnSaveAsync" FormName="company-profile" class="form-grid">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <fieldset>
        <legend>@(IsArabic ? "الهوية" : "Identity")</legend>
        <label>
            <span>@(IsArabic ? "الاسم القانوني (إنجليزي)" : "Legal name (English)")</span>
            <InputText @bind-Value="_form.LegalNameEnglish" />
        </label>
        <label>
            <span>@(IsArabic ? "الاسم القانوني (عربي)" : "Legal name (Arabic)")</span>
            <InputText @bind-Value="_form.LegalNameArabic" />
        </label>
        <label>
            <span>@(IsArabic ? "الرقم الضريبي (9 أرقام)" : "Tax registration number (TIN, 9 digits)")</span>
            <InputText @bind-Value="_form.TaxRegistrationNumber" />
        </label>
        <label>
            <span>@(IsArabic ? "رقم السجل التجاري" : "Commercial registration number")</span>
            <InputText @bind-Value="_form.CommercialRegistrationNumber" />
        </label>
        <label>
            <span>@(IsArabic ? "كود نشاط الممول (الفاتورة الإلكترونية)" : "Taxpayer activity code (ETA)")</span>
            <InputText @bind-Value="_form.TaxpayerActivityCode" />
        </label>
        <label>
            <span>@(IsArabic ? "اللغة الافتراضية" : "Default language")</span>
            <InputSelect @bind-Value="_form.DefaultLanguage">
                <option value="@Language.Ar">العربية</option>
                <option value="@Language.En">English</option>
            </InputSelect>
        </label>
        <label>
            <span>@(IsArabic ? "شهر بداية السنة المالية (1–12)" : "Fiscal-year start month (1–12)")</span>
            <InputNumber @bind-Value="_form.FiscalYearStartMonth" min="1" max="12" />
        </label>
        <label>
            <span>@(IsArabic ? "النظام الضريبي" : "Tax regime")</span>
            <InputSelect @bind-Value="_form.TaxRegime">
                <option value="@TaxRegime.Standard">@(IsArabic ? "النظام القياسي (VAT شهري + ضريبة دخل كاملة)" : "Standard (monthly VAT + full income tax)")</option>
                <option value="@TaxRegime.Law6Simplified">@(IsArabic ? "النظام المبسّط — قانون 6/2025 (VAT ربع سنوي + ضريبة معدل دوران)" : "Simplified — Law 6/2025 (quarterly VAT + turnover tax)")</option>
            </InputSelect>
        </label>
        @if (_form.TaxRegime == TaxRegime.Law6Simplified)
        {
            <p style="font-size:13px;color:var(--text-muted);margin:0;">
                @(IsArabic
                    ? "تذكير: النظام المبسّط متاح فقط للمنشآت تحت 15 مليون ج.م. سنوياً. شوف /reports/turnover-tax للتقدير."
                    : "Reminder: simplified regime is only for enterprises under EGP 15M annual revenue. See /reports/turnover-tax for an estimate.")
            </p>
        }
    </fieldset>

    <fieldset>
        <legend>@(IsArabic ? "العنوان" : "Address")</legend>
        <label>
            <span>@(IsArabic ? "العرض (إنجليزي)" : "Display (English)")</span>
            <InputText @bind-Value="_form.AddressDisplayEnglish" />
        </label>
        <label>
            <span>@(IsArabic ? "العرض (عربي)" : "Display (Arabic)")</span>
            <InputText @bind-Value="_form.AddressDisplayArabic" />
        </label>
        <label>
            <span>@(IsArabic ? "المحافظة" : "Governorate")</span>
            <InputText @bind-Value="_form.AddressGovernorate" />
        </label>
        <label>
            <span>@(IsArabic ? "المنطقة / المدينة" : "Region / city")</span>
            <InputText @bind-Value="_form.AddressRegionCity" />
        </label>
        <label>
            <span>@(IsArabic ? "الشارع" : "Street")</span>
            <InputText @bind-Value="_form.AddressStreet" />
        </label>
        <label>
            <span>@(IsArabic ? "رقم العقار" : "Building number")</span>
            <InputText @bind-Value="_form.AddressBuildingNumber" />
        </label>
        <label>
            <span>@(IsArabic ? "الرقم البريدي (اختياري)" : "Postal code (optional)")</span>
            <InputText @bind-Value="_form.AddressPostalCode" />
        </label>
    </fieldset>

    <button type="submit">@(IsArabic ? "حفظ" : "Save")</button>
</EditForm>

@code {
    private FormModel _form = new();
    private Company? _existing;
    private bool _savedFlash;

    protected override async Task OnInitializedAsync()
    {
        _existing = await Db.Set<Company>().FirstOrDefaultAsync();
        if (_existing is not null)
        {
            _form = FormModel.FromEntity(_existing);
        }
    }

    private async Task OnSaveAsync()
    {
        var address = PostalAddress.Create(
            display: new ArabicEnglishText(_form.AddressDisplayArabic, _form.AddressDisplayEnglish),
            governorate: _form.AddressGovernorate,
            regionCity: _form.AddressRegionCity,
            street: _form.AddressStreet,
            buildingNumber: _form.AddressBuildingNumber,
            postalCode: string.IsNullOrWhiteSpace(_form.AddressPostalCode) ? null : _form.AddressPostalCode);

        if (_existing is null)
        {
            var company = new Company(
                legalName: new ArabicEnglishText(_form.LegalNameArabic, _form.LegalNameEnglish),
                taxRegistrationNumber: EgyptianTin.Parse(_form.TaxRegistrationNumber),
                commercialRegistrationNumber: _form.CommercialRegistrationNumber,
                address: address,
                taxpayerActivityCode: _form.TaxpayerActivityCode,
                fiscalYearStartMonth: _form.FiscalYearStartMonth,
                defaultLanguage: _form.DefaultLanguage);
            Db.Add(company);
            _existing = company;
        }
        else
        {
            _existing.UpdateAddress(address);
            _existing.UpdateTaxpayerActivityCode(_form.TaxpayerActivityCode);
            _existing.UpdateTaxRegime(_form.TaxRegime);
        }

        await Db.SaveChangesAsync();
        _savedFlash = true;
    }

    private sealed class FormModel
    {
        [Required, StringLength(200)] public string LegalNameEnglish { get; set; } = "";
        [Required, StringLength(200)] public string LegalNameArabic  { get; set; } = "";
        [Required, RegularExpression(@"^\d{9}$", ErrorMessage = "TIN must be exactly 9 digits.")]
        public string TaxRegistrationNumber { get; set; } = "";
        [Required, StringLength(32)] public string CommercialRegistrationNumber { get; set; } = "";
        [Required, StringLength(16)] public string TaxpayerActivityCode { get; set; } = "0001";
        [Range(1, 12)] public int FiscalYearStartMonth { get; set; } = 1;
        public Language DefaultLanguage { get; set; } = Language.Ar;
        public TaxRegime TaxRegime { get; set; } = TaxRegime.Standard;

        [Required, StringLength(500)] public string AddressDisplayEnglish { get; set; } = "";
        [Required, StringLength(500)] public string AddressDisplayArabic  { get; set; } = "";
        [Required, StringLength(100)] public string AddressGovernorate    { get; set; } = "";
        [Required, StringLength(100)] public string AddressRegionCity     { get; set; } = "";
        [Required, StringLength(200)] public string AddressStreet         { get; set; } = "";
        [Required, StringLength(32)]  public string AddressBuildingNumber { get; set; } = "";
        [StringLength(16)]            public string AddressPostalCode    { get; set; } = "";

        public static FormModel FromEntity(Company c) => new()
        {
            LegalNameEnglish = c.LegalName.English,
            LegalNameArabic  = c.LegalName.Arabic,
            TaxRegistrationNumber = c.TaxRegistrationNumber,
            CommercialRegistrationNumber = c.CommercialRegistrationNumber,
            TaxpayerActivityCode = c.TaxpayerActivityCode,
            FiscalYearStartMonth = c.FiscalYearStartMonth,
            DefaultLanguage = c.DefaultLanguage,
            TaxRegime = c.TaxRegime,
            AddressDisplayEnglish = c.Address.DisplayEnglish,
            AddressDisplayArabic  = c.Address.DisplayArabic,
            AddressGovernorate    = c.Address.Governorate,
            AddressRegionCity     = c.Address.RegionCity,
            AddressStreet         = c.Address.Street,
            AddressBuildingNumber = c.Address.BuildingNumber,
            AddressPostalCode     = c.Address.PostalCode ?? "",
        };
    }
}
