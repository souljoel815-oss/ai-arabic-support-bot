@page "/settings/expense-categories"
@using System.ComponentModel.DataAnnotations
@using EgyptTax.Domain.MasterData
@using EgyptTax.Infrastructure.Persistence
@using EgyptTax.SharedKernel
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@attribute [Authorize(Policy = "NotSalesRepOnly")]

<h1>@(IsArabic ? "فئات المصروفات القابلة للخصم (FR-015)" : "Deductible expense categories (FR-015)")</h1>

<p>
    <em>
        @(IsArabic
            ? "بتتحكم في علامة قابل للخصم الافتراضية على مستندات المصروفات. المشغّل يقدر يغيّرها لكل بند، والتغيير بيتسجّل في سجل التدقيق (FR-027). تعديل القيم الافتراضية بالأسفل لا يؤثر بأثر رجعي على بنود المصروفات المرحّلة — العلامة على البنود المرحّلة مجمّدة وقت الترحيل. المصروفات الجديدة اللي تتعمل بعد التعديل بس بتاخد القيمة الافتراضية الجديدة."
            : "Drives the default deductible flag on Expense documents. The operator can override per-line; the override is recorded in the audit log (FR-027). Editing the defaults below does NOT retroactively affect already-posted expense rows — the posted-row's flag is frozen at post time. Only NEW expenses created after the edit pick up the new default.")
    </em>
</p>

@if (_savedFlash is not null)
{
    <div class="flash-success" role="status">@_savedFlash</div>
}
@if (_error is not null)
{
    <div class="flash-error" role="alert">@_error</div>
}

@if (_categories is null)
{
    <p>@(IsArabic ? "جارٍ التحميل…" : "Loading…")</p>
}
else if (_categories.Count == 0)
{
    <p>
        <em>
            @(IsArabic
                ? "لا توجد فئات بعد. أضف الفئات اللي شركتك بتستخدمها بالأسفل."
                : "No categories yet. Add the ones your business uses below.")
        </em>
    </p>
}
else
{
    <table class="data-grid">
        <thead>
            <tr>
                <th>@(IsArabic ? "الكود" : "Code")</th>
                <th>@(IsArabic ? "الاسم (إنجليزي)" : "Name (English)")</th>
                <th>@(IsArabic ? "الاسم (عربي)" : "Name (Arabic)")</th>
                <th>@(IsArabic ? "قابل للخصم افتراضياً؟" : "Default deductible?")</th>
                <th>@(IsArabic ? "رقم الحساب الافتراضي" : "Default account id")</th>
                <th>@(IsArabic ? "الحالة" : "Status")</th>
                <th>@(IsArabic ? "إجراءات" : "Actions")</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in _categories)
            {
                <tr class="@(c.Status == DeductibleExpenseCategoryStatus.Inactive ? "row-muted" : "active-row")">
                    @if (_editingId == c.Id)
                    {
                        <td><code>@c.Code</code></td>
                        <td>@c.Name.English</td>
                        <td>@c.Name.Arabic</td>
                        <td>
                            <select @bind="_editDeductible">
                                <option value="true">@(IsArabic ? "نعم" : "yes")</option>
                                <option value="false">@(IsArabic ? "لا" : "no")</option>
                            </select>
                        </td>
                        <td>
                            <input type="text" @bind="_editAccountId" style="width: 22rem;" />
                        </td>
                        <td>@c.Status</td>
                        <td>
                            <button type="button" class="btn-primary"
                                @onclick="() => SaveEditAsync(c.Id)">@(IsArabic ? "حفظ" : "Save")</button>
                            <button type="button" @onclick="CancelEdit">@(IsArabic ? "إلغاء" : "Cancel")</button>
                        </td>
                    }
                    else
                    {
                        <td><code>@c.Code</code></td>
                        <td>@c.Name.English</td>
                        <td>@c.Name.Arabic</td>
                        <td>@(c.DefaultDeductible ? (IsArabic ? "نعم" : "yes") : (IsArabic ? "لا" : "no"))</td>
                        <td><code>@c.DefaultAccountId.ToString("D")</code></td>
                        <td>@c.Status</td>
                        <td>
                            <button type="button" @onclick="() => BeginEdit(c)">@(IsArabic ? "تعديل القيم الافتراضية" : "Edit defaults")</button>
                            @if (c.Status == DeductibleExpenseCategoryStatus.Active)
                            {
                                <button type="button" @onclick="() => DeactivateAsync(c.Id)">@(IsArabic ? "تعطيل" : "Deactivate")</button>
                            }
                            else
                            {
                                <button type="button" @onclick="() => ReactivateAsync(c.Id)">@(IsArabic ? "إعادة تفعيل" : "Reactivate")</button>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}

<h2>@(IsArabic ? "+ إضافة فئة" : "+ Add a category")</h2>
<EditForm Model="_form" OnValidSubmit="OnCreateAsync" FormName="settings-expense-category-create" class="form-grid">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <label>
        <span>@(IsArabic ? "الكود" : "Code")</span>
        <InputText @bind-Value="_form.Code" />
    </label>
    <label>
        <span>@(IsArabic ? "الاسم (إنجليزي)" : "Name (English)")</span>
        <InputText @bind-Value="_form.NameEnglish" />
    </label>
    <label>
        <span>@(IsArabic ? "الاسم (عربي)" : "Name (Arabic)")</span>
        <InputText @bind-Value="_form.NameArabic" />
    </label>
    <label>
        <span>@(IsArabic ? "قابل للخصم افتراضياً" : "Default deductible")</span>
        <InputCheckbox @bind-Value="_form.DefaultDeductible" />
    </label>
    <label>
        <span>@(IsArabic ? "رقم الحساب الافتراضي" : "Default account id")</span>
        <InputText @bind-Value="_form.DefaultAccountId" />
    </label>

    <button type="submit" class="btn-primary">@(IsArabic ? "إضافة فئة" : "Add category")</button>
</EditForm>

@code {
    private List<DeductibleExpenseCategory>? _categories;
    private FormModel _form = new();
    private string? _savedFlash;
    private string? _error;

    private Guid? _editingId;
    private bool _editDeductible;
    private string _editAccountId = "";

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _categories = await Db.Set<DeductibleExpenseCategory>()
            .AsNoTracking().OrderBy(c => c.Code).ToListAsync();
    }

    private async Task OnCreateAsync()
    {
        _error = null;
        if (!Guid.TryParse(_form.DefaultAccountId, out var accountId))
        {
            _error = IsArabic ? "رقم الحساب الافتراضي يجب أن يكون Guid صالح." : "Default account id must be a valid Guid.";
            return;
        }

        try
        {
            var category = new DeductibleExpenseCategory(
                code: _form.Code,
                name: new ArabicEnglishText(_form.NameArabic, _form.NameEnglish),
                defaultDeductible: _form.DefaultDeductible,
                defaultAccountId: accountId);
            Db.Add(category);
            await Db.SaveChangesAsync();

            _form = new FormModel();
            _savedFlash = IsArabic ? $"تمت إضافة فئة المصروفات {category.Code}." : $"Expense category {category.Code} added.";
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void BeginEdit(DeductibleExpenseCategory c)
    {
        _editingId = c.Id;
        _editDeductible = c.DefaultDeductible;
        _editAccountId = c.DefaultAccountId.ToString("D");
        _savedFlash = null; _error = null;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _editAccountId = "";
    }

    private async Task SaveEditAsync(Guid id)
    {
        _error = null;
        if (!Guid.TryParse(_editAccountId, out var accountId))
        {
            _error = IsArabic ? "رقم الحساب الافتراضي يجب أن يكون Guid صالح." : "Default account id must be a valid Guid.";
            return;
        }

        var c = await Db.Set<DeductibleExpenseCategory>().FirstAsync(x => x.Id == id);
        c.UpdateDefaults(deductible: _editDeductible, accountId: accountId);
        await Db.SaveChangesAsync();

        _savedFlash = IsArabic
            ? $"تم تحديث القيم الافتراضية للفئة {c.Code}. بنود المصروفات المرحّلة لم تتأثر."
            : $"Category {c.Code} defaults updated. Already-posted expense rows are unchanged.";
        _editingId = null;
        await ReloadAsync();
    }

    private async Task DeactivateAsync(Guid id)
    {
        var c = await Db.Set<DeductibleExpenseCategory>().FirstAsync(x => x.Id == id);
        c.Deactivate();
        await Db.SaveChangesAsync();
        _savedFlash = IsArabic
            ? $"تم تعطيل الفئة {c.Code}. بنود المصروفات المرحّلة المستندة إليها تظل قابلة للقراءة."
            : $"Category {c.Code} deactivated. Posted expense rows referencing it remain readable.";
        await ReloadAsync();
    }

    private async Task ReactivateAsync(Guid id)
    {
        var c = await Db.Set<DeductibleExpenseCategory>().FirstAsync(x => x.Id == id);
        c.Reactivate();
        await Db.SaveChangesAsync();
        _savedFlash = IsArabic ? $"تم إعادة تفعيل الفئة {c.Code}." : $"Category {c.Code} reactivated.";
        await ReloadAsync();
    }

    private sealed class FormModel
    {
        [Required, StringLength(32)] public string Code { get; set; } = "";
        [Required, StringLength(200)] public string NameEnglish { get; set; } = "";
        [Required, StringLength(200)] public string NameArabic { get; set; } = "";
        public bool DefaultDeductible { get; set; } = true;
        [Required] public string DefaultAccountId { get; set; } = Guid.Empty.ToString("D");
    }
}
