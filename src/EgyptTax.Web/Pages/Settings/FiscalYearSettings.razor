@page "/settings/fiscal-year"
@using EgyptTax.Domain.MasterData
@using EgyptTax.Domain.Periods
@using EgyptTax.Infrastructure.Persistence
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@attribute [Authorize(Policy = "NotSalesRepOnly")]

<h1>@(IsArabic ? "إعدادات السنة المالية (للقراءة فقط)" : "Fiscal year settings (read-only)")</h1>

<p>
    <em>
        @(IsArabic
            ? "إعدادات السنة المالية بتتحكم في حدود فترة الإقرار الضريبي السنوي، ومنطق أول/آخر شهر في وظيفة الإهلاك الشهرية، وتطبيق قفل الفترات (FR-037). الـ MVP بيعرض شهر البداية في صفحة بيانات الشركة. الصفحة دي بتعرض الإعدادات المُحَلّة + حالة (مفتوح/مقفول) للسنوات المالية السابقة."
            : "Fiscal-year configuration drives the income-tax return period boundaries, the monthly depreciation job's first/last-month logic, and the period-locking enforcement (FR-037). The MVP exposes the start-month on the Company profile page; this page surfaces the resolved settings + the open/locked status of recent income-fiscal-year periods.")
    </em>
</p>

@if (_company is null)
{
    <p>@(IsArabic ? "جارٍ التحميل…" : "Loading…")</p>
    return;
}

<section class="master-data-list">
    <h2>@(IsArabic ? "التقويم المالي النشط" : "Active fiscal calendar")</h2>
    <table class="data-grid">
        <tbody>
            <tr>
                <th>@(IsArabic ? "شهر بداية السنة المالية" : "Fiscal-year start month")</th>
                <td>@_company.FiscalYearStartMonth (@MonthName(_company.FiscalYearStartMonth))</td>
            </tr>
            <tr>
                <th>@(IsArabic ? "العملة الافتراضية" : "Default currency")</th>
                <td>@_company.DefaultCurrency</td>
            </tr>
            <tr>
                <th>@(IsArabic ? "اللغة الافتراضية" : "Default language")</th>
                <td>@_company.DefaultLanguage</td>
            </tr>
        </tbody>
    </table>
    <p>
        <a href="/settings/company" class="btn-secondary">@(IsArabic ? "تعديل من بيانات الشركة ←" : "Edit on company profile →")</a>
    </p>
</section>

<section class="master-data-list">
    <h2>@(IsArabic ? "فترات السنوات المالية (FR-037)" : "Income-fiscal-year periods (FR-037)")</h2>
    @if (_periods.Count == 0)
    {
        <p><em>@(IsArabic ? "لا توجد فترات سنوات مالية مسجلة بعد." : "No income-fiscal-year periods recorded yet.")</em></p>
    }
    else
    {
        <table class="data-grid">
            <thead>
                <tr>
                    <th>@(IsArabic ? "السنة" : "Year")</th>
                    <th>@(IsArabic ? "الحالة" : "Status")</th>
                    <th>@(IsArabic ? "وقت القفل (UTC)" : "Locked at (UTC)")</th>
                    <th>@(IsArabic ? "بواسطة" : "Locked by")</th>
                    <th>@(IsArabic ? "السبب" : "Locked reason")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in _periods)
                {
                    <tr class="@(p.Status == TaxPeriodStatus.Locked ? "row-muted" : "active-row")">
                        <td>@p.Year</td>
                        <td>@p.Status</td>
                        <td>@(p.LockedAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                        <td>@(p.LockedByUserId?.ToString("D") ?? "—")</td>
                        <td>@(p.LockedReason ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
        <p>
            <a href="/settings/tax-periods" class="btn-secondary">@(IsArabic ? "قفل / إعادة فتح فترات ←" : "Lock / reopen periods →")</a>
        </p>
    }
</section>

@code {
    private Company? _company;
    private List<TaxPeriod> _periods = new();

    protected override async Task OnInitializedAsync()
    {
        _company = await Db.Set<Company>().AsNoTracking().FirstOrDefaultAsync();
        _periods = await Db.Set<TaxPeriod>().AsNoTracking()
            .Where(p => p.PeriodKind == TaxPeriodKind.IncomeFiscalYear)
            .OrderByDescending(p => p.Year)
            .ToListAsync();
    }

    private string MonthName(int m) => IsArabic
        ? m switch
        {
            1 => "يناير", 2 => "فبراير", 3 => "مارس", 4 => "أبريل",
            5 => "مايو", 6 => "يونيو", 7 => "يوليو", 8 => "أغسطس",
            9 => "سبتمبر", 10 => "أكتوبر", 11 => "نوفمبر", 12 => "ديسمبر",
            _ => $"الشهر {m}",
        }
        : m switch
        {
            1 => "January", 2 => "February", 3 => "March", 4 => "April",
            5 => "May", 6 => "June", 7 => "July", 8 => "August",
            9 => "September", 10 => "October", 11 => "November", 12 => "December",
            _ => $"Month {m}",
        };
}
