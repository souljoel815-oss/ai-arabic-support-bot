@page "/settings/vat-categories"
@using EgyptTax.Application.Configuration
@using EgyptTax.Domain.MasterData
@using EgyptTax.Infrastructure.Persistence
@using EgyptTax.SharedKernel
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject IVatRateLookup VatLookup
@attribute [Authorize(Policy = "FullyAuthenticated")]

<h1>@(IsArabic ? "فئات ضريبة القيمة المضافة" : "VAT categories (FR-019 / FR-022)")</h1>

<p>
    <em>
        @(IsArabic
            ? "جدول معدلات بتواريخ سريان. لتغيير معدل، أضف صفاً جديداً بنفس الكود وتاريخ سريان جديد — الصفوف القديمة بتفضل عشان الفواتير القديمة تحسب بالمعدل اللي كان ساري وقت تاريخها. فحص التداخل بالأسفل بيكشف الأخطاء (صفّين مغطيين نفس التاريخ) عشان تحلها قبل ما ترحّل مستندات بمعدل غامض."
            : "Effective-from-dated rate table. Supersede a code by inserting a new row with a later effective from — old rows stay so historical invoices keep computing against the rate in force on their document date. The overlap check below flags configuration mistakes (two rows whose effective windows cover the same date) so the operator can resolve them before posting docs at an ambiguous rate.")
    </em>
</p>

@if (_rows is null)
{
    <p>@(IsArabic ? "جارٍ التحميل…" : "Loading…")</p>
    return;
}

@if (_overlaps.Count > 0)
{
    <div class="flash-error" role="alert">
        <strong>@(IsArabic ? "تم اكتشاف نوافذ سريان متداخلة:" : "Overlapping effective windows detected:")</strong>
        <ul>
            @foreach (var ov in _overlaps)
            {
                <li>
                    @(IsArabic ? "الكود" : "Code") <code>@ov.Code</code> — @(IsArabic ? "الصفوف" : "rows")
                    <code>@ov.Left.ToString("yyyy-MM-dd")</code> @(IsArabic ? "و" : "and")
                    <code>@ov.Right.ToString("yyyy-MM-dd")</code>
                    @(IsArabic
                        ? "متداخلة. قيّد الأقدم منهم بـ تاريخ نهاية سريان قبل تاريخ بداية الصف الأحدث."
                        : "overlap. Cap the older one with an effective to date strictly before the newer row's effective from.")
                </li>
            }
        </ul>
    </div>
}

<table class="data-grid">
    <thead>
        <tr>
            <th>@(IsArabic ? "الكود" : "Code")</th>
            <th>@(IsArabic ? "الاسم (إنجليزي)" : "Name (English)")</th>
            <th>@(IsArabic ? "الاسم (عربي)" : "Name (Arabic)")</th>
            <th class="num">@(IsArabic ? "المعدل %" : "Rate %")</th>
            <th>@(IsArabic ? "بداية السريان" : "Effective from")</th>
            <th>@(IsArabic ? "نهاية السريان" : "Effective to")</th>
            <th>@(IsArabic ? "ضريبة مدخلات قابلة للاسترداد؟" : "Recoverable input?")</th>
            <th>@(IsArabic ? "نشطة اليوم؟" : "Active today?")</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in _rows)
        {
            var today = DateOnly.FromDateTime(DateTime.UtcNow.Date);
            var active = c.EffectiveFromDate <= today
                && (c.EffectiveToDate is null || c.EffectiveToDate >= today);
            <tr class="@(active ? "active-row" : "inactive-row")">
                <td><code>@c.Code</code></td>
                <td>@c.Name.English</td>
                <td>@c.Name.Arabic</td>
                <td class="num">@c.RatePercent.ToString("0.##")</td>
                <td>@c.EffectiveFromDate.ToString("yyyy-MM-dd")</td>
                <td>@(c.EffectiveToDate?.ToString("yyyy-MM-dd") ?? (IsArabic ? "(مفتوح)" : "(open)"))</td>
                <td>@(c.RecoverableInputVat ? (IsArabic ? "نعم" : "yes") : (IsArabic ? "لا" : "no"))</td>
                <td>@(active ? (IsArabic ? "نعم" : "yes") : (IsArabic ? "لا" : "no"))</td>
            </tr>
        }
    </tbody>
</table>

<h2>@(IsArabic ? "+ إضافة فئة جديدة (أو استبدال كود موجود)" : "+ Add new category (or supersede an existing code)")</h2>
<form @onsubmit="OnCreate" @onsubmit:preventDefault>
    <div class="invoice-toolbar">
        <label>
            <span>@(IsArabic ? "الكود (مثال: قياسي، مخفض، صفري، معفى)" : "Code (e.g., Standard, Reduced, ZeroRated, Exempt)")</span>
            <input type="text" @bind="_code" required />
        </label>
        <label>
            <span>@(IsArabic ? "المعدل %" : "Rate %")</span>
            <input type="number" step="0.01" min="0" max="100" @bind="_rate" required />
        </label>
        <label>
            <span>@(IsArabic ? "ضريبة مدخلات قابلة للاسترداد؟" : "Recoverable input VAT?")</span>
            <input type="checkbox" @bind="_recoverable" />
        </label>
    </div>
    <div class="invoice-toolbar">
        <label>
            <span>@(IsArabic ? "الاسم (إنجليزي)" : "Name (English)")</span>
            <input type="text" @bind="_nameEn" required />
        </label>
        <label>
            <span>@(IsArabic ? "الاسم (عربي)" : "Name (Arabic)")</span>
            <input type="text" @bind="_nameAr" required dir="rtl" />
        </label>
    </div>
    <div class="invoice-toolbar">
        <label>
            <span>@(IsArabic ? "بداية السريان" : "Effective from")</span>
            <input type="date" @bind="_effFrom" required />
        </label>
        <label>
            <span>@(IsArabic ? "نهاية السريان (اختياري — اتركه فارغ للمفتوح)" : "Effective to (optional — leave blank for open-ended)")</span>
            <input type="date" @bind="_effTo" />
        </label>
    </div>
    <p>
        <button type="submit" class="btn-primary" disabled="@_busy">
            @(_busy ? (IsArabic ? "جارٍ الحفظ…" : "Saving…") : (IsArabic ? "إضافة فئة" : "Add category"))
        </button>
    </p>
</form>

@if (_error is not null)
{
    <div class="flash-error"><strong>@(IsArabic ? "خطأ:" : "Error:")</strong> @_error</div>
}
@if (_flash is not null)
{
    <div class="flash-success" role="status">@_flash</div>
}

@code {
    private List<VatCategory>? _rows;
    private readonly List<OverlapNote> _overlaps = new();

    private string _code = "";
    private decimal _rate = 14m;
    private bool _recoverable = true;
    private string _nameEn = "";
    private string _nameAr = "";
    private DateTime _effFrom = new(DateTime.UtcNow.Year, 1, 1);
    private DateTime? _effTo;
    private bool _busy;
    private string? _error;
    private string? _flash;

    protected override async Task OnInitializedAsync() => await Refresh();

    private async Task Refresh()
    {
        _rows = await Db.Set<VatCategory>().AsNoTracking()
            .OrderBy(c => c.Code).ThenBy(c => c.EffectiveFromDate)
            .ToListAsync();

        // Overlap detection — within each code, sort by EffectiveFrom
        // and walk pairwise. An overlap exists when row[i].EffectiveTo
        // is null (open-ended) and a later row exists, OR when
        // row[i].EffectiveTo >= row[i+1].EffectiveFrom.
        _overlaps.Clear();
        foreach (var grp in _rows.GroupBy(r => r.Code))
        {
            var ordered = grp.OrderBy(r => r.EffectiveFromDate).ToList();
            for (var i = 0; i < ordered.Count - 1; i++)
            {
                var a = ordered[i];
                var b = ordered[i + 1];
                var aEnd = a.EffectiveToDate;
                if (aEnd is null || aEnd >= b.EffectiveFromDate)
                {
                    _overlaps.Add(new OverlapNote(a.Code, a.EffectiveFromDate, b.EffectiveFromDate));
                }
            }
        }
    }

    private async Task OnCreate()
    {
        _error = null; _flash = null; _busy = true;
        try
        {
            var newFrom = DateOnly.FromDateTime(_effFrom);
            var newTo = _effTo is { } d ? DateOnly.FromDateTime(d) : (DateOnly?)null;

            // Pre-validate against IVatRateLookup so the operator gets
            // a clear "this code already has an active row covering
            // newFrom" message instead of a constraint-violation
            // surprise. ListByCodeAsync returns every row for the
            // code; we only block when there's an existing row whose
            // window covers newFrom (the typical accidental dup).
            var existing = await VatLookup.ListByCodeAsync(_code);
            foreach (var ex in existing)
            {
                var exCovers = ex.EffectiveFromDate <= newFrom
                    && (ex.EffectiveToDate is null || ex.EffectiveToDate >= newFrom);
                if (exCovers)
                {
                    _error = IsArabic
                        ? $"الكود '{_code}' عنده صف نشط بالفعل بيغطي {newFrom:yyyy-MM-dd} "
                            + $"(المعدل {ex.RatePercent:0.##}%، بداية السريان {ex.EffectiveFromDate:yyyy-MM-dd}). "
                            + "قيّد هذا الصف بـ تاريخ نهاية سريان قبل تاريخ بداية الصف الجديد، ثم أضف هذا."
                        : $"Code '{_code}' already has an active row covering {newFrom:yyyy-MM-dd} "
                            + $"(rate {ex.RatePercent:0.##}%, effective from {ex.EffectiveFromDate:yyyy-MM-dd}). "
                            + "Cap that row with an 'effective to' date strictly before the new effective-from, "
                            + "then add this one.";
                    return;
                }
            }

            var cat = new VatCategory(
                code: _code,
                name: new ArabicEnglishText(_nameAr, _nameEn),
                ratePercent: _rate,
                effectiveFromDate: newFrom,
                effectiveToDate: newTo,
                recoverableInputVat: _recoverable);
            Db.Add(cat);
            await Db.SaveChangesAsync();

            _flash = IsArabic
                ? $"تمت إضافة فئة الضريبة {cat.Code} بمعدل {cat.RatePercent:0.##}% (بدأت {cat.EffectiveFromDate:yyyy-MM-dd})."
                : $"VAT category {cat.Code} @ {cat.RatePercent:0.##}% added (effective {cat.EffectiveFromDate:yyyy-MM-dd}).";
            _code = ""; _nameEn = ""; _nameAr = ""; _rate = 14m;
            _effTo = null;
            await Refresh();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private sealed record OverlapNote(string Code, DateOnly Left, DateOnly Right);
}
