@page "/settings/fiscal-positions"
@using System.Globalization
@using EgyptTax.Domain.MasterData
@using EgyptTax.Infrastructure.Persistence
@using EgyptTax.SharedKernel
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@attribute [Authorize(Policy = "NotSalesRepOnly")]

<PageTitle>@Tr("المواقف الضريبية | DaftarX", "Fiscal Positions | DaftarX")</PageTitle>

<SettingsTabStrip Group="tax-setup" />

<h1>@Tr("🌍 المواقف الضريبية", "🌍 Fiscal positions (F.4)")</h1>
<p class="page-subtitle">
    @Tr(
        "تجميعة قواعد ضريبية للعملاء حسب الجغرافيا: تصدير = 0%، عميل في المنطقة الحرة = معفى، عميل خليجي = ضريبة مختلفة. المرحلة دي: تعريف المواقف فقط — الإسناد التلقائي على بنود الفاتورة هييجي في تحديث لاحق.",
        "Group tax rules for customers by geography: exports = 0%, free-zone = exempt, GCC = different VAT. This pass: master data only — auto-swap on invoice lines lands in a follow-up.")
</p>

@if (_flash is not null) { <div class="@_flashClass">@_flash</div> }
@if (_loading) { <p>@Tr("جارٍ التحميل…", "Loading…")</p> return; }

<section class="invoice-toolbar">
    <button type="button" class="btn-primary" @onclick="StartCreate" disabled="@_editing">
        + @Tr("موقف ضريبي جديد", "New fiscal position")
    </button>
</section>

@if (_editing)
{
    <section class="form-grid" style="margin-top:16px;max-width:600px;">
        <h2 style="margin:0 0 12px;">@(_editingId is null ? Tr("موقف ضريبي جديد", "New fiscal position") : Tr("تعديل", "Edit"))</h2>
        <label>
            <span>@Tr("الاسم (عربي)", "Name (Arabic)")</span>
            <input type="text" @bind="_form.NameAr" placeholder="@Tr("مثال: تصدير - معفى", "e.g. Export - Exempt")" />
        </label>
        <label>
            <span>@Tr("الاسم (إنجليزي)", "Name (English)")</span>
            <input type="text" @bind="_form.NameEn" placeholder="e.g. Export - Zero rated" />
        </label>
        <label>
            <span>@Tr("الوصف (اختياري)", "Description (optional)")</span>
            <textarea rows="2" @bind="_form.Description"></textarea>
        </label>
        <label>
            <span>@Tr("الدولة (اختياري — للاسناد التلقائي مستقبلاً)", "Country (optional — future auto-apply)")</span>
            <input type="text" @bind="_form.CountryAutoApply" placeholder="@Tr("مثال: SA, AE, OM", "e.g. SA, AE, OM")" />
        </label>
        <div class="invoice-actions" style="margin-top:16px;">
            <button type="button" class="btn-primary" @onclick="SaveAsync" disabled="@_saving">
                @(_saving ? Tr("جارٍ الحفظ…", "Saving…") : Tr("حفظ", "Save"))
            </button>
            <button type="button" class="btn-secondary" @onclick="@(() => _editing = false)">
                @Tr("إلغاء", "Cancel")
            </button>
        </div>
    </section>
}

@if (!_editing && _positions.Count > 0)
{
    @foreach (var f in _positions)
    {
        var assignedCount = _customers.Count(c => c.FiscalPositionId == f.Id);
        <div style="border:1px solid var(--border);border-radius:10px;padding:14px 16px;margin-bottom:14px;background:var(--surface);">
            <header style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:10px;">
                <div>
                    <strong style="font-size:15px;">@(IsArabic ? f.Name.Arabic : f.Name.English)</strong>
                    <span style="font-size:11px;color:var(--text-muted);margin-inline-start:8px;">
                        @assignedCount @Tr("عميل", "customers") · @f.Mappings.Count @Tr("قاعدة ضريبة", "tax rules")
                        @if (f.CountryAutoApply is not null)
                        { <text> · @f.CountryAutoApply</text> }
                    </span>
                </div>
                <div style="display:flex;gap:8px;">
                    <span class="state-badge @(f.IsActive ? "state-approved" : "state-voided")">
                        @(f.IsActive ? Tr("نشط", "Active") : Tr("موقوف", "Inactive"))
                    </span>
                    <button type="button" @onclick="@(() => StartEdit(f))">@Tr("تعديل", "Edit")</button>
                    <button type="button" @onclick="@(() => OnToggleActiveAsync(f))">
                        @(f.IsActive ? Tr("تعطيل", "Deactivate") : Tr("تفعيل", "Activate"))
                    </button>
                </div>
            </header>

            @* Tax mappings editor *@
            <table class="data-grid" style="font-size:13px;">
                <thead>
                    <tr>
                        <th>@Tr("الفئة الضريبية الأصلية", "Source VAT category")</th>
                        <th>@Tr("الفئة البديلة", "Destination")</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in f.Mappings)
                    {
                        var srcLabel = _vatById.TryGetValue(m.SourceVatCategoryId, out var src) ? src.Code : m.SourceVatCategoryId.ToString("N").Substring(0,8);
                        var dstLabel = m.DestinationVatCategoryId is { } dstId
                            && _vatById.TryGetValue(dstId, out var dst)
                            ? dst.Code
                            : Tr("معفى — لا قيد ضريبة", "Exempt — no VAT line");
                        <tr>
                            <td>@srcLabel</td>
                            <td>@dstLabel</td>
                            <td><button type="button" style="font-size:11px;" @onclick="@(() => OnRemoveMappingAsync(f.Id, m.Id))">×</button></td>
                        </tr>
                    }
                    <tr style="background:var(--bg-2);">
                        <td>
                            <select @bind="@_mappingForm[f.Id].SourceVatId">
                                <option value="">— @Tr("اختر —", "Choose —")</option>
                                @foreach (var v in _vatCategories)
                                {
                                    <option value="@v.Id">@v.Code (@(IsArabic ? v.Name.Arabic : v.Name.English))</option>
                                }
                            </select>
                        </td>
                        <td>
                            <select @bind="@_mappingForm[f.Id].DestinationVatId">
                                <option value="exempt">— @Tr("معفى (مفيش ضريبة)", "Exempt (no VAT)") —</option>
                                @foreach (var v in _vatCategories)
                                {
                                    <option value="@v.Id">@v.Code (@(IsArabic ? v.Name.Arabic : v.Name.English))</option>
                                }
                            </select>
                        </td>
                        <td><button type="button" class="btn-primary" style="font-size:12px;" @onclick="@(() => OnAddMappingAsync(f.Id))">+</button></td>
                    </tr>
                </tbody>
            </table>
        </div>
    }

    @* Customer-assignment grid *@
    <h2 style="margin-top:32px;">@Tr("تعيين المواقف للعملاء", "Assign to customers")</h2>
    @if (_customers.Count == 0)
    {
        <p><em>@Tr("ما فيش عملاء بعد.", "No customers yet.")</em></p>
    }
    else
    {
        <table class="data-grid">
            <thead>
                <tr>
                    <th>@Tr("الكود", "Code")</th>
                    <th>@Tr("الاسم", "Name")</th>
                    <th>@Tr("الموقف الضريبي", "Fiscal position")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in _customers)
                {
                    <tr>
                        <td><code>@c.Code</code></td>
                        <td>@(IsArabic ? c.Name.Arabic : c.Name.English)</td>
                        <td>
                            <select value="@(c.FiscalPositionId?.ToString() ?? "")"
                                    @onchange="@(e => OnAssignToCustomerAsync(c.Id, e.Value?.ToString()))">
                                <option value="">— @Tr("بدون", "None") —</option>
                                @foreach (var f in _positions.Where(f => f.IsActive))
                                {
                                    <option value="@f.Id">@(IsArabic ? f.Name.Arabic : f.Name.English)</option>
                                }
                            </select>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
else if (!_editing)
{
    <p style="padding:32px 0;text-align:center;color:var(--text-muted);">
        <em>@Tr("لا توجد مواقف ضريبية. ابدأ بإنشاء «تصدير 0%» للعملاء خارج مصر.",
            "No fiscal positions. Start with \"Export 0%\" for non-Egyptian customers.")</em>
    </p>
}

@code {
    private bool IsArabic =>
        CultureInfo.CurrentCulture.Name.StartsWith("ar", StringComparison.OrdinalIgnoreCase);
    private string Tr(string ar, string en) => IsArabic ? ar : en;

    private bool _loading = true;
    private bool _editing;
    private bool _saving;
    private Guid? _editingId;
    private FormModel _form = new();
    private List<FiscalPosition> _positions = new();
    private List<Customer> _customers = new();
    private List<VatCategory> _vatCategories = new();
    private Dictionary<Guid, VatCategory> _vatById = new();
    private Dictionary<Guid, MappingFormModel> _mappingForm = new();
    private string? _flash;
    private string _flashClass = "flash-success";

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _positions = await db.Set<FiscalPosition>().AsNoTracking()
            .Include(f => f.Mappings)
            .OrderByDescending(f => f.IsActive)
            .ThenBy(f => f.Name.English).ToListAsync();
        _customers = await db.Set<Customer>().AsNoTracking()
            .Where(c => c.Status == CustomerStatus.Active)
            .OrderBy(c => c.Code).ToListAsync();
        _vatCategories = await db.Set<VatCategory>().AsNoTracking()
            .OrderBy(v => v.Code).ToListAsync();
        _vatById = _vatCategories.ToDictionary(v => v.Id);
        foreach (var p in _positions)
        {
            if (!_mappingForm.ContainsKey(p.Id))
                _mappingForm[p.Id] = new MappingFormModel();
        }
        _loading = false;
    }

    private async Task OnToggleActiveAsync(FiscalPosition f)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var live = await db.Set<FiscalPosition>().FirstAsync(x => x.Id == f.Id);
        if (live.IsActive) live.Deactivate(); else live.Reactivate();
        await db.SaveChangesAsync();
        await ReloadAsync();
    }

    private async Task OnAddMappingAsync(Guid positionId)
    {
        _flash = null;
        try
        {
            var form = _mappingForm[positionId];
            if (!Guid.TryParse(form.SourceVatId, out var sourceId))
            {
                _flash = Tr("اختر فئة ضريبية أصلية.", "Pick a source VAT category.");
                _flashClass = "flash-error";
                return;
            }
            Guid? destId = form.DestinationVatId == "exempt" || string.IsNullOrEmpty(form.DestinationVatId)
                ? null
                : Guid.TryParse(form.DestinationVatId, out var d) ? d : null;

            await using var db = await DbFactory.CreateDbContextAsync();
            var live = await db.Set<FiscalPosition>().Include(p => p.Mappings)
                .FirstAsync(p => p.Id == positionId);
            if (live.Mappings.Any(m => m.SourceVatCategoryId == sourceId))
            {
                _flash = Tr("الفئة الأصلية دي عندها قاعدة بالفعل في الموقف ده.",
                    "Source VAT already has a rule on this position.");
                _flashClass = "flash-error";
                return;
            }
            live.AddMapping(sourceId, destId);
            await db.SaveChangesAsync();
            _mappingForm[positionId] = new MappingFormModel();
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _flash = ex.Message;
            _flashClass = "flash-error";
        }
    }

    private async Task OnRemoveMappingAsync(Guid positionId, Guid mappingId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var mapping = await db.Set<FiscalPositionMapping>().FirstOrDefaultAsync(m => m.Id == mappingId);
        if (mapping is null) return;
        db.Set<FiscalPositionMapping>().Remove(mapping);
        await db.SaveChangesAsync();
        await ReloadAsync();
    }

    private async Task OnAssignToCustomerAsync(Guid customerId, string? positionIdRaw)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var live = await db.Set<Customer>().FirstOrDefaultAsync(c => c.Id == customerId);
        if (live is null) return;
        Guid? pid = Guid.TryParse(positionIdRaw, out var p) ? p : null;
        live.AssignFiscalPosition(pid);
        await db.SaveChangesAsync();
        await ReloadAsync();
    }

    private void StartCreate()
    {
        _editingId = null;
        _form = new FormModel();
        _editing = true;
        _flash = null;
    }

    private void StartEdit(FiscalPosition f)
    {
        _editingId = f.Id;
        _form = new FormModel
        {
            NameAr = f.Name.Arabic,
            NameEn = f.Name.English,
            Description = f.Description ?? "",
            CountryAutoApply = f.CountryAutoApply ?? "",
        };
        _editing = true;
        _flash = null;
    }

    private async Task SaveAsync()
    {
        _flash = null;
        if (string.IsNullOrWhiteSpace(_form.NameAr) || string.IsNullOrWhiteSpace(_form.NameEn))
        {
            _flash = Tr("الاسم بالعربي والإنجليزي مطلوب.", "Arabic and English names required.");
            _flashClass = "flash-error";
            return;
        }

        _saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            if (_editingId is { } id)
            {
                var f = await db.Set<FiscalPosition>().FirstAsync(x => x.Id == id);
                f.Update(new ArabicEnglishText(_form.NameAr, _form.NameEn),
                    _form.Description, _form.CountryAutoApply);
            }
            else
            {
                db.Add(new FiscalPosition(
                    new ArabicEnglishText(_form.NameAr, _form.NameEn),
                    _form.Description,
                    _form.CountryAutoApply,
                    DateTime.UtcNow));
            }
            await db.SaveChangesAsync();
            _flash = Tr("تم الحفظ.", "Saved.");
            _flashClass = "flash-success";
            _editing = false;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _flash = ex.Message;
            _flashClass = "flash-error";
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed class FormModel
    {
        public string NameAr { get; set; } = "";
        public string NameEn { get; set; } = "";
        public string Description { get; set; } = "";
        public string CountryAutoApply { get; set; } = "";
    }

    private sealed class MappingFormModel
    {
        public string SourceVatId { get; set; } = "";
        public string DestinationVatId { get; set; } = "exempt";
    }
}
