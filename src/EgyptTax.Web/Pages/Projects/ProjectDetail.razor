@page "/projects/{Id:guid}"
@using EgyptTax.Domain.Identity
@using EgyptTax.Domain.MasterData
@using EgyptTax.Domain.Projects
@using EgyptTax.Infrastructure.Persistence
@using EgyptTax.SharedKernel
@using EgyptTax.Web.Auth
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject AuthenticationStateProvider Auth
@attribute [Authorize(Policy = "FullyAuthenticated")]

<PageTitle>@Tr("مشروع | DaftarX", "Project | DaftarX")</PageTitle>

@if (_loading)
{
    <p>@Tr("جارٍ التحميل…", "Loading…")</p>
    return;
}
@if (_project is null)
{
    <p>@Tr("المشروع مش موجود.", "Project not found.")</p>
    return;
}

<div style="display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:12px;">
    <div>
        <h1 style="margin-bottom:4px;">@_project.Name.Display(IsArabic ? Language.Ar : Language.En)</h1>
        <p class="page-subtitle" style="margin:0;">
            <code>@_project.Code</code> ·
            <span class="badge badge-@StatusBadge(_project.Status)">@StatusLabel(_project.Status)</span>
            · @_project.StartDate.ToString("yyyy-MM-dd")
            → @(_project.EndDate?.ToString("yyyy-MM-dd") ?? Tr("بلا انتهاء", "open"))
        </p>
    </div>
    <div class="invoice-actions" style="margin:0;">
        @if (_project.Status != ProjectStatus.Active)
        {
            <button type="button" class="btn-primary" @onclick="@(() => ChangeStatusAsync(ProjectStatus.Active))">@Tr("تنشيط", "Activate")</button>
        }
        @if (_project.Status == ProjectStatus.Active)
        {
            <button type="button" class="btn-secondary" @onclick="@(() => ChangeStatusAsync(ProjectStatus.OnHold))">@Tr("تعليق", "Hold")</button>
            <button type="button" class="btn-secondary" @onclick="@(() => ChangeStatusAsync(ProjectStatus.Completed))">@Tr("إكمال", "Complete")</button>
        }
        <a href="/projects/@_project.Id/pnl" class="btn-secondary">📊 @Tr("الربح والخسارة", "P&L")</a>
        <a href="/projects/@_project.Id/gantt" class="btn-secondary">📅 @Tr("جانت", "Gantt")</a>
        <a href="/projects" class="btn-secondary">@Tr("الرجوع", "Back")</a>
    </div>
</div>

@* v5 D.2.2 — link the project to a cost-center so the P&L page
   can roll up revenue/direct costs/expenses tagged with that CC. *@
<section class="form-grid" style="margin-top:14px;max-width:480px;">
    <label>
        <span>@Tr("مركز التكلفة المربوط (للربح والخسارة)", "Linked cost center (for P&L)")</span>
        <select value="@(_project.LinkedCostCenterId?.ToString() ?? "")"
                @onchange="@(e => OnLinkCostCenterAsync(e.Value?.ToString()))">
            <option value="">— @Tr("بدون", "None") —</option>
            @foreach (var cc in _costCenters)
            {
                <option value="@cc.Id">@cc.Code — @(IsArabic ? cc.Name.Arabic : cc.Name.English)</option>
            }
        </select>
    </label>
</section>

@if (_flash is not null)
{
    <div class="@_flashClass" style="margin:12px 0;">@_flash</div>
}

<section class="form-section" style="margin-top:16px;">
    <h2>@Tr("المهام", "Tasks")</h2>

    <div class="form-grid" style="grid-template-columns:1fr auto auto auto auto auto auto;">
        <input type="text" @bind="_newTaskTitle" @bind:event="oninput"
               placeholder="@Tr("عنوان المهمة", "Task title")" maxlength="300" />
        <select @bind="_newTaskAssignee">
            <option value="@Guid.Empty">— @Tr("بدون", "unassigned") —</option>
            @foreach (var u in _users)
            {
                <option value="@u.Id">@u.DisplayName.Display(IsArabic ? Language.Ar : Language.En)</option>
            }
        </select>
        @* v5 D.2.3 — schedule range: start + due. Both optional;
           Gantt only shows tasks with both. *@
        <input type="date" @bind="_newTaskStart" placeholder="@Tr("بدء (جانت)", "Start (Gantt)")"
               title="@Tr("تاريخ البدء — لازم للظهور في جانت", "Start date — required to appear in Gantt")" />
        <input type="date" @bind="_newTaskDue" />
        @* v5 A.3 — priority + optional parent (one-level sub-tasks) *@
        <select @bind="_newTaskPriority" title="@Tr("الأولوية", "Priority")">
            @foreach (var p in Enum.GetValues<TaskPriority>())
            {
                <option value="@p">@PriorityLabel(p)</option>
            }
        </select>
        <select @bind="_newTaskParent" title="@Tr("مهمة أم (اختياري)", "Parent task (optional)")">
            <option value="@Guid.Empty">— @Tr("بلا أب", "no parent") —</option>
            @foreach (var t in _project.Tasks.Where(x => x.ParentTaskId is null))
            {
                <option value="@t.Id">↳ @t.Title</option>
            }
        </select>
        <button type="button" class="btn-secondary" disabled="@(string.IsNullOrWhiteSpace(_newTaskTitle))"
                @onclick="OnAddTaskAsync">+ @Tr("ضيف", "Add")</button>
    </div>

    @if (_project.Tasks.Count == 0)
    {
        <p class="page-subtitle" style="font-size:13px;margin-top:8px;">
            @Tr("مفيش مهام بعد.", "No tasks yet.")
        </p>
    }
    else
    {
        <table class="data-table" style="margin-top:12px;">
            <thead>
                <tr>
                    <th>@Tr("الحالة", "Status")</th>
                    <th>@Tr("الأولوية", "Priority")</th>
                    <th>@Tr("العنوان", "Title")</th>
                    <th>@Tr("المسؤول", "Assignee")</th>
                    <th>@Tr("الاستحقاق", "Due")</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @* v5 A.3 — render parents first (priority desc, due asc),
                   then their sub-tasks immediately after each parent
                   indented by ↳, then any orphan sub-tasks at the end. *@
                @foreach (var parent in _project.Tasks.Where(t => t.ParentTaskId is null)
                    .OrderBy(t => t.Status)
                    .ThenBy(t => (int)t.Priority)
                    .ThenBy(t => t.DueDate ?? DateOnly.MaxValue))
                {
                    var pTask = parent;
                    <tr>
                        <td>
                            <select value="@pTask.Status"
                                    @onchange="@(e => OnTaskStatusChangedAsync(pTask.Id, Enum.Parse<TaskStatus_>((string)e.Value!)))"
                                    style="font-size:12px;">
                                @foreach (var s in Enum.GetValues<TaskStatus_>())
                                {
                                    <option value="@s">@TaskStatusLabel(s)</option>
                                }
                            </select>
                        </td>
                        <td><span class="badge badge-@PriorityBadge(pTask.Priority)">@PriorityLabel(pTask.Priority)</span></td>
                        <td>@parent.Title</td>
                        <td>@(parent.AssignedToUserId.HasValue && _userLookup.TryGetValue(parent.AssignedToUserId.Value, out var pu) ? pu.DisplayName.Display(IsArabic ? Language.Ar : Language.En) : "—")</td>
                        <td>@(parent.DueDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                        <td></td>
                    </tr>
                    @foreach (var sub in _project.Tasks
                        .Where(t => t.ParentTaskId == parent.Id)
                        .OrderBy(t => t.Status)
                        .ThenBy(t => (int)t.Priority))
                    {
                        var sTask = sub;
                        <tr style="background:var(--bg);">
                            <td>
                                <select value="@sTask.Status"
                                        @onchange="@(e => OnTaskStatusChangedAsync(sTask.Id, Enum.Parse<TaskStatus_>((string)e.Value!)))"
                                        style="font-size:12px;">
                                    @foreach (var s in Enum.GetValues<TaskStatus_>())
                                    {
                                        <option value="@s">@TaskStatusLabel(s)</option>
                                    }
                                </select>
                            </td>
                            <td><span class="badge badge-@PriorityBadge(sub.Priority)">@PriorityLabel(sub.Priority)</span></td>
                            <td style="padding-inline-start:24px;">↳ @sub.Title</td>
                            <td>@(sub.AssignedToUserId.HasValue && _userLookup.TryGetValue(sub.AssignedToUserId.Value, out var su) ? su.DisplayName.Display(IsArabic ? Language.Ar : Language.En) : "—")</td>
                            <td>@(sub.DueDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                            <td></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
</section>

@code {
    [Parameter] public Guid Id { get; set; }

    private bool _loading = true;
    private string? _flash;
    private string _flashClass = "kpi-card kpi-info";

    private Project? _project;
    private List<User> _users = new();
    private Dictionary<Guid, User> _userLookup = new();
    private List<CostCenter> _costCenters = new();

    private string _newTaskTitle = "";
    private Guid _newTaskAssignee = Guid.Empty;
    private DateTime? _newTaskDue;
    private DateTime? _newTaskStart;
    private TaskPriority _newTaskPriority = TaskPriority.Normal;
    private Guid _newTaskParent = Guid.Empty;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _project = await Db.Set<Project>().Include(p => p.Tasks).FirstOrDefaultAsync(p => p.Id == Id);
        _users = await Db.Set<User>().AsNoTracking()
            .Where(u => u.Status == UserStatus.Active)
            .OrderBy(u => u.DisplayName.English).ToListAsync();
        _userLookup = _users.ToDictionary(u => u.Id);
        _costCenters = await Db.Set<CostCenter>().AsNoTracking()
            .Where(c => c.Status == CostCenterStatus.Active)
            .OrderBy(c => c.Code).ToListAsync();
        _loading = false;
    }

    private async Task OnLinkCostCenterAsync(string? rawId)
    {
        if (_project is null) return;
        Guid? cid = Guid.TryParse(rawId, out var g) ? g : null;
        var live = await Db.Set<Project>().FirstOrDefaultAsync(p => p.Id == _project.Id);
        if (live is null) return;
        live.LinkCostCenter(cid);
        await Db.SaveChangesAsync();
        _project = await Db.Set<Project>().Include(p => p.Tasks).FirstAsync(p => p.Id == _project.Id);
    }

    private async Task OnAddTaskAsync()
    {
        if (string.IsNullOrWhiteSpace(_newTaskTitle)) return;
        try
        {
            var newTask = _project!.AddTask(_newTaskTitle.Trim(),
                _newTaskAssignee == Guid.Empty ? null : _newTaskAssignee,
                _newTaskDue.HasValue ? DateOnly.FromDateTime(_newTaskDue.Value) : null,
                priority: _newTaskPriority,
                parentTaskId: _newTaskParent == Guid.Empty ? null : _newTaskParent);
            // v5 D.2.3 — pin the start date so the Gantt chart can plot the task.
            if (_newTaskStart.HasValue)
            {
                newTask.SetSchedule(
                    DateOnly.FromDateTime(_newTaskStart.Value),
                    _newTaskDue.HasValue ? DateOnly.FromDateTime(_newTaskDue.Value) : null);
            }
            await Db.SaveChangesAsync();
            _newTaskTitle = "";
            _newTaskDue = null;
            _newTaskStart = null;
            _newTaskAssignee = Guid.Empty;
            _newTaskPriority = TaskPriority.Normal;
            _newTaskParent = Guid.Empty;
            await LoadAsync();
        }
        catch (Exception ex) { _flash = ex.Message; _flashClass = "kpi-card kpi-error"; }
    }

    private async Task OnTaskStatusChangedAsync(Guid taskId, TaskStatus_ newStatus)
    {
        try
        {
            var task = _project!.Tasks.FirstOrDefault(t => t.Id == taskId);
            if (task is null) return;
            task.MoveTo(newStatus);
            await Db.SaveChangesAsync();
            await LoadAsync();
        }
        catch (Exception ex) { _flash = ex.Message; _flashClass = "kpi-card kpi-error"; }
    }

    private async Task ChangeStatusAsync(ProjectStatus s)
    {
        try
        {
            switch (s)
            {
                case ProjectStatus.Active: _project!.Activate(); break;
                case ProjectStatus.OnHold: _project!.PutOnHold(); break;
                case ProjectStatus.Completed: _project!.Complete(); break;
            }
            await Db.SaveChangesAsync();
            await LoadAsync();
        }
        catch (Exception ex) { _flash = ex.Message; _flashClass = "kpi-card kpi-error"; }
    }

    private string StatusLabel(ProjectStatus s) => s switch
    {
        ProjectStatus.Planning => Tr("تخطيط", "Planning"),
        ProjectStatus.Active => Tr("نشط", "Active"),
        ProjectStatus.OnHold => Tr("معلّق", "On hold"),
        ProjectStatus.Completed => Tr("مكتمل", "Completed"),
        ProjectStatus.Cancelled => Tr("ملغي", "Cancelled"),
        _ => s.ToString(),
    };
    private static string StatusBadge(ProjectStatus s) => s switch
    {
        ProjectStatus.Active => "info",
        ProjectStatus.Completed => "success",
        ProjectStatus.Cancelled => "danger",
        ProjectStatus.OnHold => "warn",
        _ => "muted",
    };

    private string TaskStatusLabel(TaskStatus_ s) => s switch
    {
        TaskStatus_.Todo => Tr("للعمل", "Todo"),
        TaskStatus_.InProgress => Tr("قيد التنفيذ", "In progress"),
        TaskStatus_.Blocked => Tr("معطّلة", "Blocked"),
        TaskStatus_.Done => Tr("✓ تمت", "✓ Done"),
        _ => s.ToString(),
    };

    // v5 A.3 — priority labels + badge color buckets.
    private string PriorityLabel(TaskPriority p) => p switch
    {
        TaskPriority.Urgent => Tr("عاجلة 🔥", "🔥 Urgent"),
        TaskPriority.High => Tr("عالية", "High"),
        TaskPriority.Normal => Tr("عادية", "Normal"),
        TaskPriority.Low => Tr("منخفضة", "Low"),
        _ => p.ToString(),
    };

    private static string PriorityBadge(TaskPriority p) => p switch
    {
        TaskPriority.Urgent => "danger",
        TaskPriority.High => "warn",
        TaskPriority.Normal => "muted",
        TaskPriority.Low => "info",
        _ => "muted",
    };
}
