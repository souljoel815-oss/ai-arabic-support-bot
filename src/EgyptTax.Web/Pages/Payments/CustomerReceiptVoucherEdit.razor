@page "/payments/customer-receipts/new"
@using EgyptTax.Application.Payments
@using EgyptTax.Domain.Documents
@using EgyptTax.Domain.Invoices
@using EgyptTax.Domain.MasterData
@using EgyptTax.Domain.Workflow
@using EgyptTax.Infrastructure.Payments
@using EgyptTax.Infrastructure.Persistence
@using EgyptTax.SharedKernel
@using EgyptTax.Web.Auth
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject IPaymentVoucherQuery Query
@inject AllocatePaymentHandler AllocateHandler
@inject PostCustomerReceiptVoucherHandler PostHandler
@inject AppDbContext Db
@inject NavigationManager Nav
@inject AuthenticationStateProvider Auth
@attribute [Authorize(Policy = "FullyAuthenticated")]

<h1>@(IsArabic ? "إيصال قبض من عميل" : "New customer receipt voucher (FR-052)")</h1>

@if (_voucher is null)
{
    <h2>@(IsArabic ? "الخطوة 1 — بيانات السند" : "Step 1 — Voucher header")</h2>
    <form @onsubmit="OnCreateDraft" @onsubmit:preventDefault>
        <div class="invoice-toolbar">
            <label>
                <span>@(IsArabic ? "العميل" : "Customer")</span>
                <select @bind="_customerId" required>
                    <option value="">— @(IsArabic ? "اختر العميل" : "pick customer") —</option>
                    @foreach (var c in _customers)
                    {
                        <option value="@c.Id">@c.Code — @(IsArabic ? c.Name.Arabic : c.Name.English)</option>
                    }
                </select>
            </label>
            <label>
                <span>@(IsArabic ? "تاريخ القبض" : "Receipt date")</span>
                <input type="date" @bind="_receiptDate" required />
            </label>
            <label>
                <span>@(IsArabic ? "طريقة الدفع" : "Payment method")</span>
                <select @bind="_paymentMethod">
                    <option value="@PaymentMethod.BankTransfer">@(IsArabic ? "تحويل بنكي" : "Bank transfer")</option>
                    <option value="@PaymentMethod.Cash">@(IsArabic ? "نقدية" : "Cash")</option>
                </select>
            </label>
            <label>
                <span>@(IsArabic ? "الحساب (خزينة / بنك)" : "Account (cashbox / bank)")</span>
                <select @bind="_cashAccountId" required>
                    @foreach (var a in _cashAccounts)
                    {
                        <option value="@a.Id">@a.AccountCode — @(IsArabic ? a.Name.Arabic : a.Name.English)</option>
                    }
                </select>
            </label>
        </div>
        <div class="invoice-toolbar">
            <label>
                <span>@(IsArabic ? "المرجع" : "Reference")</span>
                <input type="text" @bind="_paymentReference" required />
            </label>
            <label>
                <span>@(IsArabic ? "إجمالي القبض (ج.م.)" : "Gross receipt (EGP)")</span>
                <input type="number" step="0.01" min="0.01" @bind="_grossAmount" required />
            </label>
        </div>
        <p>
            <button type="submit" class="btn-primary" disabled="@_busy">
                @(_busy ? (IsArabic ? "جارٍ الحفظ…" : "Saving…") : (IsArabic ? "إنشاء مسودة ← المتابعة للتخصيصات" : "Create draft → continue to allocations"))
            </button>
        </p>
    </form>
}
else
{
    <section class="invoice-totals">
        <div><strong>@(IsArabic ? "السند (مسودة):" : "Voucher (Draft):")</strong> @_voucher.Id</div>
        <div><strong>@(IsArabic ? "الإجمالي:" : "Gross:")</strong> @_voucher.GrossReceiptAmount.Amount.ToString("F2") @(IsArabic ? "ج.م." : "EGP")</div>
        <div><strong>@(IsArabic ? "المُخصَّص:" : "Allocated:")</strong> @(_voucher.Allocations.Sum(a => a.AllocatedAmount.Amount).ToString("F2")) @(IsArabic ? "ج.م." : "EGP")</div>
        <div><strong>@(IsArabic ? "متبقٍّ للتخصيص:" : "Remaining to allocate:")</strong>
            <span class="num">@((_voucher.GrossReceiptAmount.Amount - _voucher.Allocations.Sum(a => a.AllocatedAmount.Amount)).ToString("F2")) @(IsArabic ? "ج.م." : "EGP")</span>
        </div>
    </section>

    <h2>@(IsArabic ? "الخطوة 2 — تخصيص على فواتير المبيعات المفتوحة (FR-053)" : "Step 2 — Allocate to outstanding sales invoices (FR-053)")</h2>
    @if (_outstanding is null || _outstanding.Count == 0)
    {
        <p><em>@(IsArabic ? "لا توجد فواتير مبيعات مفتوحة لهذا العميل." : "No outstanding sales invoices for this customer.")</em></p>
    }
    else
    {
        <table class="data-grid">
            <thead>
                <tr>
                    <th>@(IsArabic ? "رقم المستند" : "Doc no.")</th>
                    <th>@(IsArabic ? "التاريخ" : "Date")</th>
                    <th class="num">@(IsArabic ? "الإجمالي الكلي" : "Grand total")</th>
                    <th class="num">@(IsArabic ? "المُخصَّص" : "Allocated")</th>
                    <th class="num">@(IsArabic ? "الرصيد المفتوح" : "Open balance")</th>
                    <th class="num">@(IsArabic ? "تخصيص" : "Allocate")</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var inv in _outstanding)
                {
                    <tr>
                        <td><code>@inv.DocumentNumber</code></td>
                        <td>@inv.DocumentDate.ToString("yyyy-MM-dd")</td>
                        <td class="num">@inv.GrandTotal.Amount.ToString("F2")</td>
                        <td class="num">@inv.AllocatedToDate.Amount.ToString("F2")</td>
                        <td class="num">@inv.OpenBalance.Amount.ToString("F2")</td>
                        <td class="num">
                            <input type="number" step="0.01" min="0" max="@inv.OpenBalance.Amount"
                                   @bind="_allocateInputs[inv.InvoiceId]" />
                        </td>
                        <td>
                            <button type="button" class="btn-secondary" disabled="@_busy"
                                    @onclick="() => OnAllocate(inv.InvoiceId)">@(IsArabic ? "إضافة" : "Add")</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (_voucher.Allocations.Count > 0)
    {
        <h3>@(IsArabic ? "التخصيصات الحالية" : "Current allocations")</h3>
        <table class="data-grid">
            <thead><tr><th>@(IsArabic ? "رقم الفاتورة المستهدفة" : "Target invoice id")</th><th class="num">@(IsArabic ? "المبلغ" : "Amount")</th></tr></thead>
            <tbody>
                @foreach (var a in _voucher.Allocations)
                {
                    <tr>
                        <td><code>@a.TargetDocumentId</code></td>
                        <td class="num">@a.AllocatedAmount.Amount.ToString("F2")</td>
                    </tr>
                }
            </tbody>
        </table>

        <p>
            <button type="button" class="btn-primary" disabled="@_busy" @onclick="OnPost">
                @(_busy ? (IsArabic ? "جارٍ الترحيل…" : "Posting…") : (IsArabic ? "ترحيل السند" : "Post voucher"))
            </button>
        </p>
    }
}

@if (_error is not null)
{
    <div class="flash-error"><strong>@(IsArabic ? "خطأ:" : "Error:")</strong> @_error</div>
}

@code {
    /// <summary>v5 E.2 — when present, comma-separated list of
    /// SalesInvoice GUIDs that the operator multi-selected on the
    /// invoice list. We pre-fill the customer + amount + auto-flag
    /// these invoices for allocation in step 2.</summary>
    [SupplyParameterFromQuery(Name = "invoices")] public string? PreselectedInvoices { get; set; }

    private List<Customer> _customers = new();
    private List<CashAccount> _cashAccounts = new();
    private Guid _customerId;
    private Guid _cashAccountId;
    private DateTime _receiptDate = DateTime.UtcNow.Date;
    private PaymentMethod _paymentMethod = PaymentMethod.BankTransfer;
    private string _paymentReference = "";
    private decimal _grossAmount;
    private CustomerReceiptVoucher? _voucher;
    private IReadOnlyList<OutstandingInvoiceRow>? _outstanding;
    private readonly Dictionary<Guid, decimal> _allocateInputs = new();
    private HashSet<Guid> _preselectedIds = new();   // v5 E.2
    private bool _busy;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _customers = await Db.Set<Customer>().AsNoTracking()
            .OrderBy(c => c.Code).ToListAsync();
        _cashAccounts = await Db.Set<CashAccount>().AsNoTracking()
            .Where(a => a.Status == CashAccountStatus.Active)
            .OrderByDescending(a => a.IsDefault).ThenBy(a => a.AccountCode)
            .ToListAsync();
        _cashAccountId = _cashAccounts.FirstOrDefault(a => a.IsDefault)?.Id
                       ?? _cashAccounts.FirstOrDefault()?.Id
                       ?? Guid.Empty;

        // v5 E.2 — if we landed here from "Pay selected" on the
        // invoice list, parse the bundle + pre-fill the form.
        await TryApplyPreselectedInvoicesAsync();
    }

    private async Task TryApplyPreselectedInvoicesAsync()
    {
        if (string.IsNullOrWhiteSpace(PreselectedInvoices)) return;
        var ids = PreselectedInvoices
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(s => Guid.TryParse(s, out var g) ? g : Guid.Empty)
            .Where(g => g != Guid.Empty)
            .ToList();
        if (ids.Count == 0) return;

        _preselectedIds = ids.ToHashSet();
        var picked = await Db.Set<SalesInvoice>().AsNoTracking()
            .Where(i => ids.Contains(i.Id))
            .Select(i => new { i.Id, i.CustomerId, Grand = i.GrandTotal.Amount })
            .ToListAsync();
        if (picked.Count == 0) return;

        var allocs = await Db.Set<PaymentAllocation>().AsNoTracking()
            .Where(a => ids.Contains(a.TargetDocumentId)
                && a.TargetDocumentType == DocumentType.SalesInvoice)
            .Select(a => new { a.TargetDocumentId, Amt = a.AllocatedAmount.Amount })
            .ToListAsync();
        var paid = allocs
            .GroupBy(a => a.TargetDocumentId)
            .ToDictionary(g => g.Key, g => g.Sum(x => x.Amt));

        var totalOutstanding = picked.Sum(p => Math.Max(0m, p.Grand - paid.GetValueOrDefault(p.Id, 0m)));
        _customerId = picked.First().CustomerId;
        _grossAmount = decimal.Round(totalOutstanding, 2);
    }

    private async Task OnCreateDraft()
    {
        _error = null; _busy = true;
        try
        {
            if (_customerId == Guid.Empty) { _error = IsArabic ? "اختر عميلاً." : "Pick a customer."; return; }
            _voucher = CustomerReceiptVoucher.CreateDraft(
                customerId: _customerId,
                receiptDate: DateOnly.FromDateTime(_receiptDate),
                paymentMethod: _paymentMethod,
                paymentReference: _paymentReference,
                grossReceiptAmount: MoneyEgp.From(_grossAmount));
            if (_cashAccountId != Guid.Empty)
            {
                _voucher.SetCashAccount(_cashAccountId);
            }
            Db.Add(_voucher);
            await Db.SaveChangesAsync();
            _outstanding = await Query.ListOutstandingSalesInvoicesAsync(_customerId);
            // Pre-seed _allocateInputs so the @bind on the per-row
            // input doesn't throw KeyNotFoundException on first render.
            foreach (var inv in _outstanding)
            {
                // v5 E.2 — for invoices the operator pre-selected on
                // the list, suggest the full outstanding amount so
                // a single click per row lands the allocation.
                var suggested = _preselectedIds.Contains(inv.InvoiceId) ? inv.OpenBalance.Amount : 0m;
                _allocateInputs.TryAdd(inv.InvoiceId, suggested);
            }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task OnAllocate(Guid invoiceId)
    {
        if (_voucher is null) return;
        _error = null; _busy = true;
        try
        {
            if (!_allocateInputs.TryGetValue(invoiceId, out var amount) || amount <= 0m)
            {
                _error = IsArabic ? "أدخل مبلغاً موجباً للتخصيص." : "Enter a positive amount to allocate.";
                return;
            }
            await AllocateHandler.HandleAsync(
                new AllocateCustomerReceiptCommand(_voucher.Id, invoiceId, MoneyEgp.From(amount)));
            Db.ChangeTracker.Clear();
            _voucher = await Db.Set<CustomerReceiptVoucher>()
                .Include(v => v.Allocations)
                .FirstAsync(v => v.Id == _voucher.Id);
            _outstanding = await Query.ListOutstandingSalesInvoicesAsync(_customerId);
            _allocateInputs[invoiceId] = 0m;
            foreach (var inv in _outstanding)
            {
                _allocateInputs.TryAdd(inv.InvoiceId, 0m);
            }
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task OnPost()
    {
        if (_voucher is null) return;
        _error = null; _busy = true;
        try
        {
            var auth = await Auth.GetAuthenticationStateAsync();
            var userId = auth.User.UserId() ?? Guid.Empty;
            var posted = await PostHandler.HandleAsync(
                new PostCustomerReceiptVoucherCommand(_voucher.Id, userId));
            Nav.NavigateTo($"/journals?periodStart={posted.ReceiptDate:yyyy-MM-dd}");
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
