@page "/"
@using System.Globalization
@using EgyptTax.Application.Compliance.PenaltyShield
@using EgyptTax.Domain.Audit
@using EgyptTax.Domain.Compliance
@using EgyptTax.Domain.Documents
@using EgyptTax.Domain.Eta
@using EgyptTax.Domain.Expenses
@using EgyptTax.Domain.Invoices
@using EgyptTax.Domain.MasterData
@using EgyptTax.Domain.Periods
@using EgyptTax.Domain.Purchases
@using EgyptTax.Domain.Workflow
@using EgyptTax.Infrastructure.Persistence
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IPenaltyExposureQuery PenaltyQuery
@attribute [Authorize(Policy = "FullyAuthenticated")]

<PageTitle>DaftarX</PageTitle>

@code {
    private bool IsArabic => CultureInfo.CurrentCulture.Name.StartsWith("ar", StringComparison.OrdinalIgnoreCase);

    // --- Period ---
    private DateOnly _monthStart;
    private DateOnly _monthEnd;
    private string _periodLabel = "";
    private TaxPeriodStatus _periodStatus = TaxPeriodStatus.Open;
    private DateTime? _periodLockedAtUtc;

    // --- KPI: VAT ---
    private decimal _outputVat;
    private decimal _inputVat;
    private decimal _vatPayable;

    // --- KPI: ETA ---
    private int _etaPending;
    private int _etaFailed;
    private int _etaCriticalCount;

    // --- KPI: Attachments / risk ---
    private int _expensesMissingAttachment;
    private int _purchasesMissingAttachment;
    private int _draftsCount;
    private int _pendingApprovalCount;

    // --- KPI: Penalty Shield ---
    private PenaltyExposureReport? _penalty;

    // --- Gux.7 Upcoming deadlines (next 30 days) ---
    private List<ComplianceObligation> _upcomingDeadlines = new();

    // --- Activity feed ---
    private List<FeedItem> _feed = new();

    // --- Gux.9 Closing Cockpit drawer ---
    private bool _cockpitOpen;

    private record FeedItem(
        string IconName,
        string Tone,
        string Title,
        string Meta,
        string? Href,
        DateTime At);

    protected override async Task OnInitializedAsync()
    {
        var now = DateTime.UtcNow;
        _monthStart = new DateOnly(now.Year, now.Month, 1);
        _monthEnd = _monthStart.AddMonths(1).AddDays(-1);
        _periodLabel = $"{MonthName(now.Month)} {now.Year}";

        await using var Db = await DbFactory.CreateDbContextAsync();

        // Period lock state
        var period = await Db.Set<TaxPeriod>().AsNoTracking()
            .FirstOrDefaultAsync(p => p.PeriodKind == TaxPeriodKind.VatMonth
                && p.Year == now.Year && p.MonthOrQuarter == now.Month);
        if (period is not null)
        {
            _periodStatus = period.Status;
            _periodLockedAtUtc = period.LockedAtUtc;
        }

        // Output VAT — sum from posted sales invoices in current month.
        // Materialise + sum in-memory: SQLite doesn't support server-
        // side decimal aggregation (the values are stored as REAL/TEXT)
        // so SumAsync throws NotSupportedException on the portable EXE
        // / SQLite path. Volume is bounded to a single month's posts.
        var outputAmounts = await Db.Set<SalesInvoice>().AsNoTracking()
            .Where(i => i.State == DocumentState.Posted
                && i.DocumentDate >= _monthStart && i.DocumentDate <= _monthEnd)
            .Select(i => i.VatTotal.Amount)
            .ToListAsync();
        _outputVat = outputAmounts.Sum();

        // Input VAT — sum from posted purchase invoices in current month.
        var inputAmounts = await Db.Set<PurchaseInvoice>().AsNoTracking()
            .Where(p => p.State == DocumentState.Posted
                && p.DateReceived >= _monthStart && p.DateReceived <= _monthEnd)
            .Select(p => p.VatTotal.Amount)
            .ToListAsync();
        _inputVat = inputAmounts.Sum();

        _vatPayable = _outputVat - _inputVat;

        // ETA submission status counts
        _etaPending = await Db.Set<EtaSubmission>().AsNoTracking()
            .CountAsync(s => s.Status == EtaSubmissionStatus.Pending);
        _etaFailed = await Db.Set<EtaSubmission>().AsNoTracking()
            .CountAsync(s => s.Status == EtaSubmissionStatus.Failed);
        var critCutoff = now.AddHours(24);
        _etaCriticalCount = await Db.Set<EtaSubmission>().AsNoTracking()
            .CountAsync(s => (s.Status == EtaSubmissionStatus.Pending || s.Status == EtaSubmissionStatus.Failed)
                && s.SubmissionWindowExpiresAtUtc < critCutoff);

        // Risk: deductible expenses missing attachment (FR-016)
        var expenseAttachedIds = Db.Set<Attachment>().AsNoTracking()
            .Where(a => a.DocumentType == DocumentType.Expense)
            .Select(a => a.DocumentId);
        _expensesMissingAttachment = await Db.Set<Expense>().AsNoTracking()
            .Where(e => e.DeductibleFlag && !expenseAttachedIds.Contains(e.Id))
            .CountAsync();

        // Risk: purchase invoices with deductible lines missing attachment
        var purchaseAttachedIds = Db.Set<Attachment>().AsNoTracking()
            .Where(a => a.DocumentType == DocumentType.PurchaseInvoice)
            .Select(a => a.DocumentId);
        _purchasesMissingAttachment = await Db.Set<PurchaseInvoice>().AsNoTracking()
            .Where(p => p.Lines.Any(l => l.DeductibleFlag) && !purchaseAttachedIds.Contains(p.Id))
            .CountAsync();

        _draftsCount = await Db.Set<SalesInvoice>().AsNoTracking()
            .CountAsync(i => i.State == DocumentState.Draft);
        _pendingApprovalCount = await Db.Set<ApprovalRequest>().AsNoTracking()
            .CountAsync(r => r.ApprovedByUserId == null && r.RejectedByUserId == null);

        // Penalty Shield snapshot — uses its own DbContext via factory
        // so it doesn't contend with the queries above.
        try
        {
            _penalty = await PenaltyQuery.GetAsync(now);
        }
        catch
        {
            // Surface the rest of the dashboard even if penalty query fails.
        }

        // Activity feed — merge sales + purchases + expenses + approvals + audit
        var recentSales = await Db.Set<SalesInvoice>().AsNoTracking()
            .OrderByDescending(i => i.PostedAtUtc.HasValue)
            .ThenByDescending(i => i.PostedAtUtc)
            .ThenByDescending(i => i.DocumentDate)
            .Take(4)
            .Select(i => new { i.Id, i.DocumentNumber, i.GrandTotal, i.State, i.DocumentDate, i.PostedAtUtc })
            .ToListAsync();
        foreach (var r in recentSales)
        {
            var at = r.PostedAtUtc ?? r.DocumentDate.ToDateTime(TimeOnly.MinValue);
            _feed.Add(new FeedItem(
                IconName: "file-text",
                Tone: r.State == DocumentState.Posted ? "tone-success" : r.State == DocumentState.Draft ? "tone-info" : "tone-primary",
                Title: IsArabic ? $"فاتورة مبيعات {r.DocumentNumber ?? "(مسودة)"}" : $"Sales invoice {r.DocumentNumber ?? "(draft)"}",
                Meta: $"{r.GrandTotal.Amount:N2} {(IsArabic ? "ج.م." : "EGP")} · {r.State}",
                Href: $"invoices/{r.Id}",
                At: at));
        }

        var recentPurchases = await Db.Set<PurchaseInvoice>().AsNoTracking()
            .OrderByDescending(p => p.PostedAtUtc.HasValue)
            .ThenByDescending(p => p.PostedAtUtc)
            .ThenByDescending(p => p.DateReceived)
            .Take(3)
            .Select(p => new { p.Id, p.DocumentNumber, p.GrandTotal, p.State, p.DateReceived, p.PostedAtUtc })
            .ToListAsync();
        foreach (var r in recentPurchases)
        {
            var at = r.PostedAtUtc ?? r.DateReceived.ToDateTime(TimeOnly.MinValue);
            _feed.Add(new FeedItem(
                IconName: "package",
                Tone: r.State == DocumentState.Posted ? "tone-success" : "tone-info",
                Title: IsArabic ? $"فاتورة مشتريات {r.DocumentNumber ?? "(مسودة)"}" : $"Purchase invoice {r.DocumentNumber ?? "(draft)"}",
                Meta: $"{r.GrandTotal.Amount:N2} {(IsArabic ? "ج.م." : "EGP")} · {r.State}",
                Href: $"purchase-invoices/{r.Id}",
                At: at));
        }

        var recentExpenses = await Db.Set<Expense>().AsNoTracking()
            .OrderByDescending(e => e.PostedAtUtc.HasValue)
            .ThenByDescending(e => e.PostedAtUtc)
            .ThenByDescending(e => e.DocumentDate)
            .Take(2)
            .Select(e => new { e.Id, e.DocumentNumber, e.Amount, e.State, e.DocumentDate, e.PostedAtUtc })
            .ToListAsync();
        foreach (var r in recentExpenses)
        {
            var at = r.PostedAtUtc ?? r.DocumentDate.ToDateTime(TimeOnly.MinValue);
            _feed.Add(new FeedItem(
                IconName: "credit-card",
                Tone: "tone-info",
                Title: IsArabic ? $"مصروف {r.DocumentNumber ?? "(مسودة)"}" : $"Expense {r.DocumentNumber ?? "(draft)"}",
                Meta: $"{r.Amount.Amount:N2} {(IsArabic ? "ج.م." : "EGP")} · {r.State}",
                Href: $"expenses/{r.Id}",
                At: at));
        }

        var recentApprovals = await Db.Set<ApprovalRequest>().AsNoTracking()
            .OrderByDescending(r => r.SubmittedAtUtc)
            .Take(3)
            .Select(r => new { r.Id, r.DocumentType, r.DocumentId, r.SubmittedAtUtc, r.ApprovedByUserId, r.RejectedByUserId })
            .ToListAsync();
        foreach (var r in recentApprovals)
        {
            var (icon, tone, title) = r.RejectedByUserId is not null
                ? ("alert-triangle", "tone-danger", IsArabic ? "طلب اعتماد مرفوض" : "Approval rejected")
                : r.ApprovedByUserId is not null
                    ? ("check-circle", "tone-success", IsArabic ? "اعتماد تم" : "Approval granted")
                    : ("check-square", "tone-warning", IsArabic ? "طلب اعتماد جديد" : "Approval requested");
            _feed.Add(new FeedItem(
                IconName: icon,
                Tone: tone,
                Title: title,
                Meta: $"{r.DocumentType}",
                Href: "approvals",
                At: r.SubmittedAtUtc));
        }

        var recentAudits = await Db.Set<AuditLogEntry>().AsNoTracking()
            .OrderByDescending(a => a.TsUtc)
            .Take(2)
            .Select(a => new { a.Index, a.Kind, a.TsUtc })
            .ToListAsync();
        foreach (var r in recentAudits)
        {
            // Gux.6 — translate raw audit kinds to human-readable text.
            var translated = TranslateAuditEvent(r.Kind);
            _feed.Add(new FeedItem(
                IconName: "search",
                Tone: "tone-primary",
                Title: translated,
                Meta: $"#{r.Index}",
                Href: "audit-log",
                At: r.TsUtc));
        }

        _feed = _feed.OrderByDescending(f => f.At).Take(8).ToList();

        // Gux.7 — Upcoming deadlines (next 30 days, not yet filed).
        var deadlineHorizon = DateOnly.FromDateTime(now.AddDays(30));
        var todayDate = DateOnly.FromDateTime(now);
        _upcomingDeadlines = await Db.Set<ComplianceObligation>().AsNoTracking()
            .Where(o => o.Status == ComplianceObligationStatus.Upcoming
                && o.DueDate >= todayDate
                && o.DueDate <= deadlineHorizon)
            .OrderBy(o => o.DueDate)
            .Take(5)
            .ToListAsync();
    }

    /// <summary>Gux.6 — turn audit-log event kinds into a sentence
    /// the operator can read. Default fallback keeps the raw kind
    /// so unknown / new events still surface in the feed.</summary>
    private string TranslateAuditEvent(string kind) => (kind, IsArabic) switch
    {
        ("session.opened",                true)  => "تم فتح جلسة جديدة",
        ("session.opened",                false) => "Session started",
        ("session.closed",                true)  => "تم إنهاء الجلسة",
        ("session.closed",                false) => "Session ended",
        ("user.login.succeeded",          true)  => "تم تسجيل الدخول بنجاح",
        ("user.login.succeeded",          false) => "User signed in",
        ("user.login.failed",             true)  => "محاولة تسجيل دخول فاشلة",
        ("user.login.failed",             false) => "Failed sign-in attempt",
        ("sales_invoice.posted",          true)  => "تم ترحيل فاتورة مبيعات",
        ("sales_invoice.posted",          false) => "Sales invoice posted",
        ("purchase_invoice.posted",       true)  => "تم ترحيل فاتورة مشتريات",
        ("purchase_invoice.posted",       false) => "Purchase invoice posted",
        ("expense.posted",                true)  => "تم ترحيل مصروف",
        ("expense.posted",                false) => "Expense posted",
        ("eta_submission.acknowledged",   true)  => "تم اعتماد فاتورة من مصلحة الضرائب",
        ("eta_submission.acknowledged",   false) => "ETA acknowledged a submission",
        ("eta_submission.rejected",       true)  => "تم رفض فاتورة من مصلحة الضرائب",
        ("eta_submission.rejected",       false) => "ETA rejected a submission",
        ("eta_received.inbox_pulled",     true)  => "تم سحب فواتير جديدة من صندوق ETA",
        ("eta_received.inbox_pulled",     false) => "New documents pulled from ETA inbox",
        ("tax_period.locked",             true)  => "تم قفل فترة ضريبية",
        ("tax_period.locked",             false) => "Tax period locked",
        ("tax_period.locked.forced",      true)  => "تم قفل فترة ضريبية مع تجاوز التحذيرات",
        ("tax_period.locked.forced",      false) => "Tax period force-locked (warnings overridden)",
        ("tax_period.reopened",           true)  => "تم إعادة فتح فترة ضريبية",
        ("tax_period.reopened",           false) => "Tax period reopened",
        ("approval.requested",            true)  => "طلب اعتماد جديد",
        ("approval.requested",            false) => "Approval requested",
        ("approval.granted",              true)  => "تم منح اعتماد",
        ("approval.granted",              false) => "Approval granted",
        ("approval.rejected",             true)  => "تم رفض اعتماد",
        ("approval.rejected",             false) => "Approval rejected",
        ("audit_checkpoint.written",      true)  => "تم تثبيت نقطة تحقق للسجل",
        ("audit_checkpoint.written",      false) => "Audit checkpoint written",
        _ => IsArabic ? $"حدث: {kind}" : $"Event: {kind}",
    };

    private string DeadlineKindLabel(ComplianceObligationKind kind) => (kind, IsArabic) switch
    {
        (ComplianceObligationKind.VatMonthly,        true)  => "إقرار الضريبة الشهري",
        (ComplianceObligationKind.VatMonthly,        false) => "Monthly VAT return",
        (ComplianceObligationKind.VatQuarterly,      true)  => "إقرار الضريبة الربع سنوي",
        (ComplianceObligationKind.VatQuarterly,      false) => "Quarterly VAT return",
        (ComplianceObligationKind.Form41Quarterly,   true)  => "نموذج 41 — الخصم الربع سنوي",
        (ComplianceObligationKind.Form41Quarterly,   false) => "Form 41 — quarterly WHT",
        (ComplianceObligationKind.IncomeTaxAnnual,   true)  => "إقرار ضريبة الدخل السنوي",
        (ComplianceObligationKind.IncomeTaxAnnual,   false) => "Annual income-tax return",
        (ComplianceObligationKind.TurnoverTaxAnnual, true)  => "إقرار ضريبة معدل الدوران السنوي",
        (ComplianceObligationKind.TurnoverTaxAnnual, false) => "Annual turnover-tax return",
        _ => kind.ToString(),
    };

    private string DeadlineUrgencyClass(DateOnly due)
    {
        var days = due.DayNumber - DateOnly.FromDateTime(DateTime.UtcNow).DayNumber;
        return days <= 3 ? "deadline-urgent" : days <= 7 ? "deadline-warn" : "deadline-ok";
    }

    private string MonthName(int m) => IsArabic
        ? m switch
        {
            1 => "يناير", 2 => "فبراير", 3 => "مارس", 4 => "أبريل",
            5 => "مايو", 6 => "يونيو", 7 => "يوليو", 8 => "أغسطس",
            9 => "سبتمبر", 10 => "أكتوبر", 11 => "نوفمبر", 12 => "ديسمبر",
            _ => $"الشهر {m}",
        }
        : CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(m);

    private string RelativeTime(DateTime at)
    {
        var span = DateTime.UtcNow - at;
        if (span.TotalMinutes < 1) return IsArabic ? "الآن" : "just now";
        if (span.TotalHours < 1) return IsArabic ? $"منذ {(int)span.TotalMinutes} د" : $"{(int)span.TotalMinutes}m ago";
        if (span.TotalDays < 1) return IsArabic ? $"منذ {(int)span.TotalHours} س" : $"{(int)span.TotalHours}h ago";
        if (span.TotalDays < 30) return IsArabic ? $"منذ {(int)span.TotalDays} يوم" : $"{(int)span.TotalDays}d ago";
        return at.ToString("yyyy-MM-dd");
    }
}

<h1>@(IsArabic ? "نظرة عامة" : "Overview")</h1>
<p class="page-subtitle">
    @(IsArabic
        ? $"ملخص حركتك المحاسبية والامتثال الضريبي لفترة {_periodLabel}."
        : $"Your accounting and tax-compliance snapshot for {_periodLabel}.")
</p>

<!-- Period banner: open vs locked -->
<div class="period-banner @(_periodStatus == TaxPeriodStatus.Locked ? "is-locked" : "")">
    <div class="pb-icon">
        <Icon Name="@(_periodStatus == TaxPeriodStatus.Locked ? "lock" : "lock-open")" Class="ic" />
    </div>
    <div>
        <div class="pb-title">
            @(IsArabic ? "فترة الضريبة الشهرية:" : "Monthly VAT period:") @_periodLabel
            @if (_periodStatus == TaxPeriodStatus.Locked)
            {
                <span> · @(IsArabic ? "مقفولة" : "Locked")</span>
            }
            else
            {
                <span> · @(IsArabic ? "مفتوحة" : "Open")</span>
            }
        </div>
        <div class="pb-meta">
            @if (_periodStatus == TaxPeriodStatus.Locked && _periodLockedAtUtc is { } at)
            {
                @(IsArabic ? $"قُفلت في {at:yyyy-MM-dd HH:mm} UTC — أي تعديل يحتاج إعادة فتح من المسؤول." : $"Locked at {at:yyyy-MM-dd HH:mm} UTC — re-opening requires Administrator action.")
            }
            else
            {
                @(IsArabic ? "الفترة قابلة للتعديل والترحيل. اقفلها بعد إنهاء الإقرار الشهري." : "Period accepts new postings. Lock after filing the monthly return.")
            }
        </div>
    </div>
    <div class="pb-actions">
        <button type="button" class="btn-primary" @onclick="() => _cockpitOpen = true">
            <Icon Name="target" Class="ic" />@(IsArabic ? "إقفال الشهر" : "Close month")
        </button>
        <a href="settings/tax-periods" class="btn-secondary"><Icon Name="calendar" Class="ic" />@(IsArabic ? "إدارة الفترات" : "Manage periods")</a>
    </div>
</div>

@*
    Gux.9 — Closing Cockpit drawer. Slides in from the inline-end
    (right in Arabic, left in English). Shared body with /cockpit so
    direct links still work. Backdrop click + Esc would be ideal but
    we keep it to button-driven open/close for now.
*@
@if (_cockpitOpen)
{
    <div class="drawer-backdrop" @onclick="() => _cockpitOpen = false"></div>
    <aside class="cockpit-drawer" role="dialog" aria-modal="true">
        <header class="drawer-head">
            <strong>@(IsArabic ? "إقفال الشهر" : "Close month")</strong>
            <button type="button" class="drawer-close" @onclick="() => _cockpitOpen = false"
                    aria-label="@(IsArabic ? "إغلاق" : "Close")">×</button>
        </header>
        <div class="drawer-body">
            <ClosingCockpitPanel />
        </div>
    </aside>
}

<!-- Gux.4 — Action buttons at the TOP. The most common operator
     intent is "create a thing"; surface that before any KPI. -->
<section class="dashboard-actions">
    <a class="dashboard-action-btn" href="invoices/new">
        <Icon Name="file-text" Class="ic" />
        <div>
            <div class="action-title">@(IsArabic ? "فاتورة مبيعات جديدة" : "New sales invoice")</div>
            <div class="action-desc">@(IsArabic ? "أنشئ، رحّل، وأرسل لمصلحة الضرائب" : "Create, post, submit to ETA")</div>
        </div>
    </a>
    <a class="dashboard-action-btn" href="expenses/new">
        <Icon Name="credit-card" Class="ic" />
        <div>
            <div class="action-title">@(IsArabic ? "مصروف جديد" : "New expense")</div>
            <div class="action-desc">@(IsArabic ? "صنّف وأرفق الإيصال" : "Categorise + attach receipt")</div>
        </div>
    </a>
    <a class="dashboard-action-btn" href="purchase-invoices/new">
        <Icon Name="package" Class="ic" />
        <div>
            <div class="action-title">@(IsArabic ? "فاتورة مشتريات" : "New purchase")</div>
            <div class="action-desc">@(IsArabic ? "سجّل فاتورة من مورد" : "Record a supplier invoice")</div>
        </div>
    </a>
</section>

<!-- Gux.4 + Gux.5 — Three colour-coded KPI cards (was six). Each
     card has a single clear status (green / amber / red) the operator
     can read at a glance. -->
<section class="kpi-grid kpi-grid-3">
    @{
        var penaltyTone = _penalty switch
        {
            null => "kpi-card-ok",
            { ProjectedThisMonthEgp: 0 } => "kpi-card-ok",
            { ProjectedThisMonthEgp: < 5000 } => "kpi-card-warn",
            _ => "kpi-card-danger",
        };
    }
    <a href="penalty-shield" class="kpi-card-v2 @penaltyTone">
        <div class="kpi-v2-label"><Icon Name="shield-check" Class="ic" />@(IsArabic ? "درع الغرامات" : "Penalty Shield")</div>
        <div class="kpi-v2-value">
            @(_penalty?.ProjectedThisMonthEgp.ToString("N0") ?? "—")
            <span class="kpi-v2-unit">@(IsArabic ? "ج.م." : "EGP")</span>
        </div>
        <div class="kpi-v2-meta">
            @if (_penalty is { AvoidableIfActedTodayEgp: > 0 })
            {
                @(IsArabic ? $"وفّر {_penalty.AvoidableIfActedTodayEgp:N0} ج.م. النهارده ←" : $"Save {_penalty.AvoidableIfActedTodayEgp:N0} EGP today →")
            }
            else
            {
                @(IsArabic ? "كل الفواتير في الميعاد ✓" : "All invoices on time ✓")
            }
        </div>
    </a>

    @{
        var vatTone = _vatPayable <= 0 ? "kpi-card-ok"
                    : _vatPayable < 5000 ? "kpi-card-warn"
                    : "kpi-card-danger";
    }
    <a href="reports/vat-monthly" class="kpi-card-v2 @vatTone">
        <div class="kpi-v2-label"><Icon Name="percent" Class="ic" />@(IsArabic ? "الضريبة المستحقة" : "VAT due")</div>
        <div class="kpi-v2-value">
            @_vatPayable.ToString("N0")<span class="kpi-v2-unit">@(IsArabic ? "ج.م." : "EGP")</span>
        </div>
        <div class="kpi-v2-meta">
            @(IsArabic ? "مخرجات" : "Output") @_outputVat.ToString("N0")
            <span style="opacity:0.5"> · </span>
            @(IsArabic ? "مدخلات" : "Input") @_inputVat.ToString("N0")
        </div>
    </a>

    @{
        var etaTone = (_etaFailed > 0 || _etaCriticalCount > 0) ? "kpi-card-danger"
                    : _etaPending >= 5 ? "kpi-card-warn"
                    : _etaPending > 0 ? "kpi-card-warn"
                    : "kpi-card-ok";
    }
    <a href="eta-dashboard" class="kpi-card-v2 @etaTone">
        <div class="kpi-v2-label"><Icon Name="shield" Class="ic" />@(IsArabic ? "الفاتورة الإلكترونية" : "ETA status")</div>
        <div class="kpi-v2-value">
            @(_etaPending + _etaFailed)<span class="kpi-v2-unit">@(IsArabic ? "إرسال" : "open")</span>
        </div>
        <div class="kpi-v2-meta">
            @if (_etaFailed > 0)
            {
                <span>@_etaFailed @(IsArabic ? "فاشل" : "failed") · </span>
            }
            <span>@_etaPending @(IsArabic ? "قيد الإرسال" : "pending")</span>
            @if (_etaCriticalCount > 0)
            {
                <span> · </span>
                <span style="font-weight:600;">@_etaCriticalCount @(IsArabic ? "حرج خلال 24س" : "critical (&lt;24h)")</span>
            }
        </div>
    </a>
</section>

<!-- Gux.7 — Upcoming-deadlines widget. Tax deadlines are the #1
     customer anxiety per the market analysis; surface them here so
     the operator never has to remember to check the calendar. -->
<section class="dashboard-row">
    <div class="dashboard-col">
        <h2 class="dashboard-section-h2">@(IsArabic ? "📅 المواعيد القادمة" : "📅 Upcoming deadlines")</h2>
        @if (_upcomingDeadlines.Count == 0)
        {
            <div class="kpi-card kpi-success">
                @(IsArabic
                    ? "لا توجد مواعيد ضريبية في الـ 30 يوم القادمة. ✓"
                    : "No tax deadlines in the next 30 days. ✓")
            </div>
        }
        else
        {
            <ul class="deadline-list">
                @foreach (var d in _upcomingDeadlines)
                {
                    var days = d.DueDate.DayNumber - DateOnly.FromDateTime(DateTime.UtcNow).DayNumber;
                    <li class="deadline-row @DeadlineUrgencyClass(d.DueDate)">
                        <div class="deadline-date">
                            <div class="deadline-date-day">@d.DueDate.Day</div>
                            <div class="deadline-date-month">@MonthName(d.DueDate.Month)</div>
                        </div>
                        <div class="deadline-body">
                            <div class="deadline-title">@DeadlineKindLabel(d.Kind)</div>
                            <div class="deadline-meta">
                                @if (days <= 0)
                                {
                                    @(IsArabic ? "مستحقة اليوم" : "due today")
                                }
                                else if (days == 1)
                                {
                                    @(IsArabic ? "بعد يوم" : "in 1 day")
                                }
                                else
                                {
                                    @(IsArabic ? $"بعد {days} يوم" : $"in {days} days")
                                }
                            </div>
                        </div>
                        <a href="compliance/calendar" class="deadline-cta">→</a>
                    </li>
                }
            </ul>
        }
    </div>

    <div class="dashboard-col">
        <h2 class="dashboard-section-h2">@(IsArabic ? "🔗 روابط سريعة" : "🔗 Quick links")</h2>
        <div class="dashboard-quicklinks">
            <a href="reports/vat-monthly" class="quicklink-row">
                <Icon Name="bar-chart" Class="ic" />
                <span>@(IsArabic ? "تقرير الضريبة الشهري" : "Monthly VAT report")</span>
            </a>
            <a href="reports/trial-balance" class="quicklink-row">
                <Icon Name="scale" Class="ic" />
                <span>@(IsArabic ? "ميزان المراجعة" : "Trial balance")</span>
            </a>
            <a href="cockpit" class="quicklink-row">
                <Icon Name="target" Class="ic" />
                <span>@(IsArabic ? "قمرة الإقفال الشهري" : "Closing cockpit")</span>
            </a>
            <a href="payments/unmatched" class="quicklink-row">
                <Icon Name="search" Class="ic" />
                <span>@(IsArabic ? "بنود البنك غير المطابقة" : "Unmatched bank lines")</span>
            </a>
        </div>
    </div>
</section>

<!-- Activity feed -->
<h2>@(IsArabic ? "آخر النشاط" : "Recent activity")</h2>
<section class="activity-feed">
    @if (_feed.Count == 0)
    {
        <div class="activity-item" style="border-bottom:none;">
            <div class="activity-icon tone-info"><Icon Name="activity" Class="ic" /></div>
            <div class="activity-content">
                @(IsArabic ? "لا يوجد نشاط بعد. ابدأ بإنشاء فاتورة مبيعات أو سجّل أول مصروف." : "No activity yet. Start by creating a sales invoice or logging your first expense.")
            </div>
        </div>
    }
    else
    {
        @foreach (var item in _feed)
        {
            <div class="activity-item">
                <div class="activity-icon @item.Tone"><Icon Name="@item.IconName" Class="ic" /></div>
                <div class="activity-content">
                    @if (item.Href is { } href)
                    {
                        <a href="@href">@item.Title</a>
                    }
                    else
                    {
                        <span>@item.Title</span>
                    }
                    <div class="activity-meta">
                        <span>@item.Meta</span>
                        <span class="meta-sep">·</span>
                        <span>@RelativeTime(item.At)</span>
                    </div>
                </div>
            </div>
        }
    }
</section>
