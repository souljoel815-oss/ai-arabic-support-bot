@page "/firm-portal"
@using EgyptTax.Application.FirmPortal
@using EgyptTax.Domain.Identity
@using EgyptTax.Domain.Workflow
@using EgyptTax.Infrastructure.FirmPortal
@using EgyptTax.Infrastructure.Persistence
@using EgyptTax.SharedKernel
@using EgyptTax.SharedKernel.Time
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject IClock Clock
@inject NavigationManager Nav
@attribute [Authorize(Policy = "NotSalesRepOnly")]

<h1>@(IsArabic ? "وضع المراجعة" : "Firm portal — review mode (Differentiator 3)")</h1>

<p>
    <em>
        @(IsArabic
            ? "صفحة المكاتب المحاسبية العاملة على تثبيت هذا العميل. تعرض أقفال المراجعة النشطة (مصافحة FR-050 الناعمة التي يرفعها مَن يمسك الدفاتر عندما تكون السجلات جاهزة)، إضافة إلى قائمة مستخدمي المكتب على هذا التثبيت. للتبديل إلى تثبيت عميل آخر استخدم"
            : "Surface for accounting firms working on this client's installation. Lists active review-locks (the soft FR-050 handshake the bookkeeper raised when their books were ready), plus this installation's firm-user roster. Switching to a different client installation is on the")
        <a href="/firm-portal/switch">@(IsArabic ? "صفحة التبديل" : "switcher page")</a>.
    </em>
</p>

@if (_savedFlash is not null)
{
    <div class="flash-success" role="status">@_savedFlash</div>
}
@if (_error is not null)
{
    <div class="flash-error" role="alert">@_error</div>
}

<section>
    <h2>@(IsArabic ? "أقفال المراجعة النشطة (FR-050)" : "Active review-locks (FR-050)")</h2>
    @if (_activeLocks is null)
    {
        <p>@(IsArabic ? "جارٍ التحميل…" : "Loading…")</p>
    }
    else if (_activeLocks.Count == 0)
    {
        <p>
            <em>
                @(IsArabic
                    ? "لا يوجد شهر مقفول للمراجعة حالياً. مَن يمسك الدفاتر يرفع القفل من قمرة الإقفال عند انتهائه من تعديل الشهر ورغبته في مراجعة أحد المكتب له."
                    : "No months are currently locked for review. The bookkeeper raises the lock from the closing cockpit when they're done editing a month and want a firm reviewer to look at it.")
            </em>
        </p>
    }
    else
    {
        <table class="data-grid">
            <thead>
                <tr>
                    <th>@(IsArabic ? "الفترة" : "Period")</th>
                    <th>@(IsArabic ? "وقت القفل (UTC)" : "Locked at (UTC)")</th>
                    <th>@(IsArabic ? "أقفله (رقم المستخدم)" : "Locked by (user id)")</th>
                    <th>@(IsArabic ? "ملاحظة" : "Note")</th>
                    <th class="num">@(IsArabic ? "تعديلات حتى الآن" : "Adjusting actions so far")</th>
                    <th>@(IsArabic ? "إجراءات" : "Actions")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in _activeLocks)
                {
                    <tr class="active-row">
                        <td>@l.PeriodYear-@l.PeriodMonth.ToString("D2")</td>
                        <td>@l.LockedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td><code>@l.LockedByUserId.ToString("D")</code></td>
                        <td>@(l.LockedNote ?? "—")</td>
                        <td class="num">@l.AccountantActionsDuringLock</td>
                        <td>
                            <button type="button" class="btn-primary"
                                @onclick="() => OnReleaseAsync(l.Id)" disabled="@_busy">
                                @(IsArabic ? "تحرير" : "Release")
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section>
    <h2>+ @(IsArabic ? "إقفال شهر للمراجعة" : "Lock a month for review")</h2>
    <p>
        <em>
            @(IsArabic
                ? "ماسكو الدفاتر يرفعون القفل من"
                : "Bookkeepers raise the lock from the")
            <a href="/cockpit">@(IsArabic ? "قمرة الإقفال" : "closing cockpit")</a>.
            @(IsArabic
                ? "ومراجعو المكاتب يقدرون يرفعونه بأنفسهم لو حابين «يجمدوا» الشهر أثناء عملهم عليه."
                : "Firm reviewers can also raise it themselves if they want to \"freeze\" a month while they're working through it.")
        </em>
    </p>
    <form @onsubmit="OnLockAsync" @onsubmit:preventDefault>
        <div class="invoice-toolbar">
            <label>
                <span>@(IsArabic ? "السنة" : "Year")</span>
                <input type="number" min="2020" max="2099" @bind="_lockYear" required />
            </label>
            <label>
                <span>@(IsArabic ? "الشهر" : "Month")</span>
                <input type="number" min="1" max="12" @bind="_lockMonth" required />
            </label>
            <label>
                <span>@(IsArabic ? "رقم المستخدم القافل" : "Locked-by user id")</span>
                <input type="text" @bind="_lockByUserId" required />
            </label>
        </div>
        <div class="invoice-toolbar">
            <label style="flex: 1;">
                <span>@(IsArabic ? "ملاحظة (اختياري)" : "Note (optional)")</span>
                <input type="text" @bind="_lockNote" />
            </label>
        </div>
        <p>
            <button type="submit" class="btn-primary" disabled="@_busy">
                @(_busy ? (IsArabic ? "جارٍ الحفظ…" : "Saving…") : (IsArabic ? "إقفال للمراجعة" : "Lock for review"))
            </button>
        </p>
    </form>
</section>

<section>
    <h2>@(IsArabic ? "أقفال المراجعة المُحرَّرة (التاريخ)" : "Released review-locks (history)")</h2>
    @if (_releasedLocks is null)
    {
        <p>@(IsArabic ? "جارٍ التحميل…" : "Loading…")</p>
    }
    else if (_releasedLocks.Count == 0)
    {
        <p><em>@(IsArabic ? "لا توجد أقفال مُحرَّرة بعد." : "No released locks yet.")</em></p>
    }
    else
    {
        <table class="data-grid">
            <thead>
                <tr>
                    <th>@(IsArabic ? "الفترة" : "Period")</th>
                    <th>@(IsArabic ? "وقت القفل (UTC)" : "Locked at (UTC)")</th>
                    <th>@(IsArabic ? "وقت التحرير (UTC)" : "Released at (UTC)")</th>
                    <th class="num">@(IsArabic ? "تعديلات أثناء القفل" : "Adjusting actions during lock")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in _releasedLocks)
                {
                    <tr class="row-muted">
                        <td>@l.PeriodYear-@l.PeriodMonth.ToString("D2")</td>
                        <td>@l.LockedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@(l.ReleasedAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                        <td class="num">@l.AccountantActionsDuringLock</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section>
    <h2>@(IsArabic ? "قائمة مستخدمي المكتب على هذا التثبيت" : "Firm-user roster on this installation")</h2>
    @if (_firmUsers is null)
    {
        <p>@(IsArabic ? "جارٍ التحميل…" : "Loading…")</p>
    }
    else if (_firmUsers.Count == 0)
    {
        <p><em>@(IsArabic ? "لم يتم دعوة أي مستخدم مكتب بعد." : "No firm users invited yet.")</em></p>
    }
    else
    {
        <table class="data-grid">
            <thead>
                <tr>
                    <th>@(IsArabic ? "المكتب" : "Firm")</th>
                    <th>@(IsArabic ? "جهة الاتصال" : "Contact")</th>
                    <th>@(IsArabic ? "تاريخ الدعوة (UTC)" : "Invited at (UTC)")</th>
                    <th>@(IsArabic ? "تاريخ القبول" : "Accepted at")</th>
                    <th>@(IsArabic ? "الحالة" : "Status")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in _firmUsers)
                {
                    <tr class="@(u.RevokedAtUtc is null ? "active-row" : "row-muted")">
                        <td><strong>@u.FirmName</strong></td>
                        <td><code>@u.FirmExternalIdentifier</code></td>
                        <td>@u.InvitedAtUtc.ToString("yyyy-MM-dd")</td>
                        <td>@(u.AcceptedAtUtc?.ToString("yyyy-MM-dd") ?? (IsArabic ? "(قيد القبول)" : "(pending)"))</td>
                        <td>
                            @if (u.RevokedAtUtc is not null)
                            {
                                <span class="flash-error">@(IsArabic ? "مُلغى" : "Revoked") @u.RevokedAtUtc?.ToString("yyyy-MM-dd")</span>
                            }
                            else if (u.AcceptedAtUtc is not null)
                            {
                                <span>@(IsArabic ? "نشط" : "Active")</span>
                            }
                            else
                            {
                                <span>@(IsArabic ? "قيد القبول" : "Pending")</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    private List<PeriodReviewLock>? _activeLocks;
    private List<PeriodReviewLock>? _releasedLocks;
    private List<AccountantFirmUser>? _firmUsers;

    private int _lockYear = DateTime.UtcNow.Year;
    private int _lockMonth = DateTime.UtcNow.Month;
    private string _lockByUserId = "";
    private string _lockNote = "";

    private string? _savedFlash;
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _activeLocks = await Db.Set<PeriodReviewLock>().AsNoTracking()
            .Where(l => l.ReleasedAtUtc == null)
            .OrderByDescending(l => l.LockedAtUtc)
            .ToListAsync();
        _releasedLocks = await Db.Set<PeriodReviewLock>().AsNoTracking()
            .Where(l => l.ReleasedAtUtc != null)
            .OrderByDescending(l => l.ReleasedAtUtc)
            .Take(50)
            .ToListAsync();
        _firmUsers = await Db.Set<AccountantFirmUser>().AsNoTracking()
            .OrderByDescending(a => a.InvitedAtUtc)
            .ToListAsync();
    }

    private async Task OnLockAsync()
    {
        _error = null; _savedFlash = null; _busy = true;
        try
        {
            if (!Guid.TryParse(_lockByUserId, out var lockedBy))
            {
                _error = IsArabic ? "رقم المستخدم القافل يجب أن يكون Guid صالح." : "Locked-by user id must be a valid Guid.";
                return;
            }
            var auditStore = new EgyptTax.Infrastructure.Audit.SqlAuditLogStore(Db);
            var handler = new PeriodReviewLockHandler(Db, Clock, auditStore);
            var locked = await handler.LockAsync(new LockForReviewCommand(
                PeriodYear: _lockYear,
                PeriodMonth: _lockMonth,
                LockedByUserId: lockedBy,
                Note: string.IsNullOrWhiteSpace(_lockNote) ? null : _lockNote),
                CancellationToken.None);
            _savedFlash = IsArabic
                ? $"تم إقفال {locked.PeriodYear}-{locked.PeriodMonth:D2} للمراجعة."
                : $"Locked {locked.PeriodYear}-{locked.PeriodMonth:D2} for review.";
            _lockNote = "";
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task OnReleaseAsync(Guid lockId)
    {
        _error = null; _savedFlash = null; _busy = true;
        try
        {
            if (!Guid.TryParse(_lockByUserId, out var releasedBy))
            {
                _error = IsArabic
                    ? "اضبط رقم المستخدم القافل (يُستخدم هنا كمحرِّر) قبل التحرير."
                    : "Set Locked-by user id (used here as releaser) before releasing.";
                return;
            }
            var auditStore = new EgyptTax.Infrastructure.Audit.SqlAuditLogStore(Db);
            var handler = new PeriodReviewLockHandler(Db, Clock, auditStore);
            var released = await handler.ReleaseAsync(new ReleaseReviewCommand(lockId, releasedBy), CancellationToken.None);
            _savedFlash = IsArabic
                ? $"تم تحرير {released.PeriodYear}-{released.PeriodMonth:D2} بعد {released.AccountantActionsDuringLock} تعديل."
                : $"Released {released.PeriodYear}-{released.PeriodMonth:D2} after {released.AccountantActionsDuringLock} adjusting action(s).";
            await ReloadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
