@page "/login"
@using System.Globalization
@model EgyptTax.Web.Pages.Auth.LoginModel
@{
    var isArabic = CultureInfo.CurrentCulture.Name.StartsWith("ar", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = isArabic ? "تسجيل الدخول" : "Sign in";
    ViewData["BodyClass"] = "auth-page";
}

<div class="auth-page-shell">
    <div class="auth-page-card">
        <div class="auth-brand">
            <img class="auth-brand-img" src="/images/daftarx-logo.png" alt="DaftarX"
                 onerror="this.style.display='none';this.nextElementSibling.style.display='grid';this.nextElementSibling.nextElementSibling.style.display='block';" />
            <div class="auth-brand-mark" style="display:none;">DX</div>
            <div class="auth-brand-name" style="display:none;">DaftarX</div>
        </div>

        <h1>@(isArabic ? "تسجيل الدخول" : "Sign in")</h1>
        <p>@(isArabic ? "ادخل بياناتك للوصول إلى حسابك المحاسبي." : "Enter your credentials to access your accounting workspace.")</p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="auth-error" role="alert">@Model.ErrorMessage</div>
        }

        <form method="post" class="auth-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

            <label>
                <span>@(isArabic ? "البريد الإلكتروني" : "Email")</span>
                <input asp-for="Input.Email" type="email" autocomplete="username" required />
            </label>

            <label>
                <span>@(isArabic ? "كلمة المرور" : "Password")</span>
                <input asp-for="Input.Password" type="password" autocomplete="current-password" required />
            </label>

            @if (Model.ShowMfaPrompt)
            {
                <label>
                    <span>@(isArabic ? "رمز التحقق (TOTP)" : "Verification code (TOTP)")</span>
                    <input asp-for="Input.TotpCode" type="text" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code" />
                </label>
            }

            <button type="submit">@(isArabic ? "تسجيل الدخول" : "Sign in")</button>
        </form>

        <p style="margin-top: 1.5rem; margin-bottom: 0; text-align: center; font-size: 13px;">
            @if (isArabic)
            {
                <a href="/set-culture?culture=en-US&returnUrl=/login">English</a>
            }
            else
            {
                <a href="/set-culture?culture=ar-EG&returnUrl=/login">العربية</a>
            }
        </p>
    </div>
</div>
