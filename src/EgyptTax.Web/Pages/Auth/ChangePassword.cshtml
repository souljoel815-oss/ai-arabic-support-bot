@page "/password/change"
@model EgyptTax.Web.Pages.Auth.ChangePasswordModel
@{
    ViewData["Title"] = IsArabic ? "تغيير كلمة المرور" : "Change password";
    ViewData["BodyClass"] = "auth-page";
}

<div class="auth-page-shell">
    <div class="auth-page-card">
        <div class="auth-brand">
            <div class="auth-brand-mark">DX</div>
            <div class="auth-brand-name">DaftarX</div>
        </div>

        <h1>@(IsArabic ? "تغيير كلمة المرور" : "Change password")</h1>
        <p>@(IsArabic ? "وفقاً لـ FR-038، يجب استبدال كلمة المرور الأولية قبل المتابعة." : "Per FR-038, the bootstrap password must be replaced before continuing.")</p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="auth-error" role="alert">@Model.ErrorMessage</div>
        }

        <form method="post" class="auth-form">
            @Html.AntiForgeryToken()

            <label>
                <span>@(IsArabic ? "كلمة المرور الجديدة" : "New password")</span>
                <input asp-for="Input.NewPassword" type="password" autocomplete="new-password" minlength="12" maxlength="128" required />
            </label>

            <label>
                <span>@(IsArabic ? "تأكيد كلمة المرور الجديدة" : "Confirm new password")</span>
                <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" minlength="12" maxlength="128" required />
            </label>

            <button type="submit">@(IsArabic ? "حفظ" : "Save")</button>
        </form>
    </div>
</div>
