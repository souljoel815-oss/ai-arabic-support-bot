@page "/password/change"
@model EgyptTax.Web.Pages.Auth.ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
}

<h1>Change password / تغيير كلمة المرور</h1>
<p>Per FR-038, the bootstrap password must be replaced before continuing.</p>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="auth-error" role="alert">@Model.ErrorMessage</div>
}

<form method="post" class="auth-form">
    @Html.AntiForgeryToken()

    <label>
        <span>New password</span>
        <input asp-for="Input.NewPassword" type="password" autocomplete="new-password" minlength="12" maxlength="128" required />
    </label>

    <label>
        <span>Confirm new password</span>
        <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" minlength="12" maxlength="128" required />
    </label>

    <button type="submit">Save</button>
</form>
