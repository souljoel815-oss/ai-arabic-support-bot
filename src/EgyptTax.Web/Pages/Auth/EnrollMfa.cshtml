@page "/mfa/enroll"
@model EgyptTax.Web.Pages.Auth.EnrollMfaModel
@{
    ViewData["Title"] = IsArabic ? "تسجيل المصادقة الثنائية" : "Enroll MFA";
    ViewData["BodyClass"] = "auth-page";
}

<div class="auth-page-shell">
    <div class="auth-page-card">
        <div class="auth-brand">
            <img class="auth-brand-img" src="/images/daftarx-logo.png" alt="DaftarX"
                 onerror="this.style.display='none';this.nextElementSibling.style.display='grid';this.nextElementSibling.nextElementSibling.style.display='block';" />
            <div class="auth-brand-mark" style="display:none;">DX</div>
            <div class="auth-brand-name" style="display:none;">DaftarX</div>
        </div>

        <h1>@(IsArabic ? "تسجيل المصادقة الثنائية" : "Enrol multi-factor authentication")</h1>
        <p>@(IsArabic
            ? "وفقاً لـ FR-002، الأدوار المدير والمعتِمد تتطلب المصادقة الثنائية. امسح رابط التهيئة في تطبيق المصادقة، ثم أدخل رمز التحقق."
            : "Per FR-002, Administrator and Approver roles require MFA. Scan the provisioning URI into your authenticator app, then enter the 6-digit verification code.")</p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="auth-error" role="alert">@Model.ErrorMessage</div>
        }

        <section class="auth-mfa-secret">
            <strong style="display:block;margin-bottom:8px;font-size:12px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.04em;">@(IsArabic ? "رابط التهيئة" : "Provisioning URI")</strong>
            <code id="provisioning-uri">@Model.ProvisioningUri</code>
            <strong style="display:block;margin:16px 0 8px;font-size:12px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.04em;">@(IsArabic ? "أو أدخل يدوياً" : "Or enter manually")</strong>
            <p style="margin:0;font-size:13px;">
                @(IsArabic ? "الحساب:" : "Account:") @User.Identity?.Name<br />
                @(IsArabic ? "الجهة المصدرة:" : "Issuer:") EgyptTax<br />
                @(IsArabic ? "السر:" : "Secret:") <code id="enrollment-secret">@Model.Secret</code>
            </p>
        </section>

        <form method="post" class="auth-form">
            @Html.AntiForgeryToken()
            <input asp-for="Input.StagedSecretCipher" type="hidden" value="@Model.StagedSecretCipher" />

            <label>
                <span>@(IsArabic ? "رمز التحقق (TOTP)" : "Verification code (TOTP)")</span>
                <input asp-for="Input.TotpCode" type="text" inputmode="numeric" pattern="[0-9]{6}" autocomplete="one-time-code" maxlength="6" required />
            </label>

            <button type="submit">@(IsArabic ? "تسجيل" : "Enrol")</button>
        </form>
    </div>
</div>
