@page "/mfa/enroll"
@model EgyptTax.Web.Pages.Auth.EnrollMfaModel
@{
    ViewData["Title"] = "Enroll MFA";
}

<h1>Enrol multi-factor authentication / تسجيل المصادقة الثنائية</h1>
<p>Per FR-002, Administrator and Approver roles require MFA. Scan the provisioning URI into your authenticator app, then enter the 6-digit verification code.</p>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="auth-error" role="alert">@Model.ErrorMessage</div>
}

<section class="auth-mfa-secret">
    <h2>Provisioning URI</h2>
    <code id="provisioning-uri">@Model.ProvisioningUri</code>
    <h2>Or enter manually</h2>
    <p>Account: @User.Identity?.Name &emsp; Issuer: EgyptTax &emsp; Secret: <code id="enrollment-secret">@Model.Secret</code></p>
</section>

<form method="post" class="auth-form">
    @Html.AntiForgeryToken()
    <input asp-for="Input.StagedSecretCipher" type="hidden" value="@Model.StagedSecretCipher" />

    <label>
        <span>Verification code (TOTP)</span>
        <input asp-for="Input.TotpCode" type="text" inputmode="numeric" pattern="[0-9]{6}" autocomplete="one-time-code" maxlength="6" required />
    </label>

    <button type="submit">Enrol</button>
</form>
