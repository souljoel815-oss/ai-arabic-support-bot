@page "/inspection-bundle"
@using EgyptTax.Application.Inspection
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@inject IInspectionBundleBuilder Builder
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime Js
@attribute [Authorize(Policy = "FullyAuthenticated")]

<h1>@(IsArabic ? "إنشاء حزمة فحص ضريبي (US9 / FR-048)" : "Generate tax-inspection bundle (US9 / FR-048)")</h1>

<p>
    @(IsArabic
        ? "ينتج ملف مضغوط (ZIP) للفترة المحددة يحوي مستخرج سجل التدقيق، وكل المرفقات للمستندات المُرحَّلة في الفترة، إلى جانب فهرس SHA-256. سلِّم الحزمة للمفتش — يقدر يعيد التحقق من سلامتها على جهاز نظيف باستخدام التعليمات في README-FOR-INSPECTOR.md المضمّن."
        : "Builds a period-scoped ZIP containing the audit-trail extract, every attachment for posted documents in the period, and a SHA-256 manifest. Hand the bundle to the inspector — they can re-verify integrity on a clean machine using the instructions in the bundled README-FOR-INSPECTOR.md.")
</p>

<form class="invoice-toolbar" @onsubmit="OnGenerateAsync" @onsubmit:preventDefault>
    <label>
        <span>@(IsArabic ? "بداية الفترة" : "Period start")</span>
        <input type="date" @bind="_periodStart" />
    </label>
    <label>
        <span>@(IsArabic ? "نهاية الفترة" : "Period end")</span>
        <input type="date" @bind="_periodEnd" />
    </label>
    <label>
        <input type="checkbox" @bind="_allowDrafts" />
        @(IsArabic
            ? "السماح بالمسودات في الفترة (تُكتب أرقامها في الفهرس كمستثناة)"
            : "Allow drafts in period (write their ids into the manifest as excluded)")
    </label>
    <button type="submit" class="btn-primary" disabled="@_busy">
        @(_busy ? (IsArabic ? "جارٍ الإنشاء…" : "Building…") : (IsArabic ? "إنشاء الحزمة" : "Generate bundle"))
    </button>
</form>

@if (_flash is not null)
{
    <div class="@_flashClass" role="status">@_flash</div>
}

@if (_lastResult is not null)
{
    <section class="invoice-totals">
        <div class="grand"><strong>@(IsArabic ? $"الحزمة جاهزة: {_lastResult.SuggestedFilename}" : $"Bundle ready: {_lastResult.SuggestedFilename}")</strong></div>
        <div><strong>@(IsArabic ? "الملفات:" : "Files:")</strong> @_lastResult.Manifest.Files.Count</div>
        <div><strong>@(IsArabic ? "قيود التدقيق في المستخرج:" : "Audit entries in extract:")</strong>
            @(_lastResult.Manifest.AuditChainExtract.EndIndex - _lastResult.Manifest.AuditChainExtract.StartIndex + 1)
            (@(IsArabic ? "الفهارس" : "indices") @_lastResult.Manifest.AuditChainExtract.StartIndex..@_lastResult.Manifest.AuditChainExtract.EndIndex)
        </div>
        <div><strong>@(IsArabic ? "بصمة الأرشيف الأعلى SHA-256:" : "Top-level archive SHA-256:")</strong> <code>@_lastResult.Manifest.TopLevelArchiveSha256[..16]…</code></div>
        @if (_lastResult.Manifest.DraftsExcluded)
        {
            <div class="flash-error">
                <strong>@(IsArabic ? "مسودات مستثناة:" : "Drafts excluded:")</strong>
                @_lastResult.Manifest.ExcludedDraftIds!.Count
                @(IsArabic
                    ? "مستند مسودة في الفترة لم يُضمَّن. أرقامها تظهر في حقل excludedDraftIds في الفهرس."
                    : "draft document(s) in period were NOT included. Their ids appear in the manifest's excludedDraftIds field.")
            </div>
        }
    </section>
}

@code {
    private DateTime _periodStart = new(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1);
    private DateTime _periodEnd = new(DateTime.UtcNow.Year, DateTime.UtcNow.Month,
        DateTime.DaysInMonth(DateTime.UtcNow.Year, DateTime.UtcNow.Month));
    private bool _allowDrafts;
    private bool _busy;
    private string? _flash;
    private string _flashClass = "flash-success";
    private InspectionBundleResult? _lastResult;

    private async Task OnGenerateAsync()
    {
        _busy = true;
        _flash = null;
        _lastResult = null;
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            var claim = auth.User.FindFirst("sub")?.Value
                ?? auth.User.FindFirst("userId")?.Value;
            var operatorUserId = Guid.TryParse(claim, out var u) ? u : Guid.Empty;

            _lastResult = await Builder.BuildAsync(new InspectionBundleRequest(
                PeriodStart: DateOnly.FromDateTime(_periodStart),
                PeriodEnd: DateOnly.FromDateTime(_periodEnd),
                GeneratedByUserId: operatorUserId,
                AllowDrafts: _allowDrafts), CancellationToken.None);

            // Trigger browser download via JS interop. Pass the
            // bytes as base64 so we don't have to host the bundle
            // server-side; for very large bundles a streaming
            // server-route follow-up would be more memory-friendly.
            var base64 = Convert.ToBase64String(_lastResult.ZipBytes);
            await Js.InvokeVoidAsync("eval",
                $"const b=atob('{base64}');const a=new Uint8Array(b.length);for(let i=0;i<b.length;i++){{a[i]=b.charCodeAt(i);}}const u=URL.createObjectURL(new Blob([a],{{type:'application/zip'}}));const link=document.createElement('a');link.href=u;link.download='{_lastResult.SuggestedFilename}';link.click();URL.revokeObjectURL(u);");

            _flash = IsArabic
                ? $"تم إنشاء الحزمة: {_lastResult.SuggestedFilename} ({_lastResult.ZipBytes.Length:N0} بايت)."
                : $"Generated bundle: {_lastResult.SuggestedFilename} ({_lastResult.ZipBytes.Length:N0} bytes).";
            _flashClass = "flash-success";
        }
        catch (Exception ex)
        {
            _flash = ex.Message;
            _flashClass = "flash-error";
        }
        finally
        {
            _busy = false;
        }
    }
}
