@page "/inspection-bundle"
@using EgyptTax.Application.Inspection
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@inject IInspectionBundleBuilder Builder
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime Js
@attribute [Authorize(Policy = "FullyAuthenticated")]

<h1>Generate tax-inspection bundle (US9 / FR-048)</h1>

<p>
    Builds a period-scoped ZIP containing the audit-trail extract, every attachment
    for posted documents in the period, and a SHA-256 manifest. Hand the bundle to
    the inspector — they can re-verify integrity on a clean machine using the
    instructions in the bundled <code>README-FOR-INSPECTOR.md</code>.
</p>

<form class="invoice-toolbar" @onsubmit="OnGenerateAsync" @onsubmit:preventDefault>
    <label>
        <span>Period start</span>
        <input type="date" @bind="_periodStart" />
    </label>
    <label>
        <span>Period end</span>
        <input type="date" @bind="_periodEnd" />
    </label>
    <label>
        <input type="checkbox" @bind="_allowDrafts" />
        Allow drafts in period (write their ids into the manifest as excluded)
    </label>
    <button type="submit" class="btn-primary" disabled="@_busy">
        @(_busy ? "Building…" : "Generate bundle")
    </button>
</form>

@if (_flash is not null)
{
    <div class="@_flashClass" role="status">@_flash</div>
}

@if (_lastResult is not null)
{
    <section class="invoice-totals">
        <div class="grand"><strong>Bundle ready: @_lastResult.SuggestedFilename</strong></div>
        <div><strong>Files:</strong> @_lastResult.Manifest.Files.Count</div>
        <div><strong>Audit entries in extract:</strong>
            @(_lastResult.Manifest.AuditChainExtract.EndIndex - _lastResult.Manifest.AuditChainExtract.StartIndex + 1)
            (indices @_lastResult.Manifest.AuditChainExtract.StartIndex..@_lastResult.Manifest.AuditChainExtract.EndIndex)
        </div>
        <div><strong>Top-level archive SHA-256:</strong> <code>@_lastResult.Manifest.TopLevelArchiveSha256[..16]…</code></div>
        @if (_lastResult.Manifest.DraftsExcluded)
        {
            <div class="flash-error">
                <strong>Drafts excluded:</strong>
                @_lastResult.Manifest.ExcludedDraftIds!.Count draft document(s) in period were NOT included.
                Their ids appear in the manifest's <code>excludedDraftIds</code> field.
            </div>
        }
    </section>
}

@code {
    private DateTime _periodStart = new(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1);
    private DateTime _periodEnd = new(DateTime.UtcNow.Year, DateTime.UtcNow.Month,
        DateTime.DaysInMonth(DateTime.UtcNow.Year, DateTime.UtcNow.Month));
    private bool _allowDrafts;
    private bool _busy;
    private string? _flash;
    private string _flashClass = "flash-success";
    private InspectionBundleResult? _lastResult;

    private async Task OnGenerateAsync()
    {
        _busy = true;
        _flash = null;
        _lastResult = null;
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            var claim = auth.User.FindFirst("sub")?.Value
                ?? auth.User.FindFirst("userId")?.Value;
            var operatorUserId = Guid.TryParse(claim, out var u) ? u : Guid.Empty;

            _lastResult = await Builder.BuildAsync(new InspectionBundleRequest(
                PeriodStart: DateOnly.FromDateTime(_periodStart),
                PeriodEnd: DateOnly.FromDateTime(_periodEnd),
                GeneratedByUserId: operatorUserId,
                AllowDrafts: _allowDrafts), CancellationToken.None);

            // Trigger browser download via JS interop. Pass the
            // bytes as base64 so we don't have to host the bundle
            // server-side; for very large bundles a streaming
            // server-route follow-up would be more memory-friendly.
            var base64 = Convert.ToBase64String(_lastResult.ZipBytes);
            await Js.InvokeVoidAsync("eval",
                $"const b=atob('{base64}');const a=new Uint8Array(b.length);for(let i=0;i<b.length;i++){{a[i]=b.charCodeAt(i);}}const u=URL.createObjectURL(new Blob([a],{{type:'application/zip'}}));const link=document.createElement('a');link.href=u;link.download='{_lastResult.SuggestedFilename}';link.click();URL.revokeObjectURL(u);");

            _flash = $"Generated bundle: {_lastResult.SuggestedFilename} ({_lastResult.ZipBytes.Length:N0} bytes).";
            _flashClass = "flash-success";
        }
        catch (Exception ex)
        {
            _flash = ex.Message;
            _flashClass = "flash-error";
        }
        finally
        {
            _busy = false;
        }
    }
}
