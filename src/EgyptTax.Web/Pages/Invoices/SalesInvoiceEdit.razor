@page "/invoices/new"
@page "/invoices/{Id:guid}/edit"
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using EgyptTax.Application.Invoices
@using EgyptTax.Domain.Invoices
@using EgyptTax.Domain.MasterData
@using EgyptTax.Domain.Workflow
@using EgyptTax.Application.Workflow
@using EgyptTax.Infrastructure.Invoices
@using EgyptTax.Infrastructure.Persistence
@using EgyptTax.Infrastructure.Pricing
@using EgyptTax.Infrastructure.Settings
@using EgyptTax.Infrastructure.Workflow
@using EgyptTax.SharedKernel
@using EgyptTax.Web.Auth
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject NavigationManager Nav
@inject PostSalesInvoiceWithEtaSubmissionHandler PostHandler
@inject DocumentApprovalHandler ApprovalHandler
@inject SettingsRepository Settings
@inject PricelistResolver Pricelist
@inject EgyptTax.Infrastructure.Tax.FiscalPositionResolver FiscalPositions
@inject AuthenticationStateProvider Auth
@attribute [Authorize(Policy = "FullyAuthenticated")]

<Breadcrumb Crumbs="@(new[] {
    new Breadcrumb.BreadcrumbItem(IsArabic ? "الفواتير" : "Invoices", "/invoices"),
    new Breadcrumb.BreadcrumbItem(
        _invoice is null
            ? (IsArabic ? "فاتورة جديدة" : "New invoice")
            : (IsArabic ? "تعديل" : "Edit"),
        null)
})" />

<h1>@(IsArabic ? (_invoice is null ? "فاتورة مبيعات جديدة" : "تعديل فاتورة مبيعات") : (_invoice is null ? "New sales invoice" : "Edit sales invoice"))</h1>

@if (_flash is not null)
{
    <div class="@_flashClass" role="status">@_flash</div>
}

@if (_loading)
{
    <p>@(IsArabic ? "جارٍ التحميل…" : "Loading…")</p>
    return;
}

@if (_invoice is not null && _invoice.State != DocumentState.Draft)
{
    <div class="flash-error">@(IsArabic ? $"الفاتورة في حالة {_invoice.State}؛ المسودات فقط هي اللي يمكن تعديلها." : $"This invoice is {_invoice.State}; only Draft invoices can be edited.")</div>
    <a href="/invoices/@_invoice.Id">@(IsArabic ? "عرض الفاتورة المرحّلة ←" : "View posted detail →")</a>
    return;
}

<section class="form-grid">
    <fieldset>
        <legend>@(IsArabic ? "بيانات الفاتورة" : "Header")</legend>
        <label>
            <span>@(IsArabic ? "العميل" : "Customer")</span>
            <select @bind="_customerId">
                <option value="@Guid.Empty">@(IsArabic ? "— اختر —" : "— choose —")</option>
                @foreach (var c in _customers)
                {
                    <option value="@c.Id">@c.Code — @c.Name.English</option>
                }
            </select>
        </label>
        <label>
            <span>@(IsArabic ? "تاريخ المستند" : "Document date")</span>
            <input type="date" @bind="_documentDate" />
        </label>
        <label>
            <span>@(IsArabic ? "شروط الدفع" : "Payment term")</span>
            <select @bind="_paymentTermId">
                <option value="@Guid.Empty">@(IsArabic ? "— بدون —" : "— none —")</option>
                @foreach (var t in _paymentTerms)
                {
                    <option value="@t.Id">
                        @(IsArabic ? t.Name.Arabic : t.Name.English) — @(t.DiscountPercent > 0
                            ? (IsArabic
                                ? $"{t.DiscountPercent:0.##}% خلال {t.DiscountWindowDays} يوم / صافي {t.NetDays}"
                                : $"{t.DiscountPercent:0.##}/{t.DiscountWindowDays} Net {t.NetDays}")
                            : (IsArabic ? $"صافي {t.NetDays} يوم" : $"Net {t.NetDays}"))
                    </option>
                }
            </select>
        </label>
    </fieldset>

    <fieldset>
        <legend>@(IsArabic ? "البنود" : "Lines")</legend>
        @if (_lines.Count == 0)
        {
            <p><em>@(IsArabic ? "لا توجد بنود بعد — أضف بنداً واحداً على الأقل قبل الترحيل." : "No lines yet — add at least one before posting.")</em></p>
        }
        else
        {
            <table class="data-grid">
                <thead>
                    <tr>
                        <th>@(IsArabic ? "الصنف" : "Item")</th>
                        <th class="num">@(IsArabic ? "الكمية" : "Qty")</th>
                        <th class="num">@(IsArabic ? "سعر الوحدة" : "Unit price")</th>
                        <th>@(IsArabic ? "الضريبة" : "VAT")</th>
                        <th class="num">@(IsArabic ? "الإجمالي قبل الضريبة" : "Subtotal")</th>
                        <th class="num">@(IsArabic ? "الضريبة" : "VAT")</th>
                        <th class="num">@(IsArabic ? "الإجمالي" : "Total")</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (line, idx) in _lines.Select((l, i) => (l, i)))
                    {
                        var item = _items.FirstOrDefault(x => x.Id == line.ItemId);
                        var vat = _vatCategories.FirstOrDefault(v => v.Id == line.VatCategoryId);
                        var lineId = line.Id; var lineQty = (int)Math.Round(line.Quantity);
                        <tr>
                            <td>
                                @(item?.Code ?? "?") — @(item?.Name.English ?? "")
                                @* v5 F.6 v2 — show the line's cost-center tag inline. *@
                                @if (line.CostCenterId != Guid.Empty)
                                {
                                    var cc = _costCenters.FirstOrDefault(c => c.Id == line.CostCenterId);
                                    if (cc is not null)
                                    {
                                        <span style="font-size:11px;color:var(--text-muted);margin-inline-start:8px;">
                                            🏷 @cc.Code
                                        </span>
                                    }
                                }
                                @* v5 D.1 v2 — serial picker entry for items with TracksSerials. *@
                                @if (item?.TracksSerials == true)
                                {
                                    var pickedCount = line.SerialIds.Count;
                                    var allOk = pickedCount == lineQty;
                                    <button type="button"
                                            class="@(allOk ? "btn-secondary" : "btn-secondary")"
                                            style="font-size:11px;margin-inline-start:8px;color:@(allOk ? "var(--success-text)" : "var(--warning-text)");"
                                            @onclick="() => OpenSerialPickerAsync(lineId, line.ItemId)">
                                        🔢 @(IsArabic ? "أرقام تسلسلية" : "Serials") @pickedCount/@lineQty
                                    </button>
                                }
                                @* v5 F.6 v2 phase 2 — split editor. Only available
                                   on saved lines (line.Id matches an _invoice.Lines entry). *@
                                @if (_invoice is not null && _invoice.Lines.Any(x => x.Id == lineId))
                                {
                                    <button type="button" class="btn-secondary"
                                            style="font-size:11px;margin-inline-start:8px;"
                                            @onclick="() => _splittingForLine = (_splittingForLine == lineId ? null : lineId)">
                                        🌐 @(IsArabic ? "توزيع" : "Split")
                                    </button>
                                }
                            </td>
                            <td class="num">@line.Quantity.ToString("0.##")</td>
                            <td class="num">@line.UnitPrice.ToString("F2")</td>
                            <td>@(vat?.Code ?? "?") (@(vat?.RatePercent.ToString("0.##") ?? "?")%)</td>
                            <td class="num">@line.LineSubtotal.ToString("F2")</td>
                            <td class="num">@line.LineVat.ToString("F2")</td>
                            <td class="num">@line.LineTotal.ToString("F2")</td>
                            <td><button type="button" @onclick="() => RemoveLine(idx)">@(IsArabic ? "إزالة" : "Remove")</button></td>
                        </tr>
                        @if (_splittingForLine == lineId)
                        {
                            <tr>
                                <td colspan="8" style="background:var(--bg-2);">
                                    <div style="padding:10px 14px;">
                                        <strong>@(IsArabic ? "🌐 توزيع متعدد المراكز للسطر" : "🌐 Split allocation for this line")</strong>
                                        <CostCenterSplitEditor
                                            SourceType="EgyptTax.Domain.MasterData.CostCenterAllocationSourceType.SalesInvoiceLine"
                                            SourceLineId="@lineId"
                                            TotalAmount="@line.LineSubtotal"
                                            CostCenters="@_costCenters" />
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (_pickingSerialsForLine == lineId)
                        {
                            var available = _availableSerialsCache.TryGetValue(line.ItemId, out var list) ? list : new();
                            <tr>
                                <td colspan="8" style="background:var(--bg-2);">
                                    <div style="padding:10px 14px;">
                                        <strong>@(IsArabic ? "اختر أرقاماً تسلسلية في المخزن" : "Pick in-stock serials")</strong>
                                        <span style="font-size:12px;color:var(--text-muted);margin-inline-start:8px;">
                                            (@line.SerialIds.Count / @lineQty)
                                        </span>
                                        @if (available.Count == 0)
                                        {
                                            <p style="margin:8px 0 0;font-size:12px;"><em>
                                                @(IsArabic ? "ما فيش أرقام في المخزن لهذا الصنف. ضيف الأرقام من /items/{id}/serials أولاً." :
                                                  "No InStock serials for this item. Add serials at /items/{id}/serials first.")
                                            </em></p>
                                        }
                                        else
                                        {
                                            <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:8px;max-height:240px;overflow-y:auto;">
                                                @foreach (var s in available)
                                                {
                                                    var sid = s.Id;
                                                    var picked = line.SerialIds.Contains(sid);
                                                    <label style="display:inline-flex;align-items:center;gap:4px;padding:3px 8px;border:1px solid var(--border);border-radius:4px;background:@(picked ? "var(--accent-bg)" : "transparent");font-size:12px;font-family:monospace;">
                                                        <input type="checkbox" checked="@picked"
                                                               @onchange="(e) => OnToggleSerial(lineId, sid, (bool)(e.Value ?? false))" />
                                                        @s.SerialNumber
                                                    </label>
                                                }
                                            </div>
                                        }
                                        <div style="margin-top:10px;">
                                            <button type="button" class="btn-secondary" style="font-size:12px;"
                                                    @onclick="() => _pickingSerialsForLine = null">
                                                @(IsArabic ? "تم" : "Done")
                                            </button>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
    </fieldset>

    <fieldset>
        <legend>@(IsArabic ? "إضافة بند" : "Add line")</legend>
        <label>
            <span>@(IsArabic ? "الصنف" : "Item")</span>
            <select @bind="_newLineItemId" @bind:after="OnNewLineItemChangedAsync">
                <option value="@Guid.Empty">@(IsArabic ? "— اختر —" : "— choose —")</option>
                @foreach (var i in _items.Where(x => x.Status == ItemStatus.Active))
                {
                    <option value="@i.Id">@i.Code — @i.Name.English</option>
                }
            </select>
        </label>
        @if (_pricelistHint is not null)
        {
            <div style="grid-column:1 / -1;font-size:12px;color:var(--text-muted);margin-top:-4px;margin-bottom:8px;">
                @_pricelistHint
            </div>
        }
        @if (_fiscalPositionHint is not null)
        {
            <div style="grid-column:1 / -1;font-size:12px;color:var(--warning-text);margin-top:-4px;margin-bottom:8px;">
                ⚖ @_fiscalPositionHint
            </div>
        }
        <label>
            <span>@(IsArabic ? "الكمية" : "Quantity")</span>
            <input type="number" step="0.01" min="0.01" @bind="_newLineQty" />
        </label>
        <label>
            <span>@(IsArabic ? "سعر الوحدة (ج.م.)" : "Unit price (EGP)")</span>
            <input type="number" step="0.01" min="0" @bind="_newLineUnitPrice" />
        </label>
        <label>
            <span>@(IsArabic ? "فئة الضريبة" : "VAT category")</span>
            <select @bind="_newLineVatId">
                <option value="@Guid.Empty">@(IsArabic ? "— الافتراضية من الصنف —" : "— default from item —")</option>
                @foreach (var v in _vatCategories)
                {
                    <option value="@v.Id">@v.Code (@v.RatePercent.ToString("0.##")%)</option>
                }
            </select>
        </label>
        @if (_costCenters.Count > 0)
        {
            @* v5 F.6 v2 — per-line cost-center tag (single-tag here;
               multi-allocation editor lives on the line list once line
               is saved, mirroring the Expense pattern). *@
            <label>
                <span>@(IsArabic ? "مركز التكلفة (اختياري)" : "Cost center (optional)")</span>
                <select @bind="_newLineCostCenterId">
                    <option value="@Guid.Empty">— @(IsArabic ? "بدون" : "none") —</option>
                    @foreach (var cc in _costCenters)
                    {
                        <option value="@cc.Id">@cc.Code — @(IsArabic ? cc.Name.Arabic : cc.Name.English)</option>
                    }
                </select>
            </label>
        }
        <button type="button" @onclick="AddLine">@(IsArabic ? "إضافة بند" : "Add line")</button>
    </fieldset>

    <fieldset>
        <legend>@(IsArabic ? "خصم على مستوى الفاتورة" : "Invoice-level discount")</legend>
        <label>
            <span>@(IsArabic ? "النوع" : "Mode")</span>
            <select @bind="_discountMode">
                <option value="none">@(IsArabic ? "لا يوجد خصم" : "No discount")</option>
                <option value="percent">@(IsArabic ? "نسبة من الإجمالي" : "Percent of subtotal")</option>
                <option value="amount">@(IsArabic ? "مبلغ ثابت" : "Fixed amount")</option>
            </select>
        </label>
        @if (_discountMode == "percent")
        {
            <label>
                <span>@(IsArabic ? "النسبة (0–100)" : "Percent (0–100)")</span>
                <input type="number" step="0.01" min="0" max="100" @bind="_discountPercent" />
            </label>
        }
        else if (_discountMode == "amount")
        {
            <label>
                <span>@(IsArabic ? "المبلغ (ج.م.)" : "Amount (EGP)")</span>
                <input type="number" step="0.01" min="0" @bind="_discountAmount" />
            </label>
        }
    </fieldset>
</section>

<section class="invoice-totals">
    <div><strong>@(IsArabic ? "الإجمالي قبل الضريبة:" : "Subtotal:")</strong> <span class="num">@TotalSubtotal.ToString("F2") @(IsArabic ? "ج.م." : "EGP")</span></div>
    <div><strong>@(IsArabic ? "الخصم:" : "Discount:")</strong> <span class="num">@TotalDiscount.ToString("F2") @(IsArabic ? "ج.م." : "EGP")</span></div>
    <div><strong>@(IsArabic ? "الصافي قبل الضريبة:" : "Net before VAT:")</strong> <span class="num">@TotalNet.ToString("F2") @(IsArabic ? "ج.م." : "EGP")</span></div>
    <div><strong>@(IsArabic ? "إجمالي الضريبة:" : "VAT total:")</strong> <span class="num">@TotalVat.ToString("F2") @(IsArabic ? "ج.م." : "EGP")</span></div>
    <div class="grand"><strong>@(IsArabic ? "الإجمالي الكلي:" : "Grand total:")</strong> <span class="num">@TotalGrand.ToString("F2") @(IsArabic ? "ج.م." : "EGP")</span></div>
</section>

<div class="form-actions">
    <button type="button" @onclick="SaveDraftAsync">@(IsArabic ? "حفظ المسودة" : "Save draft")</button>
    @if (_requiresApproval)
    {
        <button type="button" @onclick="SubmitForApprovalAsync" disabled="@(!CanPost)">@(IsArabic ? "إرسال للاعتماد" : "Submit for approval")</button>
    }
    else
    {
        <button type="button" @onclick="PostAsync" disabled="@(!CanPost)">@(IsArabic ? "ترحيل" : "Post")</button>
    }
    <a href="/invoices">@(IsArabic ? "إلغاء" : "Cancel")</a>
</div>
@if (_requiresApproval)
{
    <p class="page-subtitle" style="font-size:12px;color:var(--text-muted);">
        @(IsArabic
            ? "لأنك مندوب مبيعات والإعداد يفرض الاعتماد، الفاتورة هتدخل قائمة الانتظار حتى يعتمدها مديرك."
            : "Because you are a sales rep and the approval setting is on, this invoice will go into the approval queue until your manager approves it.")
    </p>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private bool _loading = true;
    private SalesInvoice? _invoice;
    /// <summary>Phase B — true when the current user is SALES_REP
    /// (and not ADMIN) AND the operator has flipped on the
    /// "require approval" toggle. Routes the primary button from
    /// "Post" to "Submit for approval".</summary>
    private bool _requiresApproval;
    private Guid _currentUserId;
    private List<Customer> _customers = new();
    private List<Item> _items = new();
    private List<VatCategory> _vatCategories = new();
    private List<PaymentTerm> _paymentTerms = new();
    private List<DraftLine> _lines = new();

    private Guid _customerId;
    private DateOnly _documentDate = DateOnly.FromDateTime(DateTime.UtcNow);
    private Guid _paymentTermId;

    private Guid _newLineItemId;
    private decimal _newLineQty = 1m;
    private decimal _newLineUnitPrice;
    private Guid _newLineVatId;

    // v5 D.1 v2 — serial-picker state. _pickingSerialsForLine holds
    // the DraftLine.Id whose inline picker is currently open (null
    // = none). _availableSerialsCache memoises InStock serial lists
    // per item so toggling rows is instant.
    private Guid? _pickingSerialsForLine;
    private Dictionary<Guid, List<EgyptTax.Domain.MasterData.ItemSerial>> _availableSerialsCache = new();

    // v5 F.6 v2 — per-line cost-center tag captured at line-add time.
    // Sticky across consecutive Add-line clicks (operator usually wants
    // every line on the same CC). _costCenters loaded in OnInitialized.
    private Guid _newLineCostCenterId = Guid.Empty;
    private List<CostCenter> _costCenters = new();
    // v5 F.6 v2 phase 2 — which DraftLine.Id has the split editor open.
    private Guid? _splittingForLine;

    /// <summary>v5 B.2 — set when the operator picks an item and a
    /// pricelist rule applies; cleared between line entries.</summary>
    private string? _pricelistHint;
    private string? _fiscalPositionHint;

    private string _discountMode = "none";
    private decimal _discountPercent;
    private decimal _discountAmount;

    private string? _flash;
    private string _flashClass = "flash-success";

    protected override async Task OnInitializedAsync()
    {
        _customers = await Db.Set<Customer>().AsNoTracking()
            .Where(c => c.Status == CustomerStatus.Active).OrderBy(c => c.Code).ToListAsync();
        _items = await Db.Set<Item>().AsNoTracking().OrderBy(i => i.Code).ToListAsync();
        _vatCategories = await Db.Set<VatCategory>().AsNoTracking().OrderBy(v => v.Code).ToListAsync();
        _costCenters = await Db.Set<CostCenter>().AsNoTracking()
            .Where(c => c.Status == CostCenterStatus.Active)
            .OrderBy(c => c.Code).ToListAsync();
        _paymentTerms = await Db.Set<PaymentTerm>().AsNoTracking()
            .Where(t => t.IsActive)
            .OrderByDescending(t => t.IsDefault).ThenBy(t => t.NetDays).ToListAsync();

        // Phase B — decide whether the primary button is "Post" or
        // "Submit for approval". The toggle lives on SalesRepSettings;
        // only sales reps (not admins) hit the approval path.
        var authState = await Auth.GetAuthenticationStateAsync();
        _currentUserId = authState.User.UserId() ?? Guid.Empty;
        var isRepOnly = authState.User.IsInRole("SALES_REP") && !authState.User.IsInRole("ADMIN");
        if (isRepOnly)
        {
            var prefs = await Settings.GetSalesRepSettingsAsync();
            _requiresApproval = prefs.RequireApproval;
        }

        if (Id is { } id)
        {
            _invoice = await Db.Set<SalesInvoice>().Include(i => i.Lines)
                .FirstOrDefaultAsync(i => i.Id == id);
            if (_invoice is not null)
            {
                _customerId = _invoice.CustomerId;
                _documentDate = _invoice.DocumentDate;
                _paymentTermId = _invoice.PaymentTermId ?? Guid.Empty;
                _lines = _invoice.Lines
                    .Select(l => new DraftLine(l.Id, l.ItemId, l.Quantity, l.UnitPrice.Amount, l.VatCategoryId, l.VatRatePercent,
                        l.LineSubtotal.Amount, l.LineVat.Amount, l.LineTotal.Amount)
                    {
                        // v5 D.1 v2 — restore previously-picked serials so the
                        // operator sees the count badge correctly on edit.
                        SerialIds = l.GetSoldSerialIds().ToList(),
                        // v5 F.6 v2 — restore the line's cost-center tag.
                        CostCenterId = l.CostCenterId ?? Guid.Empty,
                    })
                    .ToList();
                if (_invoice.InvoiceLevelDiscountPercent > 0)
                {
                    _discountMode = "percent";
                    _discountPercent = _invoice.InvoiceLevelDiscountPercent;
                }
                else if (_invoice.InvoiceLevelDiscountAmount.Amount > 0)
                {
                    _discountMode = "amount";
                    _discountAmount = _invoice.InvoiceLevelDiscountAmount.Amount;
                }
            }
        }
        else
        {
            // New invoice — preselect the default term if one is marked.
            var def = _paymentTerms.FirstOrDefault(t => t.IsDefault);
            if (def is not null) _paymentTermId = def.Id;
        }

        _loading = false;
    }

    private void AddLine()
    {
        if (_newLineItemId == Guid.Empty || _newLineQty <= 0)
        {
            ShowFlash(IsArabic ? "اختر صنفاً وكمية موجبة قبل إضافة البند." : "Pick an item and a positive quantity before adding the line.", error: true);
            return;
        }

        var item = _items.FirstOrDefault(i => i.Id == _newLineItemId);
        var vatId = _newLineVatId == Guid.Empty ? (item?.DefaultVatCategoryId ?? Guid.Empty) : _newLineVatId;
        var vat = _vatCategories.FirstOrDefault(v => v.Id == vatId);
        if (vat is null)
        {
            ShowFlash(IsArabic ? "الصنف ليس له فئة ضريبة افتراضية — اختر واحدة صراحة." : "Item has no default VAT category — pick one explicitly.", error: true);
            return;
        }

        var subtotal = decimal.Round(_newLineQty * _newLineUnitPrice, 2, MidpointRounding.ToEven);
        var lineVat = decimal.Round(subtotal * (vat.RatePercent / 100m), 2, MidpointRounding.ToEven);

        _lines.Add(new DraftLine(
            Id: Guid.NewGuid(),
            ItemId: _newLineItemId,
            Quantity: _newLineQty,
            UnitPrice: _newLineUnitPrice,
            VatCategoryId: vatId,
            VatRatePercent: vat.RatePercent,
            LineSubtotal: subtotal,
            LineVat: lineVat,
            LineTotal: subtotal + lineVat)
        {
            CostCenterId = _newLineCostCenterId,
        });

        _newLineItemId = Guid.Empty;
        _newLineQty = 1m;
        _newLineUnitPrice = 0m;
        _newLineVatId = Guid.Empty;
        // _newLineCostCenterId stays sticky — operator usually wants
        // every line on the same CC. They can clear it manually.
    }

    private void RemoveLine(int index) => _lines.RemoveAt(index);

    /// <summary>v5 D.1 v2 — open the inline serial picker for one
    /// line. Loads InStock serials for that item on first use and
    /// caches per-item so toggling is instant.</summary>
    private async Task OpenSerialPickerAsync(Guid lineId, Guid itemId)
    {
        if (!_availableSerialsCache.ContainsKey(itemId))
        {
            // Pull InStock serials + any already picked on this draft
            // line (so an in-progress pick whose serial got reserved
            // elsewhere doesn't disappear from the list).
            var line = _lines.FirstOrDefault(l => l.Id == lineId);
            var pickedNow = line?.SerialIds ?? new List<Guid>();
            var rows = await Db.Set<EgyptTax.Domain.MasterData.ItemSerial>().AsNoTracking()
                .Where(s => s.ItemId == itemId
                    && (s.Status == EgyptTax.Domain.MasterData.ItemSerialStatus.InStock
                        || s.Status == EgyptTax.Domain.MasterData.ItemSerialStatus.Reserved
                        || pickedNow.Contains(s.Id)))
                .OrderBy(s => s.SerialNumber)
                .ToListAsync();
            _availableSerialsCache[itemId] = rows;
        }
        _pickingSerialsForLine = lineId;
    }

    private void OnToggleSerial(Guid lineId, Guid serialId, bool selected)
    {
        var line = _lines.FirstOrDefault(l => l.Id == lineId);
        if (line is null) return;
        if (selected)
        {
            if (!line.SerialIds.Contains(serialId)) line.SerialIds.Add(serialId);
        }
        else
        {
            line.SerialIds.Remove(serialId);
        }
    }

    /// <summary>v5 B.2 — when the operator picks an item, resolve
    /// the unit price via the customer's pricelist (if any) and
    /// pre-fill the field. Falls back to <c>Item.DefaultUnitPriceEgp</c>
    /// when no pricelist rule matches; falls back to whatever was
    /// already typed (or 0) when neither exists.</summary>
    private async Task OnNewLineItemChangedAsync()
    {
        _pricelistHint = null;
        _fiscalPositionHint = null;
        if (_newLineItemId == Guid.Empty || _customerId == Guid.Empty) return;

        var item = _items.FirstOrDefault(i => i.Id == _newLineItemId);
        if (item is null) return;

        // Pricelist resolution → unit price
        var listPrice = item.DefaultUnitPriceEgp ?? 0m;
        var resolution = await Pricelist.ResolveAsync(_customerId, _newLineItemId, listPrice);
        if (resolution.AppliedRule is not null || item.DefaultUnitPriceEgp is not null)
        {
            _newLineUnitPrice = resolution.UnitPriceEgp;
        }
        if (resolution.AppliedRule is not null && resolution.AppliedPricelistName is { } plName)
        {
            var name = IsArabic ? plName.Arabic : plName.English;
            _pricelistHint = IsArabic
                ? $"السعر معدّل من قائمة الأسعار «{name}»"
                : $"Price applied from pricelist \"{name}\"";
        }

        // v5 F.4 — Fiscal position auto-swap. The customer's
        // FiscalPositionId may map the line's default VAT to a
        // different category (export 0%, free zone exempt). Resolve
        // and pre-fill _newLineVatId so the operator sees the
        // mapped category before adding the line.
        var fpResolution = await FiscalPositions.ResolveAsync(
            _customerId, item.DefaultVatCategoryId);
        if (fpResolution.AppliedMapping is not null && fpResolution.AppliedPosition is { } pos)
        {
            var posName = IsArabic ? pos.Name.Arabic : pos.Name.English;
            if (fpResolution.IsExempt)
            {
                // Mapping says "no destination" → swap the line to the
                // seeded EXEMPT category (rate 0%, non-recoverable). If
                // the operator deleted the seed, fall back to any 0%
                // category so the line still posts with no VAT charge.
                var exemptCat = _vatCategories.FirstOrDefault(v => v.Code == "EXEMPT")
                    ?? _vatCategories.FirstOrDefault(v => v.RatePercent == 0m);
                if (exemptCat is not null)
                {
                    _newLineVatId = exemptCat.Id;
                }
                _fiscalPositionHint = IsArabic
                    ? $"معفى من الضريبة حسب «{posName}»."
                    : $"VAT-exempt per \"{posName}\".";
            }
            else
            {
                _newLineVatId = fpResolution.ResolvedVatCategoryId;
                var resolvedCat = _vatCategories.FirstOrDefault(v => v.Id == fpResolution.ResolvedVatCategoryId);
                var catLabel = resolvedCat?.Code ?? "";
                _fiscalPositionHint = IsArabic
                    ? $"الضريبة بُدِّلت إلى «{catLabel}» حسب «{posName}»."
                    : $"VAT swapped to \"{catLabel}\" per \"{posName}\".";
            }
        }
    }

    private async Task SaveDraftAsync()
    {
        if (!await PrecheckAsync())
        {
            return;
        }

        var customer = _customers.First(c => c.Id == _customerId);

        if (_invoice is null)
        {
            // Create a fresh draft. CreatedByUserId stamps the rep
            // who built the draft so the list view can scope per-rep
            // (and so admin approval flows know who to route back to).
            var creatorId = _currentUserId == Guid.Empty ? (Guid?)null : _currentUserId;
            _invoice = SalesInvoice.CreateDraft(_customerId, customer.TaxProfile, _documentDate, creatorId);
            foreach (var line in _lines)
            {
                var siLine = _invoice.AddLine(line.ItemId, line.Quantity, MoneyEgp.From(line.UnitPrice),
                    line.VatCategoryId, line.VatRatePercent,
                    costCenterId: line.CostCenterId == Guid.Empty ? null : line.CostCenterId);
                if (line.SerialIds.Count > 0)
                {
                    siLine.SetSoldSerialIds(line.SerialIds);
                }
            }
            ApplyDiscount(_invoice);
            _invoice.SetPaymentTerm(_paymentTermId == Guid.Empty ? null : _paymentTermId);
            Db.Add(_invoice);
        }
        else
        {
            // Sync the existing draft's lines.
            var existingIds = _invoice.Lines.Select(l => l.Id).ToHashSet();
            var newIds = _lines.Select(l => l.Id).ToHashSet();
            foreach (var lineId in existingIds.Where(id => !newIds.Contains(id)).ToList())
            {
                _invoice.RemoveLine(lineId);
                // v5 F.6 v2 phase 2 — drop orphaned cost-center
                // allocations for the deleted line so the report
                // doesn't carry dead rows in master.cost_center_allocations.
                var orphans = await Db.Set<CostCenterAllocation>()
                    .Where(a => a.SourceType == CostCenterAllocationSourceType.SalesInvoiceLine
                        && a.SourceLineId == lineId)
                    .ToListAsync();
                Db.Set<CostCenterAllocation>().RemoveRange(orphans);
            }
            foreach (var line in _lines.Where(l => !existingIds.Contains(l.Id)))
            {
                var siLine = _invoice.AddLine(line.ItemId, line.Quantity, MoneyEgp.From(line.UnitPrice),
                    line.VatCategoryId, line.VatRatePercent,
                    costCenterId: line.CostCenterId == Guid.Empty ? null : line.CostCenterId);
                if (line.SerialIds.Count > 0)
                {
                    siLine.SetSoldSerialIds(line.SerialIds);
                }
            }
            // v5 D.1 v2 — also sync serial picks for already-existing lines
            // (operator may have toggled serials on a previously-saved line
            // without removing it).
            foreach (var line in _lines.Where(l => existingIds.Contains(l.Id)))
            {
                var siLine = _invoice.Lines.FirstOrDefault(x => x.Id == line.Id);
                if (siLine is null) continue;
                var prev = siLine.GetSoldSerialIds();
                if (!prev.SequenceEqual(line.SerialIds))
                {
                    siLine.SetSoldSerialIds(line.SerialIds);
                }
            }
            ApplyDiscount(_invoice);
            _invoice.SetPaymentTerm(_paymentTermId == Guid.Empty ? null : _paymentTermId);
        }

        await Db.SaveChangesAsync();
        // v5 F.6 v2 phase 2 — refresh DraftLine list from the persisted
        // SalesInvoiceLines so each DraftLine.Id matches its underlying
        // row's Id. The Split editor needs that match to anchor its
        // CostCenterAllocation rows. Without this refresh, lines added
        // in the current session keep their fresh client-side Guids and
        // the Split button never appears.
        _lines = _invoice.Lines
            .Select(l => new DraftLine(l.Id, l.ItemId, l.Quantity, l.UnitPrice.Amount, l.VatCategoryId, l.VatRatePercent,
                l.LineSubtotal.Amount, l.LineVat.Amount, l.LineTotal.Amount)
            {
                SerialIds = l.GetSoldSerialIds().ToList(),
                CostCenterId = l.CostCenterId ?? Guid.Empty,
            })
            .ToList();
        ShowFlash(IsArabic
            ? $"تم حفظ المسودة (الإجمالي قبل الضريبة {_invoice.Subtotal.Amount:F2} ← الإجمالي الكلي {_invoice.GrandTotal.Amount:F2})."
            : $"Saved draft (subtotal {_invoice.Subtotal.Amount:F2} → grand total {_invoice.GrandTotal.Amount:F2}).");
        Nav.NavigateTo($"/invoices/{_invoice.Id}/edit", forceLoad: false);
    }

    private async Task PostAsync()
    {
        if (!CanPost)
        {
            ShowFlash(IsArabic ? "لا يوجد شيء للترحيل." : "Nothing to post.", error: true);
            return;
        }
        // v5 D.1 v2 — block post when a serial-tracked line doesn't have
        // serials picked for every unit. Operators can still SaveDraft
        // with partial picks and come back later.
        foreach (var line in _lines)
        {
            var item = _items.FirstOrDefault(i => i.Id == line.ItemId);
            if (item?.TracksSerials != true) continue;
            var needed = (int)Math.Round(line.Quantity);
            if (line.SerialIds.Count != needed)
            {
                ShowFlash(IsArabic
                    ? $"الصنف {item.Code} يتطلب {needed} رقم تسلسلي، أنت اخترت {line.SerialIds.Count}. افتح زر «أرقام تسلسلية» على البند وكمل الاختيار قبل الترحيل."
                    : $"Item {item.Code} needs {needed} serial(s); you've picked {line.SerialIds.Count}. Click the Serials button on the line to finish.",
                    error: true);
                return;
            }
        }
        await SaveDraftAsync();
        if (_invoice is null)
        {
            return;
        }

        // Wrap the post in a try/catch so domain/infrastructure
        // exceptions surface as inline flash messages — not as
        // Blazor's "An unhandled error has occurred. Reload."
        // circuit-error overlay. Common throwers from the post
        // pipeline (PostSalesInvoiceWithEtaSubmissionHandler):
        //   • InvalidOperationException — period locked (FR-037),
        //     approval required (FR-026), missing issuer Company,
        //     allocator failure
        //   • Any infrastructure exception from the journal emitter
        //     when Chart of Accounts isn't configured
        try
        {
            var posted = await PostHandler.HandleAsync(
                new PostSalesInvoiceCommand(_invoice.Id, _currentUserId), CancellationToken.None);

            Nav.NavigateTo($"/invoices/{posted.Id}", forceLoad: true);
        }
        catch (Exception ex)
        {
            ShowFlash(
                IsArabic
                    ? $"فشل ترحيل الفاتورة: {ex.Message}"
                    : $"Could not post the invoice: {ex.Message}",
                error: true);
        }
    }

    private async Task SubmitForApprovalAsync()
    {
        if (!CanPost)
        {
            ShowFlash(IsArabic ? "لا يوجد شيء للإرسال." : "Nothing to submit.", error: true);
            return;
        }
        await SaveDraftAsync();
        if (_invoice is null) return;
        try
        {
            await ApprovalHandler.SubmitAsync(
                new SubmitDocumentCommand(_invoice.Id, DocumentType.SalesInvoice, _currentUserId),
                CancellationToken.None);
            ShowFlash(IsArabic
                ? "تم إرسال الفاتورة للاعتماد. هتلقى إشعار لما يعتمدها مديرك."
                : "Submitted for approval. You'll be notified once your manager approves it.");
            Nav.NavigateTo("/invoices", forceLoad: true);
        }
        catch (Exception ex)
        {
            ShowFlash(IsArabic
                ? $"فشل الإرسال: {ex.Message}"
                : $"Could not submit for approval: {ex.Message}", error: true);
        }
    }

    private bool CanPost =>
        _customerId != Guid.Empty
        && _lines.Count > 0
        && (_invoice?.State ?? DocumentState.Draft) == DocumentState.Draft;

    private async Task<bool> PrecheckAsync()
    {
        if (_customerId == Guid.Empty)
        {
            ShowFlash(IsArabic ? "اختر العميل أولاً." : "Pick a customer first.", error: true);
            return false;
        }
        if (_lines.Count == 0)
        {
            ShowFlash(IsArabic ? "أضف بنداً واحداً على الأقل قبل الحفظ." : "Add at least one line before saving.", error: true);
            return false;
        }
        await Task.CompletedTask;
        return true;
    }

    private void ApplyDiscount(SalesInvoice invoice)
    {
        switch (_discountMode)
        {
            case "percent" when _discountPercent > 0:
                invoice.SetInvoiceLevelDiscount(amount: null, percent: _discountPercent);
                break;
            case "amount" when _discountAmount > 0:
                invoice.SetInvoiceLevelDiscount(amount: MoneyEgp.From(_discountAmount), percent: null);
                break;
            default:
                invoice.SetInvoiceLevelDiscount(amount: null, percent: null);
                break;
        }
    }

    private void ShowFlash(string message, bool error = false)
    {
        _flash = message;
        _flashClass = error ? "flash-error" : "flash-success";
    }

    private decimal TotalSubtotal => _lines.Sum(l => l.LineSubtotal);
    private decimal TotalDiscount => _discountMode switch
    {
        "percent" when _discountPercent > 0 => decimal.Round(TotalSubtotal * (_discountPercent / 100m), 2, MidpointRounding.ToEven),
        "amount" => Math.Min(_discountAmount, TotalSubtotal),
        _ => 0m,
    };
    private decimal TotalNet => TotalSubtotal - TotalDiscount;
    private decimal TotalVat => _lines.Sum(l =>
    {
        var ratio = TotalSubtotal == 0 ? 0 : (l.LineSubtotal / TotalSubtotal);
        var net = l.LineSubtotal - decimal.Round(TotalDiscount * ratio, 2, MidpointRounding.ToEven);
        return decimal.Round(net * (l.VatRatePercent / 100m), 2, MidpointRounding.ToEven);
    });
    private decimal TotalGrand => TotalNet + TotalVat;

    private sealed record DraftLine(
        Guid Id,
        Guid ItemId,
        decimal Quantity,
        decimal UnitPrice,
        Guid VatCategoryId,
        decimal VatRatePercent,
        decimal LineSubtotal,
        decimal LineVat,
        decimal LineTotal)
    {
        /// <summary>v5 D.1 v2 — serial GUIDs the operator picked for
        /// this line (only relevant when the item has TracksSerials).
        /// Mutable list so the inline serial picker can edit in place.</summary>
        public List<Guid> SerialIds { get; init; } = new();

        /// <summary>v5 F.6 v2 — optional per-line cost-center tag.
        /// Guid.Empty = none; serialised to null on AddLine.</summary>
        public Guid CostCenterId { get; init; } = Guid.Empty;
    }
}
