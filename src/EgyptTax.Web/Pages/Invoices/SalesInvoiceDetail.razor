@page "/invoices/{Id:guid}"
@using EgyptTax.Application.Compliance.RiskScoring
@using EgyptTax.Application.Verification
@using EgyptTax.Domain.Eta
@using EgyptTax.Domain.Invoices
@using EgyptTax.Domain.MasterData
@using EgyptTax.Domain.Workflow
@using EgyptTax.Infrastructure.Persistence
@using EgyptTax.Infrastructure.Verification
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject DocumentRiskScorer RiskScorer
@attribute [Authorize(Policy = "FullyAuthenticated")]

<h1>@(IsArabic ? $"فاتورة مبيعات {(_invoice?.DocumentNumber ?? "(جارٍ التحميل)")}" : $"Sales invoice {(_invoice?.DocumentNumber ?? "(loading)")}")</h1>

@if (_invoice is null)
{
    <p>@(IsArabic ? "جارٍ التحميل…" : "Loading…")</p>
    return;
}

<section class="invoice-header">
    <div><strong>@(IsArabic ? "التاريخ:" : "Date:")</strong> @_invoice.DocumentDate.ToString("yyyy-MM-dd")</div>
    <div><strong>@(IsArabic ? "الحالة:" : "State:")</strong> <StateBadge State="_invoice.State" /></div>
    <div><strong>@(IsArabic ? "العميل:" : "Customer:")</strong> @(_customer?.Name.English ?? "—") (@(_invoice.CustomerTaxProfileSnapshot.ProfileType))</div>
    @if (_invoice.PostedAtUtc is { } postedAt)
    {
        <div><strong>@(IsArabic ? "وقت الترحيل (UTC):" : "Posted at (UTC):")</strong> @postedAt.ToString("yyyy-MM-dd HH:mm:ss")</div>
        <div><strong>@(IsArabic ? "وضع الترحيل:" : "Posting mode:")</strong> @_invoice.PostingMode</div>
    }
    <div><strong>@(IsArabic ? "درجة المخاطر الضريبية:" : "Tax Risk Score:")</strong> <TaxRiskScoreBadge Findings="_riskFindings" /></div>
</section>

@* P1.7 — Pre-flight ETA validator. Always-on (cheap in-memory pass).
   Catches the local rules that cause ~80% of ETA rejections BEFORE
   the operator hits submit. *@
<PreFlightValidationPanel Invoice="_invoice" />

<section>
    <h2>@(IsArabic ? "البنود" : "Lines")</h2>
    <table class="data-grid">
        <thead>
            <tr>
                <th>#</th>
                <th>@(IsArabic ? "الصنف" : "Item")</th>
                <th class="num">@(IsArabic ? "الكمية" : "Qty")</th>
                <th class="num">@(IsArabic ? "سعر الوحدة" : "Unit price")</th>
                <th class="num">@(IsArabic ? "الإجمالي قبل الخصم" : "Subtotal")</th>
                <th class="num">@(IsArabic ? "الخصم الموزّع" : "Apportioned discount")</th>
                <th class="num">@(IsArabic ? "الصافي" : "Net")</th>
                <th>@(IsArabic ? "الضريبة %" : "VAT %")</th>
                <th class="num">@(IsArabic ? "الضريبة" : "VAT")</th>
                <th class="num">@(IsArabic ? "إجمالي البند" : "Line total")</th>
            </tr>
        </thead>
        <tbody>
            @{
                var idx = 1;
            }
            @foreach (var line in _invoice.Lines)
            {
                <tr>
                    <td>@idx</td>
                    <td>@(_items.GetValueOrDefault(line.ItemId)?.Code ?? "?")</td>
                    <td class="num">@line.Quantity.ToString("0.##")</td>
                    <td class="num">@line.UnitPrice.Amount.ToString("F2")</td>
                    <td class="num">@line.LineSubtotal.Amount.ToString("F2")</td>
                    <td class="num">@line.LineApportionedDiscount.Amount.ToString("F2")</td>
                    <td class="num">@line.LineNetSubtotal.Amount.ToString("F2")</td>
                    <td>@line.VatRatePercent.ToString("0.##")%</td>
                    <td class="num">@line.LineVat.Amount.ToString("F2")</td>
                    <td class="num">@line.LineTotal.Amount.ToString("F2")</td>
                </tr>
                idx++;
            }
        </tbody>
    </table>
</section>

<section class="invoice-totals">
    <div><strong>@(IsArabic ? "الإجمالي قبل الضريبة:" : "Subtotal:")</strong> <span class="num">@_invoice.Subtotal.Amount.ToString("F2") @(IsArabic ? "ج.م." : "EGP")</span></div>
    @if (_invoice.InvoiceLevelDiscountAmount.Amount > 0)
    {
        <div>
            <strong>@(IsArabic ? "الخصم" : "Discount")@(_invoice.InvoiceLevelDiscountPercent > 0 ? $" ({_invoice.InvoiceLevelDiscountPercent:0.##}%)" : ""):</strong>
            <span class="num">@_invoice.InvoiceLevelDiscountAmount.Amount.ToString("F2") @(IsArabic ? "ج.م." : "EGP")</span>
        </div>
    }
    <div><strong>@(IsArabic ? "الصافي قبل الضريبة:" : "Net before VAT:")</strong> <span class="num">@_invoice.NetBeforeVat.Amount.ToString("F2") @(IsArabic ? "ج.م." : "EGP")</span></div>
    <div><strong>@(IsArabic ? "إجمالي الضريبة:" : "VAT total:")</strong> <span class="num">@_invoice.VatTotal.Amount.ToString("F2") @(IsArabic ? "ج.م." : "EGP")</span></div>
    <div class="grand"><strong>@(IsArabic ? "الإجمالي الكلي:" : "Grand total:")</strong> <span class="num">@_invoice.GrandTotal.Amount.ToString("F2") @(IsArabic ? "ج.م." : "EGP")</span></div>
</section>

@if (_invoice.State is DocumentState.Draft or DocumentState.Submitted or DocumentState.Approved)
{
    <section class="invoice-actions">
        <h2>@(IsArabic ? "سير عمل الاعتماد (FR-026)" : "Approval workflow (FR-026)")</h2>
        @if (_latestApproval is not null)
        {
            <p>
                <strong>@(IsArabic ? "آخر طلب اعتماد:" : "Latest approval request:")</strong> @_latestApproval.Status
                — @(IsArabic ? "أرسله المستخدم" : "submitted by") @_latestApproval.SubmittedByUserId.ToString("D")[..8]
                @(IsArabic ? "في" : "at") @_latestApproval.SubmittedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC.
                @if (_latestApproval.RejectionReason is { } reason)
                {
                    <br /><em>@(IsArabic ? "سبب الرفض:" : "Rejection reason:") @reason</em>
                }
            </p>
        }
        <WorkflowActions
            DocumentId="_invoice.Id"
            DocumentType="_invoice.IsCreditNote ? DocumentType.CreditNote : DocumentType.SalesInvoice"
            CurrentState="_invoice.State"
            SubmittedByUserId="_latestApproval?.SubmittedByUserId"
            OnChanged="ReloadAsync" />
    </section>
}

@if (_invoice.State == DocumentState.Posted)
{
    <section class="invoice-actions">
        <a class="btn-primary" href="/invoices/@_invoice.Id/pdf" target="_blank">📄 @(IsArabic ? "تنزيل PDF" : "Download PDF")</a>
        <a href="/invoices/@_invoice.Id/einvoice.json" target="_blank">@(IsArabic ? "عرض JSON الفاتورة الإلكترونية" : "View eInvoice JSON")</a>
        @if (_seal is not null)
        {
            <a href="/api/v1/verify/@_seal" target="_blank">@(IsArabic ? "التحقق من رمز QR" : "Verify QR seal")</a>
        }
        <a href="/document360/@(_invoice.IsCreditNote ? "credit-note" : "sales-invoice")/@_invoice.Id">📂 @(IsArabic ? "ملف المستند الكامل" : "Document 360")</a>
    </section>

    @* P1.9 — Cancel-vs-Credit-Note correction wizard. Only for
       non-credit-note posted invoices (a credit note can't be
       corrected by another credit note recursively). *@
    @if (!_invoice.IsCreditNote)
    {
        <CorrectionAdvisor
            InvoiceId="_invoice.Id"
            DocumentNumber="@(_invoice.DocumentNumber ?? "")"
            SubmittedAtUtc="_etaSubmission?.LastAttemptAtUtc"
            EtaStatus="_etaSubmission?.Status ?? EtaSubmissionStatus.Pending" />
    }

    <section class="invoice-eta">
        <h2>@(IsArabic ? "إرسال الفاتورة الإلكترونية" : "ETA submission")</h2>
        @if (_etaSubmission is null)
        {
            <p><em>@(IsArabic ? "لا يوجد سجل إرسال — لازم يحصل للمستندات المرحّلة. راجع تدفق الترحيل." : "No ETA submission row — this should not happen for a posted document. Check the post flow.")</em></p>
        }
        else
        {
            <div><strong>@(IsArabic ? "الحالة:" : "Status:")</strong> <span class="eta-badge eta-@_etaSubmission.Status.ToString().ToLowerInvariant()">@_etaSubmission.Status</span></div>
            <div><strong>@(IsArabic ? "ينتهي وقت الإرسال في:" : "Window expires:")</strong> @_etaSubmission.SubmissionWindowExpiresAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC</div>
            <div><strong>@(IsArabic ? "عدد المحاولات:" : "Attempts:")</strong> @_etaSubmission.AttemptCount</div>
            @if (_etaSubmission.SubmissionUuid is { } uuid)
            {
                <div><strong>@(IsArabic ? "رقم الإرسال:" : "Submission UUID:")</strong> @uuid</div>
            }
            @* P1.3 — regulator-side acknowledgement state, populated
               by the EtaStatusPollingJob. Shows up minutes after the
               initial submit; gives the operator the citable long
               UUID they hand to a tax inspector. *@
            @if (_etaSubmission.RegulatorAcknowledgedAtUtc is { } ackAt)
            {
                <div class="eta-ack-banner">
                    <Icon Name="shield-check" Class="ic" />
                    <div>
                        <div><strong>@(IsArabic ? "اعتمدت ETA الوثيقة" : "Acknowledged by ETA")</strong></div>
                        <div class="eta-ack-meta">
                            @(IsArabic ? "وقت الاعتماد:" : "Acknowledged at:") @ackAt.ToString("yyyy-MM-dd HH:mm:ss") UTC
                            <br />
                            @(IsArabic ? "رقم ETA الرسمي:" : "ETA long UUID:")
                            <code class="eta-long-uuid">@_etaSubmission.RegulatorLongUuid</code>
                        </div>
                    </div>
                </div>
            }
            else if (_etaSubmission.Status == EtaSubmissionStatus.Submitted
                     && _etaSubmission.RegulatorRejectedAtUtc is null)
            {
                <div class="eta-pending-banner">
                    <Icon Name="activity" Class="ic" />
                    @(IsArabic
                        ? "أُرسلت الوثيقة. ETA لسه بتراجع — هنحدّث الحالة كل دقيقة."
                        : "Submitted. ETA is still validating — status refreshes every minute.")
                </div>
            }
            else if (_etaSubmission.RegulatorRejectedAtUtc is { } rejAt)
            {
                <div class="eta-reject-banner">
                    <Icon Name="x-octagon" Class="ic" />
                    <div>
                        <div><strong>@(IsArabic ? "رفضتها ETA" : "Rejected by ETA")</strong></div>
                        <div class="eta-ack-meta">@(IsArabic ? "وقت الرفض:" : "Rejected at:") @rejAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</div>
                    </div>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_etaSubmission.ErrorMessage) || !string.IsNullOrWhiteSpace(_etaSubmission.ErrorCode))
            {
                <EtaErrorBadge ErrorCode="_etaSubmission.ErrorCode"
                               ErrorMessage="_etaSubmission.ErrorMessage" />
            }
        }
    </section>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private SalesInvoice? _invoice;
    private Customer? _customer;
    private Dictionary<Guid, Item> _items = new();
    private EtaSubmission? _etaSubmission;
    private string? _seal;
    private IReadOnlyList<RiskFinding>? _riskFindings;
    private ApprovalRequest? _latestApproval;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _invoice = await Db.Set<SalesInvoice>()
            .Include(i => i.Lines)
            .AsNoTracking()
            .FirstOrDefaultAsync(i => i.Id == Id);
        if (_invoice is null)
        {
            return;
        }

        _customer = await Db.Set<Customer>().AsNoTracking()
            .FirstOrDefaultAsync(c => c.Id == _invoice.CustomerId);

        _latestApproval = await Db.Set<ApprovalRequest>().AsNoTracking()
            .Where(r => r.DocumentId == _invoice.Id)
            .OrderByDescending(r => r.SubmittedAtUtc)
            .FirstOrDefaultAsync();

        var itemIds = _invoice.Lines.Select(l => l.ItemId).Distinct().ToArray();
        _items = await Db.Set<Item>().AsNoTracking()
            .Where(i => itemIds.Contains(i.Id)).ToDictionaryAsync(i => i.Id);

        if (_invoice.State == DocumentState.Posted)
        {
            _etaSubmission = await Db.Set<EtaSubmission>().AsNoTracking()
                .FirstOrDefaultAsync(s => s.SalesInvoiceId == _invoice.Id);

            // Build a deterministic seal payload for the verify-link
            // (matches the encode the PDF route emits; auditors who
            // scan the QR off the PDF land on the same /verify URL).
            _seal = DocumentSealCodec.Encode(new DocumentSealPayload(
                DocumentType: SealedDocumentType.SalesInvoice,
                DocumentNumber: _invoice.DocumentNumber!,
                DocumentId: _invoice.Id,
                GrandTotalPiastres: (long)(_invoice.GrandTotal.Amount * 100m),
                AuditEntryHash: new byte[32],
                AuditEntryIndex: 1L,
                VerifyUrl: "/api/v1/verify",
                IssuerTin: ""));
        }

        // Differentiator 1 — score the document right after the data
        // is hydrated so the badge reflects the same view of the world
        // the user just rendered. Drafts skip the ETA-related rules
        // (no submission row exists yet) but still receive the
        // TIN + ETA-code findings.
        _riskFindings = RiskScorer.Score(new DocumentRiskContext(
            Invoice: _invoice,
            Items: _items,
            EtaSubmission: _etaSubmission,
            NowUtc: DateTime.UtcNow));
    }
}
