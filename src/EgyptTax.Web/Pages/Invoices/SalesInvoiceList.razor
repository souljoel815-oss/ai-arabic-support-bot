@page "/invoices"
@using EgyptTax.Application.Compliance.RiskScoring
@using EgyptTax.Domain.Eta
@using EgyptTax.Domain.Invoices
@using EgyptTax.Domain.MasterData
@using EgyptTax.Domain.Workflow
@using EgyptTax.Infrastructure.Persistence
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject NavigationManager Nav
@inject DocumentRiskScorer RiskScorer
@attribute [Authorize(Policy = "FullyAuthenticated")]

<h1>Sales invoices / فواتير المبيعات</h1>

<div class="invoice-toolbar">
    <a class="btn-primary" href="/invoices/new">+ New invoice</a>
    <input type="search" placeholder="Search by document number or customer name…"
           @bind="_search" @bind:event="oninput" />
    <select @bind="_stateFilter">
        <option value="">All states</option>
        @foreach (var state in Enum.GetValues<DocumentState>())
        {
            <option value="@state">@state</option>
        }
    </select>
</div>

@if (_invoices is null)
{
    <p>Loading…</p>
}
else if (_invoices.Count == 0)
{
    <p><em>No invoices match the current filters.</em></p>
}
else
{
    <table class="data-grid">
        <thead>
            <tr>
                <th>Document #</th>
                <th>Date</th>
                <th>Customer</th>
                <th>State</th>
                <th>Risk</th>
                <th class="num">Subtotal</th>
                <th class="num">VAT</th>
                <th class="num">Grand total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Filtered)
            {
                <tr>
                    <td>@(row.Invoice.DocumentNumber ?? "(draft)")</td>
                    <td>@row.Invoice.DocumentDate.ToString("yyyy-MM-dd")</td>
                    <td>@row.CustomerName</td>
                    <td><StateBadge State="row.Invoice.State" /></td>
                    <td><TaxRiskScoreDot Findings="row.RiskFindings" /></td>
                    <td class="num">@row.Invoice.Subtotal.Amount.ToString("F2")</td>
                    <td class="num">@row.Invoice.VatTotal.Amount.ToString("F2")</td>
                    <td class="num">@row.Invoice.GrandTotal.Amount.ToString("F2")</td>
                    <td>
                        @if (row.Invoice.State == DocumentState.Draft)
                        {
                            <a href="/invoices/@row.Invoice.Id/edit">Edit</a>
                        }
                        else
                        {
                            <a href="/invoices/@row.Invoice.Id">View</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Row>? _invoices;
    private string _search = "";
    private string _stateFilter = "";

    protected override async Task OnInitializedAsync()
    {
        var rows = await Db.Set<SalesInvoice>()
            .AsNoTracking()
            .Include(i => i.Lines)
            .OrderByDescending(i => i.DocumentDate)
            .ThenByDescending(i => i.PostedAtUtc)
            .Take(500)
            .ToListAsync();

        var customerIds = rows.Select(r => r.CustomerId).Distinct().ToArray();
        var customers = await Db.Set<Customer>()
            .AsNoTracking()
            .Where(c => customerIds.Contains(c.Id))
            .ToDictionaryAsync(c => c.Id, c => c.Name.English);

        // Differentiator 1 — score every row in the list so the
        // operator can spot risky invoices at a glance. Items + ETA
        // submissions are loaded in batch so the scorer's per-row
        // work is constant-factor (no N+1 queries).
        var itemIds = rows.SelectMany(r => r.Lines).Select(l => l.ItemId).Distinct().ToArray();
        var items = await Db.Set<Item>().AsNoTracking()
            .Where(i => itemIds.Contains(i.Id))
            .ToDictionaryAsync(i => i.Id);
        var invoiceIds = rows.Select(r => r.Id).ToArray();
        var etaSubmissions = await Db.Set<EtaSubmission>().AsNoTracking()
            .Where(s => invoiceIds.Contains(s.SalesInvoiceId))
            .ToDictionaryAsync(s => s.SalesInvoiceId);

        var nowUtc = DateTime.UtcNow;
        _invoices = rows
            .Select(i =>
            {
                var customerName = customers.GetValueOrDefault(i.CustomerId, i.CustomerId.ToString("D"));
                var findings = RiskScorer.Score(new DocumentRiskContext(
                    Invoice: i,
                    Items: items,
                    EtaSubmission: etaSubmissions.GetValueOrDefault(i.Id),
                    NowUtc: nowUtc));
                return new Row(i, customerName, findings);
            })
            .ToList();
    }

    private IEnumerable<Row> Filtered => (_invoices ?? Enumerable.Empty<Row>())
        .Where(r => string.IsNullOrEmpty(_search)
            || (r.Invoice.DocumentNumber?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
            || r.CustomerName.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .Where(r => string.IsNullOrEmpty(_stateFilter)
            || r.Invoice.State.ToString() == _stateFilter);

    private sealed record Row(SalesInvoice Invoice, string CustomerName, IReadOnlyList<RiskFinding> RiskFindings);
}
