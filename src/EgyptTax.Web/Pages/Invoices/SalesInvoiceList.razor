@page "/invoices"
@using EgyptTax.Application.Compliance.RiskScoring
@using EgyptTax.Domain.Documents
@using EgyptTax.Domain.Eta
@using EgyptTax.Domain.Invoices
@using EgyptTax.Domain.MasterData
@using EgyptTax.Domain.Workflow
@using EgyptTax.Infrastructure.Persistence
@using EgyptTax.Web.Auth
@using EgyptTax.Web.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject NavigationManager Nav
@inject DocumentRiskScorer RiskScorer
@inject AuthenticationStateProvider Auth
@inject IJSRuntime Js
@attribute [Authorize(Policy = "FullyAuthenticated")]

<h1>
    @(IsArabic ? "فواتير المبيعات" : "Sales invoices")
    @if (_invoices is { Count: > 0 })
    {
        <button type="button" class="btn-secondary" style="font-size:13px;margin-inline-start:12px;"
                @onclick="ExportCsvAsync">
            ⬇ @(IsArabic ? "تصدير CSV" : "Export CSV")
        </button>
    }
</h1>

@if (_invoices is { Count: > 0 })
{
    <div class="list-stats">
        <div class="list-stat">
            <span class="list-stat-label">@(IsArabic ? "إجمالي الفواتير" : "Total")</span>
            <span class="list-stat-value">@_invoices.Count</span>
        </div>
        <div class="list-stat">
            <span class="list-stat-label">@(IsArabic ? "مرحّلة" : "Posted")</span>
            <span class="list-stat-value is-success">@_invoices.Count(r => r.Invoice.State == DocumentState.Posted)</span>
        </div>
        <div class="list-stat">
            <span class="list-stat-label">@(IsArabic ? "مسودات" : "Drafts")</span>
            <span class="list-stat-value">@_invoices.Count(r => r.Invoice.State == DocumentState.Draft)</span>
        </div>
        <div class="list-stat">
            <span class="list-stat-label">@(IsArabic ? "إجمالي المستحقات" : "Outstanding")</span>
            <span class="list-stat-value is-warn">@_invoices.Sum(r => r.Outstanding).ToString("N0") <small>@(IsArabic ? "ج.م" : "EGP")</small></span>
        </div>
    </div>
}

<div class="invoice-toolbar">
    <a class="btn-primary" href="/invoices/new">@(IsArabic ? "+ فاتورة جديدة" : "+ New invoice")</a>
    <input type="search" placeholder="@(IsArabic ? "البحث برقم المستند أو اسم العميل…" : "Search by document number or customer name…")"
           @bind="_search" @bind:event="oninput" />
    <select @bind="_stateFilter">
        <option value="">@(IsArabic ? "كل الحالات" : "All states")</option>
        @foreach (var state in Enum.GetValues<DocumentState>())
        {
            <option value="@state">@state</option>
        }
    </select>
</div>

@if (_invoices is null)
{
    <p>@(IsArabic ? "جارٍ التحميل…" : "Loading…")</p>
}
else if (_invoices.Count == 0)
{
    <p><em>@(IsArabic ? "لا توجد فواتير تطابق المرشحات الحالية." : "No invoices match the current filters.")</em></p>
}
else
{
    @if (_selected.Count > 0)
    {
        <div class="kpi-card kpi-info" style="margin-bottom:12px;display:flex;align-items:center;gap:16px;justify-content:space-between;">
            <span>
                @(IsArabic ? "تم تحديد" : "Selected") <strong>@_selected.Count</strong>
                @(IsArabic ? "فاتورة — إجمالي مستحق:" : "invoices — outstanding total:")
                <strong>@SelectedOutstanding.ToString("N2") @(IsArabic ? "ج.م" : "EGP")</strong>
                @if (SelectedCustomerError is not null)
                {
                    <span style="color:var(--danger);margin-inline-start:8px;">⚠ @SelectedCustomerError</span>
                }
            </span>
            <div style="display:flex;gap:8px;">
                <button type="button" class="btn-primary"
                        disabled="@(SelectedCustomerError is not null)"
                        @onclick="OnPaySelectedAsync">
                    @(IsArabic ? "تسجيل دفعة جماعية" : "Pay selected") (@_selected.Count)
                </button>
                <button type="button" class="btn-secondary" @onclick="@(() => _selected.Clear())">
                    @(IsArabic ? "إلغاء التحديد" : "Clear")
                </button>
            </div>
        </div>
    }

    <table class="data-grid">
        <thead>
            <tr>
                <th style="width:32px;"></th>
                <th>@(IsArabic ? "رقم المستند" : "Document #")</th>
                <th>@(IsArabic ? "التاريخ" : "Date")</th>
                <th>@(IsArabic ? "العميل" : "Customer")</th>
                <th>@(IsArabic ? "الحالة" : "State")</th>
                <th>@(IsArabic ? "المخاطر" : "Risk")</th>
                <th class="num">@(IsArabic ? "الإجمالي قبل الضريبة" : "Subtotal")</th>
                <th class="num">@(IsArabic ? "الضريبة" : "VAT")</th>
                <th class="num">@(IsArabic ? "الإجمالي" : "Grand total")</th>
                <th class="num">@(IsArabic ? "المتبقي" : "Outstanding")</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Filtered)
            {
                var canPay = row.Invoice.State == DocumentState.Posted && row.Outstanding > 0m;
                <tr>
                    <td>
                        @if (canPay)
                        {
                            <input type="checkbox" checked="@_selected.Contains(row.Invoice.Id)"
                                   @onchange="@(e => OnToggleSelect(row.Invoice.Id, e))" />
                        }
                    </td>
                    <td>@(row.Invoice.DocumentNumber ?? (IsArabic ? "(مسودة)" : "(draft)"))</td>
                    <td>@row.Invoice.DocumentDate.ToString("yyyy-MM-dd")</td>
                    <td>@row.CustomerName</td>
                    <td><StateBadge State="row.Invoice.State" /></td>
                    <td><TaxRiskScoreDot Findings="row.RiskFindings" /></td>
                    <td class="num">@row.Invoice.Subtotal.Amount.ToString("F2")</td>
                    <td class="num">@row.Invoice.VatTotal.Amount.ToString("F2")</td>
                    <td class="num">@row.Invoice.GrandTotal.Amount.ToString("F2")</td>
                    <td class="num">
                        @if (row.Outstanding > 0m)
                        {
                            <strong style="color:var(--warning-text);">@row.Outstanding.ToString("F2")</strong>
                        }
                        else if (row.Invoice.State == DocumentState.Posted)
                        {
                            <span style="color:var(--success-text);">✓</span>
                        }
                    </td>
                    <td>
                        @if (row.Invoice.State == DocumentState.Draft)
                        {
                            <a href="/invoices/@row.Invoice.Id/edit">@(IsArabic ? "تعديل" : "Edit")</a>
                        }
                        else
                        {
                            <a href="/invoices/@row.Invoice.Id">@(IsArabic ? "عرض" : "View")</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Row>? _invoices;
    private string _search = "";
    private string _stateFilter = "";

    /// <summary>v5 E.2 — group-payment selection set. Operator
    /// ticks rows on the list, "Pay selected" pre-fills a single
    /// CRV draft.</summary>
    private HashSet<Guid> _selected = new();

    private decimal SelectedOutstanding =>
        (_invoices ?? Enumerable.Empty<Row>())
            .Where(r => _selected.Contains(r.Invoice.Id))
            .Sum(r => r.Outstanding);

    private string? SelectedCustomerError
    {
        get
        {
            if (_selected.Count <= 1) return null;
            var rows = (_invoices ?? Enumerable.Empty<Row>())
                .Where(r => _selected.Contains(r.Invoice.Id))
                .ToList();
            var distinctCust = rows.Select(r => r.Invoice.CustomerId).Distinct().Count();
            if (distinctCust > 1)
            {
                return IsArabic
                    ? "كل الفواتير المحددة لازم تكون لنفس العميل."
                    : "All selected invoices must belong to the same customer.";
            }
            return null;
        }
    }

    private void OnToggleSelect(Guid id, ChangeEventArgs e)
    {
        if (e.Value is bool b && b) _selected.Add(id);
        else _selected.Remove(id);
    }

    private void OnPaySelectedAsync()
    {
        if (_selected.Count == 0 || SelectedCustomerError is not null) return;
        var ids = string.Join(",", _selected);
        Nav.NavigateTo($"/payments/customer-receipts/new?invoices={ids}");
    }

    protected override async Task OnInitializedAsync()
    {
        // Sales-rep visibility: a user with ONLY the SALES_REP role
        // (and not ADMIN) sees only invoices they created. Admins
        // and other roles see everything.
        var authState = await Auth.GetAuthenticationStateAsync();
        var principal = authState.User;
        var isAdmin = principal.IsInRole("ADMIN");
        var isRep = principal.IsInRole("SALES_REP");
        var creatorId = principal.UserId();

        var query = Db.Set<SalesInvoice>()
            .AsNoTracking()
            .Include(i => i.Lines)
            .AsQueryable();
        if (isRep && !isAdmin && creatorId is not null)
        {
            query = query.Where(i => i.CreatedByUserId == creatorId);
        }

        var rows = await query
            .OrderByDescending(i => i.DocumentDate)
            .ThenByDescending(i => i.PostedAtUtc)
            .Take(500)
            .ToListAsync();

        var customerIds = rows.Select(r => r.CustomerId).Distinct().ToArray();
        var customers = await Db.Set<Customer>()
            .AsNoTracking()
            .Where(c => customerIds.Contains(c.Id))
            .ToDictionaryAsync(c => c.Id, c => c.Name.English);

        // Differentiator 1 — score every row in the list so the
        // operator can spot risky invoices at a glance. Items + ETA
        // submissions are loaded in batch so the scorer's per-row
        // work is constant-factor (no N+1 queries).
        var itemIds = rows.SelectMany(r => r.Lines).Select(l => l.ItemId).Distinct().ToArray();
        var items = await Db.Set<Item>().AsNoTracking()
            .Where(i => itemIds.Contains(i.Id))
            .ToDictionaryAsync(i => i.Id);
        var invoiceIds = rows.Select(r => r.Id).ToArray();
        var etaSubmissions = await Db.Set<EtaSubmission>().AsNoTracking()
            .Where(s => invoiceIds.Contains(s.SalesInvoiceId))
            .ToDictionaryAsync(s => s.SalesInvoiceId);

        // v5 E.2 — outstanding balance per invoice (grand total minus
        // applied payment allocations). Pull rows then sum in memory
        // since SQLite can't translate decimal Sum.
        var allocs = await Db.Set<PaymentAllocation>().AsNoTracking()
            .Where(a => invoiceIds.Contains(a.TargetDocumentId)
                && a.TargetDocumentType == DocumentType.SalesInvoice)
            .Select(a => new { a.TargetDocumentId, Amt = a.AllocatedAmount.Amount })
            .ToListAsync();
        var paidByInvoice = allocs
            .GroupBy(a => a.TargetDocumentId)
            .ToDictionary(g => g.Key, g => g.Sum(x => x.Amt));

        var nowUtc = DateTime.UtcNow;
        _invoices = rows
            .Select(i =>
            {
                var customerName = customers.GetValueOrDefault(i.CustomerId, i.CustomerId.ToString("D"));
                var findings = RiskScorer.Score(new DocumentRiskContext(
                    Invoice: i,
                    Items: items,
                    EtaSubmission: etaSubmissions.GetValueOrDefault(i.Id),
                    NowUtc: nowUtc));
                var paid = paidByInvoice.GetValueOrDefault(i.Id, 0m);
                var outstanding = Math.Max(0m, i.GrandTotal.Amount - paid);
                return new Row(i, customerName, findings, outstanding);
            })
            .ToList();
    }

    private IEnumerable<Row> Filtered => (_invoices ?? Enumerable.Empty<Row>())
        .Where(r => string.IsNullOrEmpty(_search)
            || (r.Invoice.DocumentNumber?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
            || r.CustomerName.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .Where(r => string.IsNullOrEmpty(_stateFilter)
            || r.Invoice.State.ToString() == _stateFilter);

    private async Task ExportCsvAsync()
    {
        if (_invoices is null) return;
        var bytes = CsvExporter.Build(
            headers: new[] { "Document #", "Date", "Customer", "State", "Subtotal", "VAT", "Grand total" },
            rows: _invoices,
            rowSelector: r => new object?[]
            {
                r.Invoice.DocumentNumber ?? "(draft)",
                r.Invoice.DocumentDate,
                r.CustomerName,
                r.Invoice.State.ToString(),
                r.Invoice.Subtotal.Amount,
                r.Invoice.VatTotal.Amount,
                r.Invoice.GrandTotal.Amount,
            });
        var b64 = Convert.ToBase64String(bytes);
        await Js.InvokeVoidAsync("daftarxDownloadBytes",
            $"sales-invoices-{DateTime.UtcNow:yyyyMMdd}.csv", b64, "text/csv");
    }

    private sealed record Row(SalesInvoice Invoice, string CustomerName, IReadOnlyList<RiskFinding> RiskFindings, decimal Outstanding);
}
