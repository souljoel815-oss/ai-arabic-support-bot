@page "/leads"
@using EgyptTax.Domain.Crm
@using EgyptTax.Domain.MasterData
@using EgyptTax.Infrastructure.Persistence
@using EgyptTax.SharedKernel
@using EgyptTax.Web.Auth
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject NavigationManager Nav
@inject AuthenticationStateProvider Auth
@attribute [Authorize(Policy = "FullyAuthenticated")]

@*
    N.2 (v3 §11) — sales pipeline kanban. Five fixed stages
    (New / Qualified / ProposalSent / Negotiation / Won) plus a
    Lost bucket (collapsed by default). Each card shows the lead
    name + company + expected value + next-action hint. Click to
    open detail.

    Drag-to-move is intentionally NOT shipped in v1 — Razor needs
    JS interop for native HTML5 drag handling and the value/cost
    ratio is poor for a single-column SMB sales rep. Stage moves
    happen via dropdown on the detail page.
*@

<PageTitle>@Tr("الفرص البيعية | DaftarX", "Sales Pipeline | DaftarX")</PageTitle>

<SettingsTabStrip Group="crm" />

<h1>@Tr("الفرص البيعية", "Sales Pipeline")</h1>
<p class="page-subtitle">
    @Tr(
        "العملاء المحتملين قبل ما يبقوا عملاء فعلاً. اتابع كل واحد فيهم في مرحلته، وقت ما يقبل العرض اضغط «حوّل لعميل» وعرض السعر يتفتحلك جاهز.",
        "Track prospects before they become customers. Move each one through the stages; on Won, click \"Convert to customer\" and a quotation opens pre-filled.")
</p>

<div class="invoice-toolbar" style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
    <a href="/leads/new" class="btn-primary">@Tr("+ فرصة جديدة", "+ New lead")</a>
    @* v5 UI Sprint 5 v2 — filter chips. Click a chip to narrow the
       kanban. Multi-select: assignee + date can stack. Chips set
       _filter* state which the FilteredLeads property reads. *@
    <span style="margin-inline-start:auto;display:flex;align-items:center;gap:6px;flex-wrap:wrap;">
        <strong style="font-size:12px;color:var(--text-muted);">@Tr("تصفية:", "Filter:")</strong>
        <button type="button" class="@ChipClass(_filterMineOnly)" style="@ChipStyle(_filterMineOnly, false)"
                @onclick="ToggleMine">
            👤 @Tr("بتاعتي", "Mine")
        </button>
        <button type="button" class="@ChipClass(_filterDateRange == "overdue")" style="@ChipStyle(_filterDateRange == "overdue", true)"
                @onclick="ToggleOverdue">
            ⚠ @Tr("متأخرة", "Overdue")
        </button>
        <button type="button" class="@ChipClass(_filterDateRange == "this-month")" style="@ChipStyle(_filterDateRange == "this-month", false)"
                @onclick="ToggleThisMonth">
            📅 @Tr("هذا الشهر", "This month")
        </button>
        <button type="button" class="@ChipClass(_filterValueTier == "high")" style="@ChipStyle(_filterValueTier == "high", false)"
                @onclick="ToggleHighValue">
            💎 @Tr("قيمة > 50 ألف", "Value > 50K")
        </button>
        @if (HasAnyFilter())
        {
            <button type="button" style="font-size:11px;padding:4px 8px;background:transparent;border:0;color:var(--text-muted);cursor:pointer;text-decoration:underline;"
                    @onclick="ClearFilters">
                @Tr("مسح الكل", "Clear all")
            </button>
        }
    </span>
</div>

@if (_loading)
{
    <p>@Tr("جارٍ التحميل…", "Loading…")</p>
    return;
}

@if (_leads.Count > 0)
{
    <div class="list-stats">
        <div class="list-stat">
            <span class="list-stat-label">@Tr("إجمالي الفرص", "Total leads")</span>
            <span class="list-stat-value">@_leads.Count</span>
        </div>
        <div class="list-stat">
            <span class="list-stat-label">@Tr("إجمالي القيمة المتوقعة", "Pipeline value")</span>
            <span class="list-stat-value is-gold">@_leads.Sum(l => l.ExpectedValueEgp ?? 0m).ToString("N0") <small>@(IsArabic ? "ج.م" : "EGP")</small></span>
        </div>
        <div class="list-stat">
            <span class="list-stat-label">@Tr("قيمة الفرص المكسوبة", "Won value")</span>
            <span class="list-stat-value is-success">@_leads.Where(l => l.Stage == EgyptTax.Domain.Crm.LeadStage.Won).Sum(l => l.ExpectedValueEgp ?? 0m).ToString("N0") <small>@(IsArabic ? "ج.م" : "EGP")</small></span>
        </div>
        <div class="list-stat">
            <span class="list-stat-label">@Tr("معدّل الفوز", "Win rate")</span>
            <span class="list-stat-value @(WinRatePct() >= 30 ? "is-success" : "is-warn")">@WinRatePct()<small>%</small></span>
        </div>
    </div>
}

<div class="kanban-grid">
    @foreach (var stage in _activeStages)
    {
        var stageLeads = FilteredLeads.Where(l => l.Stage == stage).ToList();
        var stageValue = stageLeads.Sum(l => l.ExpectedValueEgp ?? 0m);
        <div class="kanban-col">
            <div class="kanban-col-head">
                <strong>@StageLabel(stage)</strong>
                <span class="kanban-col-count">@stageLeads.Count</span>
                @if (stageValue > 0)
                {
                    <div class="kanban-col-value">@stageValue.ToString("N0") @Tr("ج.م", "EGP")</div>
                }
            </div>
            <div class="kanban-col-body">
                @foreach (var lead in stageLeads)
                {
                    var displayName = lead.Name.Display(IsArabic ? Language.Ar : Language.En);
                    @* v5 UI Sprint 5 — derive a probability % per stage and
                       a status dot color so the operator can scan the
                       kanban + see which deals are warming up. *@
                    var prob = StageProbability(lead.Stage);
                    var dotColor = prob >= 60 ? "#16a34a" : (prob >= 30 ? "#eab308" : "#dc2626");
                    var lastActivityUtc = lead.Activities.Count > 0
                        ? lead.Activities.Max(a => a.OccurredAtUtc)
                        : lead.CreatedAtUtc;
                    var daysSinceActivity = (int)Math.Floor((DateTime.UtcNow - lastActivityUtc).TotalDays);
                    <a href="/leads/@lead.Id" class="kanban-card">
                        <div class="kanban-card-name" style="display:flex;align-items:center;gap:6px;">
                            <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:@dotColor;flex-shrink:0;"></span>
                            <span style="flex:1;">@displayName</span>
                            <span style="font-size:11px;font-weight:600;padding:2px 6px;border-radius:10px;background:var(--bg-2);color:var(--text-muted);">@prob%</span>
                        </div>
                        @if (!string.IsNullOrEmpty(lead.CompanyName))
                        {
                            <div class="kanban-card-meta">@lead.CompanyName</div>
                        }
                        @if (lead.ExpectedValueEgp is { } v && v > 0)
                        {
                            <div class="kanban-card-value">@v.ToString("N2") @Tr("ج.م", "EGP")</div>
                        }
                        @if (lead.NextAction is { } na && !string.IsNullOrEmpty(na))
                        {
                            <div class="kanban-card-next">
                                ▸ @na
                                @if (lead.NextActionDate is { } d)
                                {
                                    <span class="kanban-card-date">· @d.ToString("MM-dd")</span>
                                }
                            </div>
                        }
                        <div class="kanban-card-activity" style="font-size:11px;color:var(--text-muted);margin-top:6px;">
                            @if (daysSinceActivity == 0)
                            {
                                @Tr("نشاط اليوم", "Active today")
                            }
                            else
                            {
                                @Tr($"آخر نشاط منذ {daysSinceActivity} يوم", $"Active {daysSinceActivity}d ago")
                            }
                        </div>
                    </a>
                }
                @if (stageLeads.Count == 0)
                {
                    <div class="kanban-col-empty">@Tr("(فاضي)", "(empty)")</div>
                }
            </div>
        </div>
    }
</div>

@{
    var lostLeads = _leads.Where(l => l.Stage == LeadStage.Lost).ToList();
}
@if (lostLeads.Count > 0)
{
    <details style="margin-top:24px;">
        <summary><strong>@Tr("مفقودة", "Lost") (@lostLeads.Count)</strong></summary>
        <ul style="font-size:13px;color:var(--muted);">
            @foreach (var lead in lostLeads)
            {
                <li>
                    <a href="/leads/@lead.Id">@lead.Name.Display(IsArabic ? Language.Ar : Language.En)</a>
                    @if (!string.IsNullOrEmpty(lead.LostReason))
                    {
                        <span> — @lead.LostReason</span>
                    }
                </li>
            }
        </ul>
    </details>
}

@code {
    // v5 UI Sprint 5 v2 — filter-chip state. _filterDateRange + _filterValueTier
    // are single-value enums (only one date OR value tier active at a time);
    // _filterMineOnly stacks with the others.
    private bool _filterMineOnly;
    private string _filterDateRange = ""; // "" | "overdue" | "this-month"
    private string _filterValueTier = ""; // "" | "high"

    private void ClearFilters()
    {
        _filterMineOnly = false;
        _filterDateRange = "";
        _filterValueTier = "";
    }

    private bool HasAnyFilter() => _filterMineOnly || _filterDateRange != "" || _filterValueTier != "";

    private void ToggleMine() => _filterMineOnly = !_filterMineOnly;
    private void ToggleOverdue() => _filterDateRange = _filterDateRange == "overdue" ? "" : "overdue";
    private void ToggleThisMonth() => _filterDateRange = _filterDateRange == "this-month" ? "" : "this-month";
    private void ToggleHighValue() => _filterValueTier = _filterValueTier == "high" ? "" : "high";

    private static string ChipClass(bool active) => active ? "lead-chip is-active" : "lead-chip";

    private static string ChipStyle(bool active, bool danger)
    {
        var bg = active ? (danger ? "#fef2f2" : "var(--accent-bg)") : "transparent";
        var color = active ? (danger ? "#dc2626" : "var(--accent-text)") : "var(--text)";
        return $"font-size:12px;padding:4px 10px;border-radius:14px;border:1px solid var(--border);background:{bg};color:{color};cursor:pointer;";
    }

    private IEnumerable<Lead> FilteredLeads
    {
        get
        {
            IEnumerable<Lead> q = _leads;
            if (_filterMineOnly && _currentUserId != Guid.Empty)
            {
                q = q.Where(l => l.AssignedToUserId == _currentUserId);
            }
            if (_filterDateRange == "overdue")
            {
                var today = DateOnly.FromDateTime(DateTime.UtcNow.Date);
                q = q.Where(l => l.ExpectedCloseDate is { } d && d < today);
            }
            else if (_filterDateRange == "this-month")
            {
                var today = DateTime.UtcNow.Date;
                var monthStart = new DateOnly(today.Year, today.Month, 1);
                var monthEnd = monthStart.AddMonths(1).AddDays(-1);
                q = q.Where(l => l.ExpectedCloseDate is { } d && d >= monthStart && d <= monthEnd);
            }
            if (_filterValueTier == "high")
            {
                q = q.Where(l => (l.ExpectedValueEgp ?? 0m) > 50000m);
            }
            return q;
        }
    }

    private bool _loading = true;
    private List<Lead> _leads = new();

    private static readonly LeadStage[] _activeStages = new[]
    {
        LeadStage.New,
        LeadStage.Qualified,
        LeadStage.ProposalSent,
        LeadStage.Negotiation,
        LeadStage.Won,
    };

    private Guid _currentUserId = Guid.Empty;

    protected override async Task OnInitializedAsync()
    {
        // v5 UI Sprint 5 v2 — capture current user for the "Mine" filter chip.
        var authState = await Auth.GetAuthenticationStateAsync();
        _currentUserId = authState.User.UserId() ?? Guid.Empty;

        _leads = await Db.Set<Lead>()
            .AsNoTracking()
            .Include(l => l.Activities)
            .OrderByDescending(l => l.CreatedAtUtc)
            .Take(500)
            .ToListAsync();
        _loading = false;
    }

    private string StageLabel(LeadStage s) => s switch
    {
        LeadStage.New => Tr("جديد", "New"),
        LeadStage.Qualified => Tr("مؤهّل", "Qualified"),
        LeadStage.ProposalSent => Tr("عرض مُرسل", "Proposal Sent"),
        LeadStage.Negotiation => Tr("تفاوض", "Negotiation"),
        LeadStage.Won => Tr("✓ مكسب", "✓ Won"),
        LeadStage.Lost => Tr("مفقود", "Lost"),
        _ => s.ToString(),
    };

    /// <summary>v5 UI Sprint 5 — derive a deal-probability % per stage.
    /// Lead doesn't carry a per-deal probability column today; deriving
    /// from stage gives the operator a directional signal without a
    /// schema change. Standard Sales-pipeline percentages.</summary>
    private static int StageProbability(LeadStage s) => s switch
    {
        LeadStage.New => 10,
        LeadStage.Qualified => 30,
        LeadStage.ProposalSent => 50,
        LeadStage.Negotiation => 75,
        LeadStage.Won => 100,
        LeadStage.Lost => 0,
        _ => 0,
    };

    private int WinRatePct()
    {
        var closed = _leads.Count(l => l.Stage == LeadStage.Won || l.Stage == LeadStage.Lost);
        if (closed == 0) return 0;
        var won = _leads.Count(l => l.Stage == LeadStage.Won);
        return (int)Math.Round(won * 100.0 / closed);
    }
}
