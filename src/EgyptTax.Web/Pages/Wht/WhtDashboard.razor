@page "/wht"
@using EgyptTax.Application.Wht
@using EgyptTax.Domain.Tax
@using Microsoft.AspNetCore.Authorization
@inject IWhtLifecycleDashboardQuery Query
@attribute [Authorize(Policy = "FullyAuthenticated")]

<h1>WHT lifecycle (FR-047) / دورة حياة الخصم</h1>

<form class="invoice-toolbar" @onsubmit="OnRefresh" @onsubmit:preventDefault>
    <label>
        <span>As-of</span>
        <input type="date" @bind="_asOf" />
    </label>
    <button type="submit" class="btn-primary" disabled="@_loading">
        @(_loading ? "Loading…" : "Refresh")
    </button>
    <a href="/settings/wht-categories" class="btn-secondary">Manage categories</a>
    <a href="/wht/form41/new" class="btn-secondary">+ Generate Form 41</a>
    <a href="/wht/form41" class="btn-secondary">All filings</a>
</form>

@if (_dashboard is null)
{
    <p>Loading…</p>
    return;
}

<section class="invoice-totals">
    <div>
        <strong>Owed (unfiled):</strong>
        <span class="num">@_dashboard.Owed.TotalAccruedNotYetFiled.ToString("F2") EGP</span>
        across @_dashboard.Owed.CertCount cert(s)
        @if (_dashboard.Owed.OldestUnfiledCertDate is { } d)
        {
            <span> — oldest @d.ToString("yyyy-MM-dd")</span>
        }
    </div>
    <div>
        <strong>Expected (customer-withheld):</strong>
        <span class="num">@_dashboard.Expected.TotalReceivableFromCustomerWht.ToString("F2") EGP</span>
        across @_dashboard.Expected.InboundCertCount cert(s)
    </div>
    <div>
        <strong>Filings:</strong> @_dashboard.Filings.Count
        — @_dashboard.Filings.Count(f => f.DerivedStatus == Form41Status.Filed) Filed,
        @_dashboard.Filings.Count(f => f.DerivedStatus == Form41Status.Unfiled) Unfiled,
        <span class="@(_dashboard.Filings.Any(f => f.DerivedStatus == Form41Status.Overdue) ? "flash-error" : "")">
            @_dashboard.Filings.Count(f => f.DerivedStatus == Form41Status.Overdue) Overdue
        </span>
    </div>
</section>

<section>
    <h2>Filings</h2>
    @if (_dashboard.Filings.Count == 0)
    {
        <p><em>No Form 41 filings yet. Click "+ Generate Form 41" to start.</em></p>
    }
    else
    {
        <table class="data-grid">
            <thead>
                <tr>
                    <th>Year</th>
                    <th>Quarter</th>
                    <th>Status</th>
                    <th>Due date</th>
                    <th class="num">Days overdue</th>
                    <th class="num">Lines</th>
                    <th class="num">WHT total (EGP)</th>
                    <th class="num">Estimated penalty (EGP)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in _dashboard.Filings)
                {
                    var rowClass = f.DerivedStatus switch
                    {
                        Form41Status.Overdue => "flash-error",
                        Form41Status.Filed => "active-row",
                        _ => "",
                    };
                    <tr class="@rowClass">
                        <td>@f.FiscalYear</td>
                        <td>Q@f.Quarter</td>
                        <td>
                            <span class="kind-badge kind-@f.DerivedStatus.ToString().ToLowerInvariant()">
                                @f.DerivedStatus
                            </span>
                        </td>
                        <td>@f.DueDate.ToString("yyyy-MM-dd")</td>
                        <td class="num">@(f.DaysOverdue > 0 ? f.DaysOverdue.ToString() : "")</td>
                        <td class="num">@f.LineCount</td>
                        <td class="num">@f.TotalWhtPayable.ToString("F2")</td>
                        <td class="num">@(f.EstimatedPenalty?.ToString("F2") ?? "")</td>
                        <td>
                            <a href="@($"/wht/form41/{f.Id:D}")" class="btn-secondary">Open</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    private DateTime _asOf = DateTime.UtcNow.Date;
    private bool _loading;
    private WhtLifecycleDashboard? _dashboard;

    protected override async Task OnInitializedAsync() => await OnRefresh();

    private async Task OnRefresh()
    {
        _loading = true;
        try
        {
            _dashboard = await Query.GetAsync(DateOnly.FromDateTime(_asOf));
        }
        finally
        {
            _loading = false;
        }
    }
}
