@page "/suppliers"
@using System.ComponentModel.DataAnnotations
@using EgyptTax.Domain.MasterData
@using EgyptTax.Infrastructure.Persistence
@using EgyptTax.SharedKernel
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@attribute [Authorize(Policy = "NotSalesRepOnly")]

<h1>@(IsArabic ? "الموردون" : "Suppliers")</h1>

@if (_savedFlash is not null)
{
    <div class="flash-success" role="status">@_savedFlash</div>
}

<section class="master-data-list">
    <h2>@(IsArabic ? "الموردون الحاليون" : "Existing suppliers")</h2>
    @if (_suppliers is null)
    {
        <p>@(IsArabic ? "جارٍ التحميل…" : "Loading…")</p>
    }
    else if (_suppliers.Count == 0)
    {
        <p><em>@(IsArabic ? "لا يوجد موردون بعد — أضف مورداً بالأسفل." : "No suppliers yet — add one below.")</em></p>
    }
    else
    {
        <table class="data-grid">
            <thead>
                <tr>
                    <th>@(IsArabic ? "الكود" : "Code")</th>
                    <th>@(IsArabic ? "الاسم (إنجليزي)" : "Name (English)")</th>
                    <th>@(IsArabic ? "الاسم (عربي)" : "Name (Arabic)")</th>
                    <th>@(IsArabic ? "نوع الملف" : "Profile")</th>
                    <th>@(IsArabic ? "الرقم الضريبي" : "TIN")</th>
                    <th>@(IsArabic ? "ضريبة عكسية" : "Reverse charge")</th>
                    <th>@(IsArabic ? "آخر تحقق من الرقم الضريبي" : "Last TIN check (UTC)")</th>
                    <th>@(IsArabic ? "الحالة" : "Status")</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in _suppliers)
                {
                    <tr class="@(s.Status == SupplierStatus.Inactive ? "row-muted" : "")">
                        <td>@s.Code</td>
                        <td>@s.Name.English</td>
                        <td>@s.Name.Arabic</td>
                        <td>@s.TaxProfile.ProfileType</td>
                        <td>@(s.TaxProfile.TinValue ?? "—")</td>
                        <td>@(s.TaxProfile.ReverseChargeFlag ? (IsArabic ? "نعم" : "yes") : "—")</td>
                        <td>@(s.LastTinRevalidatedAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? (IsArabic ? "(لا يوجد)" : "(never)"))</td>
                        <td>@s.Status</td>
                        <td>
                            <a href="/suppliers/@s.Id/statement" style="margin-inline-end:8px;">@(IsArabic ? "كشف حساب" : "Statement")</a>
                            @if (s.Status == SupplierStatus.Active)
                            {
                                <button type="button" @onclick="() => DeactivateAsync(s.Id)">@(IsArabic ? "تعطيل" : "Deactivate")</button>
                            }
                            else
                            {
                                <button type="button" @onclick="() => ReactivateAsync(s.Id)">@(IsArabic ? "إعادة تفعيل" : "Reactivate")</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="master-data-create">
    <h2>@(IsArabic ? "إضافة مورد" : "Add a supplier")</h2>
    <EditForm Model="_form" OnValidSubmit="OnCreateAsync" FormName="supplier-create" class="form-grid">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <fieldset>
            <legend>@(IsArabic ? "الهوية" : "Identity")</legend>
            <label>
                <span>@(IsArabic ? "الكود *" : "Code *")</span>
                <InputText @bind-Value="_form.Code" />
            </label>
            <label>
                <span>@(IsArabic ? "الاسم (إنجليزي) *" : "Name (English) *")</span>
                <InputText @bind-Value="_form.NameEnglish" />
            </label>
            <label>
                <span>@(IsArabic ? "الاسم (عربي) *" : "Name (Arabic) *")</span>
                <InputText @bind-Value="_form.NameArabic" />
            </label>
            <label>
                <span>@(IsArabic ? "العنوان (إنجليزي) *" : "Address (English) *")</span>
                <InputText @bind-Value="_form.AddressEnglish" />
            </label>
            <label>
                <span>@(IsArabic ? "العنوان (عربي) *" : "Address (Arabic) *")</span>
                <InputText @bind-Value="_form.AddressArabic" />
            </label>
            <label>
                <span>@(IsArabic ? "الهاتف (اختياري)" : "Phone (optional)")</span>
                <InputText @bind-Value="_form.Phone" />
            </label>
            <label>
                <span>@(IsArabic ? "البريد الإلكتروني (اختياري)" : "Email (optional)")</span>
                <InputText @bind-Value="_form.Email" />
            </label>
        </fieldset>

        <fieldset>
            <legend>@(IsArabic ? "الملف الضريبي (FR-041)" : "Tax profile (FR-041)")</legend>
            <label>
                <span>@(IsArabic ? "نوع الملف" : "Profile type")</span>
                <InputSelect @bind-Value="_form.ProfileType">
                    <option value="@SupplierTaxProfileType.RegisteredTaxpayer">@(IsArabic ? "ممول مسجل" : "Registered taxpayer")</option>
                    <option value="@SupplierTaxProfileType.Unregistered">@(IsArabic ? "غير مسجل" : "Unregistered")</option>
                    <option value="@SupplierTaxProfileType.ForeignSupplier">@(IsArabic ? "مورد أجنبي (ضريبة عكسية)" : "Foreign supplier (reverse charge)")</option>
                </InputSelect>
            </label>
            @if (_form.ProfileType == SupplierTaxProfileType.RegisteredTaxpayer)
            {
                <label>
                    <span>@(IsArabic ? "الرقم الضريبي (9 أرقام) — مطلوب للممول المسجل" : "TIN (9 digits) — required for Registered Taxpayer")</span>
                    <InputText @bind-Value="_form.Tin" />
                </label>
            }
            <label>
                <span>@(IsArabic ? "فئة الضريبة الافتراضية للمشتريات" : "Default purchase VAT category")</span>
                <InputSelect @bind-Value="_form.DefaultVatCategoryId">
                    <option value="@Guid.Empty">@(IsArabic ? "— لا شيء —" : "— none —")</option>
                    @if (_vatCategories is not null)
                    {
                        @foreach (var v in _vatCategories)
                        {
                            <option value="@v.Id">@v.Code (@v.RatePercent.ToString("0.##")%)</option>
                        }
                    }
                </InputSelect>
            </label>
        </fieldset>

        <button type="submit">@(IsArabic ? "إضافة مورد" : "Add supplier")</button>
    </EditForm>
</section>

@code {
    private List<Supplier>? _suppliers;
    private List<VatCategory>? _vatCategories;
    private FormModel _form = new();
    private string? _savedFlash;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _suppliers = await Db.Set<Supplier>().AsNoTracking().OrderBy(s => s.Code).ToListAsync();
        _vatCategories = await Db.Set<VatCategory>().AsNoTracking().OrderBy(v => v.Code).ToListAsync();
    }

    private async Task OnCreateAsync()
    {
        // FR-041 — TIN required iff RegisteredTaxpayer.
        if (_form.ProfileType == SupplierTaxProfileType.RegisteredTaxpayer
            && string.IsNullOrWhiteSpace(_form.Tin))
        {
            _savedFlash = IsArabic ? "الرقم الضريبي مطلوب للممولين المسجلين." : "TIN is required for Registered Taxpayer suppliers.";
            return;
        }

        var defaultVat = _form.DefaultVatCategoryId == Guid.Empty
            ? (Guid?)null
            : _form.DefaultVatCategoryId;

        var taxProfile = _form.ProfileType switch
        {
            SupplierTaxProfileType.RegisteredTaxpayer =>
                SupplierTaxProfile.RegisteredTaxpayer(EgyptianTin.Parse(_form.Tin!), defaultVat),
            SupplierTaxProfileType.Unregistered =>
                SupplierTaxProfile.Unregistered(defaultVat),
            _ =>
                SupplierTaxProfile.ForeignSupplier(defaultVat),
        };

        var supplier = new Supplier(
            code: _form.Code,
            name: new ArabicEnglishText(_form.NameArabic, _form.NameEnglish),
            address: new ArabicEnglishText(_form.AddressArabic, _form.AddressEnglish),
            taxProfile: taxProfile,
            phone: string.IsNullOrWhiteSpace(_form.Phone) ? null : _form.Phone,
            email: string.IsNullOrWhiteSpace(_form.Email) ? null : _form.Email);
        Db.Add(supplier);
        await Db.SaveChangesAsync();

        _form = new FormModel();
        _savedFlash = IsArabic ? $"تمت إضافة المورد {supplier.Code}." : $"Supplier {supplier.Code} added.";
        await ReloadAsync();
    }

    private async Task DeactivateAsync(Guid id)
    {
        var s = await Db.Set<Supplier>().FirstAsync(x => x.Id == id);
        s.Deactivate();
        await Db.SaveChangesAsync();
        _savedFlash = IsArabic ? $"تم تعطيل المورد {s.Code}." : $"Supplier {s.Code} deactivated.";
        await ReloadAsync();
    }

    private async Task ReactivateAsync(Guid id)
    {
        var s = await Db.Set<Supplier>().FirstAsync(x => x.Id == id);
        s.Reactivate();
        await Db.SaveChangesAsync();
        _savedFlash = IsArabic ? $"تم إعادة تفعيل المورد {s.Code}." : $"Supplier {s.Code} reactivated.";
        await ReloadAsync();
    }

    private sealed class FormModel
    {
        [Required, StringLength(32)] public string Code { get; set; } = "";
        [Required, StringLength(200)] public string NameEnglish { get; set; } = "";
        [Required, StringLength(200)] public string NameArabic { get; set; } = "";
        [Required, StringLength(500)] public string AddressEnglish { get; set; } = "";
        [Required, StringLength(500)] public string AddressArabic { get; set; } = "";
        [StringLength(32)] public string Phone { get; set; } = "";
        [EgyptTax.Web.Validation.OptionalEmailAddress, StringLength(254)] public string Email { get; set; } = "";

        public SupplierTaxProfileType ProfileType { get; set; } = SupplierTaxProfileType.RegisteredTaxpayer;
        public string? Tin { get; set; }
        public Guid DefaultVatCategoryId { get; set; }
    }
}
