@page "/expense-categories"
@using System.ComponentModel.DataAnnotations
@using EgyptTax.Domain.MasterData
@using EgyptTax.Infrastructure.Persistence
@using EgyptTax.SharedKernel
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@attribute [Authorize(Policy = "FullyAuthenticated")]

<h1>@(IsArabic ? "فئات المصروفات" : "Expense categories")</h1>

@if (_savedFlash is not null)
{
    <div class="flash-success" role="status">@_savedFlash</div>
}

<section class="master-data-list">
    <h2>@(IsArabic ? "الفئات الحالية" : "Existing categories")</h2>
    @if (_categories is null)
    {
        <p>@(IsArabic ? "جارٍ التحميل…" : "Loading…")</p>
    }
    else if (_categories.Count == 0)
    {
        <p>
            <em>
                @if (IsArabic)
                {
                    @:لا توجد فئات بعد. الفئات تتحكم في علامة "قابل للخصم" الافتراضية على مستندات المصروفات (FR-015) — أضف الفئات اللي شركتك بتستخدمها بالأسفل.
                }
                else
                {
                    @:No categories yet. Categories drive the FR-015 default-deductible flag on Expense documents; add the ones your business uses below.
                }
            </em>
        </p>
    }
    else
    {
        <table class="data-grid">
            <thead>
                <tr>
                    <th>@(IsArabic ? "الكود" : "Code")</th>
                    <th>@(IsArabic ? "الاسم (إنجليزي)" : "Name (English)")</th>
                    <th>@(IsArabic ? "الاسم (عربي)" : "Name (Arabic)")</th>
                    <th>@(IsArabic ? "قابل للخصم افتراضياً؟" : "Default deductible?")</th>
                    <th>@(IsArabic ? "رقم الحساب الافتراضي" : "Default account id")</th>
                    <th>@(IsArabic ? "الحالة" : "Status")</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in _categories)
                {
                    <tr class="@(c.Status == DeductibleExpenseCategoryStatus.Inactive ? "row-muted" : "")">
                        <td>@c.Code</td>
                        <td>@c.Name.English</td>
                        <td>@c.Name.Arabic</td>
                        <td>@(c.DefaultDeductible ? (IsArabic ? "نعم" : "yes") : (IsArabic ? "لا" : "no"))</td>
                        <td>@c.DefaultAccountId.ToString("D")</td>
                        <td>@c.Status</td>
                        <td>
                            @if (c.Status == DeductibleExpenseCategoryStatus.Active)
                            {
                                <button type="button" @onclick="() => DeactivateAsync(c.Id)">@(IsArabic ? "تعطيل" : "Deactivate")</button>
                            }
                            else
                            {
                                <button type="button" @onclick="() => ReactivateAsync(c.Id)">@(IsArabic ? "إعادة تفعيل" : "Reactivate")</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="master-data-create">
    <h2>@(IsArabic ? "إضافة فئة" : "Add a category")</h2>
    <EditForm Model="_form" OnValidSubmit="OnCreateAsync" FormName="expense-category-create" class="form-grid">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <label>
            <span>@(IsArabic ? "الكود" : "Code")</span>
            <InputText @bind-Value="_form.Code" />
        </label>
        <label>
            <span>@(IsArabic ? "الاسم (إنجليزي)" : "Name (English)")</span>
            <InputText @bind-Value="_form.NameEnglish" />
        </label>
        <label>
            <span>@(IsArabic ? "الاسم (عربي)" : "Name (Arabic)")</span>
            <InputText @bind-Value="_form.NameArabic" />
        </label>
        <label>
            <span>@(IsArabic ? "قابل للخصم افتراضياً" : "Default deductible")</span>
            <InputCheckbox @bind-Value="_form.DefaultDeductible" />
        </label>
        <label>
            <span>@(IsArabic ? "رقم الحساب الافتراضي" : "Default account id")</span>
            <InputText @bind-Value="_form.DefaultAccountId" />
        </label>

        <button type="submit">@(IsArabic ? "إضافة فئة" : "Add category")</button>
    </EditForm>
</section>

@code {
    private List<DeductibleExpenseCategory>? _categories;
    private FormModel _form = new();
    private string? _savedFlash;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _categories = await Db.Set<DeductibleExpenseCategory>()
            .AsNoTracking().OrderBy(c => c.Code).ToListAsync();
    }

    private async Task OnCreateAsync()
    {
        if (!Guid.TryParse(_form.DefaultAccountId, out var accountId))
        {
            _savedFlash = IsArabic ? "رقم الحساب الافتراضي يجب أن يكون Guid صالح." : "Default account id must be a valid Guid.";
            return;
        }

        var category = new DeductibleExpenseCategory(
            code: _form.Code,
            name: new ArabicEnglishText(_form.NameArabic, _form.NameEnglish),
            defaultDeductible: _form.DefaultDeductible,
            defaultAccountId: accountId);
        Db.Add(category);
        await Db.SaveChangesAsync();

        _form = new FormModel();
        _savedFlash = IsArabic ? $"تمت إضافة فئة المصروفات {category.Code}." : $"Expense category {category.Code} added.";
        await ReloadAsync();
    }

    private async Task DeactivateAsync(Guid id)
    {
        var c = await Db.Set<DeductibleExpenseCategory>().FirstAsync(x => x.Id == id);
        c.Deactivate();
        await Db.SaveChangesAsync();
        _savedFlash = IsArabic ? $"تم تعطيل الفئة {c.Code}." : $"Category {c.Code} deactivated.";
        await ReloadAsync();
    }

    private async Task ReactivateAsync(Guid id)
    {
        var c = await Db.Set<DeductibleExpenseCategory>().FirstAsync(x => x.Id == id);
        c.Reactivate();
        await Db.SaveChangesAsync();
        _savedFlash = IsArabic ? $"تم إعادة تفعيل الفئة {c.Code}." : $"Category {c.Code} reactivated.";
        await ReloadAsync();
    }

    private sealed class FormModel
    {
        [Required, StringLength(32)] public string Code { get; set; } = "";
        [Required, StringLength(200)] public string NameEnglish { get; set; } = "";
        [Required, StringLength(200)] public string NameArabic { get; set; } = "";
        public bool DefaultDeductible { get; set; } = true;
        [Required] public string DefaultAccountId { get; set; } = Guid.Empty.ToString("D");
    }
}
