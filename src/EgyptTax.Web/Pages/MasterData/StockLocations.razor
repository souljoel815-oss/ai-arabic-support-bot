@page "/stock-locations"
@using EgyptTax.Domain.MasterData
@using EgyptTax.Infrastructure.Persistence
@using EgyptTax.SharedKernel
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@attribute [Authorize(Policy = "FullyAuthenticated")]

@*
    L4 (v3 roadmap) — stock locations / warehouses. v1 manages the
    locations themselves; the actual per-location stock accounting
    wires into PostSalesInvoiceHandler in a follow-on commit once
    a real customer asks for it. For now, locations are visible
    + manageable, and ItemStockByLocation rows can be created by
    later code paths without re-shaping the schema.
*@

<PageTitle>@Tr("المخازن والفروع | DaftarX", "Stock Locations | DaftarX")</PageTitle>

<h1>@Tr("المخازن والفروع", "Stock Locations")</h1>
<p class="page-subtitle">
    @Tr(
        "ضيف فروعك أو مخازنك هنا (مثلاً «الفرع» و «المخزن الكبير»). الفرع المعلّم كافتراضي هو اللي بتُحسم منه المبيعات لو ما اخترتش غيره وقت الترحيل.",
        "Add your shops / warehouses here (e.g. \"Main Branch\" and \"Storage Warehouse\"). The default location is the one used for sales decrements when no other is picked at post-time.")
</p>

<p class="kpi-card kpi-info" style="padding:12px;">
    <strong>@Tr("نصيحة:", "Tip:")</strong>
    @Tr(
        "لو الأصناف بتاعتك عندها أرصدة قديمة قبل ما تستخدم فروع متعددة، اضغط «تهيئة المخزون لكل فرع» تحت لتنقل كل الأرصدة الحالية للفرع الافتراضي. بعد كده استخدم «نقل مخزون» لتوزّع الكميات بين الفروع.",
        "If your items have stock balances from before you started using multiple locations, click \"Initialize per-location tracking\" below to seed the default location with all current quantities. Then use Stock Transfer to redistribute units between locations.")
</p>

@if (_flash is not null)
{
    <div class="@_flashClass" style="margin:8px 0;">@_flash</div>
}

@if (_loading)
{
    <p>@Tr("جارٍ التحميل…", "Loading…")</p>
}
else
{
    <table class="data-table">
        <thead>
            <tr>
                <th>@Tr("الكود", "Code")</th>
                <th>@Tr("الاسم (عربي)", "Name (Ar)")</th>
                <th>@Tr("الاسم (إنجليزي)", "Name (En)")</th>
                <th>@Tr("افتراضي؟", "Default?")</th>
                <th>@Tr("الحالة", "Status")</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var loc in _locations)
            {
                var local = loc;
                <tr>
                    <td>@loc.Code</td>
                    <td>@loc.Name.Arabic</td>
                    <td>@loc.Name.English</td>
                    <td>
                        @if (loc.IsDefault)
                        {
                            <span class="badge badge-success">✓ @Tr("افتراضي", "Default")</span>
                        }
                        else if (loc.IsActive)
                        {
                            <button type="button" class="btn-secondary" style="font-size:12px;padding:4px 8px;"
                                    @onclick="() => MakeDefaultAsync(local.Id)">
                                @Tr("اجعله افتراضياً", "Make default")
                            </button>
                        }
                    </td>
                    <td>
                        @if (loc.IsActive)
                        {
                            <span style="color:var(--success);">@Tr("نشط", "Active")</span>
                        }
                        else
                        {
                            <span style="color:var(--muted);">@Tr("معطل", "Inactive")</span>
                        }
                    </td>
                    <td>
                        @if (!loc.IsDefault)
                        {
                            if (loc.IsActive)
                            {
                                <button type="button" class="btn-secondary" style="font-size:12px;"
                                        @onclick="() => DeactivateAsync(local.Id)">
                                    @Tr("تعطيل", "Deactivate")
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn-secondary" style="font-size:12px;"
                                        @onclick="() => ReactivateAsync(local.Id)">
                                    @Tr("تفعيل", "Reactivate")
                                </button>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h2 style="margin-top:24px;">@Tr("+ إضافة فرع جديد", "+ Add a new location")</h2>
    <EditForm Model="_form" OnValidSubmit="OnCreateAsync" FormName="loc-create" class="form-grid">
        <label>
            <span>@Tr("الكود *", "Code *")</span>
            <InputText @bind-Value="_form.Code" placeholder="MAIN" maxlength="32" />
        </label>
        <label>
            <span>@Tr("الاسم (عربي) *", "Name (Arabic) *")</span>
            <InputText @bind-Value="_form.NameAr" placeholder="@Tr("الفرع الرئيسي", "الفرع الرئيسي")" />
        </label>
        <label>
            <span>@Tr("الاسم (إنجليزي) *", "Name (English) *")</span>
            <InputText @bind-Value="_form.NameEn" placeholder="Main Branch" />
        </label>
        <label style="display:flex;align-items:center;gap:8px;">
            <input type="checkbox" @bind="_form.IsDefault" />
            <span>@Tr("اجعله افتراضياً", "Make default")</span>
        </label>
        <div style="grid-column:1/-1;">
            <button type="submit" class="btn-primary" disabled="@_busy">
                @(_busy ? Tr("جارٍ الحفظ…", "Saving…") : Tr("إضافة", "Add"))
            </button>
        </div>
    </EditForm>

    @* L4 phase 3 — one-time backfill that seeds ItemStockByLocation
       at the default location from existing Item.QuantityOnHand.
       Only creates rows that don't already exist (idempotent), so
       running it twice does nothing the second time. *@
    @if (_locations.Any(l => l.IsDefault))
    {
        <h2 style="margin-top:32px;">@Tr("تهيئة المخزون لكل فرع", "Initialize per-location tracking")</h2>
        <p class="page-subtitle" style="font-size:13px;">
            @Tr(
                "يقرأ كل صنف عنده رصيد دلوقتي وينشئ سجل في الفرع الافتراضي بنفس الكمية. مفيد بعد ما تضيف فرع جديد لتنقل الأرصدة القديمة. آمن للتشغيل أكتر من مرة (مش بيعدّل أرصدة موجودة).",
                "Reads every item with current stock and creates a row at the default location with the same quantity. Useful after adding a new location to seed historical balances. Safe to run multiple times (skips items that already have a row).")
        </p>
        <button type="button" class="btn-secondary" disabled="@_busy" @onclick="OnBackfillAsync">
            @(_busy ? Tr("جارٍ التهيئة…", "Initializing…") : Tr("🔄 تهيئة الآن", "🔄 Initialize now"))
        </button>
    }
}

@code {
    private bool _loading = true;
    private bool _busy;
    private string? _flash;
    private string _flashClass = "kpi-card kpi-info";

    private List<StockLocation> _locations = new();
    private FormModel _form = new();

    private sealed class FormModel
    {
        public string Code { get; set; } = "";
        public string NameAr { get; set; } = "";
        public string NameEn { get; set; } = "";
        public bool IsDefault { get; set; }
    }

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _locations = await Db.Set<StockLocation>()
            .OrderByDescending(l => l.IsDefault)
            .ThenBy(l => l.Code)
            .ToListAsync();
        _loading = false;
    }

    private async Task OnCreateAsync()
    {
        _flash = null;
        if (string.IsNullOrWhiteSpace(_form.Code) ||
            string.IsNullOrWhiteSpace(_form.NameAr) ||
            string.IsNullOrWhiteSpace(_form.NameEn))
        {
            _flash = Tr("املأ الكود + الاسمين.", "Code + both names are required.");
            _flashClass = "kpi-card kpi-error";
            return;
        }

        _busy = true;
        try
        {
            var trimmedCode = _form.Code.Trim().ToUpperInvariant();
            var dup = await Db.Set<StockLocation>().AnyAsync(l => l.Code == trimmedCode);
            if (dup)
            {
                _flash = Tr($"الكود {trimmedCode} موجود.", $"Code {trimmedCode} already exists.");
                _flashClass = "kpi-card kpi-error";
                return;
            }

            // If marking this one as default, unmark any prior default first.
            if (_form.IsDefault)
            {
                var priorDefault = await Db.Set<StockLocation>().FirstOrDefaultAsync(l => l.IsDefault);
                priorDefault?.UnmarkDefault();
            }
            // Otherwise: if there's no default yet, make this one default automatically.
            else if (!await Db.Set<StockLocation>().AnyAsync(l => l.IsDefault))
            {
                _form.IsDefault = true;
            }

            var loc = new StockLocation(
                code: trimmedCode,
                name: new ArabicEnglishText(_form.NameAr, _form.NameEn),
                isDefault: _form.IsDefault);
            Db.Add(loc);
            await Db.SaveChangesAsync();

            _form = new FormModel();
            _flash = Tr("✓ تمت الإضافة.", "✓ Location added.");
            _flashClass = "kpi-card kpi-success";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _flash = ex.Message;
            _flashClass = "kpi-card kpi-error";
        }
        finally { _busy = false; }
    }

    private async Task MakeDefaultAsync(Guid id)
    {
        try
        {
            var priorDefault = await Db.Set<StockLocation>().FirstOrDefaultAsync(l => l.IsDefault);
            priorDefault?.UnmarkDefault();
            var target = await Db.Set<StockLocation>().FirstAsync(l => l.Id == id);
            target.MarkDefault();
            await Db.SaveChangesAsync();
            await ReloadAsync();
        }
        catch (Exception ex) { _flash = ex.Message; _flashClass = "kpi-card kpi-error"; }
    }

    private async Task DeactivateAsync(Guid id)
    {
        try
        {
            var loc = await Db.Set<StockLocation>().FirstAsync(l => l.Id == id);
            loc.Deactivate();
            await Db.SaveChangesAsync();
            await ReloadAsync();
        }
        catch (Exception ex) { _flash = ex.Message; _flashClass = "kpi-card kpi-error"; }
    }

    private async Task ReactivateAsync(Guid id)
    {
        try
        {
            var loc = await Db.Set<StockLocation>().FirstAsync(l => l.Id == id);
            loc.Reactivate();
            await Db.SaveChangesAsync();
            await ReloadAsync();
        }
        catch (Exception ex) { _flash = ex.Message; _flashClass = "kpi-card kpi-error"; }
    }

    /// <summary>L4 phase 3 — one-time backfill. Loads every Item
    /// with QuantityOnHand > 0, then for each one that doesn't
    /// already have an ItemStockByLocation row at the default
    /// location, creates a row with quantity = Item.QuantityOnHand.
    /// Items that already have a default-location row are skipped
    /// so re-running is safe.</summary>
    private async Task OnBackfillAsync()
    {
        _flash = null;
        _busy = true;
        try
        {
            var defaultLoc = _locations.FirstOrDefault(l => l.IsDefault);
            if (defaultLoc is null)
            {
                _flash = Tr("اعمل فرع افتراضي الأول.", "Mark a location as default first.");
                _flashClass = "kpi-card kpi-error";
                return;
            }

            var itemsWithStock = await Db.Set<Item>().AsNoTracking()
                .Where(i => i.QuantityOnHand > 0)
                .Select(i => new { i.Id, i.QuantityOnHand })
                .ToListAsync();

            if (itemsWithStock.Count == 0)
            {
                _flash = Tr("مفيش أصناف عندها رصيد للتهيئة.", "No items with positive stock to initialize.");
                _flashClass = "kpi-card kpi-info";
                return;
            }

            var itemIds = itemsWithStock.Select(i => i.Id).ToList();
            var existing = await Db.Set<ItemStockByLocation>()
                .Where(s => s.LocationId == defaultLoc.Id && itemIds.Contains(s.ItemId))
                .Select(s => s.ItemId)
                .ToListAsync();
            var existingSet = new HashSet<Guid>(existing);

            var added = 0;
            foreach (var item in itemsWithStock)
            {
                if (existingSet.Contains(item.Id)) continue;
                Db.Add(new ItemStockByLocation(item.Id, defaultLoc.Id, item.QuantityOnHand));
                added++;
            }

            if (added > 0) await Db.SaveChangesAsync();
            _flash = Tr(
                $"✓ تم تهيئة {added} صنف في فرع {defaultLoc.Code}. (تم تخطي {existingSet.Count} صنف عنده سجل بالفعل.)",
                $"✓ Initialized {added} items at {defaultLoc.Code}. (Skipped {existingSet.Count} items that already had a row.)");
            _flashClass = "kpi-card kpi-success";
        }
        catch (Exception ex)
        {
            _flash = ex.Message;
            _flashClass = "kpi-card kpi-error";
        }
        finally { _busy = false; }
    }
}
