@page "/stock-locations"
@using EgyptTax.Domain.MasterData
@using EgyptTax.Infrastructure.Persistence
@using EgyptTax.SharedKernel
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@attribute [Authorize(Policy = "FullyAuthenticated")]

@*
    L4 (v3 roadmap) — stock locations / warehouses. v1 manages the
    locations themselves; the actual per-location stock accounting
    wires into PostSalesInvoiceHandler in a follow-on commit once
    a real customer asks for it. For now, locations are visible
    + manageable, and ItemStockByLocation rows can be created by
    later code paths without re-shaping the schema.
*@

<PageTitle>@Tr("المخازن والفروع | DaftarX", "Stock Locations | DaftarX")</PageTitle>

<h1>@Tr("المخازن والفروع", "Stock Locations")</h1>
<p class="page-subtitle">
    @Tr(
        "ضيف فروعك أو مخازنك هنا (مثلاً «الفرع» و «المخزن الكبير»). الفرع المعلّم كافتراضي هو اللي بتُحسم منه المبيعات لو ما اخترتش غيره وقت الترحيل.",
        "Add your shops / warehouses here (e.g. \"Main Branch\" and \"Storage Warehouse\"). The default location is the one used for sales decrements when no other is picked at post-time.")
</p>

<p class="kpi-card kpi-info" style="padding:12px;">
    <strong>@Tr("ملاحظة:", "Note:")</strong>
    @Tr(
        "v1: بنحفظ بيانات الفروع دلوقتي. الحركة المخزنية الفعلية (الفصل بين الفروع، تحويلات المخزون) تيجي في تحديث قريب. الفواتير دلوقتي بتسحب من الإجمالي زي ما كانت.",
        "v1: locations are stored now. Actual per-location stock accounting (separate counters, transfers) lands in a follow-on update. Invoices currently decrement from the global Item.QuantityOnHand as before.")
</p>

@if (_flash is not null)
{
    <div class="@_flashClass" style="margin:8px 0;">@_flash</div>
}

@if (_loading)
{
    <p>@Tr("جارٍ التحميل…", "Loading…")</p>
}
else
{
    <table class="data-table">
        <thead>
            <tr>
                <th>@Tr("الكود", "Code")</th>
                <th>@Tr("الاسم (عربي)", "Name (Ar)")</th>
                <th>@Tr("الاسم (إنجليزي)", "Name (En)")</th>
                <th>@Tr("افتراضي؟", "Default?")</th>
                <th>@Tr("الحالة", "Status")</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var loc in _locations)
            {
                var local = loc;
                <tr>
                    <td>@loc.Code</td>
                    <td>@loc.Name.Arabic</td>
                    <td>@loc.Name.English</td>
                    <td>
                        @if (loc.IsDefault)
                        {
                            <span class="badge badge-success">✓ @Tr("افتراضي", "Default")</span>
                        }
                        else if (loc.IsActive)
                        {
                            <button type="button" class="btn-secondary" style="font-size:12px;padding:4px 8px;"
                                    @onclick="() => MakeDefaultAsync(local.Id)">
                                @Tr("اجعله افتراضياً", "Make default")
                            </button>
                        }
                    </td>
                    <td>
                        @if (loc.IsActive)
                        {
                            <span style="color:var(--success);">@Tr("نشط", "Active")</span>
                        }
                        else
                        {
                            <span style="color:var(--muted);">@Tr("معطل", "Inactive")</span>
                        }
                    </td>
                    <td>
                        @if (!loc.IsDefault)
                        {
                            if (loc.IsActive)
                            {
                                <button type="button" class="btn-secondary" style="font-size:12px;"
                                        @onclick="() => DeactivateAsync(local.Id)">
                                    @Tr("تعطيل", "Deactivate")
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn-secondary" style="font-size:12px;"
                                        @onclick="() => ReactivateAsync(local.Id)">
                                    @Tr("تفعيل", "Reactivate")
                                </button>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h2 style="margin-top:24px;">@Tr("+ إضافة فرع جديد", "+ Add a new location")</h2>
    <EditForm Model="_form" OnValidSubmit="OnCreateAsync" FormName="loc-create" class="form-grid">
        <label>
            <span>@Tr("الكود *", "Code *")</span>
            <InputText @bind-Value="_form.Code" placeholder="MAIN" maxlength="32" />
        </label>
        <label>
            <span>@Tr("الاسم (عربي) *", "Name (Arabic) *")</span>
            <InputText @bind-Value="_form.NameAr" placeholder="@Tr("الفرع الرئيسي", "الفرع الرئيسي")" />
        </label>
        <label>
            <span>@Tr("الاسم (إنجليزي) *", "Name (English) *")</span>
            <InputText @bind-Value="_form.NameEn" placeholder="Main Branch" />
        </label>
        <label style="display:flex;align-items:center;gap:8px;">
            <input type="checkbox" @bind="_form.IsDefault" />
            <span>@Tr("اجعله افتراضياً", "Make default")</span>
        </label>
        <div style="grid-column:1/-1;">
            <button type="submit" class="btn-primary" disabled="@_busy">
                @(_busy ? Tr("جارٍ الحفظ…", "Saving…") : Tr("إضافة", "Add"))
            </button>
        </div>
    </EditForm>
}

@code {
    private bool _loading = true;
    private bool _busy;
    private string? _flash;
    private string _flashClass = "kpi-card kpi-info";

    private List<StockLocation> _locations = new();
    private FormModel _form = new();

    private sealed class FormModel
    {
        public string Code { get; set; } = "";
        public string NameAr { get; set; } = "";
        public string NameEn { get; set; } = "";
        public bool IsDefault { get; set; }
    }

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _locations = await Db.Set<StockLocation>()
            .OrderByDescending(l => l.IsDefault)
            .ThenBy(l => l.Code)
            .ToListAsync();
        _loading = false;
    }

    private async Task OnCreateAsync()
    {
        _flash = null;
        if (string.IsNullOrWhiteSpace(_form.Code) ||
            string.IsNullOrWhiteSpace(_form.NameAr) ||
            string.IsNullOrWhiteSpace(_form.NameEn))
        {
            _flash = Tr("املأ الكود + الاسمين.", "Code + both names are required.");
            _flashClass = "kpi-card kpi-error";
            return;
        }

        _busy = true;
        try
        {
            var trimmedCode = _form.Code.Trim().ToUpperInvariant();
            var dup = await Db.Set<StockLocation>().AnyAsync(l => l.Code == trimmedCode);
            if (dup)
            {
                _flash = Tr($"الكود {trimmedCode} موجود.", $"Code {trimmedCode} already exists.");
                _flashClass = "kpi-card kpi-error";
                return;
            }

            // If marking this one as default, unmark any prior default first.
            if (_form.IsDefault)
            {
                var priorDefault = await Db.Set<StockLocation>().FirstOrDefaultAsync(l => l.IsDefault);
                priorDefault?.UnmarkDefault();
            }
            // Otherwise: if there's no default yet, make this one default automatically.
            else if (!await Db.Set<StockLocation>().AnyAsync(l => l.IsDefault))
            {
                _form.IsDefault = true;
            }

            var loc = new StockLocation(
                code: trimmedCode,
                name: new ArabicEnglishText(_form.NameAr, _form.NameEn),
                isDefault: _form.IsDefault);
            Db.Add(loc);
            await Db.SaveChangesAsync();

            _form = new FormModel();
            _flash = Tr("✓ تمت الإضافة.", "✓ Location added.");
            _flashClass = "kpi-card kpi-success";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _flash = ex.Message;
            _flashClass = "kpi-card kpi-error";
        }
        finally { _busy = false; }
    }

    private async Task MakeDefaultAsync(Guid id)
    {
        try
        {
            var priorDefault = await Db.Set<StockLocation>().FirstOrDefaultAsync(l => l.IsDefault);
            priorDefault?.UnmarkDefault();
            var target = await Db.Set<StockLocation>().FirstAsync(l => l.Id == id);
            target.MarkDefault();
            await Db.SaveChangesAsync();
            await ReloadAsync();
        }
        catch (Exception ex) { _flash = ex.Message; _flashClass = "kpi-card kpi-error"; }
    }

    private async Task DeactivateAsync(Guid id)
    {
        try
        {
            var loc = await Db.Set<StockLocation>().FirstAsync(l => l.Id == id);
            loc.Deactivate();
            await Db.SaveChangesAsync();
            await ReloadAsync();
        }
        catch (Exception ex) { _flash = ex.Message; _flashClass = "kpi-card kpi-error"; }
    }

    private async Task ReactivateAsync(Guid id)
    {
        try
        {
            var loc = await Db.Set<StockLocation>().FirstAsync(l => l.Id == id);
            loc.Reactivate();
            await Db.SaveChangesAsync();
            await ReloadAsync();
        }
        catch (Exception ex) { _flash = ex.Message; _flashClass = "kpi-card kpi-error"; }
    }
}
