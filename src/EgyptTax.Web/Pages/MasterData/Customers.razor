@page "/customers"
@using System.ComponentModel.DataAnnotations
@using EgyptTax.Domain.MasterData
@using EgyptTax.Infrastructure.Persistence
@using EgyptTax.SharedKernel
@using EgyptTax.Web.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject IJSRuntime Js
@inject EgyptTax.Infrastructure.Customers.CustomerPortalService Portal
@inject NavigationManager Nav
@attribute [Authorize(Policy = "FullyAuthenticated")]

<h1>
    @(IsArabic ? "العملاء" : "Customers")
    @if (_customers is { Count: > 0 })
    {
        <button type="button" class="btn-secondary" style="font-size:13px;margin-inline-start:12px;"
                @onclick="ExportCsvAsync">
            ⬇ @(IsArabic ? "تصدير CSV" : "Export CSV")
        </button>
    }
</h1>

@if (_savedFlash is not null)
{
    <div class="flash-success" role="status">@_savedFlash</div>
}

@if (_customers is { Count: > 0 })
{
    <div class="list-stats">
        <div class="list-stat">
            <span class="list-stat-label">@(IsArabic ? "إجمالي العملاء" : "Total")</span>
            <span class="list-stat-value">@_customers.Count</span>
        </div>
        <div class="list-stat">
            <span class="list-stat-label">@(IsArabic ? "نشطين" : "Active")</span>
            <span class="list-stat-value is-success">@_customers.Count(c => c.Status == CustomerStatus.Active)</span>
        </div>
        <div class="list-stat">
            <span class="list-stat-label">@(IsArabic ? "غير نشطين" : "Inactive")</span>
            <span class="list-stat-value">@_customers.Count(c => c.Status == CustomerStatus.Inactive)</span>
        </div>
        <div class="list-stat">
            <span class="list-stat-label">@(IsArabic ? "بدون رقم ضريبي" : "Missing TIN")</span>
            <span class="list-stat-value @(_customers.Count(c => string.IsNullOrEmpty(c.TaxProfile.TinValue)) > 0 ? "is-warn" : "")">@_customers.Count(c => string.IsNullOrEmpty(c.TaxProfile.TinValue))</span>
        </div>
    </div>
}

<section class="master-data-list">
    <h2>@(IsArabic ? "العملاء الحاليون" : "Existing customers")</h2>
    @if (_customers is null)
    {
        <p>@(IsArabic ? "جارٍ التحميل…" : "Loading…")</p>
    }
    else if (_customers.Count == 0)
    {
        <p><em>@(IsArabic ? "لا يوجد عملاء بعد — أضف عميلاً بالأسفل." : "No customers yet — add one below.")</em></p>
    }
    else
    {
        <table class="data-grid">
            <thead>
                <tr>
                    <th>@(IsArabic ? "الكود" : "Code")</th>
                    <th>@(IsArabic ? "الاسم (إنجليزي)" : "Name (English)")</th>
                    <th>@(IsArabic ? "الاسم (عربي)" : "Name (Arabic)")</th>
                    <th>@(IsArabic ? "نوع الملف" : "Profile")</th>
                    <th>@(IsArabic ? "الرقم الضريبي" : "TIN")</th>
                    <th>@(IsArabic ? "الحالة" : "Status")</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in _customers)
                {
                    <tr class="@(c.Status == CustomerStatus.Inactive ? "row-muted" : "")">
                        <td>@c.Code</td>
                        <td>@c.Name.English</td>
                        <td>@c.Name.Arabic</td>
                        <td>@c.TaxProfile.ProfileType</td>
                        <td>@(c.TaxProfile.TinValue ?? "—")</td>
                        <td>@c.Status</td>
                        <td>
                            <a href="/customers/@c.Id/statement" style="margin-inline-end:8px;">@(IsArabic ? "كشف حساب" : "Statement")</a>
                            <button type="button" style="margin-inline-end:8px;font-size:12px;"
                                    @onclick="() => GeneratePortalLinkAsync(c.Id)">
                                @(IsArabic ? "🔗 رابط البوابة" : "🔗 Portal link")
                            </button>
                            @if (c.Status == CustomerStatus.Active)
                            {
                                <button type="button" @onclick="() => DeactivateAsync(c.Id)">@(IsArabic ? "تعطيل" : "Deactivate")</button>
                            }
                            else
                            {
                                <button type="button" @onclick="() => ReactivateAsync(c.Id)">@(IsArabic ? "إعادة تفعيل" : "Reactivate")</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="master-data-create">
    <h2>@(IsArabic ? "إضافة عميل" : "Add a customer")</h2>
    <EditForm Model="_form" OnValidSubmit="OnCreateAsync" FormName="customer-create" class="form-grid">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <fieldset>
            <legend>@(IsArabic ? "الهوية" : "Identity")</legend>
            <label>
                <span>@(IsArabic ? "الكود *" : "Code *")</span>
                <InputText @bind-Value="_form.Code" />
            </label>
            <label>
                <span>@(IsArabic ? "الاسم (إنجليزي) *" : "Name (English) *")</span>
                <InputText @bind-Value="_form.NameEnglish" />
            </label>
            <label>
                <span>@(IsArabic ? "الاسم (عربي) *" : "Name (Arabic) *")</span>
                <InputText @bind-Value="_form.NameArabic" />
            </label>
            <label>
                <span>@(IsArabic ? "الهاتف (اختياري)" : "Phone (optional)")</span>
                <InputText @bind-Value="_form.Phone" />
            </label>
            <label>
                <span>@(IsArabic ? "البريد الإلكتروني (اختياري)" : "Email (optional)")</span>
                <InputText @bind-Value="_form.Email" />
            </label>
        </fieldset>

        <fieldset>
            <legend>@(IsArabic ? "الملف الضريبي (FR-040)" : "Tax profile (FR-040)")</legend>
            <label>
                <span>@(IsArabic ? "نوع الملف" : "Profile type")</span>
                <InputSelect @bind-Value="_form.ProfileType">
                    <option value="@CustomerTaxProfileType.B2BRegistered">@(IsArabic ? "شركة — مسجلة ضريبياً" : "B2B — Registered")</option>
                    <option value="@CustomerTaxProfileType.B2BUnregistered">@(IsArabic ? "شركة — غير مسجلة" : "B2B — Unregistered")</option>
                    <option value="@CustomerTaxProfileType.B2CConsumer">@(IsArabic ? "مستهلك نهائي" : "B2C — Consumer")</option>
                </InputSelect>
            </label>
            @if (_form.ProfileType == CustomerTaxProfileType.B2BRegistered)
            {
                <label>
                    <span>@(IsArabic ? "الرقم الضريبي (9 أرقام) — مطلوب للشركات المسجلة" : "TIN (9 digits) — required for B2B Registered")</span>
                    <InputText @bind-Value="_form.Tin" />
                </label>
            }
            <label>
                <span>@(IsArabic ? "معفى من الضريبة" : "VAT exempt")</span>
                <InputCheckbox @bind-Value="_form.VatExemption" />
            </label>
            <label>
                <span>@(IsArabic ? "فئة الضريبة الافتراضية للمبيعات" : "Default sales VAT category")</span>
                <InputSelect @bind-Value="_form.DefaultVatCategoryId">
                    <option value="@Guid.Empty">@(IsArabic ? "— لا شيء —" : "— none —")</option>
                    @if (_vatCategories is not null)
                    {
                        @foreach (var v in _vatCategories)
                        {
                            <option value="@v.Id">@v.Code (@v.RatePercent.ToString("0.##")%)</option>
                        }
                    }
                </InputSelect>
            </label>
            <label>
                <span>@(IsArabic ? "حد الائتمان (ج.م.) — اتركه فارغاً = لا حد" : "Credit limit (EGP) — blank = no limit")</span>
                <InputNumber @bind-Value="_form.CreditLimitEgp" />
            </label>
        </fieldset>

        <fieldset>
            <legend>@(IsArabic ? "العنوان" : "Address")</legend>
            <label>
                <span>@(IsArabic ? "العرض (إنجليزي) *" : "Display (English) *")</span>
                <InputText @bind-Value="_form.AddressDisplayEnglish" />
            </label>
            <label>
                <span>@(IsArabic ? "العرض (عربي) *" : "Display (Arabic) *")</span>
                <InputText @bind-Value="_form.AddressDisplayArabic" />
            </label>
            <label>
                <span>@(IsArabic ? "المحافظة *" : "Governorate *")</span>
                <InputText @bind-Value="_form.AddressGovernorate" />
            </label>
            <label>
                <span>@(IsArabic ? "المنطقة / المدينة *" : "Region / city *")</span>
                <InputText @bind-Value="_form.AddressRegionCity" />
            </label>
            <label>
                <span>@(IsArabic ? "الشارع *" : "Street *")</span>
                <InputText @bind-Value="_form.AddressStreet" />
            </label>
            <label>
                <span>@(IsArabic ? "رقم العقار *" : "Building number *")</span>
                <InputText @bind-Value="_form.AddressBuildingNumber" />
            </label>
        </fieldset>

        <button type="submit">@(IsArabic ? "إضافة عميل" : "Add customer")</button>
    </EditForm>
</section>

@code {
    private List<Customer>? _customers;
    private List<VatCategory>? _vatCategories;
    private FormModel _form = new();
    private string? _savedFlash;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _customers = await Db.Set<Customer>().AsNoTracking().OrderBy(c => c.Code).ToListAsync();
        _vatCategories = await Db.Set<VatCategory>().AsNoTracking().OrderBy(v => v.Code).ToListAsync();
    }

    private async Task OnCreateAsync()
    {
        // FR-040 — TIN required iff B2BRegistered.
        if (_form.ProfileType == CustomerTaxProfileType.B2BRegistered
            && string.IsNullOrWhiteSpace(_form.Tin))
        {
            _savedFlash = IsArabic
                ? "الرقم الضريبي مطلوب للعملاء من نوع شركة مسجلة."
                : "TIN is required for B2B Registered customers.";
            return;
        }

        var address = PostalAddress.Create(
            display: new ArabicEnglishText(_form.AddressDisplayArabic, _form.AddressDisplayEnglish),
            governorate: _form.AddressGovernorate,
            regionCity: _form.AddressRegionCity,
            street: _form.AddressStreet,
            buildingNumber: _form.AddressBuildingNumber);

        var defaultVat = _form.DefaultVatCategoryId == Guid.Empty
            ? (Guid?)null
            : _form.DefaultVatCategoryId;

        var taxProfile = _form.ProfileType switch
        {
            CustomerTaxProfileType.B2BRegistered =>
                CustomerTaxProfile.B2BRegistered(EgyptianTin.Parse(_form.Tin!), _form.VatExemption, defaultVat),
            CustomerTaxProfileType.B2BUnregistered =>
                CustomerTaxProfile.B2BUnregistered(_form.VatExemption, defaultVat),
            _ =>
                CustomerTaxProfile.B2CConsumer(_form.VatExemption, defaultVat),
        };

        var customer = new Customer(
            code: _form.Code,
            name: new ArabicEnglishText(_form.NameArabic, _form.NameEnglish),
            address: address,
            taxProfile: taxProfile,
            phone: string.IsNullOrWhiteSpace(_form.Phone) ? null : _form.Phone,
            email: string.IsNullOrWhiteSpace(_form.Email) ? null : _form.Email);
        if (_form.CreditLimitEgp is { } limit)
        {
            customer.UpdateCreditLimit(limit);
        }
        Db.Add(customer);
        await Db.SaveChangesAsync();

        _form = new FormModel();
        _savedFlash = IsArabic
            ? $"تمت إضافة العميل {customer.Code}."
            : $"Customer {customer.Code} added.";
        await ReloadAsync();
    }

    private async Task DeactivateAsync(Guid id)
    {
        var c = await Db.Set<Customer>().FirstAsync(x => x.Id == id);
        c.Deactivate();
        await Db.SaveChangesAsync();
        _savedFlash = IsArabic
            ? $"تم تعطيل العميل {c.Code}."
            : $"Customer {c.Code} deactivated.";
        await ReloadAsync();
    }

    private async Task ReactivateAsync(Guid id)
    {
        var c = await Db.Set<Customer>().FirstAsync(x => x.Id == id);
        c.Reactivate();
        await Db.SaveChangesAsync();
        _savedFlash = IsArabic
            ? $"تم إعادة تفعيل العميل {c.Code}."
            : $"Customer {c.Code} reactivated.";
        await ReloadAsync();
    }

    /// <summary>L5 (v3 roadmap) — generate a magic-link portal URL
    /// for the customer + copy it to the clipboard. Operator can
    /// paste into WhatsApp / email / SMS to send to the customer.</summary>
    private async Task GeneratePortalLinkAsync(Guid id)
    {
        try
        {
            var c = await Db.Set<Customer>().AsNoTracking().FirstAsync(x => x.Id == id);
            var token = await Portal.GenerateLinkAsync(id, createdByUserId: null);
            var baseUri = Nav.BaseUri.TrimEnd('/');
            var url = $"{baseUri}/portal/{token}";

            // Best-effort clipboard copy via JS interop. Fall back
            // to just showing the URL in the flash message if the
            // browser blocks clipboard access.
            try
            {
                await Js.InvokeVoidAsync("navigator.clipboard.writeText", url);
                _savedFlash = IsArabic
                    ? $"✓ تم نسخ رابط البوابة لـ {c.Code}: {url}"
                    : $"✓ Portal link for {c.Code} copied to clipboard: {url}";
            }
            catch
            {
                _savedFlash = IsArabic
                    ? $"رابط البوابة لـ {c.Code} (انسخه يدوياً): {url}"
                    : $"Portal link for {c.Code} (copy manually): {url}";
            }
        }
        catch (Exception ex)
        {
            _savedFlash = IsArabic ? $"فشل التوليد: {ex.Message}" : $"Failed: {ex.Message}";
        }
    }

    private async Task ExportCsvAsync()
    {
        if (_customers is null) return;
        var bytes = CsvExporter.Build(
            headers: new[] { "Code", "Name (EN)", "Name (AR)", "TIN", "Profile type", "Phone", "Email", "Status", "Credit limit (EGP)" },
            rows: _customers,
            rowSelector: c => new object?[]
            {
                c.Code,
                c.Name.English,
                c.Name.Arabic,
                c.TaxProfile.TinValue,
                c.TaxProfile.ProfileType.ToString(),
                c.Phone,
                c.Email,
                c.Status.ToString(),
                c.CreditLimitEgp,
            });
        var b64 = Convert.ToBase64String(bytes);
        await Js.InvokeVoidAsync("daftarxDownloadBytes",
            $"customers-{DateTime.UtcNow:yyyyMMdd}.csv", b64, "text/csv");
    }

    private sealed class FormModel
    {
        [Required, StringLength(32)] public string Code { get; set; } = "";
        [Required, StringLength(200)] public string NameEnglish { get; set; } = "";
        [Required, StringLength(200)] public string NameArabic { get; set; } = "";
        [StringLength(32)] public string Phone { get; set; } = "";
        [EgyptTax.Web.Validation.OptionalEmailAddress, StringLength(254)] public string Email { get; set; } = "";

        public CustomerTaxProfileType ProfileType { get; set; } = CustomerTaxProfileType.B2BRegistered;
        public string? Tin { get; set; }
        public bool VatExemption { get; set; }
        public Guid DefaultVatCategoryId { get; set; }
        public decimal? CreditLimitEgp { get; set; }

        [Required, StringLength(500)] public string AddressDisplayEnglish { get; set; } = "";
        [Required, StringLength(500)] public string AddressDisplayArabic { get; set; } = "";
        [Required, StringLength(100)] public string AddressGovernorate { get; set; } = "";
        [Required, StringLength(100)] public string AddressRegionCity { get; set; } = "";
        [Required, StringLength(200)] public string AddressStreet { get; set; } = "";
        [Required, StringLength(32)]  public string AddressBuildingNumber { get; set; } = "";
    }
}
