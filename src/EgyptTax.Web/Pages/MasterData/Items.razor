@page "/items"
@using System.ComponentModel.DataAnnotations
@using EgyptTax.Application.Eta.ItemCodeSuggestions
@using EgyptTax.Domain.MasterData
@using EgyptTax.Infrastructure.Persistence
@using EgyptTax.SharedKernel
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@attribute [Authorize(Policy = "FullyAuthenticated")]

<h1>@(IsArabic ? "الأصناف" : "Items")</h1>

@if (_savedFlash is not null)
{
    <div class="flash-success" role="status">@_savedFlash</div>
}

<section class="master-data-list">
    <h2>@(IsArabic ? "الأصناف الحالية" : "Existing items")</h2>
    @if (_items is null)
    {
        <p>@(IsArabic ? "جارٍ التحميل…" : "Loading…")</p>
    }
    else if (_items.Count == 0)
    {
        <p><em>@(IsArabic ? "لا توجد أصناف بعد — أضف صنفاً بالأسفل." : "No items yet — add one below.")</em></p>
    }
    else
    {
        <table class="data-grid">
            <thead>
                <tr>
                    <th>@(IsArabic ? "الكود" : "Code")</th>
                    <th>@(IsArabic ? "الاسم (إنجليزي)" : "Name (English)")</th>
                    <th>@(IsArabic ? "الاسم (عربي)" : "Name (Arabic)")</th>
                    <th>@(IsArabic ? "فئة الضريبة الافتراضية" : "Default VAT")</th>
                    <th>@(IsArabic ? "كود ETA" : "ETA code")</th>
                    <th>@(IsArabic ? "الحالة" : "Status")</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in _items)
                {
                    <tr class="@(item.Status == ItemStatus.Inactive ? "row-muted" : "")">
                        <td>@item.Code</td>
                        <td>@item.Name.English</td>
                        <td>@item.Name.Arabic</td>
                        <td>@VatCodeFor(item.DefaultVatCategoryId)</td>
                        <td>@RenderEtaCodeCell(item)</td>
                        <td>@item.Status</td>
                        <td>
                            @if (item.EtaCodeStatus == EtaItemCodeStatus.None
                                 || item.EtaCodeStatus == EtaItemCodeStatus.Failed)
                            {
                                <button type="button" class="btn-secondary" @onclick="@(() => RequestCodeAsync(item.Id, EtaItemCodeKind.Gs1))">
                                    GS1
                                </button>
                                <button type="button" class="btn-secondary" @onclick="@(() => RequestCodeAsync(item.Id, EtaItemCodeKind.Egs))">
                                    EGS
                                </button>
                            }
                            @if (item.Status == ItemStatus.Active)
                            {
                                <button type="button" @onclick="() => DeactivateAsync(item.Id)">@(IsArabic ? "تعطيل" : "Deactivate")</button>
                            }
                            else
                            {
                                <button type="button" @onclick="() => ReactivateAsync(item.Id)">@(IsArabic ? "إعادة تفعيل" : "Reactivate")</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="master-data-create">
    <h2>@(IsArabic ? "إضافة صنف" : "Add an item")</h2>
    @if (_vatCategories is null || _vatCategories.Count == 0)
    {
        <p class="flash-error">@(IsArabic ? "لم يتم تعريف أي فئات ضريبة بعد. شغّل البذرة لإنشاء فئة افتراضية." : "No VAT categories defined yet. Run the seeder to create a default Standard 14% category.")</p>
    }
    else
    {
        <EditForm Model="_form" OnValidSubmit="OnCreateAsync" FormName="item-create" class="form-grid">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <label>
                <span>@(IsArabic ? "الكود" : "Code")</span>
                <InputText @bind-Value="_form.Code" />
            </label>
            <label>
                <span>@(IsArabic ? "الاسم (إنجليزي)" : "Name (English)")</span>
                <InputText @bind-Value="_form.NameEnglish" @bind-Value:after="RefreshSuggestions" />
            </label>
            <label>
                <span>@(IsArabic ? "الاسم (عربي)" : "Name (Arabic)")</span>
                <InputText @bind-Value="_form.NameArabic" @bind-Value:after="RefreshSuggestions" />
            </label>
            <label>
                <span>@(IsArabic ? "فئة الضريبة الافتراضية" : "Default VAT category")</span>
                <InputSelect @bind-Value="_form.DefaultVatCategoryId">
                    @foreach (var v in _vatCategories)
                    {
                        <option value="@v.Id">@v.Code (@v.RatePercent.ToString("0.##")%)</option>
                    }
                </InputSelect>
            </label>

            @* G2.1 — Smart GS1/EGS code suggester. Renders as soon
               as the operator types 3+ chars in either name field.
               Picks one → fills _form.EtaItemCode silently; the new
               item ships with the code already set. *@
            @if (_codeSuggestions.Count > 0 || !string.IsNullOrEmpty(_form.EtaItemCode))
            {
                <div class="code-suggester" style="grid-column:1 / -1;">
                    <div class="code-suggester-header">
                        <Icon Name="zap" Class="ic" />
                        <strong>@(IsArabic ? "اقتراحات كود ETA" : "ETA code suggestions")</strong>
                        @if (!string.IsNullOrEmpty(_form.EtaItemCode))
                        {
                            <span class="code-suggester-applied">
                                @(IsArabic ? "تم اختيار: " : "Picked: ")<code>@_form.EtaItemCode</code>
                                <button type="button" class="code-suggester-clear" @onclick="ClearSuggestion">×</button>
                            </span>
                        }
                    </div>
                    @if (string.IsNullOrEmpty(_form.EtaItemCode))
                    {
                        <div class="code-suggester-grid">
                            @foreach (var s in _codeSuggestions)
                            {
                                var conf = s.Confidence >= EtaItemCodeSuggester.HighConfidenceThreshold
                                    ? "code-conf-high" : "code-conf-mid";
                                <button type="button" class="code-suggester-card @conf"
                                        @onclick="@(() => ApplySuggestion(s.Code))"
                                        title="@s.Category — @s.Kind">
                                    <div class="code-suggester-conf">@s.Confidence%</div>
                                    <div class="code-suggester-label">@(IsArabic ? s.LabelAr : s.LabelEn)</div>
                                    <code>@s.Code</code>
                                </button>
                            }
                        </div>
                    }
                </div>
            }

            <button type="submit">@(IsArabic ? "إضافة صنف" : "Add item")</button>
        </EditForm>
    }
</section>

@code {
    private List<Item>? _items;
    private List<VatCategory>? _vatCategories;
    private FormModel _form = new();
    private string? _savedFlash;

    // G2.1 — live ETA-code suggestions for the create form.
    // Recomputed whenever the operator types in either name field
    // (debounce isn't needed — the suggester is in-memory and
    // hits ~70 entries; the whole pass is ~1ms).
    private IReadOnlyList<EtaItemCodeSuggestion> _codeSuggestions = Array.Empty<EtaItemCodeSuggestion>();
    private void RefreshSuggestions()
    {
        var description = $"{_form.NameArabic} {_form.NameEnglish}".Trim();
        _codeSuggestions = description.Length >= 3
            ? EtaItemCodeSuggester.Suggest(description, topN: 3)
            : Array.Empty<EtaItemCodeSuggestion>();
    }
    private void ApplySuggestion(string code)
    {
        _form.EtaItemCode = code;
    }
    private void ClearSuggestion()
    {
        _form.EtaItemCode = null;
    }

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        if (_vatCategories is { Count: > 0 } && _form.DefaultVatCategoryId == Guid.Empty)
        {
            _form.DefaultVatCategoryId = _vatCategories[0].Id;
        }
    }

    private async Task ReloadAsync()
    {
        _items = await Db.Set<Item>().AsNoTracking().OrderBy(i => i.Code).ToListAsync();
        _vatCategories = await Db.Set<VatCategory>().AsNoTracking().OrderBy(v => v.Code).ToListAsync();

        // Defensive auto-seed — if no VAT categories exist when an
        // operator opens the Items page, populate the standard
        // Egyptian catalog so they don't see an "empty / run seed CLI"
        // dead-end. Idempotent; later pages reuse the same seed.
        if (_vatCategories.Count == 0)
        {
            try
            {
                await EgyptTax.Web.Tools.StartupSeed.EnsureDefaultsAsync(Db);
                _vatCategories = await Db.Set<VatCategory>().AsNoTracking().OrderBy(v => v.Code).ToListAsync();
            }
            catch
            {
                // Show the existing empty-state error if seed fails.
            }
        }
    }

    private async Task OnCreateAsync()
    {
        if (_form.DefaultVatCategoryId == Guid.Empty)
        {
            _savedFlash = IsArabic ? "اختر فئة ضريبة افتراضية قبل الحفظ." : "Pick a default VAT category before saving.";
            return;
        }

        var item = new Item(
            code: _form.Code,
            name: new ArabicEnglishText(_form.NameArabic, _form.NameEnglish),
            defaultVatCategoryId: _form.DefaultVatCategoryId);
        // G2.1 — apply the operator's picked suggestion immediately
        // so the new item ships with a usable EtaItemCode (skips the
        // request-and-wait loop the buttons drive otherwise).
        if (!string.IsNullOrWhiteSpace(_form.EtaItemCode))
        {
            item.SetEtaItemCode(_form.EtaItemCode);
        }
        Db.Add(item);
        await Db.SaveChangesAsync();

        _form = new FormModel
        {
            DefaultVatCategoryId = _vatCategories?.FirstOrDefault()?.Id ?? Guid.Empty,
        };
        _savedFlash = IsArabic ? $"تمت إضافة الصنف {item.Code}." : $"Item {item.Code} added.";
        await ReloadAsync();
    }

    private async Task DeactivateAsync(Guid id)
    {
        var item = await Db.Set<Item>().FirstAsync(x => x.Id == id);
        item.Deactivate();
        await Db.SaveChangesAsync();
        _savedFlash = IsArabic ? $"تم تعطيل الصنف {item.Code}." : $"Item {item.Code} deactivated.";
        await ReloadAsync();
    }

    private async Task ReactivateAsync(Guid id)
    {
        var item = await Db.Set<Item>().FirstAsync(x => x.Id == id);
        item.Reactivate();
        await Db.SaveChangesAsync();
        _savedFlash = IsArabic ? $"تم إعادة تفعيل الصنف {item.Code}." : $"Item {item.Code} reactivated.";
        await ReloadAsync();
    }

    private string VatCodeFor(Guid id) =>
        _vatCategories?.FirstOrDefault(v => v.Id == id) is { } v
            ? $"{v.Code} ({v.RatePercent:0.##}%)"
            : "—";

    // P1.6 — render the ETA-code cell with status badge + countdown
    // for Pending rows. Done as a method so the table row stays
    // legible.
    private RenderFragment RenderEtaCodeCell(Item item) => builder =>
    {
        var (label, cls) = item.EtaCodeStatus switch
        {
            EtaItemCodeStatus.None        => (IsArabic ? "بدون كود" : "No code", "state-rejected"),
            EtaItemCodeStatus.PendingGs1  => (IsArabic ? "GS1 قيد الانتظار" : "GS1 pending", "state-submitted"),
            EtaItemCodeStatus.PendingEgs  => (IsArabic ? "EGS قيد الانتظار" : "EGS pending", "state-submitted"),
            EtaItemCodeStatus.Active      => (IsArabic ? "نشط" : "Active", "state-approved"),
            EtaItemCodeStatus.Failed      => (IsArabic ? "مرفوض" : "Failed", "state-rejected"),
            _ => (item.EtaCodeStatus.ToString(), ""),
        };
        builder.OpenElement(0, "div");
        builder.OpenElement(1, "span");
        builder.AddAttribute(2, "class", $"state-badge {cls}");
        builder.AddContent(3, label);
        builder.CloseElement();

        if (item.EtaCodeStatus == EtaItemCodeStatus.Active && !string.IsNullOrEmpty(item.EtaItemCode))
        {
            builder.OpenElement(4, "div");
            builder.AddAttribute(5, "style", "font-size:11px;font-family:monospace;color:var(--text-muted);margin-top:4px;");
            builder.AddContent(6, item.EtaItemCode);
            builder.CloseElement();
        }
        else if (item.EtaCodeStatus is EtaItemCodeStatus.PendingGs1 or EtaItemCodeStatus.PendingEgs
                 && item.EtaCodeRequestedAtUtc is { } requested)
        {
            var elapsedDays = (DateTime.UtcNow - requested).TotalDays;
            var slaDays = item.EtaCodeStatus == EtaItemCodeStatus.PendingGs1 ? 2 : 15;
            // Snap small numbers (so the demo's compressed-second SLAs
            // still read like a sane countdown).
            var dayNum = (int)Math.Max(1, Math.Ceiling(elapsedDays));
            builder.OpenElement(7, "div");
            builder.AddAttribute(8, "style", "font-size:12px;color:var(--text-muted);margin-top:4px;");
            builder.AddContent(9, IsArabic
                ? $"اليوم {dayNum} من ~{slaDays}"
                : $"Day {dayNum} of ~{slaDays}");
            builder.CloseElement();
        }
        else if (item.EtaCodeStatus == EtaItemCodeStatus.Failed && !string.IsNullOrEmpty(item.EtaCodeFailureReason))
        {
            builder.OpenElement(10, "div");
            builder.AddAttribute(11, "style", "font-size:11px;color:var(--danger-text);margin-top:4px;");
            builder.AddContent(12, item.EtaCodeFailureReason);
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    private async Task RequestCodeAsync(Guid itemId, EtaItemCodeKind kind)
    {
        var item = await Db.Set<Item>().FirstAsync(x => x.Id == itemId);
        item.RequestEtaCode(kind, DateTime.UtcNow);
        await Db.SaveChangesAsync();
        _savedFlash = IsArabic
            ? $"تم تقديم طلب {kind} للصنف {item.Code}. هنحدّث الحالة لما السجل يرد."
            : $"{kind} code requested for {item.Code}. Status will update when the registry responds.";
        await ReloadAsync();
    }

    private sealed class FormModel
    {
        [Required, StringLength(32)] public string Code { get; set; } = "";
        [Required, StringLength(200)] public string NameEnglish { get; set; } = "";
        [Required, StringLength(200)] public string NameArabic { get; set; } = "";
        public Guid DefaultVatCategoryId { get; set; }
        /// <summary>G2.1 — set by the operator when they pick a
        /// suggestion. The new item ships with this code already
        /// filled, skipping the request-and-wait flow.</summary>
        public string? EtaItemCode { get; set; }
    }
}
