@page "/journals"
@using EgyptTax.Application.Journals
@using Microsoft.AspNetCore.Authorization
@inject IJournalLedgerQuery Query
@inject NavigationManager Nav
@attribute [Authorize(Policy = "FullyAuthenticated")]

<SettingsTabStrip Group="closing" />

<h1>@(IsArabic ? "دفتر اليومية" : "Journal ledger (FR-024 / FR-025)")</h1>

<form class="invoice-toolbar" @onsubmit="OnRefresh" @onsubmit:preventDefault>
    <label>
        <span>@(IsArabic ? "بداية الفترة" : "Period start")</span>
        <input type="date" @bind="_periodStart" />
    </label>
    <label>
        <span>@(IsArabic ? "نهاية الفترة" : "Period end")</span>
        <input type="date" @bind="_periodEnd" />
    </label>
    <button type="submit" class="btn-primary" disabled="@_loading">
        @(_loading ? (IsArabic ? "جارٍ التحميل…" : "Loading…") : (IsArabic ? "عرض القيود" : "Show entries"))
    </button>
</form>

@if (_rows is null)
{
    @if (_loading)
    {
        <p>@(IsArabic ? "جارٍ التحميل…" : "Loading…")</p>
    }
    else
    {
        <p><em>@(IsArabic ? "اختر الفترة بالأعلى ثم اضغط «عرض القيود»." : "Pick a period above and click \"Show entries\".")</em></p>
    }
    return;
}

<div class="list-stats">
    <div class="list-stat">
        <span class="list-stat-label">@(IsArabic ? "إجمالي القيود" : "Total entries")</span>
        <span class="list-stat-value">@_rows.Count</span>
    </div>
    <div class="list-stat">
        <span class="list-stat-label">@(IsArabic ? "أوتوماتيكية" : "Auto-emitted")</span>
        <span class="list-stat-value is-success">@_rows.Count(r => r.Kind == JournalEntryKind.AutoEmitted)</span>
    </div>
    <div class="list-stat">
        <span class="list-stat-label">@(IsArabic ? "يدوية" : "Manual")</span>
        <span class="list-stat-value is-gold">@_rows.Count(r => r.Kind == JournalEntryKind.ManualAdjusting)</span>
    </div>
    <div class="list-stat">
        <span class="list-stat-label">@(IsArabic ? "عكسية" : "Reversals")</span>
        <span class="list-stat-value @(_rows.Count(r => r.Kind == JournalEntryKind.Reversal) > 0 ? "is-warn" : "")">@_rows.Count(r => r.Kind == JournalEntryKind.Reversal)</span>
    </div>
</div>

@if (_rows.Count == 0)
{
    <p><em>@(IsArabic ? "لا توجد حركة قيود في هذه الفترة." : "No journal activity in this period.")</em></p>
    return;
}

<table class="data-grid">
    <thead>
        <tr>
            <th>@(IsArabic ? "وقت الترحيل (UTC)" : "Posted (UTC)")</th>
            <th>@(IsArabic ? "النوع" : "Kind")</th>
            <th>@(IsArabic ? "المصدر / البيان" : "Source / Narration")</th>
            <th class="num">@(IsArabic ? "البنود" : "Lines")</th>
            <th class="num">@(IsArabic ? "إجمالي المدين (ج.م.)" : "Total debits (EGP)")</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var row in _rows)
        {
            <tr>
                <td>@row.PostedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td><span class="kind-badge kind-@row.Kind.ToString().ToLowerInvariant()">@KindLabel(row.Kind)</span></td>
                <td>@row.SourceLabel</td>
                <td class="num">@row.LineCount</td>
                <td class="num">@row.TotalDebits.ToString("F2")</td>
                <td>
                    <a href="@DetailUrl(row)" class="btn-secondary">@(IsArabic ? "فتح" : "Open")</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private DateTime _periodStart = new(DateTime.UtcNow.Year, DateTime.UtcNow.Month, 1);
    private DateTime _periodEnd = new(DateTime.UtcNow.Year, DateTime.UtcNow.Month,
        DateTime.DaysInMonth(DateTime.UtcNow.Year, DateTime.UtcNow.Month));
    private bool _loading;
    private IReadOnlyList<JournalListRow>? _rows;

    private async Task OnRefresh()
    {
        _loading = true;
        try
        {
            _rows = await Query.ListAsync(
                DateOnly.FromDateTime(_periodStart),
                DateOnly.FromDateTime(_periodEnd));
        }
        finally
        {
            _loading = false;
        }
    }

    private string KindLabel(JournalEntryKind kind) => kind switch
    {
        JournalEntryKind.AutoEmitted => IsArabic ? "أوتوماتيكي" : "Auto",
        JournalEntryKind.ManualAdjusting => IsArabic ? "يدوي" : "Manual",
        JournalEntryKind.Reversal => IsArabic ? "عكسي" : "Reversal",
        _ => kind.ToString(),
    };

    private static string DetailUrl(JournalListRow row) =>
        $"/journals/{row.Id:D}?kind={row.Kind}";
}
