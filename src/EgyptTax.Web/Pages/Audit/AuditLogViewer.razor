@page "/audit-log"
@using EgyptTax.Domain.Audit
@using EgyptTax.Infrastructure.Persistence
@using EgyptTax.Web.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime Js
@attribute [Authorize(Policy = "NotSalesRepOnly")]

<h1>
    @(IsArabic ? "سجل التدقيق (FR-028)" : "Audit log (FR-028)")
    @if (_entries is { Count: > 0 })
    {
        <button type="button" class="btn-secondary" style="font-size:13px;margin-inline-start:12px;"
                @onclick="ExportCsvAsync">
            ⬇ @(IsArabic ? "تصدير CSV" : "Export CSV")
        </button>
    }
</h1>

<form class="invoice-toolbar" @onsubmit="OnSearch" @onsubmit:preventDefault>
    <label>
        <span>@(IsArabic ? "النوع يحتوي" : "Kind contains")</span>
        <input type="search" @bind="_kindFilter" placeholder="@(IsArabic ? "مثال: sales_invoice.posted" : "e.g. sales_invoice.posted")" />
    </label>
    <label>
        <span>@(IsArabic ? "رقم المستخدم المنفِّذ (اختياري)" : "Actor user id (optional)")</span>
        <input type="text" @bind="_actorFilter" placeholder="Guid" />
    </label>
    <label>
        <span>@(IsArabic ? "المحتوى يحتوي" : "Payload contains")</span>
        <input type="search" @bind="_payloadFilter" placeholder="@(IsArabic ? "رقم المستند، رقم المورد، إلخ." : "document id, supplier number, etc.")" />
    </label>
    <label>
        <span>@(IsArabic ? "أظهر آخر" : "Show last")</span>
        <select @bind="_takeLimit">
            <option value="100">100</option>
            <option value="500">500</option>
            <option value="2000">2,000</option>
        </select>
    </label>
    <button type="submit" class="btn-primary" disabled="@_loading">
        @(_loading ? (IsArabic ? "جارٍ التحميل…" : "Loading…") : (IsArabic ? "بحث" : "Search"))
    </button>
    <button type="button" class="btn-primary" @onclick="OnVerifyAsync" disabled="@_verifying">
        @(_verifying ? (IsArabic ? "جارٍ التحقق…" : "Verifying…") : (IsArabic ? "تحقق من سلامة السلسلة" : "Verify chain integrity"))
    </button>
</form>

@if (_verifyReport is not null)
{
    <section class="invoice-totals">
        @if (_verifyReport.IsValid)
        {
            <div class="grand"><strong>@(IsArabic ? "سلامة السلسلة: ✓ صحيحة" : "Chain integrity: ✓ valid")</strong> @(IsArabic ? $"عبر {_verifyReport.EntriesScanned} قيد." : $"across {_verifyReport.EntriesScanned} entries.")</div>
        }
        else
        {
            <div class="flash-error">
                <strong>@(IsArabic ? "سلامة السلسلة: ✗ فشلت" : "Chain integrity: ✗ FAILED")</strong> — @(IsArabic ? $"{_verifyReport.Findings.Count} نتيجة عبر {_verifyReport.EntriesScanned} قيد." : $"{_verifyReport.Findings.Count} finding(s) across {_verifyReport.EntriesScanned} entries.")
            </div>
            <table class="data-grid">
                <thead><tr><th>@(IsArabic ? "النوع" : "Kind")</th><th class="num">@(IsArabic ? "عند الفهرس" : "At index")</th><th>@(IsArabic ? "ملاحظات" : "Notes")</th></tr></thead>
                <tbody>
                    @foreach (var f in _verifyReport.Findings)
                    {
                        <tr>
                            <td><code>@f.Kind</code></td>
                            <td class="num">@f.AtIndex</td>
                            <td>@(f.Notes ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}

@if (_entries is null)
{
    <p>@(IsArabic ? "جارٍ التحميل…" : "Loading…")</p>
    return;
}

@if (_entries.Count == 0)
{
    <p><em>@(IsArabic ? "لا توجد قيود تدقيق مطابقة للفلاتر." : "No audit entries match the filters.")</em></p>
    return;
}

<table class="data-grid">
    <thead>
        <tr>
            <th class="num">@(IsArabic ? "الفهرس" : "Index")</th>
            <th>@(IsArabic ? "وقت التسجيل (UTC)" : "Timestamp (UTC)")</th>
            <th>@(IsArabic ? "النوع" : "Kind")</th>
            <th>@(IsArabic ? "المنفِّذ" : "Actor")</th>
            <th>@(IsArabic ? "البصمة (أول 16 خانة)" : "Hash (first 16 hex)")</th>
            <th>@(IsArabic ? "المحتوى (أول 120 حرفاً)" : "Payload (first 120 chars)")</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in _entries)
        {
            <tr>
                <td class="num">@e.Index</td>
                <td>@e.TsUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td><code>@e.Kind</code></td>
                <td>@(e.ActorUserId?.ToString("D")[..8] ?? (IsArabic ? "النظام" : "system"))</td>
                <td><code>@Convert.ToHexString(e.ThisHash).Substring(0, 16)…</code></td>
                <td><code>@(e.PayloadJson.Length > 120 ? e.PayloadJson.Substring(0, 120) + "…" : e.PayloadJson)</code></td>
            </tr>
        }
    </tbody>
</table>

@if (_entries.Count == _takeLimit)
{
    <p>
        <em>@(IsArabic
            ? $"يتم عرض آخر {_takeLimit} قيد. زِد قيمة «أظهر آخر» أو استخدم أداة verify-audit في سطر الأوامر للاستعلامات الكاملة على التثبيتات الكبيرة."
            : $"Showing the most recent {_takeLimit} entries. Increase the \"Show last\" filter or use the verify-audit CLI for full-chain queries on large installations.")</em>
    </p>
}

@code {
    private List<AuditLogEntry>? _entries;
    private string _kindFilter = "";
    private string _actorFilter = "";
    private string _payloadFilter = "";
    private int _takeLimit = 100;
    private bool _loading;
    private bool _verifying;
    private VerifyChainResponse? _verifyReport;

    protected override async Task OnInitializedAsync() => await OnSearch();

    private async Task OnSearch()
    {
        _loading = true;
        try
        {
            var query = Db.Set<AuditLogEntry>().AsNoTracking().AsQueryable();

            if (!string.IsNullOrWhiteSpace(_kindFilter))
            {
                query = query.Where(e => e.Kind.Contains(_kindFilter));
            }
            if (Guid.TryParse(_actorFilter, out var actorGuid))
            {
                query = query.Where(e => e.ActorUserId == actorGuid);
            }
            if (!string.IsNullOrWhiteSpace(_payloadFilter))
            {
                query = query.Where(e => e.PayloadJson.Contains(_payloadFilter));
            }

            _entries = await query
                .OrderByDescending(e => e.Index)
                .Take(_takeLimit)
                .ToListAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnVerifyAsync()
    {
        _verifying = true;
        _verifyReport = null;
        try
        {
            // Build absolute URL because Blazor Server's HttpClient
            // doesn't have a BaseAddress configured by default.
            var url = Nav.ToAbsoluteUri("/api/v1/audit/verify").ToString();
            var resp = await Http.PostAsync(url, content: null);
            _verifyReport = await resp.Content.ReadFromJsonAsync<VerifyChainResponse>();
        }
        catch (Exception ex)
        {
            _verifyReport = new VerifyChainResponse(
                IsValid: false,
                EntriesScanned: 0,
                Findings: new[]
                {
                    new VerifyFinding("HttpError", 0, ex.Message),
                });
        }
        finally
        {
            _verifying = false;
        }
    }

    private async Task ExportCsvAsync()
    {
        if (_entries is null) return;
        var bytes = CsvExporter.Build(
            headers: new[] { "Index", "Timestamp (UTC)", "Actor user id", "Kind", "Payload (JSON)", "This hash (hex)" },
            rows: _entries,
            rowSelector: e => new object?[]
            {
                e.Index,
                e.TsUtc,
                e.ActorUserId,
                e.Kind,
                e.PayloadJson,
                Convert.ToHexString(e.ThisHash),
            });
        var b64 = Convert.ToBase64String(bytes);
        await Js.InvokeVoidAsync("daftarxDownloadBytes",
            $"audit-log-{DateTime.UtcNow:yyyyMMddHHmm}.csv", b64, "text/csv");
    }

    public sealed record VerifyChainResponse(
        bool IsValid,
        long EntriesScanned,
        IReadOnlyList<VerifyFinding> Findings);

    public sealed record VerifyFinding(string Kind, long AtIndex, string? Notes);
}
