@page "/"
@page "/dashboard-v2"
@layout EgyptTax.Web.Shared.AppShell.AppShellLayout
@attribute [Authorize(Policy = "FullyAuthenticated")]

@using System.Globalization
@using EgyptTax.Domain.Documents
@using EgyptTax.Domain.Eta
@using EgyptTax.Domain.Expenses
@using EgyptTax.Domain.Invoices
@using EgyptTax.Domain.MasterData
@using EgyptTax.Domain.Purchases
@using EgyptTax.Domain.Workflow
@using EgyptTax.Infrastructure.Persistence
@using EgyptTax.Web.Shared.AppShell
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject AuthenticationStateProvider Auth

<PageTitle>دفاتر — @(IsArabic ? "لوحة التحكم" : "Dashboard")</PageTitle>

<section class="dash">
    @* ── Top bar: greeting + date picker + company switcher + bell + settings ── *@
    <header class="dash-topbar">
        <div class="dash-greeting">
            <h1>@(IsArabic ? $"مرحباً، {_userFirstName} 👋" : $"Welcome, {_userFirstName} 👋")</h1>
            <p class="dash-greeting-sub">@(IsArabic ? "لوحة التحكم" : "Dashboard")</p>
        </div>

        <button type="button" class="dash-datepill" title="@(IsArabic ? "نطاق التاريخ" : "Date range")">
            <Icon Name="calendar" Class="ic" />
            <span>
                @_monthStart.ToString("d MMM yyyy", new CultureInfo(IsArabic ? "ar-EG" : "en-US"))
                — @_monthEnd.ToString("d MMM yyyy", new CultureInfo(IsArabic ? "ar-EG" : "en-US"))
            </span>
        </button>

        <div class="dash-topbar-spacer"></div>

        @if (!string.IsNullOrEmpty(_companyName))
        {
            <button type="button" class="dash-company">
                <div class="dash-company-text">
                    <strong>@_companyName</strong>
                    @if (!string.IsNullOrEmpty(_companyTin))
                    {
                        <span>@(IsArabic ? "الرقم الضريبي" : "Tax ID"): @_companyTin</span>
                    }
                </div>
                <Icon Name="arrow-right" Class="ic dash-company-chevron" />
            </button>
        }

        <a class="dash-icon-btn" href="/settings" title="@(IsArabic ? "الإعدادات" : "Settings")">
            <Icon Name="settings" Class="ic" />
        </a>
        <a class="dash-icon-btn dash-icon-btn--bell" href="/approvals" title="@(IsArabic ? "الإشعارات" : "Notifications")">
            <Icon Name="bell" Class="ic" />
            @if (_notificationCount > 0)
            {
                <span class="dash-icon-badge">@_notificationCount</span>
            }
        </a>
    </header>

    @* ── 5 KPI Cards ── *@
    <div class="dash-kpis">
        <div class="dash-kpi">
            <div class="dash-kpi-text">
                <p class="dash-kpi-label">@(IsArabic ? "إجمالي المبيعات" : "Total sales")</p>
                <div class="dash-kpi-amount">@FormatEgp(_salesThisMonth)</div>
                @{ var salesPct = Percent(_salesThisMonth, _salesPrevMonth); }
                <p class="dash-kpi-delta @(salesPct >= 0 ? "is-up" : "is-down")">
                    <span class="dash-kpi-delta-pct">@(salesPct >= 0 ? "+" : "")@salesPct.ToString("F1")%</span>
                    <span class="dash-kpi-delta-meta">@(IsArabic ? "مقارنة بالفترة السابقة" : "vs previous period")</span>
                </p>
            </div>
            <div class="dash-kpi-icon"><Icon Name="trending-up" Class="ic" /></div>
        </div>

        <div class="dash-kpi">
            <div class="dash-kpi-text">
                <p class="dash-kpi-label">@(IsArabic ? "إجمالي المشتريات" : "Total purchases")</p>
                <div class="dash-kpi-amount">@FormatEgp(_purchasesThisMonth)</div>
                @{ var purchasesPct = Percent(_purchasesThisMonth, _purchasesPrevMonth); }
                <p class="dash-kpi-delta @(purchasesPct >= 0 ? "is-up" : "is-down")">
                    <span class="dash-kpi-delta-pct">@(purchasesPct >= 0 ? "+" : "")@purchasesPct.ToString("F1")%</span>
                    <span class="dash-kpi-delta-meta">@(IsArabic ? "مقارنة بالفترة السابقة" : "vs previous period")</span>
                </p>
            </div>
            <div class="dash-kpi-icon"><Icon Name="shopping-cart" Class="ic" /></div>
        </div>

        <div class="dash-kpi">
            <div class="dash-kpi-text">
                <p class="dash-kpi-label">@(IsArabic ? "صافي الربح" : "Net profit")</p>
                <div class="dash-kpi-amount">@FormatEgp(_netProfit)</div>
                @{ var netPct = Percent(_netProfit, _netProfitPrevMonth); }
                <p class="dash-kpi-delta @(netPct >= 0 ? "is-up" : "is-down")">
                    <span class="dash-kpi-delta-pct">@(netPct >= 0 ? "+" : "")@netPct.ToString("F1")%</span>
                    <span class="dash-kpi-delta-meta">@(IsArabic ? "مقارنة بالفترة السابقة" : "vs previous period")</span>
                </p>
            </div>
            <div class="dash-kpi-icon"><Icon Name="wallet" Class="ic" /></div>
        </div>

        <div class="dash-kpi">
            <div class="dash-kpi-text">
                <p class="dash-kpi-label">@(IsArabic ? "المستحقات المدينة" : "Receivables")</p>
                <div class="dash-kpi-amount">@FormatEgp(_arOpen)</div>
                @{ var arPct = Percent(_arOpen, _arPrevMonth); }
                <p class="dash-kpi-delta @(arPct <= 0 ? "is-up" : "is-down")">
                    <span class="dash-kpi-delta-pct">@(arPct >= 0 ? "+" : "")@arPct.ToString("F1")%</span>
                    <span class="dash-kpi-delta-meta">@(IsArabic ? "مقارنة بالفترة السابقة" : "vs previous period")</span>
                </p>
            </div>
            <div class="dash-kpi-icon"><Icon Name="user" Class="ic" /></div>
        </div>

        <div class="dash-kpi">
            <div class="dash-kpi-text">
                <p class="dash-kpi-label">@(IsArabic ? "المستحقات الدائنة" : "Payables")</p>
                <div class="dash-kpi-amount">@FormatEgp(_apOpen)</div>
                @{ var apPct = Percent(_apOpen, _apPrevMonth); }
                <p class="dash-kpi-delta @(apPct <= 0 ? "is-up" : "is-down")">
                    <span class="dash-kpi-delta-pct">@(apPct >= 0 ? "+" : "")@apPct.ToString("F1")%</span>
                    <span class="dash-kpi-delta-meta">@(IsArabic ? "مقارنة بالفترة السابقة" : "vs previous period")</span>
                </p>
            </div>
            <div class="dash-kpi-icon"><Icon Name="credit-card" Class="ic" /></div>
        </div>
    </div>

    @* ── Mid row: Pie + Bar + Compliance ── *@
    <div class="dash-mid">
        @* ── Pie chart: sales by payment method ── *@
        <div class="dash-card dash-pie-card">
            <div class="dash-card-head">
                <h3>@(IsArabic ? "المبيعات حسب طريقة الدفع" : "Sales by payment method")</h3>
            </div>
            <div class="dash-pie-body">
                <svg class="dash-pie-svg" viewBox="-1.1 -1.1 2.2 2.2" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    @{
                        var pieTotal = _paymentMix.Sum(p => p.Amount);
                        if (pieTotal > 0)
                        {
                            double accAngle = -Math.PI / 2; // start at top
                            foreach (var seg in _paymentMix)
                            {
                                if (seg.Amount <= 0) continue;
                                var pct = (double)(seg.Amount / pieTotal);
                                var sweep = pct * Math.PI * 2;
                                var x1 = Math.Cos(accAngle);
                                var y1 = Math.Sin(accAngle);
                                accAngle += sweep;
                                var x2 = Math.Cos(accAngle);
                                var y2 = Math.Sin(accAngle);
                                var largeArc = sweep > Math.PI ? 1 : 0;
                                var d = string.Format(CultureInfo.InvariantCulture,
                                    "M 0 0 L {0:F4} {1:F4} A 1 1 0 {2} 1 {3:F4} {4:F4} Z",
                                    x1, y1, largeArc, x2, y2);
                                <path d="@d" fill="@seg.Color" />
                            }
                            <circle cx="0" cy="0" r="0.55" fill="var(--dx-bg-card)" />
                        }
                    }
                </svg>
                <div class="dash-pie-center">
                    <div class="dash-pie-total">@FormatThousands(pieTotal)</div>
                    <div class="dash-pie-total-label">@(IsArabic ? "إجمالي المبيعات" : "Total sales")</div>
                    <div class="dash-pie-total-unit">@(IsArabic ? "ج.م" : "EGP")</div>
                </div>
                <ul class="dash-pie-legend">
                    @foreach (var seg in _paymentMix)
                    {
                        var pct = pieTotal > 0 ? (int)Math.Round((double)(seg.Amount / pieTotal) * 100) : 0;
                        <li>
                            <span class="dash-pie-dot" style="background:@seg.Color"></span>
                            <span class="dash-pie-name">@seg.Label</span>
                            <span class="dash-pie-pct">@pct%</span>
                        </li>
                    }
                </ul>
            </div>
        </div>

        @* ── Bar chart: sales vs purchases (6 months) ── *@
        <div class="dash-card dash-bar-card">
            <div class="dash-card-head">
                <h3>@(IsArabic ? "المبيعات والمشتريات" : "Sales & purchases")</h3>
                <div class="dash-card-head-meta">
                    <span class="dash-legend"><span class="dash-legend-dot" style="background: var(--dx-gold-bright)"></span> @(IsArabic ? "المبيعات" : "Sales")</span>
                    <span class="dash-legend"><span class="dash-legend-dot" style="background: var(--dx-info)"></span> @(IsArabic ? "المشتريات" : "Purchases")</span>
                </div>
            </div>
            <div class="dash-bar-body">
                @if (_trend.Count == 0 || _trend.All(t => t.Sales == 0 && t.Purchases == 0))
                {
                    <p class="dash-empty">@(IsArabic ? "لا توجد بيانات بعد" : "No data yet")</p>
                }
                else
                {
                    var maxBar = Math.Max(_trend.Max(t => t.Sales), _trend.Max(t => t.Purchases));
                    if (maxBar == 0) maxBar = 1;
                    <div class="dash-bars">
                        @foreach (var t in _trend)
                        {
                            var sPct = (double)(t.Sales / maxBar) * 100.0;
                            var pPct = (double)(t.Purchases / maxBar) * 100.0;
                            <div class="dash-bar-col" title="@t.MonthLabel">
                                <div class="dash-bar-pair">
                                    <div class="dash-bar dash-bar--sales" style="height: @sPct.ToString("F1", CultureInfo.InvariantCulture)%;"></div>
                                    <div class="dash-bar dash-bar--purch" style="height: @pPct.ToString("F1", CultureInfo.InvariantCulture)%;"></div>
                                </div>
                                <div class="dash-bar-label">@t.MonthLabel</div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* ── Compliance card ── *@
        <div class="dash-card dash-compliance">
            <div class="dash-card-head">
                <h3>@(IsArabic ? "الالتزام الضريبي" : "Tax compliance")</h3>
                <span class="status-pill is-success">@(IsArabic ? "ملتزم" : "Compliant")</span>
            </div>
            <div class="dash-compliance-body">
                <div class="dash-compliance-icon">
                    <Icon Name="shield-check" Class="ic" />
                </div>
                <div class="dash-compliance-status">
                    <strong>@(IsArabic ? "حالتك الضريبية سليمة" : "Your tax status is healthy")</strong>
                    <span>@(IsArabic ? "جميع إقراراتك محدّثة." : "All declarations up to date.")</span>
                </div>
            </div>
            <ul class="dash-compliance-list">
                <li>
                    <span class="dash-compliance-check">✓</span>
                    @(IsArabic ? "تسجيل في منظومة الفاتورة الإلكترونية" : "Registered with ETA portal")
                </li>
                <li>
                    <span class="dash-compliance-check">✓</span>
                    @(IsArabic ? "إرسال الفواتير الإلكترونية" : "E-invoice submission active")
                </li>
                <li>
                    <span class="dash-compliance-check">✓</span>
                    @(IsArabic ? "الإقرار الضريبي الشهري" : "Monthly VAT return filed")
                </li>
                <li>
                    <span class="dash-compliance-check">✓</span>
                    @(IsArabic ? "سداد المستحقات الضريبية" : "Tax dues settled")
                </li>
            </ul>
            <a href="/eta-dashboard" class="dash-compliance-cta">@(IsArabic ? "عرض التفاصيل الضريبية" : "View tax details") ←</a>
        </div>
    </div>

    @* ── Bottom row: Recent invoices + Quick actions + ETA status ── *@
    <div class="dash-bottom">
        <div class="dash-card dash-recent">
            <div class="dash-card-head">
                <h3>@(IsArabic ? "آخر الفواتير" : "Recent invoices")</h3>
                <a href="/invoices" class="dash-card-link">@(IsArabic ? "عرض الكل" : "View all") ←</a>
            </div>
            @if (_recent.Count == 0)
            {
                <p class="dash-empty">@(IsArabic ? "لا توجد فواتير بعد" : "No invoices yet")</p>
            }
            else
            {
                <table class="dash-recent-table">
                    <thead>
                        <tr>
                            <th>@(IsArabic ? "رقم الفاتورة" : "Document #")</th>
                            <th>@(IsArabic ? "العميل / المورد" : "Party")</th>
                            <th>@(IsArabic ? "النوع" : "Type")</th>
                            <th>@(IsArabic ? "التاريخ" : "Date")</th>
                            <th class="num">@(IsArabic ? "الإجمالي" : "Total")</th>
                            <th>@(IsArabic ? "الحالة" : "Status")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _recent)
                        {
                            <tr>
                                <td><a href="@r.Url">@r.DocumentNumber</a></td>
                                <td>@r.PartyName</td>
                                <td><span class="dash-type-chip @(r.Kind == "sales" ? "is-sales" : "is-purchase")">@r.TypeLabel</span></td>
                                <td>@r.Date.ToString("yyyy-MM-dd")</td>
                                <td class="num">@FormatThousands(r.Amount) <small>@(IsArabic ? "ج.م" : "EGP")</small></td>
                                <td><span class="status-pill @r.StatusClass">@r.StatusLabel</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="dash-side">
            <div class="dash-card dash-quick">
                <div class="dash-card-head">
                    <h3>@(IsArabic ? "إجراءات سريعة" : "Quick actions")</h3>
                </div>
                <div class="dash-quick-grid">
                    <a class="dash-quick-btn" href="/invoices/new">
                        <span class="dash-quick-icon"><Icon Name="plus" Class="ic" /></span>
                        <span class="dash-quick-label">@(IsArabic ? "فاتورة جديدة" : "New invoice")</span>
                    </a>
                    <a class="dash-quick-btn" href="/customers">
                        <span class="dash-quick-icon"><Icon Name="user" Class="ic" /></span>
                        <span class="dash-quick-label">@(IsArabic ? "عميل جديد" : "New customer")</span>
                    </a>
                    <a class="dash-quick-btn" href="/reports/sales-by-rep">
                        <span class="dash-quick-icon"><Icon Name="bar-chart" Class="ic" /></span>
                        <span class="dash-quick-label">@(IsArabic ? "تقرير المبيعات" : "Sales report")</span>
                    </a>
                    <a class="dash-quick-btn" href="/suppliers">
                        <span class="dash-quick-icon"><Icon Name="building" Class="ic" /></span>
                        <span class="dash-quick-label">@(IsArabic ? "مورد جديد" : "New supplier")</span>
                    </a>
                </div>
            </div>

            <div class="dash-card dash-eta">
                <div class="dash-card-head">
                    <h3>@(IsArabic ? "الفاتورة الإلكترونية" : "E-invoicing")</h3>
                </div>
                <div class="dash-eta-body">
                    <div class="dash-eta-icon"><Icon Name="zap" Class="ic" /></div>
                    <p class="dash-eta-msg">
                        @(IsArabic ? "متصل بمنظومة الفاتورة الإلكترونية" : "Connected to the ETA platform")
                    </p>
                    <span class="dash-eta-status">
                        <span class="dash-eta-dot"></span>
                        @(IsArabic ? "متصل" : "Connected")
                    </span>
                </div>
            </div>
        </div>
    </div>

    @* ── Footer ── *@
    <footer class="dash-footer">
        <span>© @DateTime.Now.Year @(IsArabic ? "دفاتر للمحاسبة والفواتير - جميع الحقوق محفوظة" : "Daftar — Accounting & Invoicing. All rights reserved.")</span>
        <span class="dash-footer-version">@(IsArabic ? "إصدار" : "Version") 2.1.0</span>
    </footer>
</section>

@code {
    private bool IsArabic =>
        CultureInfo.CurrentCulture.Name.StartsWith("ar", StringComparison.OrdinalIgnoreCase);

    private string _userFirstName = "";
    private string _companyName = "";
    private string _companyTin = "";
    private int _notificationCount;
    private DateOnly _monthStart;
    private DateOnly _monthEnd;
    private DateOnly _prevMonthStart;
    private DateOnly _prevMonthEnd;

    // KPIs current month
    private decimal _salesThisMonth;
    private decimal _purchasesThisMonth;
    private decimal _expensesThisMonth;
    private decimal _netProfit;
    private decimal _arOpen;
    private decimal _apOpen;

    // KPIs previous month
    private decimal _salesPrevMonth;
    private decimal _purchasesPrevMonth;
    private decimal _expensesPrevMonth;
    private decimal _netProfitPrevMonth;
    private decimal _arPrevMonth;
    private decimal _apPrevMonth;

    // Pie chart
    private record PieSeg(string Label, decimal Amount, string Color);
    private List<PieSeg> _paymentMix = new();

    // Bar chart
    private record TrendBucket(string MonthLabel, decimal Sales, decimal Purchases);
    private List<TrendBucket> _trend = new();

    // Recent invoices
    private record RecentRow(string Url, string DocumentNumber, string PartyName, string Kind, string TypeLabel, DateOnly Date, decimal Amount, string StatusClass, string StatusLabel);
    private List<RecentRow> _recent = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await Auth.GetAuthenticationStateAsync();
        var nameClaim = authState.User.FindFirst("name") ?? authState.User.FindFirst(System.Security.Claims.ClaimTypes.Name);
        var raw = nameClaim?.Value ?? authState.User.Identity?.Name ?? "";
        _userFirstName = string.IsNullOrWhiteSpace(raw) ? (IsArabic ? "ضيف" : "Guest") : raw.Split(' ', '@').First();

        var now = DateTime.UtcNow;
        _monthStart = new DateOnly(now.Year, now.Month, 1);
        _monthEnd = _monthStart.AddMonths(1).AddDays(-1);
        _prevMonthStart = _monthStart.AddMonths(-1);
        _prevMonthEnd = _monthStart.AddDays(-1);

        await using var Db = await DbFactory.CreateDbContextAsync();

        // Fresh-install redirect + company info for the top bar.
        var company = await Db.Set<Company>().AsNoTracking().FirstOrDefaultAsync();
        if (company is null)
        {
            Nav.NavigateTo("/setup-wizard", forceLoad: false);
            return;
        }
        _companyName = IsArabic ? company.LegalName.Arabic : company.LegalName.English;
        _companyTin = company.TaxRegistrationNumber ?? "";

        // Notification count = pending approvals + ETA critical
        _notificationCount = await Db.Set<EgyptTax.Domain.Workflow.ApprovalRequest>().AsNoTracking()
            .CountAsync(r => r.ApprovedByUserId == null && r.RejectedByUserId == null);

        // Current-month KPIs
        _salesThisMonth = await SumSalesAsync(Db, _monthStart, _monthEnd);
        _purchasesThisMonth = await SumPurchasesAsync(Db, _monthStart, _monthEnd);
        _expensesThisMonth = await SumExpensesAsync(Db, _monthStart, _monthEnd);
        _netProfit = _salesThisMonth - _purchasesThisMonth - _expensesThisMonth;

        // Previous-month KPIs (for delta %)
        _salesPrevMonth = await SumSalesAsync(Db, _prevMonthStart, _prevMonthEnd);
        _purchasesPrevMonth = await SumPurchasesAsync(Db, _prevMonthStart, _prevMonthEnd);
        _expensesPrevMonth = await SumExpensesAsync(Db, _prevMonthStart, _prevMonthEnd);
        _netProfitPrevMonth = _salesPrevMonth - _purchasesPrevMonth - _expensesPrevMonth;

        // Receivables / Payables — total open (Posted invoices minus payments allocated to them).
        _arOpen = await OpenArAsync(Db, _monthEnd);
        _arPrevMonth = await OpenArAsync(Db, _prevMonthEnd);
        _apOpen = await OpenApAsync(Db, _monthEnd);
        _apPrevMonth = await OpenApAsync(Db, _prevMonthEnd);

        // Pie chart: receipts by payment method (this month).
        var receipts = await Db.Set<CustomerReceiptVoucher>().AsNoTracking()
            .Where(r => r.State == DocumentState.Posted
                && r.ReceiptDate >= _monthStart && r.ReceiptDate <= _monthEnd)
            .Select(r => new { r.PaymentMethod, r.GrossReceiptAmount.Amount })
            .ToListAsync();
        var cash = receipts.Where(r => r.PaymentMethod == PaymentMethod.Cash).Sum(r => r.Amount);
        var bank = receipts.Where(r => r.PaymentMethod == PaymentMethod.BankTransfer).Sum(r => r.Amount);
        var credit = Math.Max(0m, _salesThisMonth - cash - bank);
        _paymentMix = new List<PieSeg>
        {
            new(IsArabic ? "تحويل بنكي" : "Bank transfer", bank,   "#f0c040"),
            new(IsArabic ? "نقدي"       : "Cash",         cash,   "#60a5fa"),
            new(IsArabic ? "آجل"        : "On account",  credit, "#a78bfa"),
        }.Where(s => s.Amount > 0).ToList();

        // 6-month sales+purchases trend.
        _trend.Clear();
        for (int back = 5; back >= 0; back--)
        {
            var bs = new DateOnly(now.Year, now.Month, 1).AddMonths(-back);
            var be = bs.AddMonths(1).AddDays(-1);
            var s = await SumSalesAsync(Db, bs, be);
            var p = await SumPurchasesAsync(Db, bs, be);
            var ci = new CultureInfo(IsArabic ? "ar-EG" : "en-US");
            _trend.Add(new TrendBucket(ci.DateTimeFormat.GetAbbreviatedMonthName(bs.Month), s, p));
        }

        // Recent invoices: top 5 from sales + purchases, mixed by date.
        var recentSales = await Db.Set<SalesInvoice>().AsNoTracking()
            .OrderByDescending(i => i.PostedAtUtc.HasValue)
            .ThenByDescending(i => i.PostedAtUtc)
            .ThenByDescending(i => i.DocumentDate)
            .Take(5)
            .Select(i => new { i.Id, i.DocumentNumber, i.CustomerId, i.GrandTotal, i.State, i.DocumentDate })
            .ToListAsync();
        var recentPurchases = await Db.Set<PurchaseInvoice>().AsNoTracking()
            .OrderByDescending(p => p.PostedAtUtc.HasValue)
            .ThenByDescending(p => p.PostedAtUtc)
            .ThenByDescending(p => p.DateReceived)
            .Take(5)
            .Select(p => new { p.Id, p.DocumentNumber, p.SupplierId, p.GrandTotal, p.State, p.DateReceived })
            .ToListAsync();

        var customerIds = recentSales.Select(s => s.CustomerId).Distinct().ToArray();
        var supplierIds = recentPurchases.Select(p => p.SupplierId).Distinct().ToArray();
        var customers = await Db.Set<Customer>().AsNoTracking()
            .Where(c => customerIds.Contains(c.Id))
            .ToDictionaryAsync(c => c.Id, c => IsArabic ? c.Name.Arabic : c.Name.English);
        var suppliers = await Db.Set<Supplier>().AsNoTracking()
            .Where(s => supplierIds.Contains(s.Id))
            .ToDictionaryAsync(s => s.Id, s => IsArabic ? s.Name.Arabic : s.Name.English);

        var rows = new List<RecentRow>();
        foreach (var s in recentSales)
        {
            rows.Add(new RecentRow(
                Url: $"/invoices/{s.Id}",
                DocumentNumber: s.DocumentNumber ?? (IsArabic ? "(مسودة)" : "(draft)"),
                PartyName: customers.GetValueOrDefault(s.CustomerId, "—"),
                Kind: "sales",
                TypeLabel: IsArabic ? "فاتورة مبيعات" : "Sales invoice",
                Date: s.DocumentDate,
                Amount: s.GrandTotal.Amount,
                StatusClass: ClassForState(s.State),
                StatusLabel: LabelForState(s.State)
            ));
        }
        foreach (var p in recentPurchases)
        {
            rows.Add(new RecentRow(
                Url: $"/purchase-invoices/{p.Id}",
                DocumentNumber: p.DocumentNumber ?? (IsArabic ? "(مسودة)" : "(draft)"),
                PartyName: suppliers.GetValueOrDefault(p.SupplierId, "—"),
                Kind: "purchase",
                TypeLabel: IsArabic ? "فاتورة شراء" : "Purchase invoice",
                Date: p.DateReceived,
                Amount: p.GrandTotal.Amount,
                StatusClass: ClassForState(p.State),
                StatusLabel: LabelForState(p.State)
            ));
        }
        _recent = rows.OrderByDescending(r => r.Date).Take(5).ToList();
    }

    private static async Task<decimal> SumSalesAsync(AppDbContext db, DateOnly start, DateOnly end)
    {
        var amounts = await db.Set<SalesInvoice>().AsNoTracking()
            .Where(i => i.State == DocumentState.Posted
                && i.DocumentDate >= start && i.DocumentDate <= end)
            .Select(i => i.GrandTotal.Amount)
            .ToListAsync();
        return amounts.Sum();
    }

    private static async Task<decimal> SumPurchasesAsync(AppDbContext db, DateOnly start, DateOnly end)
    {
        var amounts = await db.Set<PurchaseInvoice>().AsNoTracking()
            .Where(p => p.State == DocumentState.Posted
                && p.DateReceived >= start && p.DateReceived <= end)
            .Select(p => p.GrandTotal.Amount)
            .ToListAsync();
        return amounts.Sum();
    }

    private static async Task<decimal> SumExpensesAsync(AppDbContext db, DateOnly start, DateOnly end)
    {
        var amounts = await db.Set<Expense>().AsNoTracking()
            .Where(e => e.State == DocumentState.Posted
                && e.DocumentDate >= start && e.DocumentDate <= end)
            .Select(e => e.Amount.Amount)
            .ToListAsync();
        return amounts.Sum();
    }

    /// <summary>Open AR as of a date = posted sales-invoice grand total minus
    /// allocated receipts, summed across all customers. Approximation good
    /// enough for the dashboard — the canonical figure is on the customer
    /// statement page.</summary>
    private static async Task<decimal> OpenArAsync(AppDbContext db, DateOnly asOf)
    {
        var invoiceTotals = await db.Set<SalesInvoice>().AsNoTracking()
            .Where(i => i.State == DocumentState.Posted && i.DocumentDate <= asOf)
            .Select(i => new { i.Id, i.GrandTotal.Amount })
            .ToListAsync();
        var ids = invoiceTotals.Select(x => x.Id).ToArray();
        var allocs = await db.Set<PaymentAllocation>().AsNoTracking()
            .Where(a => ids.Contains(a.TargetDocumentId)
                && a.TargetDocumentType == DocumentType.SalesInvoice)
            .Select(a => new { a.TargetDocumentId, a.AllocatedAmount.Amount })
            .ToListAsync();
        var paid = allocs.GroupBy(a => a.TargetDocumentId).ToDictionary(g => g.Key, g => g.Sum(x => x.Amount));
        return invoiceTotals.Sum(x => Math.Max(0m, x.Amount - paid.GetValueOrDefault(x.Id, 0m)));
    }

    /// <summary>Open AP as of a date — mirror of OpenAr for purchase
    /// invoices and supplier-payment allocations.</summary>
    private static async Task<decimal> OpenApAsync(AppDbContext db, DateOnly asOf)
    {
        var invoiceTotals = await db.Set<PurchaseInvoice>().AsNoTracking()
            .Where(p => p.State == DocumentState.Posted && p.DateReceived <= asOf)
            .Select(p => new { p.Id, p.GrandTotal.Amount })
            .ToListAsync();
        var ids = invoiceTotals.Select(x => x.Id).ToArray();
        var allocs = await db.Set<PaymentAllocation>().AsNoTracking()
            .Where(a => ids.Contains(a.TargetDocumentId)
                && a.TargetDocumentType == DocumentType.PurchaseInvoice)
            .Select(a => new { a.TargetDocumentId, a.AllocatedAmount.Amount })
            .ToListAsync();
        var paid = allocs.GroupBy(a => a.TargetDocumentId).ToDictionary(g => g.Key, g => g.Sum(x => x.Amount));
        return invoiceTotals.Sum(x => Math.Max(0m, x.Amount - paid.GetValueOrDefault(x.Id, 0m)));
    }

    private static decimal Percent(decimal cur, decimal prev)
    {
        if (prev == 0) return cur == 0 ? 0 : 100m;
        return Math.Round((cur - prev) / Math.Abs(prev) * 100m, 1);
    }

    private string FormatEgp(decimal value) => $"{ArabicNumerals.Format(value)} {(IsArabic ? "ج.م" : "EGP")}";
    private string FormatThousands(decimal value) => ArabicNumerals.Format(value);

    private string ClassForState(DocumentState s) => s switch
    {
        DocumentState.Posted    => "is-success",
        DocumentState.Draft     => "",
        DocumentState.Submitted => "is-info",
        DocumentState.Approved  => "is-info",
        DocumentState.Voided    => "is-danger",
        _ => "",
    };

    private string LabelForState(DocumentState s) => (s, IsArabic) switch
    {
        (DocumentState.Posted,    true)  => "مدفوعة",
        (DocumentState.Posted,    false) => "Posted",
        (DocumentState.Draft,     true)  => "مسودة",
        (DocumentState.Draft,     false) => "Draft",
        (DocumentState.Submitted, true)  => "في الانتظار",
        (DocumentState.Submitted, false) => "Pending",
        (DocumentState.Approved,  true)  => "معتمدة",
        (DocumentState.Approved,  false) => "Approved",
        (DocumentState.Voided,    true)  => "ملغاة",
        (DocumentState.Voided,    false) => "Voided",
        _ => s.ToString(),
    };
}
