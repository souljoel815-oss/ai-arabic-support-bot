@page "/"
@page "/dashboard-v2"
@layout EgyptTax.Web.Shared.AppShell.AppShellLayout
@attribute [Authorize(Policy = "FullyAuthenticated")]

@using System.Globalization
@using EgyptTax.Web.Shared.AppShell
@using Microsoft.AspNetCore.Authorization
@inject NavigationManager Nav

@*
    v5 UI Rebuild — Sprint 1 (updated 2026-05-15).
    Dashboard with:
      - Greeting header
      - 4 KPI cards (Sales, Receivables, Expenses, Compliance Score)
      - 3 action items (onboarding tasks)
      - 2 chart placeholders (Sales last 6 months, Expenses by category)
    
    Data is placeholder until the real queries are wired.
*@

<PageTitle>DaftarX — @(_isArabic ? "الرئيسية" : "Dashboard")</PageTitle>

<section class="dx-dashboard">
    @* ── Greeting Header ── *@
    <div class="dx-dash-header">
        <div class="dx-dash-greeting">
            <p class="dx-dash-greeting-pre">@GetGreeting()</p>
            <h1 class="dx-dash-greeting-brand">
                <span class="dx-dash-brand-text">Daftar<span class="dx-dash-brand-x">X</span></span>
            </h1>
            <p class="dx-dash-date">
                <Icon Name="calendar" Class="dx-dash-date-ic" />
                @DateTime.Now.ToString("dddd، d MMMM yyyy", new CultureInfo("ar-EG"))
            </p>
        </div>
    </div>

    @* ── KPI Cards Row ── *@
    <div class="dx-kpi-row">
        @* Card 1: Sales this month *@
        <div class="dx-kpi-card">
            <div class="dx-kpi-body">
                <p class="dx-kpi-label">@(_isArabic ? "المبيعات هذا الشهر" : "Sales this month")</p>
                <div class="dx-kpi-value-row">
                    <span class="dx-kpi-amount">@ArabicNumerals.Format(0m)</span>
                    <span class="dx-kpi-unit">@(_isArabic ? "ج.م" : "EGP")</span>
                </div>
                <p class="dx-kpi-trend">—</p>
            </div>
            <div class="dx-kpi-icon dx-kpi-icon--gold">
                <Icon Name="trending-up" Class="dx-kpi-ic" />
            </div>
        </div>

        @* Card 2: Receivables *@
        <div class="dx-kpi-card">
            <div class="dx-kpi-body">
                <p class="dx-kpi-label">@(_isArabic ? "المستحقات" : "Receivables")</p>
                <div class="dx-kpi-value-row">
                    <span class="dx-kpi-amount">@ArabicNumerals.Format(0m)</span>
                    <span class="dx-kpi-unit">@(_isArabic ? "ج.م" : "EGP")</span>
                </div>
                <p class="dx-kpi-trend">@(_isArabic ? "٠ فاتورة مستحقة" : "0 invoices due")</p>
            </div>
            <div class="dx-kpi-icon dx-kpi-icon--danger">
                <Icon Name="alert-triangle" Class="dx-kpi-ic" />
            </div>
        </div>

        @* Card 3: Expenses *@
        <div class="dx-kpi-card">
            <div class="dx-kpi-body">
                <p class="dx-kpi-label">@(_isArabic ? "المصروفات" : "Expenses")</p>
                <div class="dx-kpi-value-row">
                    <span class="dx-kpi-amount">@ArabicNumerals.Format(0m)</span>
                    <span class="dx-kpi-unit">@(_isArabic ? "ج.م" : "EGP")</span>
                </div>
                <p class="dx-kpi-trend">—</p>
            </div>
            <div class="dx-kpi-icon dx-kpi-icon--warning">
                <Icon Name="credit-card" Class="dx-kpi-ic" />
            </div>
        </div>

        @* Card 4: Compliance Score *@
        <div class="dx-kpi-card">
            <div class="dx-kpi-body">
                <p class="dx-kpi-label">@(_isArabic ? "درجة الامتثال" : "Compliance score")</p>
                <p class="dx-kpi-compliance-label">@(_isArabic ? "لا توجد بيانات بعد" : "No data yet")</p>
            </div>
            <div class="dx-kpi-icon dx-kpi-icon--success">
                <Icon Name="shield" Class="dx-kpi-ic" />
            </div>
        </div>
    </div>

    @* ── Action Items Panel ── *@
    <div class="dx-action-panel">
        <h2 class="dx-action-panel-title">@(_isArabic ? "المهام العاجلة" : "Urgent tasks")</h2>
        <div class="dx-action-list">
            @* Action 1: Company data *@
            <div class="dx-action-row">
                <a class="dx-action-cta" href="/settings/company">@(_isArabic ? "إعدادات ←" : "Settings →")</a>
                <div class="dx-action-text">
                    <strong>@(_isArabic ? "أضف بيانات شركتك" : "Add company data")</strong><br />
                    <span>@(_isArabic ? "اذهب للإعدادات وأكمل بيانات الشركة والرقم الضريبي" : "Go to settings and complete company info and tax ID")</span>
                </div>
                <div class="dx-action-icon dx-action-icon--warning">
                    <Icon Name="alert-triangle" Class="dx-kpi-ic" />
                </div>
            </div>

            @* Action 2: Chart of accounts *@
            <div class="dx-action-row">
                <a class="dx-action-cta" href="/settings/chart-of-accounts">@(_isArabic ? "المحاسبة ←" : "Accounting →")</a>
                <div class="dx-action-text">
                    <strong>@(_isArabic ? "أنشئ شجرة الحسابات" : "Create chart of accounts")</strong><br />
                    <span>@(_isArabic ? "ابدأ بإنشاء شجرة الحسابات أو استوردها من ملف Excel" : "Create chart of accounts or import from Excel")</span>
                </div>
                <div class="dx-action-icon dx-action-icon--info">
                    <Icon Name="boxes" Class="dx-kpi-ic" />
                </div>
            </div>

            @* Action 3: First customer *@
            <div class="dx-action-row">
                <a class="dx-action-cta" href="/customers">@(_isArabic ? "العملاء ←" : "Contacts →")</a>
                <div class="dx-action-text">
                    <strong>@(_isArabic ? "أضف أول عميل" : "Add first customer")</strong><br />
                    <span>@(_isArabic ? "أضف بيانات عملائك لبدء إصدار الفواتير" : "Add customer data to start issuing invoices")</span>
                </div>
                <div class="dx-action-icon dx-action-icon--info">
                    <Icon Name="user" Class="dx-kpi-ic" />
                </div>
            </div>
        </div>
    </div>

    @* ── Chart Placeholders ── *@
    <div class="dx-chart-row">
        <div class="dx-chart-card">
            <div class="dx-chart-header">
                <h3 class="dx-chart-title">@(_isArabic ? "المبيعات — آخر 6 أشهر" : "Sales — last 6 months")</h3>
            </div>
            <p class="dx-chart-empty">@(_isArabic ? "لا توجد بيانات بعد" : "No data yet")</p>
        </div>
        <div class="dx-chart-card">
            <div class="dx-chart-header">
                <h3 class="dx-chart-title">@(_isArabic ? "المصروفات حسب الفئة" : "Expenses by category")</h3>
            </div>
            <p class="dx-chart-empty">@(_isArabic ? "لا توجد بيانات بعد" : "No data yet")</p>
        </div>
    </div>
</section>

@code {
    private bool _isArabic =>
        CultureInfo.CurrentCulture.Name.StartsWith("ar", StringComparison.OrdinalIgnoreCase);

    private string GetGreeting()
    {
        var hour = DateTime.Now.Hour;
        if (_isArabic)
        {
            return hour < 12 ? "صباح الخير" : "مساء الخير";
        }
        return hour < 12 ? "Good morning" : "Good afternoon";
    }
}
