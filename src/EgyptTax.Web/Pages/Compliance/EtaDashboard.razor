@page "/eta-dashboard"
@using EgyptTax.Application.Eta
@using EgyptTax.Domain.Eta
@using EgyptTax.Domain.Invoices
@using EgyptTax.Domain.MasterData
@using EgyptTax.Infrastructure.Persistence
@using EgyptTax.SharedKernel.Time
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject IEtaDashboardQuery Dashboard
@inject IClock Clock
@inject IEtaStatusNotifier Notifier
@implements IDisposable
@attribute [Authorize(Policy = "NotSalesRepOnly")]

<h1>@(IsArabic ? "لوحة الامتثال للضرائب الإلكترونية" : "ETA Compliance Dashboard")</h1>

@* D3 — sandbox-mode banner. The current ETA submission path runs
   against a mock endpoint, not the live regulator. This is a trust-
   killer if it's not surfaced clearly, so we label it everywhere
   the operator might look for ETA status. Replaced by real
   submission once the customer plugs in their ETA activation
   credentials + USB signing token. *@
<div class="trial-banner trial-banner-warn" role="status" style="margin:12px 0;">
    <div class="trial-banner-text">
        <strong>🧪 @(IsArabic ? "وضع تجريبي:" : "Sandbox mode:")</strong>
        <span>
            @(IsArabic
                ? "الفواتير لا تُرسل للمصلحة الفعلية. شغّل الوضع المباشر بإدخال بيانات تفعيل ETA + شهادة التوقيع من «إعدادات → ربط منظومة ETA»."
                : "Invoices are NOT being sent to the live regulator. Switch to live mode by entering your ETA activation credentials + signing certificate under Settings → ETA Integration.")
        </span>
    </div>
    <div class="trial-banner-hwid">
        <a href="/settings?tab=eta-integration" class="trial-banner-link">
            @(IsArabic ? "افتح إعدادات ETA" : "Open ETA settings")
        </a>
    </div>
</div>

<p>@(IsArabic
    ? "وفقاً لـ FR-043، عرض كل فاتورة مُرحَّلة قاربت أو تجاوزت موعد الإرسال إلى مصلحة الضرائب حتى يتدخل المشغّل قبل الموعد النهائي المفروض من الجهة التنظيمية."
    : "Per FR-043, surface every posted invoice approaching or past its ETA submission deadline so the operator can intervene before the regulator-imposed cutoff.")</p>

@if (_loading)
{
    <p>@(IsArabic ? "جارٍ التحميل…" : "Loading…")</p>
    return;
}

<section class="eta-tiles">
    <div class="eta-tile eta-tile-critical">
        <div class="tile-label">@(IsArabic ? "حرج (< 24 ساعة)" : "Critical (< 24h)")</div>
        <div class="tile-value">@_criticalCount</div>
    </div>
    <div class="eta-tile eta-tile-warning">
        <div class="tile-label">@(IsArabic ? "خلال 7 أيام" : "Within 7 days")</div>
        <div class="tile-value">@_within7DaysCount</div>
    </div>
    <div class="eta-tile">
        <div class="tile-label">@(IsArabic ? "إجمالي قيد الانتظار" : "Pending total")</div>
        <div class="tile-value">@_pendingTotal</div>
    </div>
    <div class="eta-tile eta-tile-failed">
        <div class="tile-label">@(IsArabic ? "فاشل" : "Failed")</div>
        <div class="tile-value">@_failedTotal</div>
    </div>
    <div class="eta-tile eta-tile-expired" title="@(IsArabic ? "فاشل وتجاوز نافذة الإرسال للجهة التنظيمية — يتطلب تدخلاً يدوياً." : "Failed AND past the regulator's submission window — manual operator intervention required.")">
        <div class="tile-label">@(IsArabic ? "منتهي (بعد الموعد)" : "Expired (post-deadline)")</div>
        <div class="tile-value">@_expiredFailedTotal</div>
    </div>
    <div class="eta-tile eta-tile-submitted">
        <div class="tile-label">@(IsArabic ? "مُرسَل" : "Submitted")</div>
        <div class="tile-value">@_submittedTotal</div>
    </div>
</section>

<section class="eta-controls">
    <label>
        <span>@(IsArabic ? "نافذة الاستطلاع" : "Lookahead window")</span>
        <select @bind="_lookaheadHours" @bind:after="ReloadAsync">
            <option value="24">@(IsArabic ? "الـ 24 ساعة القادمة" : "Next 24 hours")</option>
            <option value="72">@(IsArabic ? "الـ 72 ساعة القادمة" : "Next 72 hours")</option>
            <option value="168">@(IsArabic ? "الـ 7 أيام القادمة" : "Next 7 days")</option>
            <option value="336">@(IsArabic ? "الـ 14 يوم القادمة" : "Next 14 days")</option>
        </select>
    </label>
</section>

@if (_rows.Count == 0)
{
    <p class="flash-success" role="status">
        @(IsArabic
            ? $"لا يوجد ما يُعمَل — لا توجد إرسالات قيد الانتظار أو فاشلة خلال نافذة الـ {_lookaheadHours} ساعة."
            : $"Nothing to do — no Pending or Failed submissions within the {_lookaheadHours}-hour window.")
    </p>
}
else
{
    <table class="data-grid">
        <thead>
            <tr>
                <th>@(IsArabic ? "رقم المستند" : "Document #")</th>
                <th>@(IsArabic ? "العميل" : "Customer")</th>
                <th>@(IsArabic ? "الحالة" : "Status")</th>
                <th>@(IsArabic ? "الموعد النهائي (UTC)" : "Deadline (UTC)")</th>
                <th class="num">@(IsArabic ? "ساعات متبقية" : "Hours left")</th>
                <th class="num">@(IsArabic ? "المحاولات" : "Attempts")</th>
                <th>@(IsArabic ? "آخر خطأ" : "Last error")</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in _rows)
            {
                var hoursLeft = (row.Deadline - _now).TotalHours;
                <tr class="@UrgencyRowClass(hoursLeft)">
                    <td>@row.DocumentNumber</td>
                    <td>@row.CustomerName</td>
                    <td>
                        <span class="eta-badge eta-@row.Status.ToString().ToLowerInvariant()">@row.Status</span>
                    </td>
                    <td>@row.Deadline.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="num">@hoursLeft.ToString("0.#")</td>
                    <td class="num">@row.AttemptCount</td>
                    <td>@(row.LastErrorCode ?? "—")</td>
                    <td><a href="/invoices/@row.SalesInvoiceId">@(IsArabic ? "عرض" : "View")</a></td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private bool _loading = true;
    private DateTime _now;
    private int _lookaheadHours = 168;  // 7-day default — wider than the SC-012 24h critical window so the dashboard surfaces upcoming work, not just the on-fire subset.

    private int _criticalCount;
    private int _within7DaysCount;
    private int _pendingTotal;
    private int _failedTotal;
    private int _submittedTotal;
    private int _expiredFailedTotal;

    private List<Row> _rows = new();

    protected override async Task OnInitializedAsync()
    {
        Notifier.StatusChanged += OnStatusChanged;
        await ReloadAsync();
        _loading = false;
    }

    private async void OnStatusChanged(object? sender, EtaStatusChangedEvent e)
    {
        // In-process broadcast fires on the thread the wrapper handler
        // runs on; switch to the render thread before mutating state.
        await InvokeAsync(async () =>
        {
            await ReloadAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Notifier.StatusChanged -= OnStatusChanged;
    }

    private async Task ReloadAsync()
    {
        _now = Clock.UtcNow;

        // Aggregate tiles — single grouped query.
        var groups = await Db.Set<EtaSubmission>()
            .AsNoTracking()
            .GroupBy(s => s.Status)
            .Select(g => new { Status = g.Key, Count = g.Count() })
            .ToListAsync();
        _pendingTotal   = groups.FirstOrDefault(g => g.Status == EtaSubmissionStatus.Pending)?.Count ?? 0;
        _failedTotal    = groups.FirstOrDefault(g => g.Status == EtaSubmissionStatus.Failed)?.Count ?? 0;
        _submittedTotal = groups.FirstOrDefault(g => g.Status == EtaSubmissionStatus.Submitted)?.Count ?? 0;

        // Expired Failed — past the regulator's submission window AND
        // still Failed. Surfaced as its own tile so post-deadline rows
        // never silently disappear from the operator's view; the
        // FR-036 retry job intentionally leaves these alone (manual
        // intervention is required to reattempt past the cutoff).
        _expiredFailedTotal = await Db.Set<EtaSubmission>().AsNoTracking()
            .CountAsync(s => s.Status == EtaSubmissionStatus.Failed
                && s.SubmissionWindowExpiresAtUtc < _now);

        var critical = await Dashboard.GetUpcomingDeadlinesAsync(TimeSpan.FromHours(24), _now);
        _criticalCount = critical.Count;
        var within7 = await Dashboard.GetUpcomingDeadlinesAsync(TimeSpan.FromDays(7), _now);
        _within7DaysCount = within7.Count;

        // Main list — driven by the user-chosen lookahead window.
        var dashboardRows = await Dashboard.GetUpcomingDeadlinesAsync(
            TimeSpan.FromHours(_lookaheadHours), _now);
        var invoiceIds = dashboardRows.Select(r => r.SalesInvoiceId).ToArray();
        var invoices = await Db.Set<SalesInvoice>().AsNoTracking()
            .Where(i => invoiceIds.Contains(i.Id))
            .Select(i => new { i.Id, i.DocumentNumber, i.CustomerId })
            .ToListAsync();
        var customerIds = invoices.Select(i => i.CustomerId).Distinct().ToArray();
        var customers = await Db.Set<Customer>().AsNoTracking()
            .Where(c => customerIds.Contains(c.Id))
            .ToDictionaryAsync(c => c.Id, c => c.Name);

        _rows = dashboardRows.Select(d =>
        {
            var inv = invoices.FirstOrDefault(i => i.Id == d.SalesInvoiceId);
            string customerName;
            if (inv is null)
            {
                customerName = "?";
            }
            else if (customers.TryGetValue(inv.CustomerId, out var name))
            {
                customerName = IsArabic ? name.Arabic : name.English;
            }
            else
            {
                customerName = inv.CustomerId.ToString("D");
            }
            return new Row(
                d.SalesInvoiceId,
                inv?.DocumentNumber ?? (IsArabic ? "(غير معروف)" : "(unknown)"),
                customerName,
                d.Status,
                d.SubmissionWindowExpiresAtUtc,
                d.AttemptCount,
                d.LastErrorCode);
        }).ToList();
    }

    private static string UrgencyRowClass(double hoursLeft)
    {
        if (hoursLeft < 0) return "row-overdue";
        if (hoursLeft < 24) return "row-critical";
        if (hoursLeft < 72) return "row-warning";
        return "";
    }

    private sealed record Row(
        Guid SalesInvoiceId,
        string DocumentNumber,
        string CustomerName,
        EtaSubmissionStatus Status,
        DateTime Deadline,
        int AttemptCount,
        string? LastErrorCode);
}
