@*
    R-11 — Bilingual layout shell. The <html dir> + <html lang>
    attributes are derived from CultureInfo.CurrentCulture so the
    entire DOM tree (including Blazor-rendered components inside
    <component>) inherits the correct script direction. Cookie-based
    request culture (set in Program.cs via UseRequestLocalization)
    flips this between Arabic (rtl) and English (ltr).
*@
@using System.Globalization
@{
    var culture = CultureInfo.CurrentCulture;
    var dir = culture.TextInfo.IsRightToLeft ? "rtl" : "ltr";
    var lang = string.IsNullOrEmpty(culture.TwoLetterISOLanguageName) ? "en" : culture.TwoLetterISOLanguageName;
}
<!DOCTYPE html>
<html lang="@lang" dir="@dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />
    <title>EgyptTax</title>
    <link rel="stylesheet" href="~/site.css" />
</head>
<body>
    @RenderBody()

    <div id="blazor-error-ui" hidden>
        An unhandled error has occurred.
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>
    <script src="_framework/blazor.server.js"></script>
    <script src="~/js/firm-portal-pool.js"></script>
</body>
</html>
