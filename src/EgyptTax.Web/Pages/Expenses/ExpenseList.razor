@page "/expenses"
@using EgyptTax.Application.Compliance.RiskScoring
@using EgyptTax.Domain.Documents
@using EgyptTax.Domain.Expenses
@using EgyptTax.Domain.MasterData
@using EgyptTax.Domain.Workflow
@using EgyptTax.Infrastructure.Persistence
@using EgyptTax.SharedKernel
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@attribute [Authorize(Policy = "NotSalesRepOnly")]

<h1>@(IsArabic ? "المصروفات" : "Expenses")</h1>

@if (_rows is { Count: > 0 })
{
    <div class="list-stats">
        <div class="list-stat">
            <span class="list-stat-label">@(IsArabic ? "إجمالي المصروفات" : "Total")</span>
            <span class="list-stat-value">@_rows.Count</span>
        </div>
        <div class="list-stat">
            <span class="list-stat-label">@(IsArabic ? "مرحّلة" : "Posted")</span>
            <span class="list-stat-value is-success">@_rows.Count(r => r.Expense.State == DocumentState.Posted)</span>
        </div>
        <div class="list-stat">
            <span class="list-stat-label">@(IsArabic ? "بدون مرفق" : "Missing receipt")</span>
            <span class="list-stat-value @(_rows.Count(r => r.Expense.DeductibleFlag && r.RiskFindings.Any()) > 0 ? "is-warn" : "")">@_rows.Count(r => r.Expense.DeductibleFlag && r.RiskFindings.Any())</span>
        </div>
        <div class="list-stat">
            <span class="list-stat-label">@(IsArabic ? "إجمالي المبلغ" : "Total amount")</span>
            <span class="list-stat-value is-warn">@_rows.Where(r => r.Expense.State == DocumentState.Posted).Sum(r => r.Expense.Amount.Amount).ToString("N0") <small>@(IsArabic ? "ج.م" : "EGP")</small></span>
        </div>
    </div>
}

<div class="invoice-toolbar">
    <a class="btn-primary" href="/expenses/new">+ @(IsArabic ? "مصروف جديد" : "New expense")</a>
    <input type="search" placeholder="@(IsArabic ? "بحث برقم المستند أو الوصف…" : "Search by document number or description…")"
           @bind="_search" @bind:event="oninput" />
    <select @bind="_stateFilter">
        <option value="">@(IsArabic ? "كل الحالات" : "All states")</option>
        @foreach (var state in Enum.GetValues<DocumentState>())
        {
            <option value="@state">@state</option>
        }
    </select>
</div>

@if (_rows is null)
{
    <p>@(IsArabic ? "جارٍ التحميل…" : "Loading…")</p>
}
else if (_rows.Count == 0)
{
    <p><em>@(IsArabic ? "لا توجد مصروفات مطابقة للفلاتر الحالية." : "No expenses match the current filters.")</em></p>
}
else
{
    <table class="data-grid">
        <thead>
            <tr>
                <th>@(IsArabic ? "رقم المستند" : "Document #")</th>
                <th>@(IsArabic ? "التاريخ" : "Date")</th>
                <th>@(IsArabic ? "الفئة" : "Category")</th>
                <th>@(IsArabic ? "الوصف" : "Description")</th>
                <th>@(IsArabic ? "الحالة" : "State")</th>
                <th>@(IsArabic ? "المخاطر" : "Risk")</th>
                <th>@(IsArabic ? "قابل للخصم؟" : "Deductible?")</th>
                <th class="num">@(IsArabic ? "المبلغ" : "Amount")</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Filtered)
            {
                <tr>
                    <td>@(row.Expense.DocumentNumber ?? (IsArabic ? "(مسودة)" : "(draft)"))</td>
                    <td>@row.Expense.DocumentDate.ToString("yyyy-MM-dd")</td>
                    <td>@row.CategoryCode</td>
                    <td>@(IsArabic ? row.Expense.Description.Arabic : row.Expense.Description.English)</td>
                    <td><StateBadge State="row.Expense.State" /></td>
                    <td><TaxRiskScoreDot Findings="row.RiskFindings" /></td>
                    <td>@(row.Expense.DeductibleFlag ? (IsArabic ? "نعم" : "yes") : "—")</td>
                    <td class="num">@row.Expense.Amount.Amount.ToString("F2")</td>
                    <td>
                        @if (row.Expense.State == DocumentState.Draft)
                        {
                            <a href="/expenses/@row.Expense.Id/edit">@(IsArabic ? "تعديل" : "Edit")</a>
                        }
                        else
                        {
                            <a href="/expenses/@row.Expense.Id">@(IsArabic ? "عرض" : "View")</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Row>? _rows;
    private string _search = "";
    private string _stateFilter = "";

    protected override async Task OnInitializedAsync()
    {
        var rows = await Db.Set<Expense>()
            .AsNoTracking()
            .OrderByDescending(e => e.DocumentDate)
            .ThenByDescending(e => e.PostedAtUtc)
            .Take(500)
            .ToListAsync();

        var categoryIds = rows.Select(r => r.CategoryId).Distinct().ToArray();
        var categories = await Db.Set<DeductibleExpenseCategory>()
            .AsNoTracking()
            .Where(c => categoryIds.Contains(c.Id))
            .ToDictionaryAsync(c => c.Id, c => c.Code);

        // Bulk-load attachment counts for the visible rows so the
        // FR-016 risk badge per row is constant-factor (no N+1).
        var expenseIds = rows.Select(r => r.Id).ToArray();
        var attachmentCounts = await Db.Set<Attachment>().AsNoTracking()
            .Where(a => expenseIds.Contains(a.DocumentId)
                && a.DocumentType == DocumentType.Expense)
            .GroupBy(a => a.DocumentId)
            .Select(g => new { DocumentId = g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.DocumentId, x => x.Count);

        _rows = rows.Select(e =>
        {
            var attachmentCount = attachmentCounts.GetValueOrDefault(e.Id, 0);
            return new Row(
                e,
                categories.GetValueOrDefault(e.CategoryId, "?"),
                ScoreExpense(e, attachmentCount));
        }).ToList();
    }

    /// <summary>
    /// Inline FR-016 finding — same shape as ExpenseDetail's local
    /// scorer. Lives here too rather than in a shared helper because
    /// the dedicated ExpenseDocumentRiskRule family is deferred and
    /// extracting one method while the rule context is still
    /// undecided would be premature abstraction.
    /// </summary>
    private static IReadOnlyList<RiskFinding> ScoreExpense(Expense expense, int attachmentCount)
    {
        if (expense.DeductibleFlag && attachmentCount == 0 && expense.State == DocumentState.Draft)
        {
            return new[]
            {
                new RiskFinding(
                    "EXPENSE.MISSING_ATTACHMENT",
                    RiskSeverity.Blocker,
                    new ArabicEnglishText("مرفقات مفقودة لخصم ضريبي", "Missing attachment for deductible expense"),
                    new ArabicEnglishText(
                        "مصروف قابل للخصم بدون مرفقات. لن يقبل النظام النشر.",
                        "Deductible expense has no attachments. Post will be rejected per FR-016."),
                    FixHint: "Upload the receipt before posting."),
            };
        }
        return Array.Empty<RiskFinding>();
    }

    private IEnumerable<Row> Filtered => (_rows ?? Enumerable.Empty<Row>())
        .Where(r => string.IsNullOrEmpty(_search)
            || (r.Expense.DocumentNumber?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
            || r.Expense.Description.English.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || r.Expense.Description.Arabic.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .Where(r => string.IsNullOrEmpty(_stateFilter)
            || r.Expense.State.ToString() == _stateFilter);

    private sealed record Row(Expense Expense, string CategoryCode, IReadOnlyList<RiskFinding> RiskFindings);
}
