@page "/expenses/new"
@page "/expenses/{Id:guid}/edit"
@using System.ComponentModel.DataAnnotations
@using EgyptTax.Application.Attachments
@using EgyptTax.Domain.Documents
@using EgyptTax.Domain.Expenses
@using EgyptTax.Domain.MasterData
@using EgyptTax.Domain.Workflow
@using EgyptTax.Infrastructure.Attachments
@using EgyptTax.Infrastructure.Persistence
@using EgyptTax.SharedKernel
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject NavigationManager Nav
@inject UploadAttachmentHandler UploadHandler
@inject AuthenticationStateProvider AuthState
@inject EgyptTax.Application.Ocr.IReceiptOcrService Ocr
@attribute [Authorize(Policy = "NotSalesRepOnly")]

<h1>@(_isNew ? (IsArabic ? "مصروف جديد" : "New expense") : (IsArabic ? "تعديل مصروف" : "Edit expense"))</h1>

@if (_loading)
{
    <p>@(IsArabic ? "جارٍ التحميل…" : "Loading…")</p>
    return;
}

@if (!_isNew && _expense is null)
{
    <div class="flash-error">@(IsArabic ? "المصروف غير موجود." : "Expense not found.")</div>
    return;
}

@if (!_isNew && _expense!.State != DocumentState.Draft)
{
    <div class="flash-error">
        @(IsArabic
            ? $"المصروف {_expense.DocumentNumber} في حالة {_expense.State}؛ المسودات فقط قابلة للتعديل (FR-027)."
            : $"Expense {_expense.DocumentNumber} is in state {_expense.State}; only drafts are editable (FR-027).")
    </div>
    <a href="/expenses/@_expense.Id">← @(IsArabic ? "عرض المصروف" : "View expense")</a>
    return;
}

@if (_flash is not null)
{
    <div class="@_flashClass" role="status">@_flash</div>
}

@*
    G3.2 — Mobile-first receipt scan. The capture="environment"
    attribute opens the rear camera on phones; on desktop it falls
    back to a file picker so the operator can drop in a scan. After
    capture we call IReceiptOcrService directly (Blazor Server, no
    HTTP round-trip needed) and prefill the form with whatever the
    extractor found.
*@
@if (_isNew)
{
    <section class="ocr-scan-section">
        <label class="btn-primary ocr-scan-btn">
            <Icon Name="camera" Class="ic" />
            @(IsArabic ? "🧾 صوّر إيصال" : "🧾 Scan receipt")
            <InputFile OnChange="OnOcrCaptureAsync" accept="image/*" capture="environment"
                       disabled="@_ocrRunning" style="display:none;" />
        </label>
        @if (_ocrRunning)
        {
            <span class="ocr-status">@(IsArabic ? "جارٍ القراءة…" : "Reading…")</span>
        }
        @if (_ocrFlash is not null)
        {
            <div class="@_ocrFlashClass" style="margin-top:8px;">@_ocrFlash</div>
        }
    </section>
}

<EditForm Model="_form" OnValidSubmit="OnSaveDraftAsync" FormName="expense-edit" class="form-grid">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <fieldset>
        <legend>@(IsArabic ? "المصروف" : "Expense")</legend>
        <label>
            <span>@(IsArabic ? "التاريخ" : "Date")</span>
            <InputDate @bind-Value="_form.DocumentDate" />
        </label>
        <label>
            <span>@(IsArabic ? "الفئة" : "Category")</span>
            <InputSelect @bind-Value="_form.CategoryId" @bind-Value:after="OnCategoryChanged">
                <option value="@Guid.Empty">— @(IsArabic ? "اختر" : "select") —</option>
                @foreach (var c in _categories)
                {
                    <option value="@c.Id">@c.Code — @(IsArabic ? c.Name.Arabic : c.Name.English) (@(c.DefaultDeductible ? (IsArabic ? "قابل للخصم افتراضياً" : "deductible by default") : (IsArabic ? "غير قابل للخصم افتراضياً" : "non-deductible by default")))</option>
                }
            </InputSelect>
        </label>
        <label>
            <span>@(IsArabic ? "المبلغ (ج.م.)" : "Amount (EGP)")</span>
            <InputNumber @bind-Value="_form.Amount" step="0.01" />
        </label>
        <label>
            <span>@(IsArabic ? "قابل للخصم (ضريبة المدخلات قابلة للاسترداد وفقاً لـ FR-015)" : "Deductible (input VAT recoverable per FR-015)")</span>
            <InputCheckbox @bind-Value="_form.DeductibleFlag" />
        </label>
        <label>
            <span>@(IsArabic ? "الوصف (إنجليزي)" : "Description (English)")</span>
            <InputTextArea @bind-Value="_form.DescriptionEnglish" rows="3" />
        </label>
        <label>
            <span>@(IsArabic ? "الوصف (عربي)" : "Description (Arabic)")</span>
            <InputTextArea @bind-Value="_form.DescriptionArabic" rows="3" dir="rtl" />
        </label>
    </fieldset>

    <button type="submit">@(_isNew ? (IsArabic ? "حفظ المسودة" : "Save draft") : (IsArabic ? "تحديث المسودة" : "Update draft"))</button>
    <a href="/expenses">@(IsArabic ? "إلغاء" : "Cancel")</a>
</EditForm>

@if (!_isNew && _expense is not null)
{
    <section class="upload-section">
        <h2>@(IsArabic ? "المرفقات (FR-016 — مطلوبة عند القابلية للخصم)" : "Attachments (FR-016 — required if deductible)")</h2>
        @if (_attachments.Count == 0)
        {
            <p><em>@(IsArabic ? "لا توجد مرفقات بعد." : "No attachments yet.")</em></p>
        }
        else
        {
            <ul>
                @foreach (var a in _attachments)
                {
                    <li>@a.FilenameOriginal — @a.MimeType — @a.SizeBytes.ToString("N0") @(IsArabic ? "بايت" : "bytes")</li>
                }
            </ul>
        }

        <InputFile OnChange="OnUploadAsync" accept=".pdf,.jpg,.jpeg,.png" disabled="@_uploading" />
        @if (_uploading)
        {
            <span> @(IsArabic ? "جارٍ الرفع…" : "Uploading…")</span>
        }
    </section>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private bool _isNew;
    private bool _loading = true;
    private Expense? _expense;
    private List<DeductibleExpenseCategory> _categories = new();
    private List<Attachment> _attachments = new();
    private FormModel _form = new();
    private string? _flash;
    private string _flashClass = "flash-success";
    private bool _uploading;

    // G3.2 — receipt OCR scan state
    private bool _ocrRunning;
    private string? _ocrFlash;
    private string _ocrFlashClass = "kpi-card kpi-info";

    protected override async Task OnInitializedAsync()
    {
        _isNew = Id is null;
        _categories = await Db.Set<DeductibleExpenseCategory>().AsNoTracking()
            .Where(c => c.Status == DeductibleExpenseCategoryStatus.Active)
            .OrderBy(c => c.Code).ToListAsync();

        if (!_isNew)
        {
            _expense = await Db.Set<Expense>().AsNoTracking()
                .FirstOrDefaultAsync(e => e.Id == Id);
            if (_expense is not null && _expense.State == DocumentState.Draft)
            {
                _form.DocumentDate = _expense.DocumentDate.ToDateTime(TimeOnly.MinValue);
                _form.CategoryId = _expense.CategoryId;
                _form.Amount = _expense.Amount.Amount;
                _form.DeductibleFlag = _expense.DeductibleFlag;
                _form.DescriptionEnglish = _expense.Description.English;
                _form.DescriptionArabic = _expense.Description.Arabic;

                _attachments = await Db.Set<Attachment>().AsNoTracking()
                    .Where(a => a.DocumentId == _expense.Id
                        && a.DocumentType == DocumentType.Expense)
                    .OrderBy(a => a.UploadedAtUtc).ToListAsync();
            }
        }
        else
        {
            _form.DocumentDate = DateTime.UtcNow.Date;
            // M.1 (v3 roadmap) — when reached via the "Create expense
            // from this" link on /scan-receipt, the URL carries
            // ?vendor= &date= &total= &vat= &category= prefill params.
            // Read them here so the operator lands on a populated form
            // instead of a blank one.
            ApplyOcrPrefill();
        }

        _loading = false;
    }

    private void ApplyOcrPrefill()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (string.IsNullOrEmpty(uri.Query)) return;

        var qs = QueryHelpers.ParseQuery(uri.Query);

        if (qs.TryGetValue("date", out var dateRaw)
            && DateTime.TryParse(dateRaw.ToString(),
                System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out var d))
        {
            _form.DocumentDate = d;
        }

        if (qs.TryGetValue("total", out var totalRaw)
            && decimal.TryParse(totalRaw.ToString(),
                System.Globalization.NumberStyles.Number,
                System.Globalization.CultureInfo.InvariantCulture, out var amount))
        {
            _form.Amount = amount;
        }

        var vendor = qs.TryGetValue("vendor", out var v) ? v.ToString() : "";
        var vatRaw = qs.TryGetValue("vat", out var vv) ? vv.ToString() : "";
        var hasVendor = !string.IsNullOrWhiteSpace(vendor);
        var hasVat = !string.IsNullOrWhiteSpace(vatRaw);

        if (hasVendor || hasVat)
        {
            var arParts = new List<string>();
            var enParts = new List<string>();
            if (hasVendor)
            {
                arParts.Add(vendor);
                enParts.Add(vendor);
            }
            if (hasVat)
            {
                arParts.Add($"ضريبة قيمة مضافة: {vatRaw} ج.م");
                enParts.Add($"VAT: {vatRaw} EGP");
            }
            _form.DescriptionArabic = string.Join(" · ", arParts);
            _form.DescriptionEnglish = string.Join(" · ", enParts);
        }

        // Category match: best-effort only. Try to find a category
        // whose code or English/Arabic name contains the suggested
        // word ("travel" → "سفر / Travel"). If no match, leave the
        // dropdown unset; operator picks manually.
        if (qs.TryGetValue("category", out var catRaw))
        {
            var raw = catRaw.ToString().Trim();
            if (!string.IsNullOrEmpty(raw))
            {
                var match = _categories.FirstOrDefault(c =>
                    c.Code.Contains(raw, StringComparison.OrdinalIgnoreCase)
                    || c.Name.English.Contains(raw, StringComparison.OrdinalIgnoreCase)
                    || c.Name.Arabic.Contains(raw, StringComparison.OrdinalIgnoreCase));
                if (match is not null)
                {
                    _form.CategoryId = match.Id;
                    _form.DeductibleFlag = match.DefaultDeductible;
                }
            }
        }
    }

    private void OnCategoryChanged()
    {
        // Apply the category's default-deductible flag whenever the
        // operator picks a category. They can still flip it but the
        // default removes one click in the common case (FR-015).
        var cat = _categories.FirstOrDefault(c => c.Id == _form.CategoryId);
        if (cat is not null)
        {
            _form.DeductibleFlag = cat.DefaultDeductible;
        }
    }

    private async Task OnSaveDraftAsync()
    {
        if (_form.CategoryId == Guid.Empty)
        {
            _flash = IsArabic ? "اختر فئة مصروف." : "Select an expense category.";
            _flashClass = "flash-error";
            return;
        }
        if (_form.Amount <= 0m)
        {
            _flash = IsArabic ? "يجب أن يكون المبلغ موجباً." : "Amount must be positive.";
            _flashClass = "flash-error";
            return;
        }

        var date = DateOnly.FromDateTime(_form.DocumentDate);
        var description = new ArabicEnglishText(_form.DescriptionArabic, _form.DescriptionEnglish);
        var amount = MoneyEgp.From(_form.Amount);

        if (_isNew)
        {
            var draft = Expense.CreateDraft(date, _form.CategoryId, amount, _form.DeductibleFlag, description);
            Db.Add(draft);
            await Db.SaveChangesAsync();
            Nav.NavigateTo($"/expenses/{draft.Id}/edit", forceLoad: true);
            return;
        }

        var live = await Db.Set<Expense>().FirstAsync(e => e.Id == _expense!.Id);
        live.UpdateDocumentDate(date);
        live.UpdateCategory(_form.CategoryId);
        live.UpdateAmount(amount);
        live.UpdateDeductibleFlag(_form.DeductibleFlag);
        live.UpdateDescription(description);
        await Db.SaveChangesAsync();

        _flash = IsArabic ? "تم حفظ المسودة." : "Draft saved.";
        _flashClass = "flash-success";
    }

    private async Task OnOcrCaptureAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        _ocrRunning = true;
        _ocrFlash = null;
        try
        {
            // 10 MB cap matches the API endpoint guard so the
            // operator gets a clear error before we do any work.
            const long maxBytes = 10 * 1024 * 1024;
            await using var stream = file.OpenReadStream(maxAllowedSize: maxBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var result = await Ocr.RecognizeAsync(ms.ToArray());

            if (!result.Available)
            {
                _ocrFlash = IsArabic
                    ? $"محرك OCR غير متاح: {result.UnavailableReason}"
                    : $"OCR engine not available: {result.UnavailableReason}";
                _ocrFlashClass = "kpi-card kpi-warn";
                return;
            }

            var draft = result.Draft!;
            var prefilled = new List<string>();
            if (draft.TotalEgp is { } amt && amt > 0m)
            {
                _form.Amount = amt;
                prefilled.Add(IsArabic ? "المبلغ" : "amount");
            }
            if (draft.Date is { } d)
            {
                _form.DocumentDate = d.ToDateTime(TimeOnly.MinValue);
                prefilled.Add(IsArabic ? "التاريخ" : "date");
            }
            if (!string.IsNullOrWhiteSpace(draft.SupplierName))
            {
                // Supplier name on the receipt is usually one line —
                // mirror it into both description fields so the
                // operator only needs to translate one if at all.
                if (string.IsNullOrWhiteSpace(_form.DescriptionEnglish))
                    _form.DescriptionEnglish = draft.SupplierName;
                if (string.IsNullOrWhiteSpace(_form.DescriptionArabic))
                    _form.DescriptionArabic = draft.SupplierName;
                prefilled.Add(IsArabic ? "اسم المحل" : "supplier");
            }

            if (prefilled.Count == 0)
            {
                _ocrFlash = IsArabic
                    ? "تم قراءة الإيصال لكن لم يتمكن البرنامج من التعرف على أي حقل. اكتب البيانات يدوياً."
                    : "Receipt read OK but no fields recognised. Please type the values manually.";
                _ocrFlashClass = "kpi-card kpi-warn";
            }
            else
            {
                var note = draft.ExtractorNote is { } n ? $" ({n})" : "";
                _ocrFlash = IsArabic
                    ? $"✓ تم تعبئة: {string.Join("، ", prefilled)}{note}. راجع الأرقام قبل الحفظ."
                    : $"✓ Prefilled: {string.Join(", ", prefilled)}{note}. Review before saving.";
                _ocrFlashClass = "kpi-card kpi-info";
            }
        }
        catch (Exception ex)
        {
            _ocrFlash = ex.Message;
            _ocrFlashClass = "kpi-card kpi-error";
        }
        finally
        {
            _ocrRunning = false;
        }
    }

    private async Task OnUploadAsync(InputFileChangeEventArgs e)
    {
        if (_expense is null) return;
        var file = e.File;
        if (file is null) return;

        _uploading = true;
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            var userIdClaim = auth.User.FindFirst("sub")?.Value
                ?? auth.User.FindFirst("userId")?.Value;
            var operatorUserId = Guid.TryParse(userIdClaim, out var u) ? u : Guid.Empty;

            await using var content = file.OpenReadStream(maxAllowedSize: UploadAttachmentHandler.MaxBytes);
            await UploadHandler.HandleAsync(new UploadAttachmentCommand(
                DocumentId: _expense.Id,
                DocumentType: DocumentType.Expense,
                FilenameOriginal: file.Name,
                MimeType: file.ContentType,
                ContentStream: content,
                UploadedByUserId: operatorUserId), CancellationToken.None);

            _attachments = await Db.Set<Attachment>().AsNoTracking()
                .Where(a => a.DocumentId == _expense.Id
                    && a.DocumentType == DocumentType.Expense)
                .OrderBy(a => a.UploadedAtUtc).ToListAsync();
            _flash = IsArabic ? $"تم رفع {file.Name}." : $"Uploaded {file.Name}.";
            _flashClass = "flash-success";
        }
        catch (Exception ex)
        {
            _flash = ex.Message;
            _flashClass = "flash-error";
        }
        finally
        {
            _uploading = false;
        }
    }

    private sealed class FormModel
    {
        public DateTime DocumentDate { get; set; } = DateTime.UtcNow.Date;
        public Guid CategoryId { get; set; } = Guid.Empty;
        public decimal Amount { get; set; }
        public bool DeductibleFlag { get; set; }
        [Required, StringLength(2000)] public string DescriptionEnglish { get; set; } = "";
        [Required, StringLength(2000)] public string DescriptionArabic { get; set; } = "";
    }
}
