@page "/purchase-invoices/{Id:guid}"
@using EgyptTax.Application.Compliance.RiskScoring
@using EgyptTax.Application.Purchases
@using EgyptTax.Domain.Documents
@using EgyptTax.Domain.MasterData
@using EgyptTax.Domain.Purchases
@using EgyptTax.Domain.Workflow
@using EgyptTax.Infrastructure.Persistence
@using EgyptTax.Infrastructure.Purchases
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject NavigationManager Nav
@inject PurchaseDocumentRiskScorer RiskScorer
@inject IPurchaseInvoiceFingerprintQuery FingerprintQuery
@inject PostPurchaseInvoiceHandler PostHandler
@inject AuthenticationStateProvider AuthState
@attribute [Authorize(Policy = "NotSalesRepOnly")]

<Breadcrumb Crumbs="@(new[] {
    new Breadcrumb.BreadcrumbItem(IsArabic ? "فواتير الشراء" : "Purchase invoices", "/purchase-invoices"),
    new Breadcrumb.BreadcrumbItem(_invoice?.DocumentNumber ?? (IsArabic ? "..." : "..."), null)
})" />

<h1>@(IsArabic ? $"فاتورة شراء {(_invoice?.DocumentNumber ?? "(جارٍ التحميل)")}" : $"Purchase invoice {(_invoice?.DocumentNumber ?? "(loading)")}")</h1>

@if (_invoice is null)
{
    <p>@(IsArabic ? "جارٍ التحميل…" : "Loading…")</p>
    return;
}

@if (_flash is not null)
{
    <div class="@_flashClass" role="status">@_flash</div>
}

<section class="invoice-header">
    <div><strong>@(IsArabic ? "رقم المورد:" : "Supplier #:")</strong> @_invoice.SupplierInvoiceNumber</div>
    <div><strong>@(IsArabic ? "تاريخ الاستلام:" : "Date received:")</strong> @_invoice.DateReceived.ToString("yyyy-MM-dd")</div>
    <div><strong>@(IsArabic ? "الحالة:" : "State:")</strong> <StateBadge State="_invoice.State" /></div>
    <div><strong>@(IsArabic ? "المورد:" : "Supplier:")</strong> @(IsArabic ? (_supplier?.Name.Arabic ?? "—") : (_supplier?.Name.English ?? "—")) (@(_invoice.SupplierTaxProfileSnapshot.ProfileType))</div>
    @if (_invoice.PostedAtUtc is { } postedAt)
    {
        <div><strong>@(IsArabic ? "وقت الترحيل (UTC):" : "Posted at (UTC):")</strong> @postedAt.ToString("yyyy-MM-dd HH:mm:ss")</div>
        <div><strong>@(IsArabic ? "وضع الترحيل:" : "Posting mode:")</strong> @_invoice.PostingMode</div>
    }
    <div><strong>@(IsArabic ? "درجة المخاطر الضريبية:" : "Tax Risk Score:")</strong> <TaxRiskScoreBadge Findings="_riskFindings" /></div>
</section>

@* P1.12 — reverse-charge banner. Foreign supplier => we self-account
   the VAT in our books and the periodic VAT return; the supplier
   doesn't bill VAT and ETA's e-invoice portal is bypassed entirely. *@
@if (_invoice.SupplierTaxProfileSnapshot.ReverseChargeFlag)
{
    <div class="reverse-charge-banner">
        <Icon Name="shield-alert" Class="ic" />
        <div>
            <div><strong>@(IsArabic ? "ضريبة قيمة مضافة بنظام الخصم العكسي" : "Reverse-charge VAT")</strong></div>
            <div class="reverse-charge-meta">
                @(IsArabic
                    ? "المورّد غير مقيم في مصر — أنت تتحمّل ضريبة القيمة المضافة بنفسك في الإقرار الدوري بدلاً من دفعها للمورّد. القيد المحاسبي بيخصم ضريبة قابلة للاسترداد ويضيف ضريبة مستحقة بنفس المبلغ (صافي صفر)."
                    : "Supplier is not Egypt-resident — you self-account VAT in the periodic return instead of paying it to the supplier. The journal debits Recoverable Input VAT and credits Output VAT Payable for the same amount (net zero).")
            </div>
            <div class="reverse-charge-meta">
                @(IsArabic
                    ? "الفاتورة الإلكترونية ETA متخطية لهذه الفاتورة — الإقرار الدوري هو القناة الصحيحة."
                    : "ETA e-invoicing is bypassed for this document — the periodic VAT return is the correct channel.")
            </div>
        </div>
    </div>
}

<section>
    <h2>@(IsArabic ? "البنود" : "Lines")</h2>
    <table class="data-grid">
        <thead>
            <tr>
                <th>#</th>
                <th>@(IsArabic ? "الصنف / فئة المصروف" : "Item / Expense category")</th>
                <th class="num">@(IsArabic ? "الكمية" : "Qty")</th>
                <th class="num">@(IsArabic ? "سعر الوحدة" : "Unit price")</th>
                <th class="num">@(IsArabic ? "الإجمالي قبل الضريبة" : "Subtotal")</th>
                <th>@(IsArabic ? "الضريبة %" : "VAT %")</th>
                <th class="num">@(IsArabic ? "الضريبة" : "VAT")</th>
                <th class="num">@(IsArabic ? "إجمالي البند" : "Line total")</th>
                <th>@(IsArabic ? "قابل للخصم؟" : "Deductible?")</th>
            </tr>
        </thead>
        <tbody>
            @{ var idx = 1; }
            @foreach (var line in _invoice.Lines)
            {
                <tr>
                    <td>@idx</td>
                    <td>@DescribeLine(line)</td>
                    <td class="num">@line.Quantity.ToString("0.##")</td>
                    <td class="num">@line.UnitPrice.Amount.ToString("F2")</td>
                    <td class="num">@line.LineSubtotal.Amount.ToString("F2")</td>
                    <td>@line.VatRatePercent.ToString("0.##")%</td>
                    <td class="num">@line.LineVat.Amount.ToString("F2")</td>
                    <td class="num">@line.LineTotal.Amount.ToString("F2")</td>
                    <td>@(line.DeductibleFlag ? (IsArabic ? "نعم" : "yes") : "—")</td>
                </tr>
                idx++;
            }
        </tbody>
    </table>
</section>

<section class="invoice-totals">
    <div><strong>@(IsArabic ? "الإجمالي قبل الضريبة:" : "Subtotal:")</strong> <span class="num">@_invoice.Subtotal.Amount.ToString("F2") @(IsArabic ? "ج.م." : "EGP")</span></div>
    <div><strong>@(IsArabic ? "إجمالي الضريبة:" : "VAT total:")</strong> <span class="num">@_invoice.VatTotal.Amount.ToString("F2") @(IsArabic ? "ج.م." : "EGP")</span></div>
    <div class="grand"><strong>@(IsArabic ? "الإجمالي الكلي:" : "Grand total:")</strong> <span class="num">@_invoice.GrandTotal.Amount.ToString("F2") @(IsArabic ? "ج.م." : "EGP")</span></div>
</section>

<section>
    <h2>@(IsArabic ? $"المرفقات ({_attachments.Count})" : $"Attachments ({_attachments.Count})")</h2>
    @if (_attachments.Count == 0)
    {
        <p><em>@(IsArabic ? "لا توجد مرفقات مرفوعة." : "No attachments uploaded.")</em></p>
    }
    else
    {
        <table class="data-grid">
            <thead>
                <tr>
                    <th>@(IsArabic ? "اسم الملف" : "Filename")</th>
                    <th>@(IsArabic ? "النوع" : "MIME")</th>
                    <th class="num">@(IsArabic ? "الحجم (بايت)" : "Size (bytes)")</th>
                    <th>@(IsArabic ? "SHA-256 (أول 16 خانة)" : "SHA-256 (first 16 hex)")</th>
                    <th>@(IsArabic ? "وقت الرفع (UTC)" : "Uploaded (UTC)")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in _attachments)
                {
                    <tr>
                        <td>@a.FilenameOriginal</td>
                        <td>@a.MimeType</td>
                        <td class="num">@a.SizeBytes.ToString("N0")</td>
                        <td><code>@Convert.ToHexString(a.Sha256).Substring(0, 16)…</code></td>
                        <td>@a.UploadedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@* P2.4 — one-click WhatsApp nudge to ask the supplier for the
   missing PDF / corrected amount. Only renders when supplier has a
   phone on file. *@
@if (_supplier?.Phone is { Length: > 0 })
{
    <section class="invoice-actions">
        <h2>@(IsArabic ? "تذكير عبر واتساب" : "WhatsApp nudge")</h2>
        <p style="font-size:13px;color:var(--text-muted);">
            @(IsArabic
                ? "ضغطة واحدة لفتح واتساب برسالة جاهزة للمورّد."
                : "One click to open WhatsApp with a pre-filled message to the supplier.")
        </p>
        <WhatsAppNudgeButton
            Phone="_supplier.Phone"
            ButtonLabel="@(IsArabic ? "اطلب المرفق من المورّد" : "Request attachment from supplier")"
            CssClass="btn-primary"
            MessageText="@(IsArabic
                ? $"السلام عليكم، نحتاج نسخة PDF من فاتورتكم رقم {_invoice.SupplierInvoiceNumber} بتاريخ {_invoice.DateReceived:yyyy-MM-dd} بمبلغ إجمالي {_invoice.GrandTotal.Amount:N2} ج.م.، عشان نقدر نكمل الترحيل عندنا. شكراً."
                : $"Hi, could you please send a PDF copy of invoice {_invoice.SupplierInvoiceNumber} dated {_invoice.DateReceived:yyyy-MM-dd} (total EGP {_invoice.GrandTotal.Amount:N2})? We need it to complete posting on our side. Thanks.")" />
    </section>
}

@if (_invoice.State is DocumentState.Draft or DocumentState.Submitted or DocumentState.Approved)
{
    <section class="invoice-actions">
        <h2>@(IsArabic ? "سير عمل الاعتماد (FR-026)" : "Approval workflow (FR-026)")</h2>
        @if (_latestApproval is not null)
        {
            <p>
                <strong>@(IsArabic ? "آخر طلب اعتماد:" : "Latest approval request:")</strong> @_latestApproval.Status
                — @(IsArabic ? "أرسله المستخدم" : "submitted by") @_latestApproval.SubmittedByUserId.ToString("D")[..8]
                @(IsArabic ? "في" : "at") @_latestApproval.SubmittedAtUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC.
                @if (_latestApproval.RejectionReason is { } reason)
                {
                    <br /><em>@(IsArabic ? "سبب الرفض:" : "Rejection reason:") @reason</em>
                }
            </p>
        }
        <WorkflowActions
            DocumentId="_invoice.Id"
            DocumentType="DocumentType.PurchaseInvoice"
            CurrentState="_invoice.State"
            SubmittedByUserId="_latestApproval?.SubmittedByUserId"
            OnChanged="ReloadAsync" />
    </section>
}

@if (_invoice.State == DocumentState.Draft)
{
    <section class="invoice-actions">
        <a class="btn-primary" href="/purchase-invoices/@_invoice.Id/edit">@(IsArabic ? "تعديل المسودة" : "Edit draft")</a>
        <button type="button" class="btn-primary" disabled="@_posting" @onclick="OnPostAsync">
            @(_posting ? (IsArabic ? "جارٍ الترحيل…" : "Posting…") : (IsArabic ? "ترحيل الفاتورة" : "Post invoice"))
        </button>
        <a href="/document360/purchase-invoice/@_invoice.Id">📂 @(IsArabic ? "ملف المستند الكامل" : "Document 360")</a>
    </section>
}
else
{
    <section class="invoice-actions">
        <a href="/document360/purchase-invoice/@_invoice.Id">📂 @(IsArabic ? "ملف المستند الكامل" : "Document 360")</a>
        @if (_invoice.State == DocumentState.Posted && !_invoice.IsCreditNote)
        {
            <a class="btn-secondary" href="/purchase-invoices/@_invoice.Id/credit-note/new">
                @(IsArabic ? "إصدار إشعار خصم" : "Issue credit note")
            </a>
        }
    </section>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private PurchaseInvoice? _invoice;
    private Supplier? _supplier;
    private List<Attachment> _attachments = new();
    private IReadOnlyList<RiskFinding>? _riskFindings;
    private ApprovalRequest? _latestApproval;
    private string? _flash;
    private string _flashClass = "flash-success";
    private bool _posting;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _invoice = await Db.Set<PurchaseInvoice>()
            .Include(p => p.Lines)
            .AsNoTracking()
            .FirstOrDefaultAsync(p => p.Id == Id);
        if (_invoice is null) return;

        _supplier = await Db.Set<Supplier>().AsNoTracking()
            .FirstOrDefaultAsync(s => s.Id == _invoice.SupplierId);

        _latestApproval = await Db.Set<ApprovalRequest>().AsNoTracking()
            .Where(r => r.DocumentId == _invoice.Id)
            .OrderByDescending(r => r.SubmittedAtUtc)
            .FirstOrDefaultAsync();

        _attachments = await Db.Set<Attachment>()
            .AsNoTracking()
            .Where(a => a.DocumentId == _invoice.Id
                && a.DocumentType == DocumentType.PurchaseInvoice)
            .OrderBy(a => a.UploadedAtUtc)
            .ToListAsync();

        var fingerprints = await FingerprintQuery
            .FindOtherPurchaseInvoicesWithSameSupplierReferenceAsync(
                _invoice.SupplierId,
                _invoice.SupplierInvoiceNumber,
                excludePurchaseInvoiceId: _invoice.Id);

        _riskFindings = RiskScorer.Score(new PurchaseDocumentRiskContext(
            Invoice: _invoice,
            Supplier: _supplier,
            Attachments: _attachments,
            SupplierInvoiceFingerprints: fingerprints,
            NowUtc: DateTime.UtcNow));
    }

    private async Task OnPostAsync()
    {
        if (_invoice is null) return;
        _posting = true;
        _flash = null;
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            var sessionUser = auth.User;
            var userIdClaim = sessionUser.FindFirst("sub")?.Value
                ?? sessionUser.FindFirst("userId")?.Value;
            var operatorUserId = Guid.TryParse(userIdClaim, out var u) ? u : Guid.Empty;

            await PostHandler.HandleAsync(
                new PostPurchaseInvoiceCommand(_invoice.Id, operatorUserId),
                CancellationToken.None);
            Nav.NavigateTo($"/purchase-invoices/{_invoice.Id}", forceLoad: true);
        }
        catch (InvalidOperationException ex)
        {
            _flash = ex.Message;
            _flashClass = "flash-error";
        }
        finally
        {
            _posting = false;
        }
    }

    private string DescribeLine(PurchaseInvoiceLine line) =>
        line.ItemId is { } itemId
            ? (IsArabic ? $"صنف {itemId:D}" : $"Item {itemId:D}")
            : line.ExpenseCategoryId is { } catId
                ? (IsArabic ? $"فئة مصروف {catId:D}" : $"Expense category {catId:D}")
                : (IsArabic ? "(غير معروف)" : "(unknown)");
}
