@page "/purchase-invoices/new"
@page "/purchase-invoices/{Id:guid}/edit"
@using System.ComponentModel.DataAnnotations
@using EgyptTax.Application.Attachments
@using EgyptTax.Domain.Documents
@using EgyptTax.Domain.MasterData
@using EgyptTax.Domain.Purchases
@using EgyptTax.Domain.Workflow
@using EgyptTax.Infrastructure.Attachments
@using EgyptTax.Infrastructure.Persistence
@using EgyptTax.SharedKernel
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject NavigationManager Nav
@inject UploadAttachmentHandler UploadHandler
@inject AuthenticationStateProvider AuthState
@attribute [Authorize(Policy = "NotSalesRepOnly")]

<Breadcrumb Crumbs="@(new[] {
    new Breadcrumb.BreadcrumbItem(IsArabic ? "فواتير الشراء" : "Purchase invoices", "/purchase-invoices"),
    new Breadcrumb.BreadcrumbItem(_isNew ? (IsArabic ? "جديدة" : "New") : (IsArabic ? "تعديل" : "Edit"), null)
})" />

<h1>@(_isNew ? (IsArabic ? "فاتورة شراء جديدة" : "New purchase invoice") : (IsArabic ? "تعديل فاتورة شراء" : "Edit purchase invoice"))</h1>

@if (_loading)
{
    <p>@(IsArabic ? "جارٍ التحميل…" : "Loading…")</p>
    return;
}

@if (!_isNew && _invoice is null)
{
    <div class="flash-error">@(IsArabic ? "فاتورة الشراء غير موجودة." : "Purchase invoice not found.")</div>
    return;
}

@if (!_isNew && _invoice!.State != DocumentState.Draft)
{
    <div class="flash-error">
        @(IsArabic
            ? $"الفاتورة {_invoice.DocumentNumber} في حالة {_invoice.State}؛ المسودات فقط قابلة للتعديل (FR-027)."
            : $"Invoice {_invoice.DocumentNumber} is in state {_invoice.State}; only drafts are editable (FR-027).")
    </div>
    <a href="/purchase-invoices/@_invoice.Id">← @(IsArabic ? "عرض الفاتورة" : "View invoice")</a>
    return;
}

@if (_flash is not null)
{
    <div class="@_flashClass" role="status">@_flash</div>
}

<EditForm Model="_form" OnValidSubmit="OnSaveDraftAsync" FormName="purchase-invoice-edit" class="form-grid">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <fieldset>
        <legend>@(IsArabic ? "البيانات الأساسية" : "Header")</legend>
        <label>
            <span>@(IsArabic ? "المورد" : "Supplier")</span>
            <InputSelect @bind-Value="_form.SupplierId">
                <option value="@Guid.Empty">— @(IsArabic ? "اختر" : "select") —</option>
                @foreach (var s in _suppliers)
                {
                    <option value="@s.Id">@s.Code — @(IsArabic ? s.Name.Arabic : s.Name.English) (@s.TaxProfile.ProfileType)</option>
                }
            </InputSelect>
        </label>
        <label>
            <span>@(IsArabic ? "رقم فاتورة المورد" : "Supplier invoice number")</span>
            <InputText @bind-Value="_form.SupplierInvoiceNumber" />
        </label>
        <label>
            <span>@(IsArabic ? "تاريخ الاستلام" : "Date received")</span>
            <InputDate @bind-Value="_form.DateReceived" />
        </label>
    </fieldset>

    <fieldset>
        <legend>@(IsArabic ? "البنود" : "Lines")</legend>
        @if (_form.Lines.Count == 0)
        {
            <p><em>@(IsArabic ? "لا توجد بنود بعد — أضف بنداً بالأسفل." : "No lines yet — add one below.")</em></p>
        }
        else
        {
            <table class="data-grid">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@(IsArabic ? "الصنف / الفئة" : "Item / Category")</th>
                        <th>@(IsArabic ? "الضريبة" : "VAT")</th>
                        <th class="num">@(IsArabic ? "الكمية" : "Qty")</th>
                        <th class="num">@(IsArabic ? "سعر الوحدة" : "Unit price")</th>
                        <th>@(IsArabic ? "قابل للخصم" : "Deductible")</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < _form.Lines.Count; i++)
                    {
                        var idx = i;
                        var line = _form.Lines[idx];
                        <tr>
                            <td>@(idx + 1)</td>
                            <td>
                                @DescribeLine(line)
                                @* v5 F.6 v2 — show the line's cost-center tag inline. *@
                                @if (line.CostCenterId != Guid.Empty)
                                {
                                    var cc = _costCenters.FirstOrDefault(c => c.Id == line.CostCenterId);
                                    if (cc is not null)
                                    {
                                        <span style="font-size:11px;color:var(--text-muted);margin-inline-start:8px;">
                                            🏷 @cc.Code
                                        </span>
                                    }
                                }
                                @* v5 F.6 v2 phase 2 — split editor toggle. Only on
                                   saved lines (FormLine.SavedLineId populated). *@
                                @if (line.SavedLineId != Guid.Empty)
                                {
                                    var sid = line.SavedLineId;
                                    <button type="button" class="btn-secondary"
                                            style="font-size:11px;margin-inline-start:8px;"
                                            @onclick="() => _splittingForLine = (_splittingForLine == sid ? null : sid)">
                                        🌐 @(IsArabic ? "توزيع" : "Split")
                                    </button>
                                }
                            </td>
                            <td>@DescribeVat(line.VatCategoryId)</td>
                            <td class="num">@line.Quantity.ToString("0.##")</td>
                            <td class="num">@line.UnitPrice.ToString("F2")</td>
                            <td>@(line.DeductibleFlag ? (IsArabic ? "نعم" : "yes") : (IsArabic ? "لا" : "no"))</td>
                            <td><button type="button" @onclick="() => _form.Lines.RemoveAt(idx)">@(IsArabic ? "حذف" : "Remove")</button></td>
                        </tr>
                        @if (line.SavedLineId != Guid.Empty && _splittingForLine == line.SavedLineId)
                        {
                            var lineNetAmount = decimal.Round(line.Quantity * line.UnitPrice, 2, MidpointRounding.ToEven);
                            <tr>
                                <td colspan="7" style="background:var(--bg-2);">
                                    <div style="padding:10px 14px;">
                                        <strong>@(IsArabic ? "🌐 توزيع متعدد المراكز للسطر" : "🌐 Split allocation for this line")</strong>
                                        <CostCenterSplitEditor
                                            SourceType="EgyptTax.Domain.MasterData.CostCenterAllocationSourceType.PurchaseInvoiceLine"
                                            SourceLineId="@line.SavedLineId"
                                            TotalAmount="@lineNetAmount"
                                            CostCenters="@_costCenters" />
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
    </fieldset>

    <fieldset>
        <legend>@(IsArabic ? "إضافة بند" : "Add a line")</legend>
        <label>
            <span>@(IsArabic ? "نوع البند" : "Line kind")</span>
            <InputSelect @bind-Value="_newLine.Kind">
                <option value="@LineKind.Item">@(IsArabic ? "صنف (مخزون / بضاعة)" : "Item (inventory / trading goods)")</option>
                <option value="@LineKind.Expense">@(IsArabic ? "فئة مصروف" : "Expense category")</option>
            </InputSelect>
        </label>
        @if (_newLine.Kind == LineKind.Item)
        {
            <label>
                <span>@(IsArabic ? "الصنف" : "Item")</span>
                <InputSelect @bind-Value="_newLine.ItemId">
                    <option value="@Guid.Empty">— @(IsArabic ? "اختر" : "select") —</option>
                    @foreach (var i in _items)
                    {
                        <option value="@i.Id">@i.Code — @(IsArabic ? i.Name.Arabic : i.Name.English)</option>
                    }
                </InputSelect>
            </label>
        }
        else
        {
            <label>
                <span>@(IsArabic ? "فئة المصروف" : "Expense category")</span>
                <InputSelect @bind-Value="_newLine.ExpenseCategoryId">
                    <option value="@Guid.Empty">— @(IsArabic ? "اختر" : "select") —</option>
                    @foreach (var c in _categories)
                    {
                        <option value="@c.Id">@c.Code — @(IsArabic ? c.Name.Arabic : c.Name.English) (@(c.DefaultDeductible ? (IsArabic ? "قابل للخصم افتراضياً" : "deductible by default") : (IsArabic ? "غير قابل للخصم افتراضياً" : "non-deductible by default")))</option>
                    }
                </InputSelect>
            </label>
        }
        <label>
            <span>@(IsArabic ? "فئة الضريبة" : "VAT category")</span>
            <InputSelect @bind-Value="_newLine.VatCategoryId">
                <option value="@Guid.Empty">— @(IsArabic ? "اختر" : "select") —</option>
                @foreach (var v in _vatCategories)
                {
                    <option value="@v.Id">@v.Code (@v.RatePercent.ToString("0.##")%)</option>
                }
            </InputSelect>
        </label>
        <label>
            <span>@(IsArabic ? "الكمية" : "Quantity")</span>
            <InputNumber @bind-Value="_newLine.Quantity" step="0.01" />
        </label>
        <label>
            <span>@(IsArabic ? "سعر الوحدة" : "Unit price")</span>
            <InputNumber @bind-Value="_newLine.UnitPrice" step="0.01" />
        </label>
        <label>
            <span>@(IsArabic ? "قابل للخصم (ضريبة المدخلات قابلة للاسترداد)" : "Deductible (input VAT recoverable)")</span>
            <InputCheckbox @bind-Value="_newLine.DeductibleFlag" />
        </label>
        @if (_costCenters.Count > 0)
        {
            @* v5 F.6 v2 — per-line cost-center tag (single-tag here;
               sticky across consecutive Add-line clicks). *@
            <label>
                <span>@(IsArabic ? "مركز التكلفة (اختياري)" : "Cost center (optional)")</span>
                <InputSelect @bind-Value="_newLine.CostCenterId">
                    <option value="@Guid.Empty">— @(IsArabic ? "بدون" : "none") —</option>
                    @foreach (var cc in _costCenters)
                    {
                        <option value="@cc.Id">@cc.Code — @(IsArabic ? cc.Name.Arabic : cc.Name.English)</option>
                    }
                </InputSelect>
            </label>
        }
        <button type="button" @onclick="OnAddLine">@(IsArabic ? "إضافة بند" : "Add line")</button>
    </fieldset>

    <button type="submit">@(_isNew ? (IsArabic ? "حفظ المسودة" : "Save draft") : (IsArabic ? "تحديث المسودة" : "Update draft"))</button>
    <a href="/purchase-invoices">@(IsArabic ? "إلغاء" : "Cancel")</a>
</EditForm>

@if (!_isNew && _invoice is not null)
{
    <section class="upload-section">
        <h2>@(IsArabic ? "المرفقات (FR-016 — مطلوبة للبنود القابلة للخصم)" : "Attachments (FR-016 — required for deductible lines)")</h2>
        @if (_attachments.Count == 0)
        {
            <p><em>@(IsArabic ? "لا توجد مرفقات بعد. البنود القابلة للخصم تتطلب مستنداً داعماً واحداً على الأقل قبل الترحيل." : "No attachments yet. Deductible lines require at least one supporting document before posting.")</em></p>
        }
        else
        {
            <ul>
                @foreach (var a in _attachments)
                {
                    <li>@a.FilenameOriginal — @a.MimeType — @a.SizeBytes.ToString("N0") @(IsArabic ? "بايت" : "bytes")</li>
                }
            </ul>
        }

        <InputFile OnChange="OnUploadAsync" accept=".pdf,.jpg,.jpeg,.png" disabled="@_uploading" />
        @if (_uploading)
        {
            <span> @(IsArabic ? "جارٍ الرفع…" : "Uploading…")</span>
        }
    </section>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private bool _isNew;
    private bool _loading = true;
    private PurchaseInvoice? _invoice;
    private List<Supplier> _suppliers = new();
    private List<Item> _items = new();
    private List<DeductibleExpenseCategory> _categories = new();
    private List<VatCategory> _vatCategories = new();
    // v5 F.6 v2 — cost-center dropdown source. Active centers only.
    private List<CostCenter> _costCenters = new();
    // v5 F.6 v2 phase 2 — which saved PurchaseInvoiceLine.Id has the split editor open.
    private Guid? _splittingForLine;
    private List<Attachment> _attachments = new();
    private FormModel _form = new();
    private NewLineModel _newLine = new();
    private string? _flash;
    private string _flashClass = "flash-success";
    private bool _uploading;

    protected override async Task OnInitializedAsync()
    {
        _isNew = Id is null;

        _suppliers = await Db.Set<Supplier>().AsNoTracking()
            .Where(s => s.Status == SupplierStatus.Active)
            .OrderBy(s => s.Code).ToListAsync();
        _items = await Db.Set<Item>().AsNoTracking()
            .Where(i => i.Status == ItemStatus.Active)
            .OrderBy(i => i.Code).ToListAsync();
        _categories = await Db.Set<DeductibleExpenseCategory>().AsNoTracking()
            .Where(c => c.Status == DeductibleExpenseCategoryStatus.Active)
            .OrderBy(c => c.Code).ToListAsync();
        _vatCategories = await Db.Set<VatCategory>().AsNoTracking()
            .OrderBy(v => v.Code).ToListAsync();
        _costCenters = await Db.Set<CostCenter>().AsNoTracking()
            .Where(c => c.Status == CostCenterStatus.Active)
            .OrderBy(c => c.Code).ToListAsync();

        if (!_isNew)
        {
            _invoice = await Db.Set<PurchaseInvoice>()
                .Include(p => p.Lines)
                .AsNoTracking()
                .FirstOrDefaultAsync(p => p.Id == Id);
            if (_invoice is not null && _invoice.State == DocumentState.Draft)
            {
                _form.SupplierId = _invoice.SupplierId;
                _form.SupplierInvoiceNumber = _invoice.SupplierInvoiceNumber;
                _form.DateReceived = _invoice.DateReceived.ToDateTime(TimeOnly.MinValue);
                _form.Lines = _invoice.Lines
                    .Select(l => new FormLine
                    {
                        SavedLineId = l.Id,
                        ItemId = l.ItemId,
                        ExpenseCategoryId = l.ExpenseCategoryId,
                        VatCategoryId = l.VatCategoryId,
                        Quantity = l.Quantity,
                        UnitPrice = l.UnitPrice.Amount,
                        VatRatePercent = l.VatRatePercent,
                        DeductibleFlag = l.DeductibleFlag,
                        CostCenterId = l.CostCenterId ?? Guid.Empty,
                    }).ToList();
                _attachments = await Db.Set<Attachment>()
                    .AsNoTracking()
                    .Where(a => a.DocumentId == _invoice.Id
                        && a.DocumentType == DocumentType.PurchaseInvoice)
                    .OrderBy(a => a.UploadedAtUtc)
                    .ToListAsync();
            }
        }

        if (_isNew)
        {
            _form.DateReceived = DateTime.UtcNow.Date;
        }

        _loading = false;
    }

    private void OnAddLine()
    {
        if (_newLine.VatCategoryId == Guid.Empty || _newLine.Quantity <= 0m)
        {
            _flash = IsArabic ? "اختر فئة ضريبة وكمية موجبة." : "Select a VAT category and a positive quantity.";
            _flashClass = "flash-error";
            return;
        }
        if (_newLine.Kind == LineKind.Item && _newLine.ItemId == Guid.Empty)
        {
            _flash = IsArabic ? "اختر صنفاً." : "Select an item.";
            _flashClass = "flash-error";
            return;
        }
        if (_newLine.Kind == LineKind.Expense && _newLine.ExpenseCategoryId == Guid.Empty)
        {
            _flash = IsArabic ? "اختر فئة مصروف." : "Select an expense category.";
            _flashClass = "flash-error";
            return;
        }

        var vat = _vatCategories.First(v => v.Id == _newLine.VatCategoryId);
        _form.Lines.Add(new FormLine
        {
            ItemId = _newLine.Kind == LineKind.Item ? _newLine.ItemId : null,
            ExpenseCategoryId = _newLine.Kind == LineKind.Expense ? _newLine.ExpenseCategoryId : null,
            VatCategoryId = vat.Id,
            VatRatePercent = vat.RatePercent,
            Quantity = _newLine.Quantity,
            UnitPrice = _newLine.UnitPrice,
            DeductibleFlag = _newLine.DeductibleFlag,
            CostCenterId = _newLine.CostCenterId,
        });
        // v5 F.6 v2 — preserve sticky CC selection across consecutive
        // Add-line clicks (operator usually wants every line on the
        // same CC). Reset everything else.
        var stickyCc = _newLine.CostCenterId;
        _newLine = new NewLineModel { CostCenterId = stickyCc };
        _flash = null;
    }

    private async Task OnSaveDraftAsync()
    {
        if (_form.SupplierId == Guid.Empty)
        {
            _flash = IsArabic ? "اختر مورداً." : "Select a supplier.";
            _flashClass = "flash-error";
            return;
        }
        if (_form.Lines.Count == 0)
        {
            _flash = IsArabic ? "أضف بنداً واحداً على الأقل." : "Add at least one line.";
            _flashClass = "flash-error";
            return;
        }

        var supplier = _suppliers.First(s => s.Id == _form.SupplierId);
        var dateReceived = DateOnly.FromDateTime(_form.DateReceived);

        if (_isNew)
        {
            var draft = PurchaseInvoice.CreateDraft(
                supplier.Id, supplier.TaxProfile, _form.SupplierInvoiceNumber, dateReceived);
            foreach (var l in _form.Lines)
            {
                draft.AddLine(l.ItemId, l.ExpenseCategoryId, l.Quantity,
                    MoneyEgp.From(l.UnitPrice), l.VatCategoryId, l.VatRatePercent, l.DeductibleFlag,
                    costCenterId: l.CostCenterId == Guid.Empty ? null : l.CostCenterId);
            }
            Db.Add(draft);
            await Db.SaveChangesAsync();
            Nav.NavigateTo($"/purchase-invoices/{draft.Id}/edit", forceLoad: true);
            return;
        }

        // Edit existing draft. v5 F.6 v2 phase 2 — diff-based update
        // (mirror of SalesInvoiceEdit) so existing line ids survive
        // edits, which keeps any CostCenterAllocation rows linked.
        // Previously this path did delete-then-reinsert, which gave
        // every line a fresh id and orphaned the operator's split work.
        var live = await Db.Set<PurchaseInvoice>()
            .Include(p => p.Lines)
            .FirstAsync(p => p.Id == _invoice!.Id);
        live.UpdateSupplierInvoiceNumber(_form.SupplierInvoiceNumber);
        live.UpdateDateReceived(dateReceived);

        var existingIds = live.Lines.Select(l => l.Id).ToHashSet();
        var keptIds = _form.Lines
            .Where(l => l.SavedLineId != Guid.Empty)
            .Select(l => l.SavedLineId).ToHashSet();
        // Remove only lines the operator dropped from the form.
        foreach (var droppedId in existingIds.Where(id => !keptIds.Contains(id)).ToList())
        {
            live.RemoveLine(droppedId);
            // Drop orphaned cost-center allocations for the deleted line.
            var orphans = await Db.Set<CostCenterAllocation>()
                .Where(a => a.SourceType == CostCenterAllocationSourceType.PurchaseInvoiceLine
                    && a.SourceLineId == droppedId)
                .ToListAsync();
            Db.Set<CostCenterAllocation>().RemoveRange(orphans);
        }
        // Add only the lines that aren't already in DB.
        foreach (var l in _form.Lines.Where(l => l.SavedLineId == Guid.Empty))
        {
            live.AddLine(l.ItemId, l.ExpenseCategoryId, l.Quantity,
                MoneyEgp.From(l.UnitPrice), l.VatCategoryId, l.VatRatePercent, l.DeductibleFlag,
                costCenterId: l.CostCenterId == Guid.Empty ? null : l.CostCenterId);
        }
        // NB: existing-line edits (qty/unit-price changes on lines the
        // operator kept) aren't supported in v1 — the form treats kept
        // FormLines as immutable. PurchaseInvoiceLine doesn't expose
        // mutators today; the operator must Remove + re-Add for changes.

        await Db.SaveChangesAsync();

        // Refresh FormLine list with the freshly-persisted Ids so any
        // newly-added lines pick up their SavedLineId for the Split button.
        _invoice = live;
        _form.Lines = live.Lines
            .Select(l => new FormLine
            {
                SavedLineId = l.Id,
                ItemId = l.ItemId,
                ExpenseCategoryId = l.ExpenseCategoryId,
                VatCategoryId = l.VatCategoryId,
                Quantity = l.Quantity,
                UnitPrice = l.UnitPrice.Amount,
                VatRatePercent = l.VatRatePercent,
                DeductibleFlag = l.DeductibleFlag,
                CostCenterId = l.CostCenterId ?? Guid.Empty,
            }).ToList();

        _flash = IsArabic ? "تم حفظ المسودة." : "Draft saved.";
        _flashClass = "flash-success";
    }

    private async Task OnUploadAsync(InputFileChangeEventArgs e)
    {
        if (_invoice is null) return;
        var file = e.File;
        if (file is null) return;

        _uploading = true;
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            var userIdClaim = auth.User.FindFirst("sub")?.Value
                ?? auth.User.FindFirst("userId")?.Value;
            var operatorUserId = Guid.TryParse(userIdClaim, out var u) ? u : Guid.Empty;

            await using var content = file.OpenReadStream(maxAllowedSize: UploadAttachmentHandler.MaxBytes);
            await UploadHandler.HandleAsync(new UploadAttachmentCommand(
                DocumentId: _invoice.Id,
                DocumentType: DocumentType.PurchaseInvoice,
                FilenameOriginal: file.Name,
                MimeType: file.ContentType,
                ContentStream: content,
                UploadedByUserId: operatorUserId), CancellationToken.None);

            _attachments = await Db.Set<Attachment>()
                .AsNoTracking()
                .Where(a => a.DocumentId == _invoice.Id
                    && a.DocumentType == DocumentType.PurchaseInvoice)
                .OrderBy(a => a.UploadedAtUtc)
                .ToListAsync();
            _flash = IsArabic ? $"تم رفع {file.Name}." : $"Uploaded {file.Name}.";
            _flashClass = "flash-success";
        }
        catch (Exception ex)
        {
            _flash = ex.Message;
            _flashClass = "flash-error";
        }
        finally
        {
            _uploading = false;
        }
    }

    private string DescribeLine(FormLine line)
    {
        if (line.ItemId is { } itemId)
        {
            var item = _items.FirstOrDefault(i => i.Id == itemId);
            return item is null ? itemId.ToString("D") : $"{item.Code} — {(IsArabic ? item.Name.Arabic : item.Name.English)}";
        }
        if (line.ExpenseCategoryId is { } catId)
        {
            var cat = _categories.FirstOrDefault(c => c.Id == catId);
            return cat is null ? catId.ToString("D") : $"{cat.Code} — {(IsArabic ? cat.Name.Arabic : cat.Name.English)}";
        }
        return IsArabic ? "(غير معروف)" : "(unknown)";
    }

    private string DescribeVat(Guid vatId)
    {
        var v = _vatCategories.FirstOrDefault(x => x.Id == vatId);
        return v is null ? vatId.ToString("D") : $"{v.Code} ({v.RatePercent:0.##}%)";
    }

    private enum LineKind { Item, Expense }

    private sealed class FormModel
    {
        public Guid SupplierId { get; set; } = Guid.Empty;
        [Required, StringLength(64)]
        public string SupplierInvoiceNumber { get; set; } = "";
        public DateTime DateReceived { get; set; } = DateTime.UtcNow.Date;
        public List<FormLine> Lines { get; set; } = new();
    }

    private sealed class FormLine
    {
        // v5 F.6 v2 phase 2 — when this FormLine was loaded from a
        // persisted PurchaseInvoiceLine, SavedLineId is the underlying
        // row's Guid. Empty for lines added in the current session that
        // haven't been saved yet (split editor needs a saved Id, so
        // those lines hide the Split button until the invoice is saved
        // and the page reloads).
        public Guid SavedLineId { get; set; } = Guid.Empty;
        public Guid? ItemId { get; set; }
        public Guid? ExpenseCategoryId { get; set; }
        public Guid VatCategoryId { get; set; }
        public decimal VatRatePercent { get; set; }
        public decimal Quantity { get; set; }
        public decimal UnitPrice { get; set; }
        public bool DeductibleFlag { get; set; }
        // v5 F.6 v2 — optional per-line cost-center tag.
        public Guid CostCenterId { get; set; } = Guid.Empty;
    }

