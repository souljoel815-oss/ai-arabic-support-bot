<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>EgyptTax.IntegrationTests</RootNamespace>
    <AssemblyName>EgyptTax.IntegrationTests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EgyptTax.SharedKernel\EgyptTax.SharedKernel.csproj" />
    <ProjectReference Include="..\..\src\EgyptTax.Domain\EgyptTax.Domain.csproj" />
    <ProjectReference Include="..\..\src\EgyptTax.Application\EgyptTax.Application.csproj" />
    <ProjectReference Include="..\..\src\EgyptTax.Infrastructure\EgyptTax.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\EgyptTax.Web\EgyptTax.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="WireMock.Net" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <!--
    T227 — copy the inspection-bundle manifest schema to bin so the
    contract-validation test can load it via AppContext.BaseDirectory.
    Mirrors the ContractTests project's contracts/**/*.json glob.
  -->
  <ItemGroup>
    <None Include="..\..\specs\008-egypt-tax-accounting\contracts\inspection-bundle-manifest.schema.json"
          Link="contracts\inspection-bundle-manifest.schema.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
